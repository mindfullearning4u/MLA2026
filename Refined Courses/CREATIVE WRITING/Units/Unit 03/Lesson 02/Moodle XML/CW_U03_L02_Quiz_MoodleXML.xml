mat="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Childhood has no meaning.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Songs cannot be remembered.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer></question><question type="multichoice"><name><text>CW_U03_L02_R_Q21</text></name><questiontext format="html"><text>&lt;p&gt;Passage A: The hero refuses the throne to remain with the village. Passage B: The captain declines promotion to protect her crew. What comparison is strongest?&lt;/p&gt;</text></questiontext><generalfeedback format="html"><text /></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>none</answernumbering><showstandardinstruction>1</showstandardinstruction><correctfeedback format="html"><text /></correctfeedback><partiallycorrectfeedback format="html"><text /></partiallycorrectfeedback><incorrectfeedback format="html"><text /></incorrectfeedback><answer fraction="0.0" format="html"><text>&lt;p&gt;Thrones and ships are identical.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Promotions always mean danger.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="100.0" format="html"><text>&lt;p&gt;Both passages show leadership as service rather than status.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Villages cannot have leaders.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer></question><question type="multichoice"><name><text>CW_U03_L02_R_Q22</text></name><questiontext format="html"><text>&lt;p&gt;Passage A: A sister waits outside the audition room holding a lucky ribbon. Passage B: A brother records every practice so his sibling can improve. What shared theme is best supported?&lt;/p&gt;</text></questiontext><generalfeedback format="html"><text /></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>none</answernumbering><showstandardinstruction>1</showstandardinstruction><correctfeedback format="html"><text /></correctfeedback><partiallycorrectfeedback format="html"><text /></partiallycorrectfeedback><incorrectfeedback format="html"><text /></incorrectfeedback><answer fraction="100.0" format="html"><text>&lt;p&gt;Support can appear through quiet actions, not only advice.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Ribbons and recordings are the same.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Auditions never need practice.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Siblings always compete.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer></question><question type="multichoice"><name><text>CW_U03_L02_R_Q23</text></name><questiontext format="html"><text>&lt;p&gt;Passage A: A farmer saves seeds after a failed harvest. Passage B: A student keeps notes after failing a test. What shared theme fits?&lt;/p&gt;</text></questiontext><generalfeedback format="html"><text /></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>none</answernumbering><showstandardinstruction>1</showstandardinstruction><correctfeedback format="html"><text /></correctfeedback><partiallycorrectfeedback format="html"><text /></partiallycorrectfeedback><incorrectfeedback format="html"><text /></incorrectfeedback><answer fraction="0.0" format="html"><text>&lt;p&gt;Seeds are tests.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Failure ends every future.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Notes only matter on farms.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="100.0" format="html"><text>&lt;p&gt;Hope can survive failure when people prepare for another chance.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer></question><question type="multichoice"><name><text>CW_U03_L02_R_Q24</text></name><questiontext format="html"><text>&lt;p&gt;Passage A: A character burns an old invitation after finally saying goodbye. Passage B: A character packs a photo carefully before moving away. Which comparison is strongest?&lt;/p&gt;</text></questiontext><generalfeedback format="html"><text /></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>none</answernumbering><showstandardinstruction>1</showstandardinstruction><correctfeedback format="html"><text /></correctfeedback><partiallycorrectfeedback format="html"><text /></partiallycorrectfeedback><incorrectfeedback format="html"><text /></incorrectfeedback><answer fraction="100.0" format="html"><text>&lt;p&gt;Both passages explore letting go, but one uses release while the other uses carrying memory forward.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Burning and packing mean exactly the same action.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Invitations and photos cannot carry meaning.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Moving always means forgetting.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer></question><question type="multichoice"><name><text>CW_U03_L02_R_Q25</text></name><questiontext format="html"><text>&lt;p&gt;Passage A: A student speaks up when the group excludes a classmate. Passage B: A neighbor opens her door when everyone else looks away. What shared theme is strongest?&lt;/p&gt;</text></questiontext><generalfeedback format="html"><text /></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>none</answernumbering><showstandardinstruction>1</showstandardinstruction><correctfeedback format="html"><text /></correctfeedback><partiallycorrectfeedback format="html"><text /></partiallycorrectfeedback><incorrectfeedback format="html"><text /></incorrectfeedback><answer fraction="0.0" format="html"><text>&lt;p&gt;Doors and classmates are identical.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="100.0" format="html"><text>&lt;p&gt;Belonging often depends on someone choosing inclusion over silence.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Silence always helps people belong.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Neighbors cannot appear in themes.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer></question></quiz>