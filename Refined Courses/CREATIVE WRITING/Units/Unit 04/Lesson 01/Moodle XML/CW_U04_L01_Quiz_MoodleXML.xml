action="0.0" format="html"><text>&lt;p&gt;Simile creates an excited mood.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="100.0" format="html"><text>&lt;p&gt;Personification makes the bus seem weary as it departs, creating a subdued mood.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Metaphor creates a royal mood.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Hyperbole creates a furious mood.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer></question><question type="multichoice"><name><text>CW_U04_L01_R_Q22</text></name><questiontext format="html"><text>&lt;p&gt;Poem: The attic was an ocean of dust. Which mood is strongest?&lt;/p&gt;</text></questiontext><generalfeedback format="html"><text /></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>none</answernumbering><showstandardinstruction>1</showstandardinstruction><correctfeedback format="html"><text /></correctfeedback><partiallycorrectfeedback format="html"><text /></partiallycorrectfeedback><incorrectfeedback format="html"><text /></incorrectfeedback><answer fraction="0.0" format="html"><text>&lt;p&gt;Clean and fresh.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Joyful and musical.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Formal and polite.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="100.0" format="html"><text>&lt;p&gt;The metaphor compares the attic&amp;#39;s dust to an ocean, emphasizing its vast quantity and long neglect.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer></question><question type="multichoice"><name><text>CW_U04_L01_R_Q23</text></name><questiontext format="html"><text>&lt;p&gt;Poem: The rain tapped tiny fingers on the roof. What does the personification create?&lt;/p&gt;</text></questiontext><generalfeedback format="html"><text /></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>none</answernumbering><showstandardinstruction>1</showstandardinstruction><correctfeedback format="html"><text /></correctfeedback><partiallycorrectfeedback format="html"><text /></partiallycorrectfeedback><incorrectfeedback format="html"><text /></incorrectfeedback><answer fraction="0.0" format="html"><text>&lt;p&gt;A harsh mood.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;A jealous mood.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="100.0" format="html"><text>&lt;p&gt;Personification and soft sound imagery make the rain feel gentle and rhythmic.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;A silent mood.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer></question><question type="multichoice"><name><text>CW_U04_L01_R_Q24</text></name><questiontext format="html"><text>&lt;p&gt;Poem: His hope flickered like a match in wind. Which explanation is strongest?&lt;/p&gt;</text></questiontext><generalfeedback format="html"><text /></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>none</answernumbering><showstandardinstruction>1</showstandardinstruction><correctfeedback format="html"><text /></correctfeedback><partiallycorrectfeedback format="html"><text /></partiallycorrectfeedback><incorrectfeedback format="html"><text /></incorrectfeedback><answer fraction="0.0" format="html"><text>&lt;p&gt;The metaphor creates a confident mood because matches are strong.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;The line creates a comic mood because wind is funny.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;The line is literal because hope burns.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="100.0" format="html"><text>&lt;p&gt;The simile presents hope as small and vulnerable but still alive against difficult conditions.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer></question><question type="multichoice"><name><text>CW_U04_L01_R_Q25</text></name><questiontext format="html"><text>&lt;p&gt;Poem: The noon sun hammered the playground flat. What mood is created?&lt;/p&gt;</text></questiontext><generalfeedback format="html"><text /></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>none</answernumbering><showstandardinstruction>1</showstandardinstruction><correctfeedback format="html"><text /></correctfeedback><partiallycorrectfeedback format="html"><text /></partiallycorrectfeedback><incorrectfeedback format="html"><text /></incorrectfeedback><answer fraction="100.0" format="html"><text>&lt;p&gt;The verb hammered personifies the sun and creates an oppressive mood of intense heat.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Soft and soothing.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Cold and distant.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Quiet and sleepy only.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer></question></quiz>