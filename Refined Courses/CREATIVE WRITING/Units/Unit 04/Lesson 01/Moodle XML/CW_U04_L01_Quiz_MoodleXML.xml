dback format="html"><text /></feedback></answer><answer fraction="100.0" format="html"><text>&lt;p&gt;The simile compares city lights to scattered coins, creating a bright, glittering mood.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Bitter and harsh.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Silent and blank.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer></question><question type="multichoice"><name><text>CW_U04_L01_R_Q19</text></name><questiontext format="html"><text>&lt;p&gt;Poem: The desk waited with its blank white stare. Which explanation is best?&lt;/p&gt;</text></questiontext><generalfeedback format="html"><text /></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>none</answernumbering><showstandardinstruction>1</showstandardinstruction><correctfeedback format="html"><text /></correctfeedback><partiallycorrectfeedback format="html"><text /></partiallycorrectfeedback><incorrectfeedback format="html"><text /></incorrectfeedback><answer fraction="0.0" format="html"><text>&lt;p&gt;Simile creates happiness because desks are helpful.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Imagery creates a beach mood because white is sand.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="100.0" format="html"><text>&lt;p&gt;Personification gives the blank desk a stare, making it feel intimidating and expectant.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;The line is literal.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer></question><question type="multichoice"><name><text>CW_U04_L01_R_Q20</te