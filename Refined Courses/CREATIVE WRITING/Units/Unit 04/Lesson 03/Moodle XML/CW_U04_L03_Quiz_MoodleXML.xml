true</shuffleanswers><answernumbering>none</answernumbering><showstandardinstruction>1</showstandardinstruction><correctfeedback format="html"><text /></correctfeedback><partiallycorrectfeedback format="html"><text /></partiallycorrectfeedback><incorrectfeedback format="html"><text /></incorrectfeedback><answer fraction="100.0" format="html"><text>&lt;p&gt;Keeping the ticket inside a dictionary connects a remembered journey with knowledge, identity, or a story worth preserving.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;The dictionary is definitely new.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;The ticket proves the speaker dislikes reading.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;The poem only teaches alphabetizing.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer></question><question type="multichoice"><name><text>CW_U04_L03_R_Q06</text></name><questiontext format="html"><text>&lt;p&gt;Poem: The mirror showed the room, but not the open door behind me. What does the ambiguity invite?&lt;/p&gt;</text></questiontext><generalfeedback format="html"><text /></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>none</answernumbering><showstandardinstruction>1</showstandardinstruction><correctfeedback format="html"><text /></correctfeedback><partiallycorrectfeedback format="html"><text /></partiallycorrectfeedback><incorrectfeedback format="html"><text /></incorrectfeedback><answer fraction="0.0" format="html"><text>&lt;p&gt;A single literal answer only.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;A claim that mirrors never reflect anything.&lt;