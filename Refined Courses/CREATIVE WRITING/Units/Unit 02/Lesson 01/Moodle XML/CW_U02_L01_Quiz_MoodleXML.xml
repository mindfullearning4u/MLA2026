rmat="html"><text /></incorrectfeedback><answer fraction="0.0" format="html"><text>&lt;p&gt;The elevator doors opened on the sixth floor.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;&amp;quot;Are you coming?&amp;quot; Dad asked.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="100.0" format="html"><text>&lt;p&gt;I knew then that I had not come to apologize; I had come to say goodbye.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;A red suitcase leaned against the wall.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer></question><question type="multichoice"><name><text>CW_U02_L01_R_Q17</text></name><questiontext format="html"><text>&lt;p&gt;Which transition best shows place?&lt;/p&gt;</text></questiontext><generalfeedback format="html"><text /></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>none</answernumbering><showstandardinstruction>1</showstandardinstruction><correctfeedback format="html"><text /></correctfeedback><partiallycorrectfeedback format="html"><text /></partiallycorrectfeedback><incorrectfeedback format="html"><text /></incorrectfeedback><answer fraction="0.0" format="html"><text>&lt;p&gt;After the bell rang, Mia stayed seated.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="100.0" format="html"><text>&lt;p&gt;At the far end of the hallway, Mia spotted the blue locker.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Because the hallway was crowded, Mia waited.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Even though she was late, Mia smiled.&lt;/p&gt;</text><fe