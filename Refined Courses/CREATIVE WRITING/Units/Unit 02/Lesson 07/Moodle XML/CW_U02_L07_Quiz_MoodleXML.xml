defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>none</answernumbering><showstandardinstruction>1</showstandardinstruction><correctfeedback format="html"><text /></correctfeedback><partiallycorrectfeedback format="html"><text /></partiallycorrectfeedback><incorrectfeedback format="html"><text /></incorrectfeedback><answer fraction="0.0" format="html"><text>&lt;p&gt;Jules throws the map away.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;The scene is only about geography facts.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="100.0" format="html"><text>&lt;p&gt;The care suggests the map may still matter to Jules despite its inaccuracy.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;The map has no role in the scene.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer></question><question type="multichoice"><name><text>CW_U02_L07_R_Q21</text></name><questiontext format="html"><text>&lt;p&gt;Passage: Which planning sequence best creates an integrated narrative scene?&lt;/p&gt;</text></questiontext><generalfeedback format="html"><text /></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>none</answernumbering><showstandardinstruction>1</showstandardinstruction><correctfeedback format="html"><text /></correctfeedback><partiallycorrectfeedback format="html"><text /></partiallycorrectfeedback><incorrectfeedback format="html"><text /></incorrectfeedback><answer fraction="0.0" format="html"><text>&lt;p&gt;Choose random details first and decide meaning later.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Write only dialogue with no context.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Avoid revision after drafting.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="100.0" format="html"><text>&lt;p&gt;Pick a purpose, choose point of view for that purpose, select key details, and control pacing around the turn.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer></question><question type="multichoice"><name><text>CW_U02_L07_R_Q22</text></name><questiontext format="html"><text>&lt;p&gt;Passage: &amp;quot;The classroom clock clicked through the silence after Omar said, &amp;#39;I was the one who erased it.&amp;#39;&amp;quot; What is the function of the clock?&lt;/p&gt;</text></questiontext><generalfeedback format="html"><text /></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>none</answernumbering><showstandardinstruction>1</showstandardinstruction><correctfeedback format="html"><text /></correctfeedback><partiallycorrectfeedback format="html"><text /></partiallycorrectfeedback><incorrectfeedback format="html"><text /></incorrectfeedback><answer fraction="0.0" format="html"><text>&lt;p&gt;It gives a math lesson.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="100.0" format="html"><text>&lt;p&gt;It slows the moment after a confession.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;It changes the genre to fantasy.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;It proves Omar is innocent.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer></question><question type="multichoice"><name><text>CW_U02_L07_R_Q23</text></name><questiontext format="html"><text>&lt;p&gt;Passage: A student says, &amp;quot;My scene has a necklace, a storm, and a secret, so it is integrated.&amp;quot; What is the best response?&lt;/p&gt;</text></questiontext><generalfeedback format="html"><text /></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>none</answernumbering><showstandardinstruction>1</showstandardinstruction><correctfeedback format="html"><text /></correctfeedback><partiallycorrectfeedback format="html"><text /></partiallycorrectfeedback><incorrectfeedback format="html"><text /></incorrectfeedback><answer fraction="100.0" format="html"><text>&lt;p&gt;Integration means the pieces work together to develop character, conflict, and meaning.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Integration means every scene must include three objects.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Integration means the author writes quickly.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer><answer fraction="0.0" format="html"><text>&lt;p&gt;Integration means removing all setting.&lt;/p&gt;</text><feedback format="html"><text /></feedback></answer></question><question type="multichoice"><name><text>CW_U02_L07_R_Q24</text></name><questiontext format="html"><text>&lt;p&gt;Passage: &amp;quot;After the argument, June washed the same clean glass three times.&amp;quot; Which interpretation best fits?&lt;/p&gt;</text></questiontext><generalfeedback format="html"><text /></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>none</answernumbering><showstandardinstruction>1</showstandardinstruction><correctfeedback format="html"><text /></correctfeedback><partiallycorrectfeedback for