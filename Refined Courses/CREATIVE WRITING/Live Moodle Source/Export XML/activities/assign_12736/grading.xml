      <definition id="3000">
        <method>rubric</method>
        <name>Checkpoint Rubric</name>
        <description>Use this generic rubric for every Checkpoint. It grades source analysis and evidence, original application and organization, lesson-skill reasoning including the A/B justification, purposeful revision and reflection, and completeness, clarity, and conventions. A score of at least 80% demonstrates mastery. Below 80%, provide focused feedback for correction and resubmission.</description>
        <descriptionformat>1</descriptionformat>
        <status>20</status>
