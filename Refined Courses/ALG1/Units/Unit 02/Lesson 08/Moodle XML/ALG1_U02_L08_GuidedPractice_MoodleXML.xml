  <question type="multichoice">
    <name>
      <text>ALG1_U02_L08_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U02_L08_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A1.AR.1</p><p>Solve 3x+7=22.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[3]]></text>
      <feedback format="html">
        <text><![CDATA[This subtracts 7 but does not divide 15 by 3 correctly.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[5]]></text>
      <feedback format="html">
        <text><![CDATA[Subtract 7 to get 3x=15, then divide by 3.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[15]]></text>
      <feedback format="html">
        <text><![CDATA[This is the value of 3x, not x.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[29]]></text>
      <feedback format="html">
        <text><![CDATA[This adds 7 instead of using inverse operations.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U02_L08_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U02_L08_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A1.AR.1</p><p>Solve 2(x+4)=18.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[9]]></text>
      <feedback format="html">
        <text><![CDATA[This divides by 2 but stops before subtracting 4 from both sides.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[7]]></text>
      <feedback format="html">
        <text><![CDATA[This divides 18 by 2 but forgets to subtract 4.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[14]]></text>
      <feedback format="html">
        <text><![CDATA[This subtracts 4 from 18 and stops.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[5]]></text>
      <feedback format="html">
        <text><![CDATA[Divide by 2 to get x+4=9, then subtract 4.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U02_L08_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U02_L08_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A1.FND.5</p><p>Solve A=lw for w.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[w=A/l]]></text>
      <feedback format="html">
        <text><![CDATA[Divide both sides by l to isolate w.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[w=Al]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies by l instead of dividing by l.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[w=l/A]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the needed ratio.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[w=A-l]]></text>
      <feedback format="html">
        <text><![CDATA[Subtraction does not undo multiplication by l.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U02_L08_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U02_L08_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A1.AR.1</p><p>The equation 5x+2=5x+9 has what type of solution?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[One solution]]></text>
      <feedback format="html">
        <text><![CDATA[Subtracting 5x from both sides does not leave a true equation.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Infinitely many solutions]]></text>
      <feedback format="html">
        <text><![CDATA[Infinitely many solutions would leave a true statement like 2=2.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[No solution]]></text>
      <feedback format="html">
        <text><![CDATA[Subtracting 5x gives 2=9, which is false.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 7]]></text>
      <feedback format="html">
        <text><![CDATA[There is no value of x that makes 2=9 true.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U02_L08_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U02_L08_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A1.AR.1</p><p>A gym charges $20 to join plus $8 per visit. Which equation gives total cost C for v visits?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[C=20v+8]]></text>
      <feedback format="html">
        <text><![CDATA[This treats 20 as the per-visit cost and 8 as the fixed fee.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[C=8v+20]]></text>
      <feedback format="html">
        <text><![CDATA[The fixed fee is 20 and each visit adds 8.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[C=28v]]></text>
      <feedback format="html">
        <text><![CDATA[This treats the fixed fee and visit cost as one repeated rate.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[C=20+8]]></text>
      <feedback format="html">
        <text><![CDATA[This does not include the number of visits.]]></text>
      </feedback>
    </answer>
  </question>
