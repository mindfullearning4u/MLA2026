  <question type="multichoice">
    <name>
      <text>ALG1_U02_L05_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U02_L05_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A1.FND.5</p><p>Solve d = rt for r.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[r = d - t]]></text>
      <feedback format="html">
        <text><![CDATA[Subtracting t does not undo multiplication by t.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[r = d/t]]></text>
      <feedback format="html">
        <text><![CDATA[Divide both sides by t to isolate r.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[r = dt]]></text>
      <feedback format="html">
        <text><![CDATA[Multiplying by t moves farther from isolating r.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[r = t/d]]></text>
      <feedback format="html">
        <text><![CDATA[The numerator and denominator are reversed.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U02_L05_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U02_L05_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A1.FND.5</p><p>Solve y = mx + b for b.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[b = y + mx]]></text>
      <feedback format="html">
        <text><![CDATA[The term mx must be subtracted from y.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[b = mx - y]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the subtraction order.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[b = y/m - x]]></text>
      <feedback format="html">
        <text><![CDATA[Dividing by m is not needed to isolate b.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[b = y - mx]]></text>
      <feedback format="html">
        <text><![CDATA[Subtract mx from both sides.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U02_L05_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U02_L05_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A1.FND.5</p><p>Solve A = bh for h.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[h = A/b]]></text>
      <feedback format="html">
        <text><![CDATA[Divide both sides by b.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[h = A - b]]></text>
      <feedback format="html">
        <text><![CDATA[Subtraction does not undo multiplication by b.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[h = b/A]]></text>
      <feedback format="html">
        <text><![CDATA[The numerator and denominator are reversed.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[h = Ab]]></text>
      <feedback format="html">
        <text><![CDATA[Multiplying by b does not isolate h.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U02_L05_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U02_L05_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A1.FND.5</p><p>Solve P = 2l + 2w for l.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[l = P - 2w]]></text>
      <feedback format="html">
        <text><![CDATA[This does not account for the factor of 2 on l.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[l = P/2 + w]]></text>
      <feedback format="html">
        <text><![CDATA[The 2w term must be subtracted before dividing.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[l = (P - 2w)/2]]></text>
      <feedback format="html">
        <text><![CDATA[Subtract 2w, then divide by 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[l = (P + 2w)/2]]></text>
      <feedback format="html">
        <text><![CDATA[The 2w term should be subtracted, not added.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U02_L05_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U02_L05_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A1.FND.5</p><p>Why should the target variable be named before rearranging a formula?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[It tells which numbers should be rounded.]]></text>
      <feedback format="html">
        <text><![CDATA[Rounding is not the purpose of naming the target variable.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[It tells which variable must be isolated.]]></text>
      <feedback format="html">
        <text><![CDATA[The target variable determines the goal of the rearrangement.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It changes the original formula.]]></text>
      <feedback format="html">
        <text><![CDATA[Naming the target variable does not change the formula.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It removes the need to use inverse operations.]]></text>
      <feedback format="html">
        <text><![CDATA[Inverse operations are still needed.]]></text>
      </feedback>
    </answer>
  </question>
