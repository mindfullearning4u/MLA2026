    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U02_L03_Q04</p><p><strong>MLA Standard:</strong> MLA.A1.AR.1</p><p>Which equation represents a $12 fee plus $5 per ticket totaling $47? Let t represent tickets.</p>]]></text>
    </questiontext>
