        <text><![CDATA[This reverses the fee and per-ticket cost.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[12t + 5 = 47]]></text>
      <feedback format="html">
        <text><![CDATA[This makes 12 the repeated cost instead of the fixed fee.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
