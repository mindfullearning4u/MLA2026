  <question type="multichoice">
    <name>
      <text>ALG1_U02_L03_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U02_L03_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A1.AR.1</p><p>Solve 3(x + 2) = 24.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 8]]></text>
      <feedback format="html">
        <text><![CDATA[This stops after dividing 24 by 3 and ignores the +2.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x = 6]]></text>
      <feedback format="html">
        <text><![CDATA[Distribute or divide first: 3x + 6 = 24, so x = 6.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 10]]></text>
      <feedback format="html">
        <text><![CDATA[This adds 2 instead of subtracting after undoing multiplication.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 72]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies instead of solving.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U02_L03_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U02_L03_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A1.AR.1</p><p>Solve 4x + 2x - 9 = 27.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 3]]></text>
      <feedback format="html">
        <text><![CDATA[This does not correctly add 9 and divide by 6.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 36]]></text>
      <feedback format="html">
        <text><![CDATA[This stops after adding 9 and does not divide by 6.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 4]]></text>
      <feedback format="html">
        <text><![CDATA[This uses an incorrect coefficient after combining like terms.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x = 6]]></text>
      <feedback format="html">
        <text><![CDATA[Combine like terms to get 6x - 9 = 27, then solve.]]></text>
      </feedback>
    </answer>
