  <question type="multichoice">
    <name>
      <text>ALG1_U02_L03_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U02_L03_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A1.AR.1</p><p>Solve 1/2x + 5 = 13.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[x = 16]]></text>
      <feedback format="html">
        <text><![CDATA[Subtract 5 to get one-half x equals 8, then multiply by 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 8]]></text>
      <feedback format="html">
        <text><![CDATA[This stops after subtracting 5 and does not undo multiplication by one-half.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 4]]></text>
      <feedback format="html">
        <text><![CDATA[This divides by 2 instead of multiplying by 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 18]]></text>
      <feedback format="html">
        <text><![CDATA[This adds 5 instead of subtracting 5.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U02_L03_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U02_L03_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A1.AR.1</p><p>Which equation represents a $12 fee plus $5 per ticket totaling $47? Let t represent tickets.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[5 + 12t = 47]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the fee and per-ticket cost.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[12t + 5 = 47]]></text>
      <feedback format="html">
        <text><![CDATA[This makes 12 the repeated cost instead of the fixed fee.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[12 + 5t = 47]]></text>
      <feedback format="html">
        <text><![CDATA[The fixed fee is 12 and the repeated ticket cost is 5t.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[47 + 5t = 12]]></text>
      <feedback format="html">
        <text><![CDATA[This places the total on the wrong side of the relationship.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U02_L03_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U02_L03_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A1.AR.1</p><p>A student writes 2(x + 5) = 2x + 5. What is the error?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The x should be removed.]]></text>
      <feedback format="html">
        <text><![CDATA[The variable remains part of the expression.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The 2 was not distributed to 5.]]></text>
      <feedback format="html">
        <text><![CDATA[The 2 must multiply both x and 5.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The equation has no solution.]]></text>
      <feedback format="html">
        <text><![CDATA[The issue is distribution, not solution type.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The 2 should be added to x.]]></text>
      <feedback format="html">
        <text><![CDATA[Distribution uses multiplication, not addition.]]></text>
      </feedback>
    </answer>
  </question>
