      <text>ALG1_U02_L01_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U02_L01_GP_Q05</p><p><strong>MLA Standard:</strong> Readiness Support Only - No primary MLA standard assigned in approved mapping</p><p>Why should you check a solution in the original equation?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[To make the answer larger]]></text>
      <feedback format="html">
        <text><![CDATA[Checking verifies an answer; it does not change the value.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[To verify that the value makes both sides equal]]></text>
      <feedback format="html">
        <text><![CDATA[A solution must make the original equation true.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[To avoid using inverse operations]]></text>
      <feedback format="html">
        <text><![CDATA[Inverse operations are still needed to solve.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[To remove the variable from the course]]></text>
      <feedback format="html">
        <text><![CDATA[Checking is about accuracy, not removing variables from future lessons.]]></text>
      </feedback>
    </answer>
