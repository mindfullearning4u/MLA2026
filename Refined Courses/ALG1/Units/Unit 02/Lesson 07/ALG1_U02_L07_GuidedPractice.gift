::ALG1_U02_L07_GP_Q01::Solve 4x + 7 = 31. {
~A. x = 5 #This gives 27, not 31.
=B. x = 6 #Correct. Subtract 7, then divide by 4.
~C. x = 7 #This gives 35, not 31.
~D. x = 24 #This stops after subtracting 7.
}

::ALG1_U02_L07_GP_Q02::Solve 2(x - 3) = 18. {
~A. x = 6 #This forgets to add 3 after dividing.
~B. x = 8 #This gives 10, not 18.
~C. x = 15 #This adds 3 to 12 instead of to 9.
=D. x = 12 #Correct. Divide by 2 to get x - 3 = 9, then add 3.
}

::ALG1_U02_L07_GP_Q03::Solve 5x + 4 = 2x + 25. {
=A. x = 7 #Correct. Subtract 2x, then subtract 4 and divide by 3.
~B. x = 21 #This is the difference before dividing by 3.
~C. x = 29 #This adds constants instead of isolating x.
~D. x = 3 #This does not satisfy the equation.
}

::ALG1_U02_L07_GP_Q04::A rental costs $10 plus $6 per hour. The total is $46. How many hours h were rented? {
~A. h = 5 #This gives a total of $40.
~B. h = 36 #This is the remaining cost before dividing by 6.
=C. h = 6 #Correct. 10 + 6h = 46, so h = 6.
~D. h = 46 #This is the total cost, not the number of hours.
}

::ALG1_U02_L07_GP_Q05::Solve A = bh for b. {
~A. b = A - h #Subtraction does not undo multiplication by h.
=B. b = A/h #Correct. Divide both sides by h.
~C. b = h/A #The quotient is reversed.
~D. b = Ah #Multiplication does not isolate b.
}
