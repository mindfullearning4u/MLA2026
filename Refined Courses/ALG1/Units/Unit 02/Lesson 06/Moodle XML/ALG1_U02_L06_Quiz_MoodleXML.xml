      <text>ALG1_U02_L06_Q21</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U02_L06_Q21</p><p><strong>MLA Standard:</strong> Unit 2 application support</p><p>A club charges 12 dollars to join and 5 dollars for each event. The total cost is 42 dollars. Which equation represents the situation?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
