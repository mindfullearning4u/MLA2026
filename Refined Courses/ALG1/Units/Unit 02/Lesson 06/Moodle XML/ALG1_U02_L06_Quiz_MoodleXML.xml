    <answer fraction="0" format="html">
      <text><![CDATA[12e + 5 = 42]]></text>
      <feedback format="html">
        <text><![CDATA[This treats 12 as the repeated cost instead of the fixed cost.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[12 + 5e = 42]]></text>
      <feedback format="html">
        <text><![CDATA[The fixed cost is 12 and 5 is multiplied by the number of events.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[5 + 42e = 12]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the total and the fixed cost.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[12 - 5e = 42]]></text>
      <feedback format="html">
        <text><![CDATA[The event cost is added, not subtracted, from the membership cost.]]></text>
      </feedback>
    </answer>
  </question>
