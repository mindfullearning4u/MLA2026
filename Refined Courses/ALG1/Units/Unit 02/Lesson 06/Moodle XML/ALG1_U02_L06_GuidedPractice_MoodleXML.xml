<quiz>
  <question type="category">
    <category>
      <text>$course$/ALG1/Units/Unit 02/Lesson 06/ALG1_U02_L06_GuidedPractice</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U02_L06_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U02_L06_GP_Q01</p><p><strong>MLA Standard:</strong> Unit 2 application support</p><p>A skateboard rental costs $8 plus $5 per hour. The total cost is $28. Which equation and solution model the number of hours h?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[8h + 5 = 28, h = 2.875]]></text>
      <feedback format="html">
        <text><![CDATA[The hourly charge and starting cost are reversed.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[8 + 5h = 28, h = 4]]></text>
      <feedback format="html">
        <text><![CDATA[Subtract 8, then divide by 5.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[5 + 8h = 28, h = 2.875]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the fixed cost and hourly cost.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[8 + 5h = 28, h = 20]]></text>
      <feedback format="html">
        <text><![CDATA[This stops after subtracting 8 and does not divide by 5.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U02_L06_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U02_L06_GP_Q02</p><p><strong>MLA Standard:</strong> Unit 2 application support</p><p>A student has 12 stickers and buys packs with 4 stickers each. The student has 36 stickers total. Which equation and solution model the number of packs p?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[12p + 4 = 36, p = 8/3]]></text>
      <feedback format="html">
        <text><![CDATA[This treats 12 as the number per pack.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[12 + 4p = 36, p = 24]]></text>
      <feedback format="html">
        <text><![CDATA[This stops after subtracting 12.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4 + 12p = 36, p = 8/3]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the starting amount and pack size.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[12 + 4p = 36, p = 6]]></text>
      <feedback format="html">
        <text><![CDATA[The student bought 6 packs.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U02_L06_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U02_L06_GP_Q03</p><p><strong>MLA Standard:</strong> Unit 2 application support</p><p>The sum of a number and 9 is 31. Which equation and solution are correct?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[n + 9 = 31, n = 22]]></text>
      <feedback format="html">
        <text><![CDATA[Subtract 9 from both sides.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[9n = 31, n = 31/9]]></text>
      <feedback format="html">
        <text><![CDATA[The word sum indicates addition, not multiplication.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[n - 9 = 31, n = 40]]></text>
      <feedback format="html">
        <text><![CDATA[The phrase says the number plus 9.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[n + 31 = 9, n = -22]]></text>
      <feedback format="html">
        <text><![CDATA[The total is 31, not 9.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U02_L06_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U02_L06_GP_Q04</p><p><strong>MLA Standard:</strong> Unit 2 application support</p><p>A rectangle has perimeter 38 feet and length 12 feet. Which equation can be solved for the width w, and what is w?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[12 + w = 38, w = 26]]></text>
      <feedback format="html">
        <text><![CDATA[Perimeter uses two lengths and two widths.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[2(12) + w = 38, w = 14]]></text>
      <feedback format="html">
        <text><![CDATA[There are two widths, not one.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[2(12) + 2w = 38, w = 7]]></text>
      <feedback format="html">
        <text><![CDATA[24 + 2w = 38, so w = 7.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[12w = 38, w = 19/6]]></text>
      <feedback format="html">
        <text><![CDATA[This equation models area, not perimeter.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U02_L06_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U02_L06_GP_Q05</p><p><strong>MLA Standard:</strong> Unit 2 application support</p><p>Why should a final answer include units or context?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[It makes the equation longer.]]></text>
      <feedback format="html">
        <text><![CDATA[Length is not the purpose of interpretation.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[It explains what the number means in the situation.]]></text>
      <feedback format="html">
        <text><![CDATA[A solution should answer the original question.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It changes an incorrect answer into a correct one.]]></text>
      <feedback format="html">
        <text><![CDATA[Units do not fix incorrect solving.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It replaces the need to solve the equation.]]></text>
      <feedback format="html">
        <text><![CDATA[The equation still must be solved.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>