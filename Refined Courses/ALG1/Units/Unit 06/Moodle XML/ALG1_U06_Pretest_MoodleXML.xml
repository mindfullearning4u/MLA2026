<quiz>
  <question type="category">
    <category>
      <text>$course$/ALG1/Units/Unit 06/ALG1_U06_Pretest</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_PT_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_PT_Q01</p><p><strong>MLA Standard:</strong> MLA.A1.AR.5</p><p>The lines y=x+4 and y=2x+1 intersect at (3,7). What does (3,7) represent?</p><p><img src="@@PLUGINFILE@@/ALG1_U06_PT_Q01_graph.png" alt="Point-pair graph supports slope/rate interpretation." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="ALG1_U06_PT_Q01_graph.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[The ordered pair that satisfies both equations]]></text>
      <feedback format="html">
        <text><![CDATA[A system solution is the point that makes both equations true.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The slope of both lines]]></text>
      <feedback format="html">
        <text><![CDATA[The slopes are 1 and 2, not the ordered pair.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The y-intercept of both lines]]></text>
      <feedback format="html">
        <text><![CDATA[The y-intercepts are 4 and 1, not the ordered pair.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The number of solutions]]></text>
      <feedback format="html">
        <text><![CDATA[The ordered pair gives the solution, not a count of solutions.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_PT_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_PT_Q02</p><p><strong>MLA Standard:</strong> MLA.A1.AR.6; MLA.A1.AR.7</p><p>A student has at most $40 to buy notebooks costing $5 each and pens costing $2 each. Which inequality models the cost constraint?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[5n+2p \ge 40]]></text>
      <feedback format="html">
        <text><![CDATA[This would mean the cost is at least $40, not at most $40.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[2n+5p \le 40]]></text>
      <feedback format="html">
        <text><![CDATA[This switches the notebook and pen costs.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[5n+2p \le 40]]></text>
      <feedback format="html">
        <text><![CDATA[The total cost must be less than or equal to the spending limit.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[5n-2p \le 40]]></text>
      <feedback format="html">
        <text><![CDATA[Costs should be added, not subtracted.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_PT_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_PT_Q03</p><p><strong>MLA Standard:</strong> MLA.A1.DF.1</p><p>Find the simple interest on $700 at 4% for 3 years.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[$28]]></text>
      <feedback format="html">
        <text><![CDATA[This is the interest for only one year.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[$84]]></text>
      <feedback format="html">
        <text><![CDATA[I=Prt=700(0.04)(3)=84.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$84,000]]></text>
      <feedback format="html">
        <text><![CDATA[This uses 4 instead of 0.04 and gives an unreasonable amount.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$784]]></text>
      <feedback format="html">
        <text><![CDATA[This is close to principal plus interest but uses the wrong total for the question.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_PT_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_PT_Q04</p><p><strong>MLA Standard:</strong> MLA.A1.DF.2</p><p>Which expression gives the total amount for $1,000 at 5% compounded annually for 2 years?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[1000+0.05(2)]]></text>
      <feedback format="html">
        <text><![CDATA[This does not multiply the rate by the principal or compound.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[1000(0.05)(2)]]></text>
      <feedback format="html">
        <text><![CDATA[This gives simple interest, not total compound amount.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[1000(1.5)&#178;]]></text>
      <feedback format="html">
        <text><![CDATA[This uses 50% instead of 5%.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[1000(1.05)&#178;]]></text>
      <feedback format="html">
        <text><![CDATA[Annual compounding uses growth factor 1.05 for 2 years.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_PT_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_PT_Q05</p><p><strong>MLA Standard:</strong> MLA.A1.DF.3; MLA.A1.DF.4</p><p>Which display is best for comparing counts across different categories?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Scatterplot]]></text>
      <feedback format="html">
        <text><![CDATA[A scatterplot shows association between two numerical variables.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Bar graph]]></text>
      <feedback format="html">
        <text><![CDATA[A bar graph compares counts or amounts across categories.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Residual plot]]></text>
      <feedback format="html">
        <text><![CDATA[A residual plot is used to examine model errors.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Line of fit]]></text>
      <feedback format="html">
        <text><![CDATA[A line of fit models a trend, not category counts.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_PT_Q06</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_PT_Q06</p><p><strong>MLA Standard:</strong> MLA.A1.DF.5; MLA.A1.DF.7</p><p>A scatterplot rises from left to right. What does this suggest?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Positive association]]></text>
      <feedback format="html">
        <text><![CDATA[As x increases, y tends to increase.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Negative association]]></text>
      <feedback format="html">
        <text><![CDATA[A negative association falls as x increases.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[No association]]></text>
      <feedback format="html">
        <text><![CDATA[A visible upward trend is an association.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Constant y-values]]></text>
      <feedback format="html">
        <text><![CDATA[The points are changing upward, not staying constant.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_PT_Q07</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_PT_Q07</p><p><strong>MLA Standard:</strong> MLA.A1.DF.6</p><p>A model predicts 68, but the actual value is 74. What is the residual?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[-6]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the subtraction order.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[142]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the values instead of comparing prediction error.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[6]]></text>
      <feedback format="html">
        <text><![CDATA[Residual = actual - predicted = 74 - 68 = 6.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[68]]></text>
      <feedback format="html">
        <text><![CDATA[This is the predicted value, not the residual.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_PT_Q08</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_PT_Q08</p><p><strong>MLA Standard:</strong> MLA.A1.DF.8</p><p>Which sampling method is most likely to represent an entire school fairly?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Survey only students in one club]]></text>
      <feedback format="html">
        <text><![CDATA[One club may not represent the whole school.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Survey only students who volunteer online]]></text>
      <feedback format="html">
        <text><![CDATA[Voluntary response can overrepresent strong opinions.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Survey only seniors]]></text>
      <feedback format="html">
        <text><![CDATA[This leaves out other grade levels.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Randomly survey students from every grade level]]></text>
      <feedback format="html">
        <text><![CDATA[Random selection across grade levels better represents the population.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_PT_Q09</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_PT_Q09</p><p><strong>MLA Standard:</strong> MLA.A1.DF.9</p><p>In a two-way table, 18 of 60 students in one group chose online tutoring. What is the relative frequency?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[30%]]></text>
      <feedback format="html">
        <text><![CDATA[18/60=0.30=30\%.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[18%]]></text>
      <feedback format="html">
        <text><![CDATA[This uses the count as the percent without using the total.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[60%]]></text>
      <feedback format="html">
        <text><![CDATA[This uses the group total as a percent.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[42%]]></text>
      <feedback format="html">
        <text><![CDATA[This uses the number who did not choose online tutoring.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_PT_Q10</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_PT_Q10</p><p><strong>MLA Standard:</strong> MLA.A1.AR.5; MLA.A1.DF.8</p><p>Which statement best describes a simulation used before solving a real-world algebra problem?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[It guarantees the exact answer before any calculation]]></text>
      <feedback format="html">
        <text><![CDATA[Simulation estimates outcomes; it does not guarantee an exact answer.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[It can estimate likely outcomes by repeating a modeled process]]></text>
      <feedback format="html">
        <text><![CDATA[Simulations use repeated trials to estimate what may happen.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It replaces the need to define variables]]></text>
      <feedback format="html">
        <text><![CDATA[Variables and quantities still need to be identified.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It proves that every sample is unbiased]]></text>
      <feedback format="html">
        <text><![CDATA[Simulation does not prove a sample was selected fairly.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>