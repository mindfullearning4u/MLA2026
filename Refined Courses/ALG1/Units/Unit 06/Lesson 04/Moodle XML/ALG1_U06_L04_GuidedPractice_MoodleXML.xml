    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Minutes spent reading each night]]></text>
      <feedback format="html">
        <text><![CDATA[Minutes are measured with numbers.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Favorite sport]]></text>
      <feedback format="html">
        <text><![CDATA[This is categorical because responses are labels.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Type of phone]]></text>
      <feedback format="html">
        <text><![CDATA[This is categorical because responses are groups.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Eye color]]></text>
      <feedback format="html">
        <text><![CDATA[This is categorical because responses are labels.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_L04_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L04_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A1.DF.4</p><p>A bar graph shows 14 students chose art and 9 chose music. How many more chose art?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[23]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the counts instead of comparing them.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[9]]></text>
      <feedback format="html">
        <text><![CDATA[This is the music count, not the difference.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[5]]></text>
      <feedback format="html">
        <text><![CDATA[14 - 9 = 5 more students chose art.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[14]]></text>
      <feedback format="html">
        <text><![CDATA[This is the art count, not the difference.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_L04_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L04_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A1.DF.3</p><p>What should you check before interpreting values from any graph?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The color of the bars]]></text>
      <feedback format="html">
        <text><![CDATA[Color may help visually, but it does not determine the values.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The title, labels, scale, and units]]></text>
      <feedback format="html">
        <text><![CDATA[These features tell what the graph measures and how to read values.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Whether the graph is printed on paper]]></text>
      <feedback format="html">
        <text><![CDATA[The format does not determine the data meaning.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Whether the graph has exactly four categories]]></text>
      <feedback format="html">
        <text><![CDATA[Graphs can have many valid numbers of categories.]]></text>
      </feedback>
    </answer>
  </question>
