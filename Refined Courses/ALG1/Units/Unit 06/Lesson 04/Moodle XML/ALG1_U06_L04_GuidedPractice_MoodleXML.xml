  <question type="multichoice">
    <name>
      <text>ALG1_U06_L04_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L04_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A1.DF.4</p><p>Which display is best for comparing how many students chose each favorite fruit?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Box plot]]></text>
      <feedback format="html">
        <text><![CDATA[A box plot summarizes numerical data, not category counts.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Bar graph]]></text>
      <feedback format="html">
        <text><![CDATA[A bar graph compares counts across categories.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Histogram]]></text>
      <feedback format="html">
        <text><![CDATA[A histogram groups numerical data into intervals.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Scatterplot]]></text>
      <feedback format="html">
        <text><![CDATA[A scatterplot compares two numerical variables.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_L04_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L04_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A1.DF.3</p><p>Which display is best for showing the distribution of quiz scores?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Pie chart]]></text>
      <feedback format="html">
        <text><![CDATA[A pie chart shows parts of a whole, not numerical distribution well.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Bar graph of names]]></text>
      <feedback format="html">
        <text><![CDATA[Names are categories and do not show score distribution.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Line graph]]></text>
      <feedback format="html">
        <text><![CDATA[A line graph is best for change over time.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Dot plot]]></text>
      <feedback format="html">
        <text><![CDATA[A dot plot shows the distribution of numerical scores.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_L04_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L04_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A1.DF.3</p><p>Which data set is numerical?</p>]]></text>
