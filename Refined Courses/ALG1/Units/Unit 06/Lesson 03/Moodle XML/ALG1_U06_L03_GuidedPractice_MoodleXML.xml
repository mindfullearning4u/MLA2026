  <question type="multichoice">
    <name>
      <text>ALG1_U06_L03_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L03_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A1.AR.6</p><p>A store sells pens for $2 and notebooks for $5. Which equation models spending exactly $30, where p is pens and n is notebooks?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[5p + 2n = 30]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the prices for pens and notebooks.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[2p + 5n = 30]]></text>
      <feedback format="html">
        <text><![CDATA[Each pen contributes 2 dollars and each notebook contributes 5 dollars.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[p + n = 30]]></text>
      <feedback format="html">
        <text><![CDATA[This counts items, not total cost.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[2p + 5n &lt;= 30]]></text>
      <feedback format="html">
        <text><![CDATA[This models spending at most 30 dollars, not exactly 30 dollars.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_L03_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L03_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A1.AR.7</p><p>For the constraint 4x + 10y &gt;= 40, does (5, 2) satisfy the requirement?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[No, because 5 + 2 is less than 40]]></text>
      <feedback format="html">
        <text><![CDATA[The point values must be weighted by 4 and 10.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[No, because 4(5) + 10(2) = 20]]></text>
      <feedback format="html">
        <text><![CDATA[The arithmetic is incomplete; 20 + 20 = 40.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[No, because equality is not allowed]]></text>
      <feedback format="html">
        <text><![CDATA[The symbol &gt;= includes equality.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Yes, because 4(5) + 10(2) = 40]]></text>
      <feedback format="html">
        <text><![CDATA[The total equals 40, and equality satisfies at least 40.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_L03_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L03_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A1.AR.6</p><p>A club can buy no more than 18 total shirts and hats. If s is shirts and h is hats, which inequality represents the limit?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[s + h &lt;= 18]]></text>
      <feedback format="html">
        <text><![CDATA[No more than 18 means the total is less than or equal to 18.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[s + h &gt;= 18]]></text>
      <feedback format="html">
        <text><![CDATA[This means at least 18, not no more than 18.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[sh &lt;= 18]]></text>
      <feedback format="html">
        <text><![CDATA[Multiplying the variables does not count total items.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[s - h &lt;= 18]]></text>
      <feedback format="html">
        <text><![CDATA[Subtracting does not represent total items.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_L03_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L03_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A1.AR.7</p><p>In a model, x represents small boxes and y represents large boxes. What does the ordered pair (6, 3) mean?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[6 large boxes and 3 small boxes]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the variable definitions.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[9 total boxes only]]></text>
      <feedback format="html">
        <text><![CDATA[The total may be 9, but the ordered pair gives more specific information.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[6 small boxes and 3 large boxes]]></text>
      <feedback format="html">
        <text><![CDATA[The x-coordinate matches small boxes and the y-coordinate matches large boxes.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[3 small boxes and 6 large boxes]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the coordinates.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_L03_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L03_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A1.AR.7</p><p>A solution is called feasible when it:</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[satisfies only the first constraint]]></text>
      <feedback format="html">
        <text><![CDATA[A feasible solution must satisfy all constraints.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[satisfies every constraint in the model]]></text>
      <feedback format="html">
        <text><![CDATA[Feasible means the solution works for the full system.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[has the largest possible x-value]]></text>
      <feedback format="html">
        <text><![CDATA[A feasible point does not have to maximize x.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[makes both variables equal]]></text>
      <feedback format="html">
        <text><![CDATA[Equal variable values are not required.]]></text>
      </feedback>
    </answer>
  </question>
