  <question type="multichoice">
    <name>
      <text>ALG1_U06_L03_Q17</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L03_Q17</p><p><strong>MLA Standard:</strong> MLA.A1.AR.6</p><p>Which system models &quot;at least 100 dollars&quot; and &quot;no more than 30 items&quot; for $4 items x and $6 items y?</p>]]></text>
