<quiz>
  <question type="category">
    <category>
      <text>$course$/ALG1/Units/Unit 06/Lesson 06/ALG1_U06_L06_GuidedPractice</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_L06_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L06_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A1.DF.1</p><p>Find the simple interest on $500 at 6% for 2 years.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[$30]]></text>
      <feedback format="html">
        <text><![CDATA[This is interest for only one year.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[$60]]></text>
      <feedback format="html">
        <text><![CDATA[I = Prt = 500(0.06)(2) = 60.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$560]]></text>
      <feedback format="html">
        <text><![CDATA[This is the total amount, not the interest.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$6,000]]></text>
      <feedback format="html">
        <text><![CDATA[This uses 6 instead of 0.06.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_L06_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L06_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A1.DF.2</p><p>Which formula represents compound interest?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[I = Prt]]></text>
      <feedback format="html">
        <text><![CDATA[This is simple interest.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A = P + I]]></text>
      <feedback format="html">
        <text><![CDATA[This adds principal and interest but does not model compounding.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A = P(1 - r/n)⁽ⁿᵗ⁾]]></text>
      <feedback format="html">
        <text><![CDATA[This models repeated decrease, not interest growth.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[A = P(1 + r/n)⁽ⁿᵗ⁾]]></text>
      <feedback format="html">
        <text><![CDATA[Compound interest uses repeated multiplication by a growth factor.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_L06_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L06_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A1.DF.1</p><p>What decimal should be used for a 4% interest rate?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[0.04]]></text>
      <feedback format="html">
        <text><![CDATA[Divide 4 by 100 to convert percent to decimal.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[0.4]]></text>
      <feedback format="html">
        <text><![CDATA[This represents 40%, not 4%.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4]]></text>
      <feedback format="html">
        <text><![CDATA[This represents 400%, not 4%.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[40]]></text>
      <feedback format="html">
        <text><![CDATA[This is not the decimal form of 4%.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_L06_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L06_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A1.DF.2</p><p>$1,000 is invested at 5% compounded annually for 2 years. Which expression gives the total amount?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[1000 + 0.05(2)]]></text>
      <feedback format="html">
        <text><![CDATA[This does not multiply interest by the principal.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[1000(0.05)(2)]]></text>
      <feedback format="html">
        <text><![CDATA[This gives simple interest, not total compound amount.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[1000(1.05)&#178;]]></text>
      <feedback format="html">
        <text><![CDATA[Annual compounding uses a growth factor of 1.05 for 2 years.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[1000(1.5)&#178;]]></text>
      <feedback format="html">
        <text><![CDATA[This uses 50% instead of 5%.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_L06_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L06_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A1.DF.1</p><p>What is the total amount for $400 at 5% simple interest for 3 years?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[$60]]></text>
      <feedback format="html">
        <text><![CDATA[This is the interest only.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[$460]]></text>
      <feedback format="html">
        <text><![CDATA[I = 400(0.05)(3) = 60, so A = 400 + 60 = 460.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$406]]></text>
      <feedback format="html">
        <text><![CDATA[This uses 0.05 incorrectly.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$6,000]]></text>
      <feedback format="html">
        <text><![CDATA[This uses 5 instead of 0.05 and gives an unreasonable amount.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>