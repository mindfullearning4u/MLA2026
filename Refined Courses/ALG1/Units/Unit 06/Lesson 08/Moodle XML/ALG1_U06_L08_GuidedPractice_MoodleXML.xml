  <question type="multichoice">
    <name>
      <text>ALG1_U06_L08_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L08_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A1.AR.5</p><p>The lines y=x+2 and y=-x+8 intersect at (3,5). What does this point represent?</p><p><img src="@@PLUGINFILE@@/ALG1_U06_L08_GP_Q01_graph.png" alt="Coordinate graph supports line, slope, intercept, or inequality interpretation." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="ALG1_U06_L08_GP_Q01_graph.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The slope of both lines]]></text>
      <feedback format="html">
        <text><![CDATA[The point is an ordered-pair solution, not a slope.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The solution to the system]]></text>
      <feedback format="html">
        <text><![CDATA[The intersection satisfies both equations.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The y-intercept of both lines]]></text>
      <feedback format="html">
        <text><![CDATA[The y-intercepts are 2 and 8.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The number of equations]]></text>
      <feedback format="html">
        <text><![CDATA[The system has two equations, but the point gives the solution.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_L08_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L08_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A1.DF.1</p><p>Find the simple interest on $500 at 4% for 3 years.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[$20]]></text>
      <feedback format="html">
        <text><![CDATA[This is interest for only one year.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$500]]></text>
      <feedback format="html">
        <text><![CDATA[This is the principal, not the interest.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$560]]></text>
      <feedback format="html">
        <text><![CDATA[This is the total amount, not the interest.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[$60]]></text>
      <feedback format="html">
        <text><![CDATA[I=Prt=500(0.04)(3)=60.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_L08_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L08_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A1.DF.5</p><p>A scatterplot falls from left to right. What association is shown?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Negative association]]></text>
      <feedback format="html">
        <text><![CDATA[As x increases, y tends to decrease.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Positive association]]></text>
      <feedback format="html">
        <text><![CDATA[Positive association rises from left to right.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[No association]]></text>
      <feedback format="html">
        <text><![CDATA[A visible downward trend is an association.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Constant association]]></text>
      <feedback format="html">
        <text><![CDATA[This is not the standard term for a scatterplot trend.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_L08_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L08_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A1.DF.6</p><p>A model predicts 45, but the actual value is 50. What is the residual?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[-5]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses actual minus predicted.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[95]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the values.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[5]]></text>
      <feedback format="html">
        <text><![CDATA[Residual = actual - predicted = 50 - 45.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[45]]></text>
      <feedback format="html">
        <text><![CDATA[This is the predicted value, not the residual.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_L08_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L08_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A1.DF.9</p><p>In a two-way table, 12 of 40 students in a group chose online tutoring. What is the relative frequency?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[12%]]></text>
      <feedback format="html">
        <text><![CDATA[This uses the count as the percent without dividing by the group total.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[30%]]></text>
      <feedback format="html">
        <text><![CDATA[12/40=0.30=30\%.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[40%]]></text>
      <feedback format="html">
        <text><![CDATA[This uses the group total as the percent.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[52%]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the count and total instead of finding a ratio.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>