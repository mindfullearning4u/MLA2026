  <question type="multichoice">
    <name>
      <text>ALG1_U06_L07_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L07_Q01</p><p><strong>MLA Standard:</strong> MLA.A1.DF.6</p><p>A line of fit predicts 32 sales. Actual sales are 37. What is the residual?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[5]]></text>
      <feedback format="html">
        <text><![CDATA[Residual = actual - predicted = 37 - 32 = 5.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[-5]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the subtraction order.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[69]]></text>
      <feedback format="html">
        <text><![CDATA[This adds actual and predicted values.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[32]]></text>
      <feedback format="html">
        <text><![CDATA[This is the predicted value, not the residual.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_L07_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L07_Q02</p><p><strong>MLA Standard:</strong> MLA.A1.DF.8</p><p>Which sampling plan is most biased for estimating the favorite sport of all students?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Randomly survey 10 students from each grade]]></text>
      <feedback format="html">
        <text><![CDATA[This is more representative than surveying one activity group.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Use a schoolwide random student list]]></text>
      <feedback format="html">
        <text><![CDATA[This reduces selection bias.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Survey only students at basketball practice]]></text>
      <feedback format="html">
        <text><![CDATA[This group is likely to favor basketball-related responses.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Randomly survey students during each lunch period]]></text>
      <feedback format="html">
        <text><![CDATA[This covers more of the school population.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_L07_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L07_Q03</p><p><strong>MLA Standard:</strong> MLA.A1.DF.9</p><p>A table shows 30 students prefer online tutoring and 20 prefer in-person tutoring. What percent prefer online tutoring?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[30%]]></text>
      <feedback format="html">
        <text><![CDATA[This uses the online count as a percent without using the total.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[60%]]></text>
      <feedback format="html">
        <text><![CDATA[The total is 50, and 30/50 = 0.60 = 60%.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[40%]]></text>
      <feedback format="html">
        <text><![CDATA[This is the percent for in-person tutoring.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[50%]]></text>
      <feedback format="html">
        <text><![CDATA[This would mean the two choices are equal.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_L07_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L07_Q04</p><p><strong>MLA Standard:</strong> MLA.A1.DF.6</p><p>Actual value is 91 and predicted value is 100. What does the residual show?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The model underpredicted by 9]]></text>
      <feedback format="html">
        <text><![CDATA[The prediction was higher than the actual value.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The model predicted exactly 91]]></text>
      <feedback format="html">
        <text><![CDATA[The prediction was 100, not 91.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The residual is 9]]></text>
      <feedback format="html">
        <text><![CDATA[Using actual - predicted gives a negative value.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The model overpredicted by 9]]></text>
      <feedback format="html">
        <text><![CDATA[Residual = 91 - 100 = -9, so the model overpredicted.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U06_L07_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L07_Q05</p><p><strong>MLA Standard:</strong> MLA.A1.DF.8</p><p>A simulation has 200 trials, and an event occurs 48 times. What is the estimated probability?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[0.24]]></text>
      <feedback format="html">
        <text><![CDATA[48/200 = 0.24.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[0.48]]></text>
      <feedback format="html">
        <text><![CDATA[This uses 48 as if the denominator were 100.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4.17]]></text>
      <feedback format="html">
        <text><![CDATA[This divides 200 by 48 instead of 48 by 200.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[152]]></text>
      <feedback format="html">
        <text><![CDATA[This is the number of trials where the event did not occur.]]></text>
      </feedback>
    </answer>
  </question>
