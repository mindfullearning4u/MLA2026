  <question type="multichoice">
    <name>
      <text>ALG1_U06_L07_Q11</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L07_Q11</p><p><strong>MLA Standard:</strong> MLA.A1.DF.8</p><p>A teacher wants to simulate flipping two coins. Which method matches the situation?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Roll one die and count six as success]]></text>
      <feedback format="html">
        <text><![CDATA[This models a one-out-of-six event, not two coins.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Flip two coins many times and record outcomes]]></text>
      <feedback format="html">
        <text><![CDATA[This directly simulates the chance process.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Ask students which outcome they prefer]]></text>
      <feedback format="html">
        <text><![CDATA[A preference survey does not simulate random coin flips.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Use last week&#39;s attendance data]]></text>
      <feedback format="html">
        <text><![CDATA[Attendance data is unrelated to coin outcomes.]]></text>
      </feedback>
    </answer>
  </question>
