      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[30m + 12]]></text>
      <feedback format="html">
        <text><![CDATA[This repeats the fixed cost instead of the monthly cost.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
