    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L07_Q07</p><p><strong>MLA Standard:</strong> MLA.A1.DF.6</p><p>Which residual shows the prediction was closest to the actual value?</p>]]></text>
