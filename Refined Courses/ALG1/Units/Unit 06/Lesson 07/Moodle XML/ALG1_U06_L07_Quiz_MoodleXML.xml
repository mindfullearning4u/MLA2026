  <question type="multichoice">
    <name>
      <text>ALG1_U06_L07_Q14</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U06_L07_Q14</p><p><strong>MLA Standard:</strong> MLA.A1.DF.8</p><p>Why is a larger number of simulation trials usually helpful?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[It guarantees the exact theoretical answer]]></text>
      <feedback format="html">
        <text><![CDATA[More trials improve estimates but do not guarantee exact results.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It changes the event being simulated]]></text>
      <feedback format="html">
        <text><![CDATA[The event should stay the same.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[It can make the estimate more stable]]></text>
      <feedback format="html">
        <text><![CDATA[More trials usually reduce random variation in the estimate.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It removes the need to count outcomes]]></text>
      <feedback format="html">
        <text><![CDATA[Outcomes still must be recorded and counted.]]></text>
      </feedback>
    </answer>
  </question>
