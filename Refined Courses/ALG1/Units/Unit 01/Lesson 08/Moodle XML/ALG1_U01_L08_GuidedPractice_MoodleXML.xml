  <question type="multichoice">
    <name>
      <text>ALG1_U01_L08_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U01_L08_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A1.FND.4</p><p>In the expression 9x+5, what is the coefficient?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[5]]></text>
      <feedback format="html">
        <text><![CDATA[This is the constant term. The coefficient is the number multiplying the variable.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[9]]></text>
      <feedback format="html">
        <text><![CDATA[In 9x, 9 is the coefficient because it multiplies x.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x]]></text>
      <feedback format="html">
        <text><![CDATA[This is the variable, not the coefficient.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[14]]></text>
      <feedback format="html">
        <text><![CDATA[This is the sum of 9 and 5, not an expression part.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U01_L08_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U01_L08_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A1.FND.1</p><p>Evaluate 3&#179;.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[6]]></text>
      <feedback format="html">
        <text><![CDATA[This adds 3 + 3 instead of multiplying three factors of 3.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[9]]></text>
      <feedback format="html">
        <text><![CDATA[This is 3&#178;, not 3&#179;.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[18]]></text>
      <feedback format="html">
        <text><![CDATA[This doubles 9, but exponents mean repeated multiplication.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[27]]></text>
      <feedback format="html">
        <text><![CDATA[3&#179;=3\cdot3\cdot3=27.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U01_L08_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U01_L08_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A1.FND.2</p><p>Simplify 4(x+2)+3x.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[7x+8]]></text>
      <feedback format="html">
        <text><![CDATA[Distribute to get 4x+8, then combine 4x+3x.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[7x+2]]></text>
      <feedback format="html">
        <text><![CDATA[This combines variable terms but does not distribute 4 to the constant.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4x+11]]></text>
      <feedback format="html">
        <text><![CDATA[This adds constants and leaves out the 3x term.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[12x+8]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies coefficients instead of combining like terms.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U01_L08_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U01_L08_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A1.FND.4</p><p>Which phrase best describes the variable in c+12?</p>]]></text>
