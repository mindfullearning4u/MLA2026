  <question type="multichoice">
    <name>
      <text>ALG1_U01_L08_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U01_L08_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A1.FND.2</p><p>Simplify 6a-2a+5.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[8a+5]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the coefficients, but the expression says 6a-2a.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[4a+5]]></text>
      <feedback format="html">
        <text><![CDATA[Combine like terms: 6a-2a=4a.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4a]]></text>
      <feedback format="html">
        <text><![CDATA[This combines the variable terms but drops the constant 5.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[9a]]></text>
      <feedback format="html">
        <text><![CDATA[This combines unlike terms by treating 5 as if it has variable a.]]></text>
      </feedback>
    </answer>
  </question>
