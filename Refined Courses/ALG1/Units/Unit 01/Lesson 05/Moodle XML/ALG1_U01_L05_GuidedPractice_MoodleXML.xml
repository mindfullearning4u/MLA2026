  <question type="multichoice">
    <name>
      <text>ALG1_U01_L05_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U01_L05_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A1.FND.4</p><p>In the expression 5x + 8, what is the coefficient?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x]]></text>
      <feedback format="html">
        <text><![CDATA[This identifies the variable, not the coefficient. The coefficient is the number multiplied by the variable.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[5]]></text>
      <feedback format="html">
        <text><![CDATA[In 5x + 8, the 5 is multiplied by x, so 5 is the coefficient.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[8]]></text>
      <feedback format="html">
        <text><![CDATA[This identifies the constant. The constant stands alone and is not multiplied by the variable.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[5x]]></text>
      <feedback format="html">
        <text><![CDATA[This identifies a term. The coefficient is the numerical factor of the variable term.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U01_L05_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U01_L05_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A1.FND.4</p><p>In the expression 7n + 3, what is the constant?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[7]]></text>
      <feedback format="html">
        <text><![CDATA[This is the coefficient because it is multiplied by n. The constant stands alone.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[n]]></text>
      <feedback format="html">
        <text><![CDATA[This is the variable. A constant is a number that does not change.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[7n]]></text>
      <feedback format="html">
        <text><![CDATA[This is a term containing the variable. The constant is the standalone number.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[3]]></text>
      <feedback format="html">
        <text><![CDATA[The 3 stands alone, so it is the constant.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U01_L05_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U01_L05_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A1.FND.4</p><p>A delivery company charges $6 per package plus a $10 fee. In 6p + 10, what does p represent?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[the number of packages]]></text>
      <feedback format="html">
        <text><![CDATA[The 6 is the cost per package, so p represents how many packages there are.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[the total fee]]></text>
      <feedback format="html">
        <text><![CDATA[This describes the whole expression 6p + 10, not the variable p.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[the $10 fee]]></text>
      <feedback format="html">
        <text><![CDATA[This describes the constant. The variable p changes with the number of packages.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[the cost per package]]></text>
      <feedback format="html">
        <text><![CDATA[This describes the coefficient 6, not the variable p.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U01_L05_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U01_L05_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A1.FND.4</p><p>In 4(x + 2), which part can be viewed as one grouped quantity?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[4]]></text>
      <feedback format="html">
        <text><![CDATA[The 4 is a factor outside the parentheses. It is not the grouped quantity.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x]]></text>
      <feedback format="html">
        <text><![CDATA[This is only part of the grouped quantity. The parentheses group x and 2 together.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x + 2]]></text>
      <feedback format="html">
        <text><![CDATA[The parentheses show that x + 2 should be viewed as one quantity.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[2]]></text>
      <feedback format="html">
        <text><![CDATA[This is only part of the grouped quantity. The full grouped quantity is inside the parentheses.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U01_L05_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U01_L05_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A1.FND.4</p><p>Which expression has two terms?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[8x]]></text>
      <feedback format="html">
        <text><![CDATA[This expression has one term because there is no addition or subtraction separating parts.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[3a + 5]]></text>
      <feedback format="html">
        <text><![CDATA[The terms are 3a and 5, separated by addition.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4(m + 1)]]></text>
      <feedback format="html">
        <text><![CDATA[This is a product with a grouped quantity. It is not written as two separate terms at the outer level.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[12]]></text>
      <feedback format="html">
        <text><![CDATA[This expression has one constant term.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>