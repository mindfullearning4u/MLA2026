::ALG1_U01_L01_Pretest_Q01::
[MA.912.NSO.1.1] Evaluate 25^(1/2). {
=5 #Correct.
~12.5 #Not quite. This divides by 2 instead of taking a square root.
~50 #Not quite. This multiplies instead of applying a root.
~625 #Not quite. This squares instead of taking the square root.
}

::ALG1_U01_L01_Pretest_Q02::
[MA.912.NSO.1.1] Evaluate 8^(1/3). {
=2 #Correct.
~3 #Not quite. The denominator names the root, not the value.
~4 #Not quite. This does not represent the cube root.
~24 #Not quite. This multiplies instead of applying a root.
}

::ALG1_U01_L01_Pretest_Q03::
[MA.912.NSO.1.1] Evaluate 27^(2/3). {
=9 #Correct.
~3 #Not quite. This only applies the root.
~18 #Not quite. This treats the exponent as multiplication.
~243 #Not quite. This applies the power without the root.
}

::ALG1_U01_L01_Pretest_Q04::
[MA.912.NSO.1.1] Which expression is equivalent to 16^(1/4)? {
=fourthroot(16) #Correct.
~sqrt(16) #Not quite. This represents an exponent of 1/2.
~16/4 #Not quite. The denominator indicates a root, not division.
~16^4 #Not quite. This applies a power, not a root.
}

::ALG1_U01_L01_Pretest_Q05::
[MA.912.NSO.1.1] Simplify 3^(2/5) * 3^(1/5). {
=3^(3/5) #Correct.
~3^(2/25) #Not quite. Exponents are added, not multiplied.
~9^(3/5) #Not quite. The base remains the same.
~3^(1/5) #Not quite. This ignores part of the expression.
}

::ALG1_U01_L01_Pretest_Q06::
[MA.912.NSO.1.1] Simplify 6^(5/2) / 6^(1/2). {
=6^2 #Correct.
~6^3 #Not quite. The exponents were not subtracted correctly.
~6^(6/2) #Not quite. Exponents are subtracted when dividing.
~1 #Not quite. The exponents are not equal.
}

::ALG1_U01_L01_Pretest_Q07::
[MA.912.NSO.1.1] Evaluate 625^(1/4). {
=5 #Correct.
~25 #Not quite. This applies a square root, not a fourth root.
~4 #Not quite. The denominator names the root, not the value.
~156.25 #Not quite. This divides instead of applying a root.
}

::ALG1_U01_L01_Pretest_Q08::
[MA.912.NSO.1.1] Evaluate 64^(5/6). {
=32 #Correct.
~2 #Not quite. This only applies the root.
~10 #Not quite. This treats the exponent as multiplication.
~64 #Not quite. The exponent changes the value.
}