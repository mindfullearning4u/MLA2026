  <question type="multichoice">
    <name>
      <text>ALG1_U05_L03_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L03_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A1.QE.2</p><p>Which table shows evidence of a quadratic relationship when x-values increase by 1?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<table class="mla-assessment-table" style="border-collapse:collapse;margin:4px 0;"><tr><th style="border:1px solid #555;padding:4px 8px;">x</th><td style="border:1px solid #555;padding:4px 8px;text-align:center;">0</td><td style="border:1px solid #555;padding:4px 8px;text-align:center;">1</td><td style="border:1px solid #555;padding:4px 8px;text-align:center;">2</td><td style="border:1px solid #555;padding:4px 8px;text-align:center;">3</td></tr><tr><th style="border:1px solid #555;padding:4px 8px;">y</th><td style="border:1px solid #555;padding:4px 8px;text-align:center;">2</td><td style="border:1px solid #555;padding:4px 8px;text-align:center;">5</td><td style="border:1px solid #555;padding:4px 8px;text-align:center;">8</td><td style="border:1px solid #555;padding:4px 8px;text-align:center;">11</td></tr></table>]]></text>
      <feedback format="html">
        <text><![CDATA[This table is linear because the first differences are constant at 3.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<table class="mla-assessment-table" style="border-collapse:collapse;margin:4px 0;"><tr><th style="border:1px solid #555;padding:4px 8px;">x</th><td style="border:1px solid #555;padding:4px 8px;text-align:center;">0</td><td style="border:1px solid #555;padding:4px 8px;text-align:center;">1</td><td style="border:1px solid #555;padding:4px 8px;text-align:center;">2</td><td style="border:1px solid #555;padding:4px 8px;text-align:center;">3</td></tr><tr><th style="border:1px solid #555;padding:4px 8px;">y</th><td style="border:1px solid #555;padding:4px 8px;text-align:center;">1</td><td style="border:1px solid #555;padding:4px 8px;text-align:center;">4</td><td style="border:1px solid #555;padding:4px 8px;text-align:center;">9</td><td style="border:1px solid #555;padding:4px 8px;text-align:center;">16</td></tr></table>]]></text>
      <feedback format="html">
        <text><![CDATA[The first differences are 3, 5, and 7, so the second differences are constant at 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<table class="mla-assessment-table" style="border-collapse:collapse;margin:4px 0;"><tr><th style="border:1px solid #555;padding:4px 8px;">x</th><td style="border:1px solid #555;padding:4px 8px;text-align:center;">0</td><td style="border:1px solid #555;padding:4px 8px;text-align:center;">1</td><td style="border:1px solid #555;padding:4px 8px;text-align:center;">2</td><td style="border:1px solid #555;padding:4px 8px;text-align:center;">3</td></tr><tr><th style="border:1px solid #555;padding:4px 8px;">y</th><td style="border:1px solid #555;padding:4px 8px;text-align:center;">3</td><td style="border:1px solid #555;padding:4px 8px;text-align:center;">6</td><td style="border:1px solid #555;padding:4px 8px;text-align:center;">12</td><td style="border:1px solid #555;padding:4px 8px;text-align:center;">24</td></tr></table>]]></text>
      <feedback format="html">
        <text><![CDATA[The outputs double, so this is exponential rather than quadratic.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<table class="mla-assessment-table" style="border-collapse:collapse;margin:4px 0;"><tr><th style="border:1px solid #555;padding:4px 8px;">x</th><td style="border:1px solid #555;padding:4px 8px;text-align:center;">0</td><td style="border:1px solid #555;padding:4px 8px;text-align:center;">1</td><td style="border:1px solid #555;padding:4px 8px;text-align:center;">2</td><td style="border:1px solid #555;padding:4px 8px;text-align:center;">3</td></tr><tr><th style="border:1px solid #555;padding:4px 8px;">y</th><td style="border:1px solid #555;padding:4px 8px;text-align:center;">5</td><td style="border:1px solid #555;padding:4px 8px;text-align:center;">5</td><td style="border:1px solid #555;padding:4px 8px;text-align:center;">5</td><td style="border:1px solid #555;padding:4px 8px;text-align:center;">5</td></tr></table>]]></text>
      <feedback format="html">
        <text><![CDATA[This is constant, not quadratic, because the output does not change.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L03_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L03_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A1.QE.2</p><p>Why is f(x)=x&#178;+3x+2 a quadratic function?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[It has two terms after combining like terms.]]></text>
      <feedback format="html">
        <text><![CDATA[The number of terms does not determine whether a function is quadratic.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It has an x-intercept.]]></text>
      <feedback format="html">
        <text><![CDATA[Having an x-intercept does not by itself make a function quadratic.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It has a constant term of 2.]]></text>
      <feedback format="html">
        <text><![CDATA[A constant term can appear in many function types, so this is not the defining feature.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Its highest power of x is 2.]]></text>
      <feedback format="html">
        <text><![CDATA[A quadratic function has degree 2, so the x&#178; term identifies the function as quadratic.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L03_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L03_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A1.QE.2</p><p>Which context is best modeled by a quadratic function?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[The area of a square changes as its side length changes.]]></text>
      <feedback format="html">
        <text><![CDATA[Square area is A=s&#178;, which is a quadratic relationship.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A taxi charges a base fee plus a constant amount per mile.]]></text>
      <feedback format="html">
        <text><![CDATA[A constant rate of change with distance is linear.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A savings account earns the same percent interest each year.]]></text>
      <feedback format="html">
        <text><![CDATA[Percent growth over equal time intervals is exponential.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A student reads the same number of pages each day.]]></text>
      <feedback format="html">
        <text><![CDATA[Equal daily increases create a linear relationship.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L03_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L03_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A1.QE.2</p><p>A table has y-values 2, 7, 14, 23, 34 for x-values 0, 1, 2, 3, 4. What evidence shows it can be quadratic?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The y-values are all positive.]]></text>
      <feedback format="html">
        <text><![CDATA[Positive outputs do not prove the relationship is quadratic.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The first differences are constant.]]></text>
      <feedback format="html">
        <text><![CDATA[The first differences are 5, 7, 9, and 11, so they are not constant.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The second differences are constant.]]></text>
      <feedback format="html">
        <text><![CDATA[The first differences are 5, 7, 9, and 11, and the second differences are all 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The x-values increase by 2 each time.]]></text>
      <feedback format="html">
        <text><![CDATA[The x-values increase by 1 each time, and equal spacing only lets you test differences.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L03_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L03_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A1.QE.2</p><p>A rectangle has width x and length x+5. Which function represents its area?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[A=2x+5]]></text>
      <feedback format="html">
        <text><![CDATA[This adds side lengths instead of multiplying length by width for area.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[A=x&#178;+5x]]></text>
      <feedback format="html">
        <text><![CDATA[Area is x(x+5), which expands to x&#178;+5x.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A=x&#178;+25]]></text>
      <feedback format="html">
        <text><![CDATA[This squares x and 5 separately, but x(x+5) requires distribution.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A=5x]]></text>
      <feedback format="html">
        <text><![CDATA[This would model a rectangle with constant length 5, not length x+5.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>