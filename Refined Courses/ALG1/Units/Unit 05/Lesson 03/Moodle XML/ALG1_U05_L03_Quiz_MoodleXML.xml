  <question type="multichoice">
    <name>
      <text>ALG1_U05_L03_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L03_Q01</p><p><strong>MLA Standard:</strong> MLA.A1.QE.2</p><p>Which equation represents a quadratic function?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[y=2x&#178;-5x+1]]></text>
      <feedback format="html">
        <text><![CDATA[The highest power of x is 2, so the function is quadratic.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y=4x-7]]></text>
      <feedback format="html">
        <text><![CDATA[This is linear because the highest power of x is 1.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y=3ˣ]]></text>
      <feedback format="html">
        <text><![CDATA[This is exponential because the variable is in the exponent.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y=8]]></text>
      <feedback format="html">
        <text><![CDATA[This is constant, not quadratic.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L03_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L03_Q02</p><p><strong>MLA Standard:</strong> MLA.A1.QE.2</p><p>For evenly spaced x-values, which table pattern suggests a quadratic function?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Constant y-values]]></text>
      <feedback format="html">
        <text><![CDATA[Constant y-values show a constant function, not a quadratic one.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Constant ratios between outputs]]></text>
      <feedback format="html">
        <text><![CDATA[Constant ratios suggest exponential behavior.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Constant second differences]]></text>
      <feedback format="html">
        <text><![CDATA[Constant second differences identify a quadratic pattern when x-values are equally spaced.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Constant first differences]]></text>
      <feedback format="html">
        <text><![CDATA[Constant first differences identify a linear pattern.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L03_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L03_Q03</p><p><strong>MLA Standard:</strong> MLA.A1.QE.2</p><p>Which graph shape is associated with a quadratic function?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[A straight line]]></text>
      <feedback format="html">
        <text><![CDATA[A straight line represents a linear function.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[A parabola]]></text>
      <feedback format="html">
        <text><![CDATA[Quadratic functions graph as parabolas.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A circle]]></text>
      <feedback format="html">
        <text><![CDATA[A circle is not the graph of a quadratic function written as a single y-value for each x-value in Algebra 1.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A horizontal line]]></text>
      <feedback format="html">
        <text><![CDATA[A horizontal line represents a constant function.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L03_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L03_Q04</p><p><strong>MLA Standard:</strong> MLA.A1.QE.2</p><p>Which context most naturally produces a quadratic model?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Paying the same monthly phone bill]]></text>
      <feedback format="html">
        <text><![CDATA[A constant monthly payment is not quadratic growth.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Driving at a constant speed]]></text>
      <feedback format="html">
        <text><![CDATA[Constant speed creates a linear distance-time relationship.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Multiplying an item price by the number of items]]></text>
      <feedback format="html">
        <text><![CDATA[That relationship is linear when the unit price is fixed.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Finding the area of a rectangle with sides x and x+4]]></text>
      <feedback format="html">
        <text><![CDATA[The area x(x+4)=x&#178;+4x is quadratic.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L03_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L03_Q05</p><p><strong>MLA Standard:</strong> MLA.A1.QE.2</p><p>A table has y-values 4, 9, 16, 25, 36 for x-values 0, 1, 2, 3, 4. What is true?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[The table can represent a quadratic function.]]></text>
      <feedback format="html">
        <text><![CDATA[The first differences are 5, 7, 9, and 11, so the second differences are constant.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The table must be linear.]]></text>
      <feedback format="html">
        <text><![CDATA[A linear table would have constant first differences, but these first differences change.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The table must be exponential.]]></text>
      <feedback format="html">
        <text><![CDATA[The outputs do not have a constant ratio.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The table is constant.]]></text>
      <feedback format="html">
        <text><![CDATA[The outputs change, so the table is not constant.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L03_Q06</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L03_Q06</p><p><strong>MLA Standard:</strong> MLA.A1.QE.2</p><p>Which expression expands from x(x+8)?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[2x+8]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the factors instead of multiplying.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x&#178;+8x]]></text>
      <feedback format="html">
        <text><![CDATA[Distributing x gives x&#178;+8x, a quadratic expression.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x&#178;+8]]></text>
      <feedback format="html">
        <text><![CDATA[The second term should be 8x, not 8.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[8x&#178;]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies coefficients incorrectly and misses the 8x term.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L03_Q07</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L03_Q07</p><p><strong>MLA Standard:</strong> MLA.A1.QE.2</p><p>Which function is not quadratic?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[f(x)=x&#178;-4]]></text>
      <feedback format="html">
        <text><![CDATA[This is quadratic because it contains an x&#178; term.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[f(x)=3x&#178;+x]]></text>
      <feedback format="html">
        <text><![CDATA[This is quadratic because the highest power is 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[f(x)=(x+2)&#178;]]></text>
      <feedback format="html">
        <text><![CDATA[This is quadratic because expanding creates an x&#178; term.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[f(x)=5x-9]]></text>
      <feedback format="html">
        <text><![CDATA[This is linear because the highest power of x is 1.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L03_Q08</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L03_Q08</p><p><strong>MLA Standard:</strong> MLA.A1.QE.2</p><p>Which statement correctly describes the table with y-values 3, 6, 11, 18, 27?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[It is linear because the y-values increase.]]></text>
      <feedback format="html">
        <text><![CDATA[Increasing outputs alone do not make a relationship linear.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It is constant because the x-values are evenly spaced.]]></text>
      <feedback format="html">
        <text><![CDATA[Evenly spaced x-values do not mean the y-values are constant.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It is exponential because the differences grow.]]></text>
      <feedback format="html">
        <text><![CDATA[Exponential tables are identified by constant ratios, not just growing differences.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[It can be quadratic because the second differences are constant.]]></text>
      <feedback format="html">
        <text><![CDATA[The first differences are 3, 5, 7, and 9, so the second differences are constant.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L03_Q09</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L03_Q09</p><p><strong>MLA Standard:</strong> MLA.A1.QE.2</p><p>A square has side length x+3. Which function gives its area?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[A=(x+3)&#178;]]></text>
      <feedback format="html">
        <text><![CDATA[Square area is side length squared, so the area function is quadratic.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A=4(x+3)]]></text>
      <feedback format="html">
        <text><![CDATA[This represents perimeter, not area.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A=x+6]]></text>
      <feedback format="html">
        <text><![CDATA[This does not square the side length.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A=3x]]></text>
      <feedback format="html">
        <text><![CDATA[This does not model the area of a square with side x+3.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L03_Q10</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L03_Q10</p><p><strong>MLA Standard:</strong> MLA.A1.QE.2</p><p>What is the degree of g(x)=7-2x+4x&#178;?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[0]]></text>
      <feedback format="html">
        <text><![CDATA[The constant term has degree 0, but the function&#39;s degree comes from the highest power.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4]]></text>
      <feedback format="html">
        <text><![CDATA[The coefficient 4 is not the degree.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[7]]></text>
      <feedback format="html">
        <text><![CDATA[The constant 7 is not the degree.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[2]]></text>
      <feedback format="html">
        <text><![CDATA[The highest exponent on x is 2.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L03_Q11</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L03_Q11</p><p><strong>MLA Standard:</strong> MLA.A1.QE.2</p><p>Which table is most likely linear, not quadratic?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[y-values 1, 4, 9, 16]]></text>
      <feedback format="html">
        <text><![CDATA[These have changing first differences and constant second differences.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[y-values 5, 8, 11, 14]]></text>
      <feedback format="html">
        <text><![CDATA[The first differences are all 3, so the pattern is linear.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y-values 2, 6, 12, 20]]></text>
      <feedback format="html">
        <text><![CDATA[These have first differences 4, 6, and 8, suggesting quadratic behavior.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y-values 0, 3, 8, 15]]></text>
      <feedback format="html">
        <text><![CDATA[These have first differences 3, 5, and 7, suggesting quadratic behavior.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L03_Q12</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L03_Q12</p><p><strong>MLA Standard:</strong> MLA.A1.QE.2</p><p>Which product creates a quadratic expression when expanded?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[3(x+5)]]></text>
      <feedback format="html">
        <text><![CDATA[This expands to 3x+15, which is linear.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x+9]]></text>
      <feedback format="html">
        <text><![CDATA[This expression is linear and is not a product of variable factors.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x(x-6)]]></text>
      <feedback format="html">
        <text><![CDATA[The product expands to x&#178;-6x, which is quadratic.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4x]]></text>
      <feedback format="html">
        <text><![CDATA[This is a monomial of degree 1.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L03_Q13</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L03_Q13</p><p><strong>MLA Standard:</strong> MLA.A1.QE.2</p><p>Which clue from a graph supports that a function is quadratic?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[The graph curves and has one turning point.]]></text>
      <feedback format="html">
        <text><![CDATA[A parabola has one turning point, which is a key quadratic feature.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The graph is a vertical line.]]></text>
      <feedback format="html">
        <text><![CDATA[A vertical line is not a function of x.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The graph has a constant slope everywhere.]]></text>
      <feedback format="html">
        <text><![CDATA[A constant slope describes a linear function.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The graph is a set of disconnected points with no pattern.]]></text>
      <feedback format="html">
        <text><![CDATA[Disconnected points without structure do not identify a quadratic function.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L03_Q14</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L03_Q14</p><p><strong>MLA Standard:</strong> MLA.A1.QE.2</p><p>A ball&#39;s height is modeled by h(t)=-16t&#178;+32t+5. Why is this quadratic?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[It has a negative coefficient.]]></text>
      <feedback format="html">
        <text><![CDATA[A negative coefficient alone does not define a quadratic function.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It has three terms.]]></text>
      <feedback format="html">
        <text><![CDATA[A three-term expression is not automatically quadratic.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[It contains a t&#178; term as the highest power.]]></text>
      <feedback format="html">
        <text><![CDATA[The highest power of the variable is 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It starts at 5.]]></text>
      <feedback format="html">
        <text><![CDATA[The starting value is the y-intercept, not the reason the function is quadratic.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L03_Q15</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L03_Q15</p><p><strong>MLA Standard:</strong> MLA.A1.QE.2</p><p>Which function matches the area of a rectangle with length x+2 and width x+7?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[A=2x+9]]></text>
      <feedback format="html">
        <text><![CDATA[This combines side lengths but does not multiply for area.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A=x&#178;+14]]></text>
      <feedback format="html">
        <text><![CDATA[This misses both middle products from distribution.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A=9x+14]]></text>
      <feedback format="html">
