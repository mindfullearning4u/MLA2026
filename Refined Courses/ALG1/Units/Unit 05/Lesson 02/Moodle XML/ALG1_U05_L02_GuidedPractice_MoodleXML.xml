  <question type="multichoice">
    <name>
      <text>ALG1_U05_L02_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L02_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A1.FND.8</p><p>Factor 3x&#178;+12x.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[3(x&#178;+4x)]]></text>
      <feedback format="html">
        <text><![CDATA[This removes a factor of 3 but misses the common factor x.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x(3x+12)]]></text>
      <feedback format="html">
        <text><![CDATA[This removes x but leaves a common factor of 3 inside.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[3x(x+4)]]></text>
      <feedback format="html">
        <text><![CDATA[The greatest common factor is 3x.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[3x(x+12)]]></text>
      <feedback format="html">
        <text><![CDATA[Dividing 12x by 3x gives 4, not 12.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L02_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L02_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A1.QE.3</p><p>If f(x)=(x-2)(x+5), what are the zeros?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[2 and 5]]></text>
      <feedback format="html">
        <text><![CDATA[The factor x+5 gives zero at x = -5, not 5.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[2 and -5]]></text>
      <feedback format="html">
        <text><![CDATA[Set each factor equal to 0: x-2=0 and x+5=0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[-2 and 5]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses both signs.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[-2 and -5]]></text>
      <feedback format="html">
        <text><![CDATA[The factor x-2 gives zero at x = 2.]]></text>
      </feedback>
    </answer>
  </question>
