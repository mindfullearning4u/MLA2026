    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[It confirms the factors produce the original expression]]></text>
      <feedback format="html">
        <text><![CDATA[Multiplying the factors should return the original polynomial.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It changes the factors into a graph]]></text>
      <feedback format="html">
        <text><![CDATA[Checking by multiplication does not create a graph.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
