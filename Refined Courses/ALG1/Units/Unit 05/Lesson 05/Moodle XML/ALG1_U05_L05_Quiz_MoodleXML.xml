  <question type="multichoice">
    <name>
      <text>ALG1_U05_L05_Q14</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L05_Q14</p><p><strong>MLA Standard:</strong> MLA.A1.QE.1</p><p>Solve 2x&#178;-8x=0.</p>]]></text>
