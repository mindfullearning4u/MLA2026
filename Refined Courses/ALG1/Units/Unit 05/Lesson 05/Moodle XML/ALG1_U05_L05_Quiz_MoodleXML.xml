  <question type="multichoice">
    <name>
      <text>ALG1_U05_L05_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L05_Q01</p><p><strong>MLA Standard:</strong> MLA.A1.QE.1</p><p>Solve x&#178;-9=0.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[x=-3 and x=3]]></text>
      <feedback format="html">
        <text><![CDATA[This is a difference of squares: (x-3)(x+3)=0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x=9 only]]></text>
      <feedback format="html">
        <text><![CDATA[Squaring a number to get 9 gives two real solutions, not one solution of 9.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x=-9 and x=9]]></text>
      <feedback format="html">
        <text><![CDATA[These values are the constant&#39;s opposites, not the square roots of 9.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x=0 and x=9]]></text>
      <feedback format="html">
        <text><![CDATA[Substituting 0 does not make x&#178;-9 equal 0.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L05_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L05_Q02</p><p><strong>MLA Standard:</strong> MLA.A1.QE.6</p><p>A quadratic height model has zeros at t=0 and t=5. What does t=5 usually represent?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The starting height]]></text>
      <feedback format="html">
        <text><![CDATA[The starting height is the y-intercept at t=0, not the later zero.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The maximum height]]></text>
      <feedback format="html">
        <text><![CDATA[The maximum height occurs at the vertex, not at a zero.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The time the object returns to the ground]]></text>
      <feedback format="html">
        <text><![CDATA[A zero in a height model means height is 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The axis of symmetry]]></text>
      <feedback format="html">
        <text><![CDATA[The axis of symmetry is a vertical line, not the later zero.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L05_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L05_Q03</p><p><strong>MLA Standard:</strong> MLA.A1.QE.1</p><p>Solve x&#178;+x-12=0.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x=3 and x=4]]></text>
      <feedback format="html">
        <text><![CDATA[These values do not create opposite signs needed for -12.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x=-4 and x=3]]></text>
      <feedback format="html">
        <text><![CDATA[The equation factors as (x+4)(x-3)=0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x=4 and x=-3]]></text>
      <feedback format="html">
        <text><![CDATA[These values would give factors (x-4)(x+3), producing x&#178;-x-12.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x=-3 and x=-4]]></text>
      <feedback format="html">
        <text><![CDATA[Both negative roots would produce a positive middle coefficient of 7.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L05_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L05_Q04</p><p><strong>MLA Standard:</strong> MLA.A1.QE.1</p><p>Solve (x-8)(x+2)=0.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x=-8 and x=2]]></text>
      <feedback format="html">
        <text><![CDATA[The signs are reversed from the factors.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x=8 and x=2]]></text>
      <feedback format="html">
        <text><![CDATA[The factor x+2 gives -2, not 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x=-8 and x=-2]]></text>
      <feedback format="html">
        <text><![CDATA[The factor x-8 gives 8, not -8.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x=8 and x=-2]]></text>
      <feedback format="html">
        <text><![CDATA[Set each factor equal to zero.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L05_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L05_Q05</p><p><strong>MLA Standard:</strong> MLA.A1.QE.6</p><p>A garden has side lengths x and x+5 and area 84. Which equation models the area?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[x(x+5)=84]]></text>
      <feedback format="html">
        <text><![CDATA[Area is the product of the side lengths.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[2x+10=84]]></text>
      <feedback format="html">
        <text><![CDATA[This uses a perimeter-style expression, not area.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x+5=84]]></text>
      <feedback format="html">
        <text><![CDATA[This uses only one side length.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x&#178;+25=84]]></text>
      <feedback format="html">
        <text><![CDATA[This squares each part separately and misses the 5x term.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L05_Q06</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L05_Q06</p><p><strong>MLA Standard:</strong> MLA.A1.QE.1</p><p>Solve x&#178;-2x-15=0.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x=3 and x=-5]]></text>
      <feedback format="html">
        <text><![CDATA[These roots would produce x&#178;+2x-15, not the given equation.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x=-3 and x=5]]></text>
      <feedback format="html">
        <text><![CDATA[The equation factors as (x-5)(x+3)=0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x=3 and x=5]]></text>
      <feedback format="html">
        <text><![CDATA[Both positive roots would produce a negative constant term only if the factors had opposite signs.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x=-3 and x=-5]]></text>
      <feedback format="html">
        <text><![CDATA[Both negative roots would produce a positive middle term.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L05_Q07</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L05_Q07</p><p><strong>MLA Standard:</strong> MLA.A1.QE.6</p><p>A model gives solutions x=-4 and x=6 for a side length. Which solution is reasonable?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[-4, because it is smaller]]></text>
      <feedback format="html">
        <text><![CDATA[A side length cannot be negative in this context.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Both, because every algebraic solution is always reasonable]]></text>
      <feedback format="html">
        <text><![CDATA[Context can rule out solutions that do not make sense.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Neither, because quadratics cannot model side lengths]]></text>
      <feedback format="html">
        <text><![CDATA[Quadratic equations can model area and side length relationships.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[6, because side length must be positive]]></text>
      <feedback format="html">
        <text><![CDATA[Negative length is not meaningful, so 6 is the reasonable solution.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L05_Q08</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L05_Q08</p><p><strong>MLA Standard:</strong> MLA.A1.QE.1</p><p>What are the zeros of y=(x+6)(x-1)?</p>]]></text>
