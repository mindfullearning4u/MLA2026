    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[6 and -1]]></text>
      <feedback format="html">
        <text><![CDATA[These reverse the signs from the factors.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[6 and 1]]></text>
      <feedback format="html">
        <text><![CDATA[The factor x+6 gives -6, not 6.]]></text>
      </feedback>
    </answer>
