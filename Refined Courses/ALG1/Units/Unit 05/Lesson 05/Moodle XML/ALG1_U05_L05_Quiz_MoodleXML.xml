  <question type="multichoice">
    <name>
      <text>ALG1_U05_L05_Q13</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L05_Q13</p><p><strong>MLA Standard:</strong> MLA.A1.QE.6</p><p>A ball is launched from the ground and lands after 4 seconds. Which pair of zeros fits the context?</p>]]></text>
