      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L05_Q12</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L05_Q12</p><p><strong>MLA Standard:</strong> MLA.A1.QE.1</p><p>Which equation has solutions x=-2 and x=7?</p>]]></text>
