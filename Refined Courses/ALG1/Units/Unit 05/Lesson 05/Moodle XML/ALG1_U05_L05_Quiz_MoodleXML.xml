    <name>
      <text>ALG1_U05_L05_Q11</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L05_Q11</p><p><strong>MLA Standard:</strong> MLA.A1.QE.1</p><p>Solve x&#178;-10x+25=0.</p>]]></text>
