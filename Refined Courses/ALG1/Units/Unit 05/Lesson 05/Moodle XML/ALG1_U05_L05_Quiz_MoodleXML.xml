  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L05_Q15</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L05_Q15</p><p><strong>MLA Standard:</strong> MLA.A1.QE.6</p><p>The solutions to an area equation are x=-9 and x=4. What should be done with -9?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Keep it because it is farther from zero]]></text>
      <feedback format="html">
        <text><![CDATA[Distance from zero does not make a negative length meaningful.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Average it with 4]]></text>
      <feedback format="html">
        <text><![CDATA[Averaging solutions does not interpret the area context.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Change it to positive 9]]></text>
      <feedback format="html">
        <text><![CDATA[Changing the sign creates a value that was not a solution.]]></text>
      </feedback>
