    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L05_Q09</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L05_Q09</p><p><strong>MLA Standard:</strong> MLA.A1.QE.1</p><p>Which factorization helps solve x&#178;+7x+10=0?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[(x+5)(x+2)=0]]></text>
      <feedback format="html">
        <text><![CDATA[The factors multiply to 10 and add to 7.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(x-5)(x-2)=0]]></text>
      <feedback format="html">
        <text><![CDATA[This gives x&#178;-7x+10, not the original equation.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(x+10)(x+1)=0]]></text>
      <feedback format="html">
        <text><![CDATA[These factors multiply to 10 but add to 11.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(x-10)(x-1)=0]]></text>
      <feedback format="html">
        <text><![CDATA[These factors produce the wrong signs and middle term.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L05_Q10</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L05_Q10</p><p><strong>MLA Standard:</strong> MLA.A1.QE.6</p><p>A quadratic profit model has zeros at 20 and 80 items sold. What do these zeros represent?</p>]]></text>
