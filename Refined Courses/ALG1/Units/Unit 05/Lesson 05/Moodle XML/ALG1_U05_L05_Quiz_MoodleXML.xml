    <answer fraction="0" format="html">
      <text><![CDATA[(x-2)(x+7)=0]]></text>
      <feedback format="html">
        <text><![CDATA[This gives roots 2 and -7.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(x+2)(x+7)=0]]></text>
      <feedback format="html">
        <text><![CDATA[This gives roots -2 and -7.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[(x+2)(x-7)=0]]></text>
      <feedback format="html">
        <text><![CDATA[The factors produce roots -2 and 7.]]></text>
