    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x=2 and x=8]]></text>
      <feedback format="html">
        <text><![CDATA[These values come from parts of the coefficients, not from factoring.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x=-4 and x=0]]></text>
      <feedback format="html">
        <text><![CDATA[The factor x-4 gives x=4, not -4.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x=0 and x=4]]></text>
      <feedback format="html">
        <text><![CDATA[Factor 2x(x-4)=0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x=8 only]]></text>
      <feedback format="html">
        <text><![CDATA[There are two factors that can be zero.]]></text>
      </feedback>
