  <question type="multichoice">
    <name>
      <text>ALG1_U05_L08_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L08_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A1.FND.3</p><p>Simplify 3x(x+4).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[3x&#178;+4]]></text>
      <feedback format="html">
        <text><![CDATA[The 4 must also be multiplied by 3x.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[3x&#178;+12x]]></text>
      <feedback format="html">
        <text><![CDATA[Distribute 3x to both terms.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4x&#178;+12x]]></text>
      <feedback format="html">
        <text><![CDATA[This adds coefficients instead of multiplying 3x\cdot x.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[3x+12]]></text>
      <feedback format="html">
        <text><![CDATA[This misses the x&#178; term.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L08_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L08_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A1.QE.3</p><p>Factor x&#178;+7x+12.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[(x+2)(x+6)]]></text>
      <feedback format="html">
        <text><![CDATA[These factors multiply to 12 but add to 8.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(x-3)(x-4)]]></text>
      <feedback format="html">
        <text><![CDATA[The signs would create a negative middle term.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(x+1)(x+12)]]></text>
      <feedback format="html">
        <text><![CDATA[These factors multiply to 12 but add to 13.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[(x+3)(x+4)]]></text>
      <feedback format="html">
        <text><![CDATA[3 and 4 multiply to 12 and add to 7.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L08_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L08_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A1.QE.1</p><p>Solve x&#178;-5x+6=0.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[x=2 and x=3]]></text>
      <feedback format="html">
        <text><![CDATA[The equation factors as (x-2)(x-3)=0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x=-2 and x=-3]]></text>
      <feedback format="html">
        <text><![CDATA[These signs would produce a positive middle term.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x=1 and x=6]]></text>
      <feedback format="html">
        <text><![CDATA[These multiply to 6 but add to 7, not 5.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x=-1 and x=-6]]></text>
      <feedback format="html">
        <text><![CDATA[These do not match the factorization.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L08_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L08_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A1.QE.7</p><p>Which function shows exponential decay?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[y=4x+2]]></text>
      <feedback format="html">
        <text><![CDATA[This is linear, not exponential.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y=2x&#178;]]></text>
      <feedback format="html">
        <text><![CDATA[This is quadratic, not exponential.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[y=100(0.8)ˣ]]></text>
      <feedback format="html">
        <text><![CDATA[A base between 0 and 1 shows decay.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y=100(1.2)ˣ]]></text>
      <feedback format="html">
        <text><![CDATA[A base greater than 1 shows growth.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L08_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L08_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A1.FN.6</p><p>Which pattern suggests a quadratic model?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Constant first differences]]></text>
      <feedback format="html">
        <text><![CDATA[Constant first differences suggest a linear model.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Constant second differences]]></text>
      <feedback format="html">
        <text><![CDATA[Quadratic tables have constant second differences.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Constant ratios]]></text>
      <feedback format="html">
        <text><![CDATA[Constant ratios suggest an exponential model.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[No changing outputs]]></text>
      <feedback format="html">
        <text><![CDATA[No changing outputs suggest a constant model.]]></text>
      </feedback>
    </answer>
  </question>
