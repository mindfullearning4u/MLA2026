  <question type="multichoice">
    <name>
      <text>ALG1_U05_L06_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L06_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A1.QE.7</p><p>Which function shows exponential growth?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[y=40(0.75)ˣ]]></text>
      <feedback format="html">
        <text><![CDATA[A base between 0 and 1 shows decay.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[y=40(1.25)ˣ]]></text>
      <feedback format="html">
        <text><![CDATA[The base 1.25 is greater than 1, so the model grows.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y=40+1.25x]]></text>
      <feedback format="html">
        <text><![CDATA[This is linear because x is multiplied, not used as an exponent.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y=40x&#178;]]></text>
      <feedback format="html">
        <text><![CDATA[This is quadratic, not exponential.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L06_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L06_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A1.QE.7</p><p>A value starts at 500 and decreases by 12% each year. Which model represents the situation?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[y=500(1.12)ˣ]]></text>
      <feedback format="html">
        <text><![CDATA[This shows 12% growth, not decay.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y=500-12x]]></text>
      <feedback format="html">
        <text><![CDATA[This subtracts a fixed amount, not a percent of the current amount.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y=12(500)ˣ]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the initial value and base.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[y=500(0.88)ˣ]]></text>
      <feedback format="html">
        <text><![CDATA[A 12% decrease leaves 88%, so the decay factor is 0.88.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L06_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L06_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A1.QE.8</p><p>What is the initial value of y=18(2)ˣ?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[18]]></text>
      <feedback format="html">
        <text><![CDATA[When x=0, 2⁰=1, so y=18.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[2]]></text>
      <feedback format="html">
        <text><![CDATA[The base is 2, which is the multiplier, not the initial value.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[20]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the coefficient and base, which is not how initial value is found.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[36]]></text>
      <feedback format="html">
        <text><![CDATA[This is the value after one multiplication by 2, not the initial value.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L06_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L06_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A1.QE.9</p><p>A bacteria culture doubles every hour from an initial amount of 75. What does the 2 represent in B(t)=75(2)ᵗ?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The starting amount]]></text>
      <feedback format="html">
        <text><![CDATA[The starting amount is 75.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The number of hours already passed]]></text>
      <feedback format="html">
        <text><![CDATA[The exponent t represents time in hours.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The growth factor each hour]]></text>
      <feedback format="html">
        <text><![CDATA[Multiplying by 2 each hour means the culture doubles.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The final amount]]></text>
      <feedback format="html">
        <text><![CDATA[The final amount depends on the value of t.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L06_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L06_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A1.QE.8</p><p>A table has outputs 6, 18, 54, 162 as x increases by 1. What is the common multiplier?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[6]]></text>
      <feedback format="html">
        <text><![CDATA[The first output is not the multiplier.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[3]]></text>
      <feedback format="html">
        <text><![CDATA[Each output is multiplied by 3 to get the next output.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[12]]></text>
      <feedback format="html">
        <text><![CDATA[This is the first difference, but exponential models use a common multiplier.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[18]]></text>
      <feedback format="html">
        <text><![CDATA[This is one output value, not the ratio between consecutive outputs.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>