  <question type="multichoice">
    <name>
      <text>ALG1_U05_L07_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L07_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A1.FN.6</p><p>A table has outputs 4, 7, 10, 13 as x increases by 1. Which model type fits best?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Quadratic]]></text>
      <feedback format="html">
        <text><![CDATA[Quadratic tables have constant second differences, not constant first differences.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Linear]]></text>
      <feedback format="html">
        <text><![CDATA[The first differences are constant at 3.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Exponential]]></text>
      <feedback format="html">
        <text><![CDATA[Exponential tables have constant ratios, not constant differences.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[No model]]></text>
      <feedback format="html">
        <text><![CDATA[The constant difference gives clear evidence for a linear model.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L07_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L07_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A1.FN.6</p><p>A table has outputs 2, 6, 18, 54 as x increases by 1. Which evidence identifies the model?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The first differences are constant.]]></text>
      <feedback format="html">
        <text><![CDATA[The first differences are 4, 12, and 36, so they are not constant.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The second differences are constant.]]></text>
      <feedback format="html">
        <text><![CDATA[The second differences are not constant.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The outputs are all even.]]></text>
      <feedback format="html">
        <text><![CDATA[Even outputs do not identify the function family.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The ratios are constant.]]></text>
      <feedback format="html">
        <text><![CDATA[Each output is multiplied by 3, so the model is exponential.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L07_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L07_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A1.FN.7</p><p>Which context is best modeled by a quadratic function?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[The area of a square changes as side length changes.]]></text>
      <feedback format="html">
        <text><![CDATA[Square area is represented by A=s&#178;.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A runner travels at a constant speed.]]></text>
      <feedback format="html">
        <text><![CDATA[Constant speed gives a linear relationship.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A bank account grows by 4% each year.]]></text>
      <feedback format="html">
        <text><![CDATA[Repeated percent growth is exponential.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A subscription costs the same amount each month.]]></text>
      <feedback format="html">
        <text><![CDATA[A fixed monthly increase is linear.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L07_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L07_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A1.FN.6</p><p>Which equation is exponential?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[y=5x+2]]></text>
      <feedback format="html">
        <text><![CDATA[This is linear because x has power 1.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y=x&#178;+5]]></text>
      <feedback format="html">
        <text><![CDATA[This is quadratic because the variable is squared.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[y=5(2)ˣ]]></text>
      <feedback format="html">
        <text><![CDATA[The variable is in the exponent.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y=5(x-2)&#178;]]></text>
      <feedback format="html">
        <text><![CDATA[This is quadratic in vertex form.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U05_L07_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U05_L07_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A1.FN.7</p><p>A phone plan charges 25 dollars plus 10 dollars per gigabyte. Which model type is most appropriate?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Quadratic]]></text>
      <feedback format="html">
        <text><![CDATA[There is no squared variable or area-like relationship.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Linear]]></text>
      <feedback format="html">
        <text><![CDATA[The cost increases by a constant amount per gigabyte.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Exponential]]></text>
      <feedback format="html">
        <text><![CDATA[There is no repeated multiplication or percent change.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Random]]></text>
      <feedback format="html">
        <text><![CDATA[The constant charge pattern gives a clear linear model.]]></text>
      </feedback>
    </answer>
  </question>
