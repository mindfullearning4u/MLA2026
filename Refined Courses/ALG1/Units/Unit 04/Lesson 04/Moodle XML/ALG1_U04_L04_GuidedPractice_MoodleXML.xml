      <text>ALG1_U04_L04_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_L04_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A1.FN.1</p><p>The ordered pairs (1,4), (2,6), and (3,8) represent a function. What is the domain?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[(4, 6, 8)]]></text>
      <feedback format="html">
        <text><![CDATA[These are the output values, so they form the range. The domain is the set of input values.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[(1, 2, 3)]]></text>
      <feedback format="html">
        <text><![CDATA[The domain is the set of x-values: 1, 2, and 3. This is the correct choice because it follows the mapped lesson method. Notice the key relationship, operation, or representation that supports the result.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(1, 4, 2, 6, 3, 8)]]></text>
      <feedback format="html">
        <text><![CDATA[This lists both inputs and outputs. The domain includes only the input values.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(1, 3, 4, 8)]]></text>
      <feedback format="html">
        <text><![CDATA[This leaves out some values and mixes inputs with outputs.]]></text>
      </feedback>
    </answer>
  </question>
