  <question type="multichoice">
    <name>
      <text>ALG1_U04_L05_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_L05_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A1.FN.3</p><p>A function starts at y=4 when x=0. What key feature is described?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x-intercept]]></text>
      <feedback format="html">
        <text><![CDATA[An x-intercept occurs when the output is 0. Here the input is 0 and the output is 4.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[y-intercept]]></text>
      <feedback format="html">
        <text><![CDATA[The y-intercept is the output when the input is 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[zero]]></text>
      <feedback format="html">
        <text><![CDATA[A zero is an input that makes the output 0. The output here is 4.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[maximum]]></text>
      <feedback format="html">
        <text><![CDATA[A starting value is not automatically the highest output.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U04_L05_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_L05_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A1.FN.3</p><p>A graph crosses the x-axis at x=6. What does this mean?</p><p><img src="@@PLUGINFILE@@/ALG1_U04_L05_GP_Q02_numberline.png" alt="Number-line graph supports one-variable inequality interpretation." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="ALG1_U04_L05_GP_Q02_numberline.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The y-intercept is 6.]]></text>
      <feedback format="html">
        <text><![CDATA[The y-intercept happens when x = 0. Crossing the x-axis means y = 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The maximum output is 6.]]></text>
      <feedback format="html">
        <text><![CDATA[An x-axis crossing does not identify the highest output.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The output is 6 when the input is 0.]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the meaning of the x-intercept. This choice reflects a common error or incomplete step. Recheck the mapped lesson method, compare the representation or equation carefully, and identify where the reasoning changes.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The input 6 gives an output of 0.]]></text>
      <feedback format="html">
        <text><![CDATA[A zero or x-intercept occurs when the output is 0.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U04_L05_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_L05_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A1.AR.8</p><p>For d(x)=|x-5|, what is the minimum output value?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[0]]></text>
      <feedback format="html">
        <text><![CDATA[Absolute value measures distance, and the smallest possible distance is 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[5]]></text>
      <feedback format="html">
        <text><![CDATA[The expression is centered at 5, but the output can be 0 when x = 5.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[-5]]></text>
      <feedback format="html">
        <text><![CDATA[Absolute value outputs are never negative. This choice reflects a common error or incomplete step. Recheck the mapped lesson method, compare the representation or equation carefully, and identify where the reasoning changes.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[10]]></text>
      <feedback format="html">
        <text><![CDATA[This may occur for some inputs, but it is not the minimum.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U04_L05_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_L05_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A1.FN.3</p><p>A height function increases from t=0 to t=4, then decreases from t=4 to t=8. What happens at t=4?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The graph has a zero.]]></text>
      <feedback format="html">
        <text><![CDATA[A zero happens when the output is 0. The description focuses on changing from increasing to decreasing.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The y-intercept is 4.]]></text>
      <feedback format="html">
        <text><![CDATA[The y-intercept is the output when the input is 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The graph reaches a maximum.]]></text>
      <feedback format="html">
        <text><![CDATA[A function that changes from increasing to decreasing reaches a highest point at the change.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The function is constant.]]></text>
      <feedback format="html">
        <text><![CDATA[A function that increases and then decreases is not constant over the whole interval.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U04_L05_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_L05_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A1.FN.3</p><p>In a cost function, the y-intercept is 25. What is the best interpretation?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The cost is always $25.]]></text>
      <feedback format="html">
        <text><![CDATA[A y-intercept is a starting value, not necessarily every output.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The initial cost is $25 before any additional items.]]></text>
      <feedback format="html">
        <text><![CDATA[The y-intercept is the output when the input is 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The cost increases by $25 each time.]]></text>
      <feedback format="html">
        <text><![CDATA[Increase per step is rate of change, not the y-intercept.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The function has a zero at 25.]]></text>
      <feedback format="html">
        <text><![CDATA[A zero is an input where the output is 0, not a starting cost.]]></text>
      </feedback>
    </answer>
  </question>
