  <question type="multichoice">
    <name>
      <text>ALG1_U04_L03_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_L03_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A1.FN.2</p><p>If f(x)=3x+4, what is f(5)?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[17]]></text>
      <feedback format="html">
        <text><![CDATA[Substitute 5 for x first. Multiplying 3 by 5 gives 15, and then 4 must be added.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[19]]></text>
      <feedback format="html">
        <text><![CDATA[f(5)=3(5)+4=15+4=19.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[23]]></text>
      <feedback format="html">
        <text><![CDATA[This adds 5 after multiplying by 3 and 4. The input replaces x, but the rule stays 3x+4.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[35]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies 3 by 5 and then by 4. The expression calls for addition, not another multiplication.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U04_L03_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_L03_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A1.FN.2</p><p>If g(x)=x&#178;-2, what is g(6)?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[10]]></text>
      <feedback format="html">
        <text><![CDATA[This treats 6&#178; as 12. Squaring means 6\cdot6, not 6+6.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[30]]></text>
      <feedback format="html">
        <text><![CDATA[This subtracts before squaring. Substitute first and follow the order of operations: square 6, then subtract 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[38]]></text>
      <feedback format="html">
        <text><![CDATA[This adds 2 after squaring. The rule says subtract 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[34]]></text>
      <feedback format="html">
        <text><![CDATA[g(6)=6&#178;-2=36-2=34.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U04_L03_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_L03_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A1.FN.2</p><p>The table shows values of h(x).
| x | 2 | 4 | 6 |
| h(x) | 7 | 11 | 15 |
What is h(4)?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[11]]></text>
      <feedback format="html">
        <text><![CDATA[The input 4 matches the output 11 in the table.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[7]]></text>
      <feedback format="html">
        <text><![CDATA[This is the output paired with input 2. Find the row entry directly below x = 4.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[15]]></text>
      <feedback format="html">
        <text><![CDATA[This is the output paired with input 6. The notation h(4) asks for the output when x is 4.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4]]></text>
      <feedback format="html">
        <text><![CDATA[This is the input, not the output. h(4) means the function value at input 4.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U04_L03_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_L03_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A1.FN.2</p><p>A theater charges a $20 reservation fee plus $12 per ticket. The function C(t)=12t+20 gives the total cost for t tickets. What does C(3)=56 mean?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The cost is $3 for 56 tickets.]]></text>
      <feedback format="html">
        <text><![CDATA[The input is the number of tickets, so 3 is the number of tickets. The output 56 is the cost.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The reservation fee is $56.]]></text>
      <feedback format="html">
        <text><![CDATA[The reservation fee is the constant 20. The value C(3) gives the total cost after buying 3 tickets.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The total cost for 3 tickets is $56.]]></text>
      <feedback format="html">
        <text><![CDATA[The input 3 represents tickets, and the output 56 represents total dollars.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Each ticket costs $56.]]></text>
      <feedback format="html">
        <text><![CDATA[The coefficient 12 gives the cost per ticket. The function value 56 is the total for 3 tickets plus the fee.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U04_L03_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_L03_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A1.FN.2</p><p>If p(x)=20-4x, what is p(2)?</p>]]></text>
