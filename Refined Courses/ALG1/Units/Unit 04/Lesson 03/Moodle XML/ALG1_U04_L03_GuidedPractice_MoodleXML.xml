    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[18]]></text>
      <feedback format="html">
        <text><![CDATA[This subtracts 2 instead of 4(2). Substitute 2 for x and multiply before subtracting.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[12]]></text>
      <feedback format="html">
        <text><![CDATA[p(2)=20-4(2)=20-8=12.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[28]]></text>
      <feedback format="html">
        <text><![CDATA[This adds 4(2) instead of subtracting it. The rule shows a minus sign.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[40]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies 20 by 2. The input replaces x only, so the 20 remains unchanged.]]></text>
      </feedback>
    </answer>
  </question>
