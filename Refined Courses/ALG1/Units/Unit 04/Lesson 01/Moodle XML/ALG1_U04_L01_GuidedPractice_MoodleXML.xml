  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U04_L01_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_L01_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A1.FN.1</p><p>Which relationship is a function?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[(1, 2), (1, 3), (2, 4)]]></text>
      <feedback format="html">
        <text><![CDATA[Input 1 has two different outputs, so this is not a function.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[(1, 2), (2, 3), (3, 4)]]></text>
      <feedback format="html">
        <text><![CDATA[Each input has exactly one output.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(4, 1), (4, 2), (5, 3)]]></text>
      <feedback format="html">
        <text><![CDATA[Input 4 has two different outputs.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(2, 5), (2, 5), (2, 6)]]></text>
      <feedback format="html">
        <text><![CDATA[Input 2 is paired with different outputs.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U04_L01_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_L01_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A1.FN.1</p><p>Why is (2, 8), (2, 9), (3, 10) not a function?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[It has repeated outputs]]></text>
      <feedback format="html">
        <text><![CDATA[The outputs are not repeated; the issue is the repeated input.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It has only three ordered pairs]]></text>
      <feedback format="html">
        <text><![CDATA[A function can have three ordered pairs.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It includes the input 3]]></text>
      <feedback format="html">
        <text><![CDATA[The input 3 is not a problem.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Input 2 has two different outputs]]></text>
      <feedback format="html">
        <text><![CDATA[A function cannot assign one input to two different outputs.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U04_L01_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_L01_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A1.FN.1</p><p>Can different inputs have the same output in a function?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Yes, because the rule is about each input having one output]]></text>
      <feedback format="html">
        <text><![CDATA[Repeated outputs are allowed.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Yes, but only for linear functions]]></text>
      <feedback format="html">
        <text><![CDATA[Repeated outputs can occur in different function types.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[No, repeated outputs always fail the function test]]></text>
      <feedback format="html">
        <text><![CDATA[Repeated inputs with different outputs fail the test, not repeated outputs.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[No, every output must be unique]]></text>
      <feedback format="html">
        <text><![CDATA[Functions do not require unique outputs.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U04_L01_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_L01_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A1.FN.1</p><p>What does it mean if a vertical line crosses a graph twice?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The graph is linear]]></text>
      <feedback format="html">
        <text><![CDATA[Linearity is not determined by one vertical line crossing twice.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The graph has repeated outputs]]></text>
      <feedback format="html">
        <text><![CDATA[A vertical line checks repeated inputs, not repeated outputs.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The graph is not a function]]></text>
      <feedback format="html">
        <text><![CDATA[One input has more than one output.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The graph must have slope 0]]></text>
      <feedback format="html">
        <text><![CDATA[A horizontal line has slope 0 and is still a function.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U04_L01_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_L01_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A1.FN.1</p><p>Which type best describes y = 3x + 2?</p><p><img src="@@PLUGINFILE@@/ALG1_U04_L01_GP_Q05_graph.png" alt="Coordinate graph supports line, slope, intercept, or inequality interpretation." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="ALG1_U04_L01_GP_Q05_graph.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Quadratic]]></text>
      <feedback format="html">
        <text><![CDATA[A quadratic function includes an x&#178; term.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Linear]]></text>
      <feedback format="html">
        <text><![CDATA[The equation has the form y = mx + b.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Exponential]]></text>
      <feedback format="html">
        <text><![CDATA[An exponential function has the variable in the exponent.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Absolute value]]></text>
      <feedback format="html">
        <text><![CDATA[An absolute value function includes an absolute value expression.]]></text>
      </feedback>
    </answer>
  </question>
