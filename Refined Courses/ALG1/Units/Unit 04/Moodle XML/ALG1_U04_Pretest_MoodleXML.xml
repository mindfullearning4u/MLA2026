    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[10]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies 2 by 5 instead of substituting into 3x+2.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[17]]></text>
      <feedback format="html">
        <text><![CDATA[g(5)=3(5)+2=15+2=17.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[15]]></text>
      <feedback format="html">
        <text><![CDATA[This stops after 3(5) and leaves out the +2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[25]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies 5 by both numbers instead of following the rule.]]></text>
      </feedback>
    </answer>
  </question>
