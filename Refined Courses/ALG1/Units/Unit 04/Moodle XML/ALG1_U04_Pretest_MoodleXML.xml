  <question type="multichoice">
    <name>
      <text>ALG1_U04_PT_Q09</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_PT_Q09</p><p><strong>MLA Standard:</strong> MLA.A1.LR.4</p><p>Function A is A(x)=4x+3. Function B is B(x)=2x+9. Which function has the greater rate of change?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Function A]]></text>
      <feedback format="html">
        <text><![CDATA[Function A has slope 4, and Function B has slope 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Function B]]></text>
      <feedback format="html">
        <text><![CDATA[Function B has the greater y-intercept, but the smaller slope.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[They have the same rate of change.]]></text>
      <feedback format="html">
        <text><![CDATA[The slopes are 4 and 2, so the rates are different.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Cannot be determined.]]></text>
      <feedback format="html">
        <text><![CDATA[Both equations show the rates of change.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U04_PT_Q10</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_PT_Q10</p><p><strong>MLA Standard:</strong> MLA.A1.FN.4</p><p>A context says there is a $10 starting fee plus $3 per item. Which equation matches the context?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[C(x)=10x+3]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the starting fee and per-item rate.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[C(x)=3x+10]]></text>
      <feedback format="html">
        <text><![CDATA[The starting fee is 10 and each item adds 3.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[C(x)=13x]]></text>
      <feedback format="html">
        <text><![CDATA[This treats the fee and item cost as one rate.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[C(x)=3x-10]]></text>
      <feedback format="html">
        <text><![CDATA[The starting fee is added, not subtracted.]]></text>
      </feedback>
    </answer>
