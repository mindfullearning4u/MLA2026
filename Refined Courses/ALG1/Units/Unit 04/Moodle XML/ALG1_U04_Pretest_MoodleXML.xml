      <text>ALG1_U04_PT_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_PT_Q05</p><p><strong>MLA Standard:</strong> MLA.A1.FN.1</p><p>What is the domain of (2,9), (4,11), (6,13)?</p>]]></text>
