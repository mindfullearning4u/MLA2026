  <question type="multichoice">
    <name>
      <text>ALG1_U04_PT_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_PT_Q01</p><p><strong>MLA Standard:</strong> MLA.A1.FN.1</p><p>Which relation is a function?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[(1,4), (2,6), (3,8)]]></text>
      <feedback format="html">
        <text><![CDATA[Each input appears once and has exactly one output.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(1,4), (1,6), (2,8)]]></text>
      <feedback format="html">
        <text><![CDATA[Input 1 has two different outputs, so this is not a function.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(2,5), (2,5), (2,7)]]></text>
      <feedback format="html">
        <text><![CDATA[Input 2 is paired with more than one output value.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(3,1), (4,2), (3,5)]]></text>
      <feedback format="html">
        <text><![CDATA[Input 3 has two different outputs.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U04_PT_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_PT_Q02</p><p><strong>MLA Standard:</strong> MLA.A1.FN.1</p><p>What does f(4)=11 mean?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The input is 11 and the output is 4.]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the input and output in the notation.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The function always equals 11.]]></text>
      <feedback format="html">
        <text><![CDATA[The statement gives one output, not every output.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[When the input is 4, the output is 11.]]></text>
      <feedback format="html">
        <text><![CDATA[Function notation gives the output for a named input.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The function has a zero at 4.]]></text>
      <feedback format="html">
        <text><![CDATA[A zero would mean f(4)=0, not 11.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U04_PT_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_PT_Q03</p><p><strong>MLA Standard:</strong> MLA.A1.FN.2</p><p>If g(x)=3x+2, what is g(5)?</p>]]></text>
