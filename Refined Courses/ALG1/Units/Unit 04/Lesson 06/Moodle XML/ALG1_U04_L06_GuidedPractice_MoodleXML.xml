  <question type="multichoice">
    <name>
      <text>ALG1_U04_L06_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_L06_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A1.FN.4</p><p>Which table matches f(x)=2x+1?</p><p><strong>Representation support:</strong></p><table class="mla-assessment-table" style="border-collapse:collapse;margin:8px 0;"><tr><th style="border:1px solid #555;padding:5px 10px;">Representation</th><th style="border:1px solid #555;padding:5px 10px;">What to Check</th></tr><tr><td style="border:1px solid #555;padding:5px 10px;">table</td><td style="border:1px solid #555;padding:5px 10px;">compare input changes with output changes</td></tr><tr><td style="border:1px solid #555;padding:5px 10px;">linear pattern</td><td style="border:1px solid #555;padding:5px 10px;">constant rate of change</td></tr></table>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Table A: x-row 0, 1, 2; f(x)-row 2, 3, 4]]></text>
      <feedback format="html">
        <text><![CDATA[These outputs increase by 1 and do not match 2x+1.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Table B: x-row 0, 1, 2; f(x)-row 1, 3, 5]]></text>
      <feedback format="html">
        <text><![CDATA[Substituting 0, 1, and 2 gives 1, 3, and 5. This is the correct choice because it follows the mapped lesson method. Notice the key relationship, operation, or representation that supports the result.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Table C: x-row 0, 1, 2; f(x)-row 0, 2, 4]]></text>
      <feedback format="html">
        <text><![CDATA[This table matches 2x, not 2x+1. This choice reflects a common error or incomplete step. Recheck the mapped lesson method, compare the representation or equation carefully, and identify where the reasoning changes.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Table D: x-row 0, 1, 2; f(x)-row 1, 2, 3]]></text>
      <feedback format="html">
        <text><![CDATA[This table matches x+1, not 2x+1. This choice reflects a common error or incomplete step. Recheck the mapped lesson method, compare the representation or equation carefully, and identify where the reasoning changes.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U04_L06_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_L06_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A1.FN.4</p><p>A context says a $5 fee is charged plus $3 per item. Which equation matches the context?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[C(x)=5x+3]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the fee and per-item rate. This choice reflects a common error or incomplete step. Recheck the mapped lesson method, compare the representation or equation carefully, and identify where the reasoning changes.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[C(x)=8x]]></text>
      <feedback format="html">
        <text><![CDATA[This treats the fee and item cost as one rate.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[C(x)=3x-5]]></text>
      <feedback format="html">
        <text><![CDATA[The context adds the fee; it does not subtract it. This choice reflects a common error or incomplete step. Recheck the mapped lesson method, compare the representation or equation carefully, and identify where the reasoning changes.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[C(x)=3x+5]]></text>
      <feedback format="html">
        <text><![CDATA[The output starts at 5 and increases by 3 per item.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U04_L06_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_L06_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A1.FN.4</p><p>If g(x)=f(x)+4, how do the outputs of g compare to the outputs of f?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Each output of g is 4 greater than the matching output of f.]]></text>
      <feedback format="html">
        <text><![CDATA[Adding 4 outside the function raises every output by 4.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Each output of g is 4 less than the matching output of f.]]></text>
      <feedback format="html">
        <text><![CDATA[That would match f(x)-4. This choice reflects a common error or incomplete step. Recheck the mapped lesson method, compare the representation or equation carefully, and identify where the reasoning changes.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Each output of g is 4 times the matching output of f.]]></text>
      <feedback format="html">
        <text><![CDATA[That would match 4f(x). This choice reflects a common error or incomplete step. Recheck the mapped lesson method, compare the representation or equation carefully, and identify where the reasoning changes.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Each input of g is 4 greater than the matching input of f.]]></text>
      <feedback format="html">
        <text><![CDATA[The change is to outputs, not inputs. This choice reflects a common error or incomplete step. Recheck the mapped lesson method, compare the representation or equation carefully, and identify where the reasoning changes.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U04_L06_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_L06_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A1.FN.4</p><p>The table has outputs 7, 10, 13, 16 for inputs 0, 1, 2, 3. Which equation matches?</p><p><strong>Representation support:</strong></p><table class="mla-assessment-table" style="border-collapse:collapse;margin:8px 0;"><tr><th style="border:1px solid #555;padding:5px 10px;">Representation</th><th style="border:1px solid #555;padding:5px 10px;">What to Check</th></tr><tr><td style="border:1px solid #555;padding:5px 10px;">table</td><td style="border:1px solid #555;padding:5px 10px;">compare input changes with output changes</td></tr><tr><td style="border:1px solid #555;padding:5px 10px;">linear pattern</td><td style="border:1px solid #555;padding:5px 10px;">constant rate of change</td></tr></table>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[y=7x+3]]></text>
      <feedback format="html">
        <text><![CDATA[This starts at 3 and increases by 7, the reverse of the table&#39;s pattern.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y=x+7]]></text>
      <feedback format="html">
        <text><![CDATA[This starts at 7 but increases by only 1 each time. This choice reflects a common error or incomplete step. Recheck the mapped lesson method, compare the representation or equation carefully, and identify where the reasoning changes.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[y=3x+7]]></text>
      <feedback format="html">
        <text><![CDATA[The starting output is 7 and the output increases by 3 each time.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y=10x]]></text>
      <feedback format="html">
        <text><![CDATA[This does not match the starting output or the rate of change.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U04_L06_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U04_L06_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A1.FN.4</p><p>Which graph description matches y=x-2?</p><p><img src="@@PLUGINFILE@@/ALG1_U04_L06_GP_Q05_graph.png" alt="Coordinate graph supports line, slope, intercept, or inequality interpretation." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="ALG1_U04_L06_GP_Q05_graph.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[A line with y-intercept 2 and slope 1]]></text>
      <feedback format="html">
        <text><![CDATA[The equation x-2 has y-intercept -2, not 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[A line with y-intercept -2 and slope 1]]></text>
      <feedback format="html">
        <text><![CDATA[The graph starts at -2 and rises 1 for each increase of 1 in x.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A line with y-intercept -2 and slope 2]]></text>
      <feedback format="html">
        <text><![CDATA[The slope is 1 because the coefficient of x is 1.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A line with y-intercept 1 and slope -2]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the slope and intercept values. This choice reflects a common error or incomplete step. Recheck the mapped lesson method, compare the representation or equation carefully, and identify where the reasoning changes.]]></text>
      </feedback>
    </answer>
  </question>
