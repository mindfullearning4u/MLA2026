  <question type="multichoice">
    <name>
      <text>ALG1_U03_L01_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U03_L01_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A1.LR.1</p><p>A relationship has points (0, 2), (1, 5), (2, 8), (3, 11). What is the rate of change?</p><p><img src="@@PLUGINFILE@@/ALG1_U03_L01_GP_Q01_graph.png" alt="Point-pair graph supports slope/rate interpretation." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="ALG1_U03_L01_GP_Q01_graph.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[2]]></text>
      <feedback format="html">
        <text><![CDATA[This is the starting output, not the amount the output changes each step.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[3]]></text>
      <feedback format="html">
        <text><![CDATA[The output increases by 3 each time the input increases by 1.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[5]]></text>
      <feedback format="html">
        <text><![CDATA[This is one output value, not the repeated change.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[11]]></text>
      <feedback format="html">
        <text><![CDATA[This is the last output shown, not the rate of change.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U03_L01_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U03_L01_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A1.LR.1</p><p>Inputs are 0, 1, 2, 3 and outputs are 4, 9, 14, 19. Is the relationship linear?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[No, because the outputs are different.]]></text>
      <feedback format="html">
        <text><![CDATA[Outputs can be different in a linear relationship; the changes must be constant.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[No, because the inputs start at 0.]]></text>
      <feedback format="html">
        <text><![CDATA[Starting at 0 does not prevent a relationship from being linear. This choice reflects a common error or incomplete step. Recheck the mapped lesson method, compare the representation or equation carefully, and identify where the reasoning changes.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Yes, because the outputs increase by 4.]]></text>
      <feedback format="html">
        <text><![CDATA[The outputs do not increase by 4; they increase by 5.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Yes, because the outputs increase by 5 each time.]]></text>
      <feedback format="html">
        <text><![CDATA[Equal input steps have equal output changes. This is the correct choice because it follows the mapped lesson method. Notice the key relationship, operation, or representation that supports the result.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U03_L01_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U03_L01_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A1.LR.1</p><p>A parking garage charges $6 per hour. Which ordered pairs match hours x and cost y?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[(1, 6), (2, 12), (3, 18)]]></text>
      <feedback format="html">
        <text><![CDATA[The cost is 6 times the number of hours. This is the correct choice because it follows the mapped lesson method. Notice the key relationship, operation, or representation that supports the result.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(1, 7), (2, 8), (3, 9)]]></text>
      <feedback format="html">
        <text><![CDATA[This adds 6 only once instead of multiplying by each hour. This choice reflects a common error or incomplete step. Recheck the mapped lesson method, compare the representation or equation carefully, and identify where the reasoning changes.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(6, 1), (12, 2), (18, 3)]]></text>
      <feedback format="html">
        <text><![CDATA[The input and output values are reversed. This choice reflects a common error or incomplete step. Recheck the mapped lesson method, compare the representation or equation carefully, and identify where the reasoning changes.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(0, 6), (1, 6), (2, 6)]]></text>
      <feedback format="html">
        <text><![CDATA[This shows a constant cost, not $6 per hour. This choice reflects a common error or incomplete step. Recheck the mapped lesson method, compare the representation or equation carefully, and identify where the reasoning changes.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
