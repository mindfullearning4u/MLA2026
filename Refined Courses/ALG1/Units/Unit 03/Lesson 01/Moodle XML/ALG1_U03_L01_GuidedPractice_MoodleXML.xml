      <text>ALG1_U03_L01_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U03_L01_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A1.LR.1</p><p>A plant starts at 10 inches and grows 3 inches each week. What are the starting value and rate of change?</p>]]></text>
