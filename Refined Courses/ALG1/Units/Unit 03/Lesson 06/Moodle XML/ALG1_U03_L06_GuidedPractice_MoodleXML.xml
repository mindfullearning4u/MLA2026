  <question type="multichoice">
    <name>
      <text>ALG1_U03_L06_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U03_L06_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A1.AR.2</p><p>Solve x + 6 &lt; 10.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x &lt; 16]]></text>
      <feedback format="html">
        <text><![CDATA[This adds 6 instead of subtracting 6.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x &lt; 4]]></text>
      <feedback format="html">
        <text><![CDATA[Subtract 6 from both sides.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x &gt; 4]]></text>
      <feedback format="html">
        <text><![CDATA[The direction does not change when subtracting 6.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x &gt; 16]]></text>
      <feedback format="html">
        <text><![CDATA[This combines the wrong operation with the wrong direction.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U03_L06_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U03_L06_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A1.AR.2</p><p>Solve 2x - 5 &gt;= 7.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x &gt;= 1]]></text>
      <feedback format="html">
        <text><![CDATA[This subtracts 5 from 7 instead of adding 5 to both sides.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x &lt;= 6]]></text>
      <feedback format="html">
        <text><![CDATA[The direction does not reverse when dividing by positive 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x &gt;= 12]]></text>
      <feedback format="html">
        <text><![CDATA[This stops before dividing by 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x &gt;= 6]]></text>
      <feedback format="html">
        <text><![CDATA[Add 5 to get 2x &gt;= 12, then divide by 2.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U03_L06_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U03_L06_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A1.AR.2</p><p>Solve -3x &lt;= 12.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[x &gt;= -4]]></text>
      <feedback format="html">
        <text><![CDATA[Divide by -3 and reverse the inequality symbol.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x &lt;= -4]]></text>
      <feedback format="html">
        <text><![CDATA[This finds the boundary but forgets to reverse the symbol.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x &gt;= 4]]></text>
      <feedback format="html">
        <text><![CDATA[The sign of the boundary value is wrong.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x &lt;= 4]]></text>
      <feedback format="html">
        <text><![CDATA[This has the wrong boundary sign and the wrong direction.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U03_L06_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U03_L06_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A1.AR.2</p><p>Solve -1 &lt; x + 2 &lt;= 5.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[1 &lt; x &lt;= 7]]></text>
      <feedback format="html">
        <text><![CDATA[This adds 2 instead of subtracting 2 from all three parts.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[-3 &lt;= x &lt; 3]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses which endpoints are included.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[-3 &lt; x &lt;= 3]]></text>
      <feedback format="html">
        <text><![CDATA[Subtract 2 from each part of the compound inequality.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x &lt; -3 or x &gt;= 3]]></text>
      <feedback format="html">
        <text><![CDATA[This changes an interval into an or statement.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG1_U03_L06_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG1_U03_L06_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A1.AR.2</p><p>Why does the inequality symbol reverse when solving -4x &gt; 20?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Because 20 is positive]]></text>
      <feedback format="html">
        <text><![CDATA[The sign of 20 is not what causes the reversal.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Because both sides are divided by a negative number]]></text>
      <feedback format="html">
        <text><![CDATA[Multiplying or dividing by a negative reverses the order relationship.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Because x is a variable]]></text>
      <feedback format="html">
        <text><![CDATA[Variables do not automatically change inequality direction.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Because the solution is negative]]></text>
      <feedback format="html">
        <text><![CDATA[The direction changes because of the negative divisor, not because the answer is negative.]]></text>
      </feedback>
    </answer>
  </question>
