<quiz>
  <question type="category">
    <category>
      <text>$course$/STATISTICS/Units/Unit 05/Lesson 08/STAT_U05_L08_GuidedPractice</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U05_L08_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U05_L08_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.STAT.DCR.1</p><p>A value calculated from a sample is called what?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Statistic]]></text>
      <feedback format="html">
        <text><![CDATA[A statistic is calculated from sample data.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Parameter]]></text>
      <feedback format="html">
        <text><![CDATA[A parameter describes an entire population.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Population]]></text>
      <feedback format="html">
        <text><![CDATA[A population is the full group, not the calculated value.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Treatment]]></text>
      <feedback format="html">
        <text><![CDATA[A treatment is assigned in an experiment.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U05_L08_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U05_L08_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.STAT.DCR.2</p><p>Why is random sampling important?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[It helps the sample represent the population]]></text>
      <feedback format="html">
        <text><![CDATA[Random sampling reduces selection bias and supports representativeness.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It guarantees no variation]]></text>
      <feedback format="html">
        <text><![CDATA[Random samples still vary.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It replaces the need for a population]]></text>
      <feedback format="html">
        <text><![CDATA[The population must still be defined.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It always proves causation]]></text>
      <feedback format="html">
        <text><![CDATA[Causation depends on study design, not random sampling alone.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U05_L08_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U05_L08_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.STAT.DCR.3</p><p>A sample chosen because people are easy to reach is usually what type?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Cluster sample]]></text>
      <feedback format="html">
        <text><![CDATA[Cluster samples choose whole groups.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Convenience sample]]></text>
      <feedback format="html">
        <text><![CDATA[Convenience samples use easily available participants.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Stratified sample]]></text>
      <feedback format="html">
        <text><![CDATA[Stratified samples choose from subgroups.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Census]]></text>
      <feedback format="html">
        <text><![CDATA[A census includes everyone.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U05_L08_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U05_L08_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.STAT.INF.1</p><p>A survey estimate is 62% with margin of error 4 percentage points. What interval is represented?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[54% to 58%]]></text>
      <feedback format="html">
        <text><![CDATA[This interval is not centered at 62%.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[62% to 66%]]></text>
      <feedback format="html">
        <text><![CDATA[This only adds the margin.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[58% to 66%]]></text>
      <feedback format="html">
        <text><![CDATA[Subtract and add 4 percentage points.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4% to 62%]]></text>
      <feedback format="html">
        <text><![CDATA[The margin is not the lower endpoint.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U05_L08_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U05_L08_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.STAT.INF.2</p><p>What does confidence level describe?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The number of people surveyed]]></text>
      <feedback format="html">
        <text><![CDATA[Sample size is not the definition of confidence level.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The exact percent who agree]]></text>
      <feedback format="html">
        <text><![CDATA[A sample percent is an estimate, not confidence level.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The graph title]]></text>
      <feedback format="html">
        <text><![CDATA[A graph title does not define confidence.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The long-run success rate of the interval method]]></text>
      <feedback format="html">
        <text><![CDATA[Confidence level describes the method over repeated samples.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>