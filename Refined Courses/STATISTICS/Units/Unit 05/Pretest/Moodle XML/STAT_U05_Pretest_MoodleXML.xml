<?xml version="1.0" encoding="utf-8"?>
<quiz>
  <question type="category">
    <category>
      <text>$course$/STATISTICS/Units/Unit 05/Pretest/STAT_U05_Pretest</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U05_PT_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U05_PT_Q01</p><p><strong>MLA Standard:</strong> MLA.STAT.DCR.1</p><p>A value calculated from a sample is called what?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Parameter]]></text>
      <feedback format="html">
        <text><![CDATA[A parameter describes an entire population.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Statistic]]></text>
      <feedback format="html">
        <text><![CDATA[A statistic is calculated from sample data.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Population]]></text>
      <feedback format="html">
        <text><![CDATA[A population is the full group, not the calculated value.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Treatment]]></text>
      <feedback format="html">
        <text><![CDATA[A treatment is assigned in an experiment.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U05_PT_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U05_PT_Q02</p><p><strong>MLA Standard:</strong> MLA.STAT.DCR.2</p><p>Why is random sampling important?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[It guarantees no variation]]></text>
      <feedback format="html">
        <text><![CDATA[Random samples still vary.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It replaces the need for a population]]></text>
      <feedback format="html">
        <text><![CDATA[The population must still be defined.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It always proves causation]]></text>
      <feedback format="html">
        <text><![CDATA[Causation depends on study design, not random sampling alone.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[It helps the sample represent the population]]></text>
      <feedback format="html">
        <text><![CDATA[Random sampling reduces selection bias and supports representativeness.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U05_PT_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U05_PT_Q03</p><p><strong>MLA Standard:</strong> MLA.STAT.DCR.3</p><p>A sample chosen because people are easy to reach is usually what type?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Cluster sample]]></text>
      <feedback format="html">
        <text><![CDATA[Cluster samples choose whole groups.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Stratified sample]]></text>
      <feedback format="html">
        <text><![CDATA[Stratified samples choose from subgroups.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Convenience sample]]></text>
      <feedback format="html">
        <text><![CDATA[Convenience samples use easily available participants.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Census]]></text>
      <feedback format="html">
        <text><![CDATA[A census includes everyone.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U05_PT_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U05_PT_Q04</p><p><strong>MLA Standard:</strong> MLA.STAT.INF.1</p><p>A survey estimate is 62% with margin of error 4 percentage points. What interval is represented?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[58% to 66%]]></text>
      <feedback format="html">
        <text><![CDATA[Subtract and add 4 percentage points.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[54% to 58%]]></text>
      <feedback format="html">
        <text><![CDATA[This interval is not centered at 62%.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[62% to 66%]]></text>
      <feedback format="html">
        <text><![CDATA[This only adds the margin.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4% to 62%]]></text>
      <feedback format="html">
        <text><![CDATA[The margin is not the lower endpoint.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U05_PT_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U05_PT_Q05</p><p><strong>MLA Standard:</strong> MLA.STAT.INF.2</p><p>What does confidence level describe?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The number of people surveyed]]></text>
      <feedback format="html">
        <text><![CDATA[Sample size is not the definition of confidence level.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The long-run success rate of the interval method]]></text>
      <feedback format="html">
        <text><![CDATA[Confidence level describes the method over repeated samples.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The exact percent who agree]]></text>
      <feedback format="html">
        <text><![CDATA[A sample percent is an estimate, not confidence level.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The graph title]]></text>
      <feedback format="html">
        <text><![CDATA[A graph title does not define confidence.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U05_PT_Q06</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U05_PT_Q06</p><p><strong>MLA Standard:</strong> MLA.STAT.INF.3</p><p>What do repeated simulated samples show?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[That every estimate is identical]]></text>
      <feedback format="html">
        <text><![CDATA[Repeated samples usually differ.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[That no model is needed]]></text>
      <feedback format="html">
        <text><![CDATA[Simulation is based on a model or process.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[That sampling cannot be studied]]></text>
      <feedback format="html">
        <text><![CDATA[Sampling variability can be studied through simulation.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[How estimates vary]]></text>
      <feedback format="html">
        <text><![CDATA[Simulation helps display sampling variability.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U05_PT_Q07</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U05_PT_Q07</p><p><strong>MLA Standard:</strong> MLA.STAT.INF.4</p><p>An observed result near the center of simulated results is usually what?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Proof of bias]]></text>
      <feedback format="html">
        <text><![CDATA[A typical result alone does not prove bias.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Consistent with the model]]></text>
      <feedback format="html">
        <text><![CDATA[A central result is typical under the model.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Impossible under the model]]></text>
      <feedback format="html">
        <text><![CDATA[A typical result is not impossible.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A census]]></text>
      <feedback format="html">
        <text><![CDATA[A census means data from everyone.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U05_PT_Q08</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U05_PT_Q08</p><p><strong>MLA Standard:</strong> MLA.STAT.DCR.4; MLA.STAT.DCR.5</p><p>Which design assigns treatments?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Experiment]]></text>
      <feedback format="html">
        <text><![CDATA[Experiments assign treatments to compare effects.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Convenience sample]]></text>
      <feedback format="html">
        <text><![CDATA[Convenience sampling describes how people are selected.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Survey]]></text>
      <feedback format="html">
        <text><![CDATA[Surveys ask questions.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Observational study]]></text>
      <feedback format="html">
        <text><![CDATA[Observational studies do not assign treatment.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U05_PT_Q09</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U05_PT_Q09</p><p><strong>MLA Standard:</strong> MLA.STAT.INF.6; MLA.STAT.INF.7</p><p>In a randomized experiment, a simulated model shows differences from -2 to 2 are common, but the observed treatment difference is 8. What is the best conclusion?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The treatments must be identical]]></text>
      <feedback format="html">
        <text><![CDATA[The observed difference is far from typical simulated differences, so identical treatment effects are not supported.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The study is only a convenience survey]]></text>
      <feedback format="html">
        <text><![CDATA[The situation describes a randomized experiment, not a convenience survey.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The treatment difference is unusual and may be statistically meaningful]]></text>
      <feedback format="html">
        <text><![CDATA[Random assignment supports treatment comparison, and the simulation shows the observed difference is unusual.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The difference should be ignored because all differences are random]]></text>
      <feedback format="html">
        <text><![CDATA[Simulation helps decide whether a difference is typical or unusual; this one is unusual.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U05_PT_Q10</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U05_PT_Q10</p><p><strong>MLA Standard:</strong> MLA.STAT.INF.5; MLA.STAT.DMC.1</p><p>A report compares two random samples from two populations and claims one population has a higher mean. What should you check first?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Whether the samples were random and the conclusion matches the data]]></text>
      <feedback format="html">
        <text><![CDATA[Random samples support population inference, and report evaluation checks whether the claim follows from the evidence.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Whether the headline is exciting]]></text>
      <feedback format="html">
        <text><![CDATA[A headline does not determine whether the inference is valid.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Whether the graph uses the brightest color]]></text>
      <feedback format="html">
        <text><![CDATA[Color choice does not determine whether the statistical claim is valid.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Whether the report avoids all statistics]]></text>
      <feedback format="html">
        <text><![CDATA[A report comparing populations should use appropriate statistics, not avoid them.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>