  <question type="multichoice">
    <name>
      <text>STAT_U05_L06_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U05_L06_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.STAT.INF.5</p><p>Two random samples compare average study time in two schools. What conclusion is being supported?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[A treatment effect from random assignment]]></text>
      <feedback format="html">
        <text><![CDATA[No treatment was assigned, so this is not a treatment effect.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A census of every student]]></text>
      <feedback format="html">
        <text><![CDATA[A census would include everyone.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[An inference about two populations]]></text>
      <feedback format="html">
        <text><![CDATA[Random samples support inference about the populations.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A counting permutation]]></text>
      <feedback format="html">
        <text><![CDATA[Permutation is unrelated to population inference.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U05_L06_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U05_L06_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.STAT.INF.6</p><p>Students are randomly assigned to Method A or Method B. What does random assignment help support?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[A biased volunteer sample]]></text>
      <feedback format="html">
        <text><![CDATA[Volunteer bias is not random assignment.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A conclusion about every population without caution]]></text>
      <feedback format="html">
        <text><![CDATA[Conclusions still require context and caution.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A margin of error only]]></text>
      <feedback format="html">
        <text><![CDATA[Margin of error is not the main purpose of random assignment.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[A fair comparison of treatment effects]]></text>
      <feedback format="html">
        <text><![CDATA[Random assignment helps make treatment groups comparable.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U05_L06_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U05_L06_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.STAT.INF.5</p><p>Why should two samples be random when comparing populations?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[It removes all variation]]></text>
      <feedback format="html">
        <text><![CDATA[Sampling variation still exists.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Random sampling helps each sample represent its population]]></text>
      <feedback format="html">
        <text><![CDATA[Representativeness supports population inference.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It guarantees identical sample means]]></text>
      <feedback format="html">
        <text><![CDATA[Random samples can still have different means.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It changes the populations]]></text>
      <feedback format="html">
        <text><![CDATA[Sampling does not change the populations.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U05_L06_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U05_L06_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.STAT.INF.6</p><p>Which situation is a randomized experiment?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Participants are randomly assigned to two treatments]]></text>
      <feedback format="html">
        <text><![CDATA[Random treatment assignment defines a randomized experiment.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A survey asks opinions about treatment]]></text>
      <feedback format="html">
        <text><![CDATA[A survey asks questions but does not assign treatment.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Participants choose their own treatment]]></text>
      <feedback format="html">
        <text><![CDATA[Self-selection can create confounding.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Only past records are observed]]></text>
      <feedback format="html">
        <text><![CDATA[Observing past records is observational.]]></text>
      </feedback>
    </answer>
  </question>
