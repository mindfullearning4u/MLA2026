  <question type="multichoice">
    <name>
      <text>STAT_U03_L01_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U03_L01_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.STAT.BVM.1</p><p>A study finds students who spend more time reading tend to have higher vocabulary scores. What conclusion is safest?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Reading time is associated with vocabulary score]]></text>
      <feedback format="html">
        <text><![CDATA[This describes the relationship without claiming the study proves cause and effect.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Reading time always causes higher vocabulary scores]]></text>
      <feedback format="html">
        <text><![CDATA[This overstates the evidence. Association alone does not prove causation.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Vocabulary score causes students to read more]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the claim and still assumes causation without evidence.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[There is no relationship because the variables are different]]></text>
      <feedback format="html">
        <text><![CDATA[Different variables can still be associated when a pattern appears.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U03_L01_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U03_L01_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.STAT.BVM.1</p><p>When screen time increases, sleep time tends to decrease. What type of association is described?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Positive association]]></text>
      <feedback format="html">
        <text><![CDATA[Positive association means both variables tend to increase together.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[No association]]></text>
      <feedback format="html">
        <text><![CDATA[There is a pattern, so no association is not the best description.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Proven causation]]></text>
      <feedback format="html">
        <text><![CDATA[A pattern does not automatically prove cause and effect.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Negative association]]></text>
      <feedback format="html">
        <text><![CDATA[One variable increases while the other tends to decrease.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U03_L01_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U03_L01_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.STAT.BVM.1</p><p>A chart shows people who own gym memberships exercise more often. Does the chart alone prove the membership caused the exercise?</p><p><img src="@@PLUGINFILE@@/STAT_U03_L01_GP_Q03_visual.png" alt="Statistics visual supports graph, table, distribution, or data-display interpretation without adding new assessment facts." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="STAT_U03_L01_GP_Q03_visual.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Yes, because the two variables are related]]></text>
      <feedback format="html">
        <text><![CDATA[A relationship alone does not prove causation.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Yes, because exercise is healthy]]></text>
      <feedback format="html">
        <text><![CDATA[This may be true, but it does not prove a causal claim from the chart.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[No, because another factor could explain the association]]></text>
      <feedback format="html">
        <text><![CDATA[Motivation, schedule, or income could affect both membership and exercise.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[No, because charts cannot show any association]]></text>
      <feedback format="html">
        <text><![CDATA[Charts can show association, but association is not the same as causation.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U03_L01_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U03_L01_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.STAT.BVM.1</p><p>Two variables have no clear pattern in a scatterplot. What conclusion is appropriate?</p><p><img src="@@PLUGINFILE@@/STAT_U03_L01_GP_Q04_visual.png" alt="Statistics visual supports graph, table, distribution, or data-display interpretation without adding new assessment facts." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="STAT_U03_L01_GP_Q04_visual.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[One variable caused the other]]></text>
      <feedback format="html">
        <text><![CDATA[Causation is not supported, especially when there is no clear pattern.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[There is no clear association shown]]></text>
      <feedback format="html">
        <text><![CDATA[No visible pattern means no clear association is supported.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The variables have a strong positive association]]></text>
      <feedback format="html">
        <text><![CDATA[A strong positive association would show an upward pattern.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The variables have a strong negative association]]></text>
      <feedback format="html">
        <text><![CDATA[A strong negative association would show a downward pattern.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U03_L01_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U03_L01_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.STAT.BVM.1</p><p>A news headline says, &quot;Eating breakfast causes higher grades&quot; based only on a survey. What word should replace causes?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[is associated with]]></text>
      <feedback format="html">
        <text><![CDATA[A survey can show a relationship, but it does not automatically prove cause and effect.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[eliminates]]></text>
      <feedback format="html">
        <text><![CDATA[This changes the meaning and is not supported by the survey.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[guarantees]]></text>
      <feedback format="html">
        <text><![CDATA[Statistical relationships do not guarantee an outcome for every person.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[prevents]]></text>
      <feedback format="html">
        <text><![CDATA[This is a causal claim and is not supported by the survey alone.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>