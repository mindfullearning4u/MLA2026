  <question type="multichoice">
    <name>
      <text>STAT_U03_L04_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U03_L04_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.STAT.BVM.4</p><p>What does r = 0.89 suggest?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[A strong positive linear relationship]]></text>
      <feedback format="html">
        <text><![CDATA[The value is positive and close to 1.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A strong negative linear relationship]]></text>
      <feedback format="html">
        <text><![CDATA[A negative relationship would have r below 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[No linear relationship]]></text>
      <feedback format="html">
        <text><![CDATA[Values close to 0 suggest weak or no linear relationship.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Causation is proven]]></text>
      <feedback format="html">
        <text><![CDATA[Correlation does not prove causation.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U03_L04_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U03_L04_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.STAT.BVM.4</p><p>What does r = -0.76 suggest?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[A strong positive linear relationship]]></text>
      <feedback format="html">
        <text><![CDATA[The sign is negative, not positive.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[No linear relationship]]></text>
      <feedback format="html">
        <text><![CDATA[The value is not close to 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Causation is proven]]></text>
      <feedback format="html">
        <text><![CDATA[Correlation does not prove causation.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[A moderately strong negative linear relationship]]></text>
      <feedback format="html">
        <text><![CDATA[The value is negative and fairly close to -1.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U03_L04_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U03_L04_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.STAT.BVM.5</p><p>Which value shows the strongest linear relationship?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[-0.91]]></text>
      <feedback format="html">
        <text><![CDATA[Strength depends on distance from 0, and -0.91 is closest to -1.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[0.12]]></text>
      <feedback format="html">
        <text><![CDATA[This is close to 0, so it is weak.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[0.48]]></text>
      <feedback format="html">
        <text><![CDATA[This is moderate but not the strongest listed.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[-0.30]]></text>
      <feedback format="html">
        <text><![CDATA[This is weaker than -0.91.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U03_L04_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U03_L04_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.STAT.BVM.5</p><p>What does r close to 0 usually mean?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[A strong positive linear relationship]]></text>
      <feedback format="html">
        <text><![CDATA[Strong positive values are close to 1.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Weak or no linear relationship]]></text>
      <feedback format="html">
        <text><![CDATA[Values close to 0 show little linear association.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A strong negative linear relationship]]></text>
      <feedback format="html">
        <text><![CDATA[Strong negative values are close to -1.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Causation is proven]]></text>
      <feedback format="html">
        <text><![CDATA[Correlation values do not prove causation.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U03_L04_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U03_L04_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.STAT.BVM.4</p><p>Does a strong correlation prove causation?</p><p><img src="@@PLUGINFILE@@/STAT_U03_L04_GP_Q05_visual.png" alt="Statistics visual supports graph, table, distribution, or data-display interpretation without adding new assessment facts." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="STAT_U03_L04_GP_Q05_visual.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Yes, if r is positive]]></text>
      <feedback format="html">
        <text><![CDATA[Positive direction does not prove causation.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Yes, if r is negative]]></text>
      <feedback format="html">
        <text><![CDATA[Negative direction does not prove causation.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[No, correlation alone does not prove cause and effect]]></text>
      <feedback format="html">
        <text><![CDATA[Strong correlation can still be affected by confounding variables or study design limits.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Yes, if the graph has a line]]></text>
      <feedback format="html">
        <text><![CDATA[A line shows association, not automatic causation.]]></text>
      </feedback>
    </answer>
  </question>
