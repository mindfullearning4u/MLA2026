      <feedback format="html">
        <text><![CDATA[A title does not show association.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Every count being positive]]></text>
      <feedback format="html">
        <text><![CDATA[Positive counts alone do not show association.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Different distributions across categories]]></text>
      <feedback format="html">
        <text><![CDATA[Association may appear when one variable&#39;s distribution changes across categories of another variable.]]></text>
      </feedback>
    </answer>
  </question>
