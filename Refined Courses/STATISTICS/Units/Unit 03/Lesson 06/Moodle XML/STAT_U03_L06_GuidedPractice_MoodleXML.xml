  <question type="multichoice">
    <name>
      <text>STAT_U03_L06_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U03_L06_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.STAT.BVM.7</p><p>What is a joint frequency in a two-way table?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[A row total only]]></text>
      <feedback format="html">
        <text><![CDATA[A row total is a marginal frequency.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A column total only]]></text>
      <feedback format="html">
        <text><![CDATA[A column total is a marginal frequency.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[A count inside the table for one row category and one column category]]></text>
      <feedback format="html">
        <text><![CDATA[A joint frequency combines categories from both variables.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The title of the table]]></text>
      <feedback format="html">
        <text><![CDATA[The title describes the table but is not a frequency.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U03_L06_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U03_L06_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.STAT.BVM.7</p><p>What is a marginal frequency?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[A row total or column total]]></text>
      <feedback format="html">
        <text><![CDATA[Marginal frequencies appear at the margins of the table.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A count inside the table]]></text>
      <feedback format="html">
        <text><![CDATA[That is a joint frequency.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A category label]]></text>
      <feedback format="html">
        <text><![CDATA[Labels name groups but are not frequencies.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A causal conclusion]]></text>
      <feedback format="html">
        <text><![CDATA[Frequency tables do not automatically prove causation.]]></text>
      </feedback>
    </answer>
  </question>
