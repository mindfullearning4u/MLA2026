  <question type="multichoice">
    <name>
      <text>STAT_U06_L01_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U06_L01_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.STAT.PSU.11</p><p>A student rolls one fair number cube. Let X be the number rolled. What is X?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[A random variable]]></text>
      <feedback format="html">
        <text><![CDATA[X assigns a numerical value to the outcome of the roll.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A probability]]></text>
      <feedback format="html">
        <text><![CDATA[A probability describes chance. X is the number assigned to an outcome.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A sample space]]></text>
      <feedback format="html">
        <text><![CDATA[The sample space is the set of possible outcomes, not the variable itself.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A graph]]></text>
      <feedback format="html">
        <text><![CDATA[A graph can show the distribution, but X is not the graph.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U06_L01_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U06_L01_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.STAT.PSU.11</p><p>If X is the number of heads when two coins are tossed, which list shows all possible values of X?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[0, 1, 2]]></text>
      <feedback format="html">
        <text><![CDATA[With two coins, the number of heads can be 0, 1, or 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Heads, tails]]></text>
      <feedback format="html">
        <text><![CDATA[Those are coin outcomes, not numerical values of the random variable.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[1, 2]]></text>
      <feedback format="html">
        <text><![CDATA[This misses the possible value 0 when no heads occur.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[0, 1, 2, 3]]></text>
      <feedback format="html">
        <text><![CDATA[Three heads is not possible when only two coins are tossed.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U06_L01_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U06_L01_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.STAT.PSU.11</p><p>A probability distribution has probabilities 0.20, 0.50, and 0.30. Is it valid?</p><p><img src="@@PLUGINFILE@@/STAT_U06_L01_GP_Q03_visual.png" alt="Statistics visual supports graph, table, distribution, or data-display interpretation without adding new assessment facts." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="STAT_U06_L01_GP_Q03_visual.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[No, because 0.50 is too large]]></text>
      <feedback format="html">
        <text><![CDATA[A probability of 0.50 is valid because it is between 0 and 1.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Yes, because each probability is between 0 and 1 and the total is 1]]></text>
      <feedback format="html">
        <text><![CDATA[Both validity rules are satisfied.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[No, because there are three values]]></text>
      <feedback format="html">
        <text><![CDATA[A distribution may have three values; the probabilities must be checked.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Yes, because the largest probability is listed in the middle]]></text>
      <feedback format="html">
        <text><![CDATA[The position of the largest probability does not determine validity.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U06_L01_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U06_L01_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.STAT.PSU.11</p><p>Which probability list cannot be a valid probability distribution?</p><p><img src="@@PLUGINFILE@@/STAT_U06_L01_GP_Q04_visual.png" alt="Statistics visual supports graph, table, distribution, or data-display interpretation without adding new assessment facts." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="STAT_U06_L01_GP_Q04_visual.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[0.25, 0.25, 0.50]]></text>
      <feedback format="html">
        <text><![CDATA[These probabilities are between 0 and 1 and add to 1.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[0.10, 0.40, 0.50]]></text>
      <feedback format="html">
        <text><![CDATA[These probabilities are between 0 and 1 and add to 1.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[0.30, 0.30, 0.40]]></text>
      <feedback format="html">
        <text><![CDATA[These probabilities are between 0 and 1 and add to 1.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[0.20, 0.60, 0.40]]></text>
      <feedback format="html">
        <text><![CDATA[These add to 1.20, which is more than 1.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U06_L01_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U06_L01_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.STAT.PSU.11</p><p>A bar graph of a probability distribution has the tallest bar at X = 3. What does that mean?</p><p><img src="@@PLUGINFILE@@/STAT_U06_L01_GP_Q05_visual.png" alt="Statistics visual supports graph, table, distribution, or data-display interpretation without adding new assessment facts." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="STAT_U06_L01_GP_Q05_visual.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[X = 3 must happen every time]]></text>
      <feedback format="html">
        <text><![CDATA[The most likely value is not guaranteed in a random process.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[X = 3 has probability 1]]></text>
      <feedback format="html">
        <text><![CDATA[A tallest bar does not automatically mean the probability is 1.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[X = 3 is the only possible value]]></text>
      <feedback format="html">
        <text><![CDATA[Other bars may still represent other possible values.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[X = 3 is the most likely value]]></text>
      <feedback format="html">
        <text><![CDATA[The tallest probability bar represents the value with the greatest probability.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>