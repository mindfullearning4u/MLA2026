<quiz>
  <question type="category">
    <category>
      <text>$course$/STATISTICS/Units/Unit 06/Lesson 02/STAT_U06_L02_GuidedPractice</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U06_L02_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U06_L02_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.STAT.PSU.12</p><p>A fair spinner has values 1, 2, 3, and 4. What is the theoretical probability of each value?</p><p><img src="@@PLUGINFILE@@/STAT_U06_L02_GP_Q01_visual.png" alt="Statistics visual supports graph, table, distribution, or data-display interpretation without adding new assessment facts." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="STAT_U06_L02_GP_Q01_visual.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[0.25]]></text>
      <feedback format="html">
        <text><![CDATA[Four equal sections means each value has probability 1/4, or 0.25.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[0.50]]></text>
      <feedback format="html">
        <text><![CDATA[This would fit two equal outcomes, not four equal outcomes.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[1.00]]></text>
      <feedback format="html">
        <text><![CDATA[A probability of 1 would mean one value is certain.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4.00]]></text>
      <feedback format="html">
        <text><![CDATA[Probabilities cannot be greater than 1.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U06_L02_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U06_L02_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.STAT.PSU.12</p><p>Which expression finds expected value for values 0, 5, and 10 with probabilities 0.60, 0.30, and 0.10?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[0(0.60) + 5(0.30) + 10(0.10)]]></text>
      <feedback format="html">
        <text><![CDATA[Expected value multiplies each value by its probability and adds the products.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[0 + 5 + 10]]></text>
      <feedback format="html">
        <text><![CDATA[This ignores the probabilities.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[0.60 + 0.30 + 0.10]]></text>
      <feedback format="html">
        <text><![CDATA[This only checks the total probability, not expected value.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[10 - 5 - 0]]></text>
      <feedback format="html">
        <text><![CDATA[Subtraction does not calculate expected value.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U06_L02_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U06_L02_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.STAT.PSU.12</p><p>A game pays $0 with probability 0.50 and $4 with probability 0.50. What is the expected value?</p><p><img src="@@PLUGINFILE@@/STAT_U06_L02_GP_Q03_visual.png" alt="Statistics visual supports graph, table, distribution, or data-display interpretation without adding new assessment facts." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="STAT_U06_L02_GP_Q03_visual.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[$0]]></text>
      <feedback format="html">
        <text><![CDATA[This ignores the possible $4 payout.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$4]]></text>
      <feedback format="html">
        <text><![CDATA[This assumes the highest payout happens every time.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[$2]]></text>
      <feedback format="html">
        <text><![CDATA[0(0.50) + 4(0.50) = 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$8]]></text>
      <feedback format="html">
        <text><![CDATA[This adds values without accounting for probability.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U06_L02_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U06_L02_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.STAT.PSU.12</p><p>What does an expected value of 3.5 for rolling a fair number cube mean?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The next roll must be 3.5]]></text>
      <feedback format="html">
        <text><![CDATA[A single roll cannot be 3.5.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The long-run average roll is 3.5]]></text>
      <feedback format="html">
        <text><![CDATA[Expected value describes the average over many repeated rolls.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Every roll will be either 3 or 4]]></text>
      <feedback format="html">
        <text><![CDATA[Individual rolls can be 1 through 6.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The cube is unfair]]></text>
      <feedback format="html">
        <text><![CDATA[An expected value of 3.5 is normal for a fair number cube.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U06_L02_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U06_L02_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.STAT.PSU.12</p><p>Why is expected value called a weighted average?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[All values are always equally likely]]></text>
      <feedback format="html">
        <text><![CDATA[Expected value can be used when probabilities are unequal.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Values are weighted by their probabilities]]></text>
      <feedback format="html">
        <text><![CDATA[More likely values influence the average more.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The largest value is always chosen]]></text>
      <feedback format="html">
        <text><![CDATA[Expected value uses all values, not only the largest.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The probabilities are ignored]]></text>
      <feedback format="html">
        <text><![CDATA[Expected value depends on probabilities.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>