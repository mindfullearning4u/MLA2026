  <question type="multichoice">
    <name>
      <text>STAT_U06_L05_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U06_L05_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.STAT.PSU.15</p><p>Which question is geometric?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[How many of 10 calls are answered?]]></text>
      <feedback format="html">
        <text><![CDATA[This counts successes in a fixed number of trials, which is binomial.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[How many calls until the first person answers?]]></text>
      <feedback format="html">
        <text><![CDATA[This counts trials until the first success.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[What is the average number of calls per day?]]></text>
      <feedback format="html">
        <text><![CDATA[This asks for an average, not first success.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[What percent of calls are answered?]]></text>
      <feedback format="html">
        <text><![CDATA[This asks for a proportion, not first success.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U06_L05_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U06_L05_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.STAT.PSU.15</p><p>If p = 0.30, what is the probability of failure on one trial?</p><p><img src="@@PLUGINFILE@@/STAT_U06_L05_GP_Q02_visual.png" alt="Statistics visual supports graph, table, distribution, or data-display interpretation without adding new assessment facts." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="STAT_U06_L05_GP_Q02_visual.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[0.70]]></text>
      <feedback format="html">
        <text><![CDATA[Failure probability is 1 - 0.30 = 0.70.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[0.30]]></text>
      <feedback format="html">
        <text><![CDATA[That is the probability of success.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[1.30]]></text>
      <feedback format="html">
        <text><![CDATA[A probability cannot be greater than 1.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[0.03]]></text>
      <feedback format="html">
        <text><![CDATA[This moves the decimal incorrectly.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U06_L05_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U06_L05_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.STAT.PSU.15</p><p>First success on trial 3 means which pattern?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[failure, failure, success]]></text>
      <feedback format="html">
        <text><![CDATA[Trials before the first success must be failures.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[success, success, success]]></text>
      <feedback format="html">
        <text><![CDATA[That has success before trial 3, so trial 3 is not the first success.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[success, failure, success]]></text>
      <feedback format="html">
        <text><![CDATA[This has success on trial 1.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[failure, success, failure]]></text>
      <feedback format="html">
        <text><![CDATA[The first success happens on trial 2, not trial 3.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U06_L05_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U06_L05_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.STAT.PSU.15</p><p>If p = 0.20, what is the probability of first success on trial 2?</p><p><img src="@@PLUGINFILE@@/STAT_U06_L05_GP_Q04_visual.png" alt="Statistics visual supports graph, table, distribution, or data-display interpretation without adding new assessment facts." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="STAT_U06_L05_GP_Q04_visual.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[0.20]]></text>
      <feedback format="html">
        <text><![CDATA[This is success on the first trial, not first success on trial 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[0.04]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies success by success.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[0.80]]></text>
      <feedback format="html">
        <text><![CDATA[This is only the failure probability.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[0.16]]></text>
      <feedback format="html">
        <text><![CDATA[First success on trial 2 is failure then success: 0.80(0.20) = 0.16.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U06_L05_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U06_L05_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.STAT.PSU.15</p><p>Why does the word first matter in a geometric problem?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[It means every trial must be a success]]></text>
      <feedback format="html">
        <text><![CDATA[That would not be first success on a later trial.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It means probabilities are ignored]]></text>
      <feedback format="html">
        <text><![CDATA[Probabilities are still used.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[It means all earlier trials must be failures]]></text>
      <feedback format="html">
        <text><![CDATA[The first success cannot have any earlier successes.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It means the number of trials is fixed in advance]]></text>
      <feedback format="html">
        <text><![CDATA[Geometric problems count until the first success.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>