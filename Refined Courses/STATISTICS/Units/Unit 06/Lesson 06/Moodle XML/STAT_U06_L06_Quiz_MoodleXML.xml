      <feedback format="html">
        <text><![CDATA[This ignores the possible gain.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[$2]]></text>
      <feedback format="html">
        <text><![CDATA[5(0.80) + (-10)(0.20) = 4 - 2 = 2.]]></text>
