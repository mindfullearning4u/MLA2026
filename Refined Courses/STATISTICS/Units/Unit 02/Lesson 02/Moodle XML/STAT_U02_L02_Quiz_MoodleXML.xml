      <text>STAT_U02_L02_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U02_L02_Q04</p><p><strong>MLA Standard:</strong> MLA.STAT.DVD.4</p><p>Two classes have the same mean score. Class A has range 8 and Class B has range 30. Which class is more consistent?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Class B]]></text>
      <feedback format="html">
        <text><![CDATA[A larger range means more spread, not more consistency.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Both are equally consistent]]></text>
      <feedback format="html">
        <text><![CDATA[The ranges are different.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Class A]]></text>
      <feedback format="html">
        <text><![CDATA[The smaller range shows less spread.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Cannot compare because the means match]]></text>
      <feedback format="html">
        <text><![CDATA[Matching means do not prevent comparing variability.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U02_L02_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U02_L02_Q05</p><p><strong>MLA Standard:</strong> MLA.STAT.DVD.4</p><p>Why should variability be reported with center?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[It changes numerical data into categories]]></text>
      <feedback format="html">
        <text><![CDATA[Variability does not change data type.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It removes all outliers]]></text>
      <feedback format="html">
        <text><![CDATA[Reporting variability does not remove values.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[It shows how spread out the values are]]></text>
      <feedback format="html">
        <text><![CDATA[Center gives a typical value, while variability shows consistency and spread.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It replaces the need for a measure of center]]></text>
      <feedback format="html">
        <text><![CDATA[Both center and spread are useful.]]></text>
      </feedback>
    </answer>
  </question>
