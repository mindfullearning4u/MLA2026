  <question type="multichoice">
    <name>
      <text>STAT_U02_L02_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U02_L02_Q02</p><p><strong>MLA Standard:</strong> MLA.STAT.DVD.4</p><p>A smaller standard deviation means what?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The mean is always smaller]]></text>
      <feedback format="html">
        <text><![CDATA[Standard deviation does not determine the mean.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Values are typically closer to the mean]]></text>
      <feedback format="html">
        <text><![CDATA[Standard deviation describes typical distance from the mean.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The data are categorical]]></text>
      <feedback format="html">
        <text><![CDATA[Standard deviation is for numerical data.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[There are more outliers]]></text>
      <feedback format="html">
        <text><![CDATA[Smaller standard deviation usually suggests less spread.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U02_L02_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U02_L02_Q03</p><p><strong>MLA Standard:</strong> MLA.STAT.DVD.4</p><p>What does range describe?</p>]]></text>
