<?xml version="1.0" encoding="utf-8"?>
<quiz>
  <question type="category">
    <category>
      <text>$course$/STATISTICS/Units/Unit 02/Lesson 02/STAT_U02_L02_GuidedPractice</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U02_L02_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U02_L02_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.STAT.DVD.4</p><p>What is the range of 5, 7, 12, 15?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[5]]></text>
      <feedback format="html">
        <text><![CDATA[5 is the minimum, not the range.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[10]]></text>
      <feedback format="html">
        <text><![CDATA[The range is 15 minus 5, which equals 10.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[15]]></text>
      <feedback format="html">
        <text><![CDATA[15 is the maximum, not the range.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[20]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the maximum and minimum instead of subtracting.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U02_L02_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U02_L02_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.STAT.DVD.4</p><p>Two data sets have the same mean. Set A has smaller standard deviation than Set B. What does that mean?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Set A has a larger mean]]></text>
      <feedback format="html">
        <text><![CDATA[The means are stated to be the same.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Set A has more categories]]></text>
      <feedback format="html">
        <text><![CDATA[Standard deviation describes numerical spread, not category count.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Set A has no variability]]></text>
      <feedback format="html">
        <text><![CDATA[Smaller spread does not necessarily mean no spread.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Set A is less spread out]]></text>
      <feedback format="html">
        <text><![CDATA[A smaller standard deviation means values are typically closer to the mean.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U02_L02_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U02_L02_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.STAT.DVD.4</p><p>What does interquartile range measure?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Spread of the middle half of the data]]></text>
      <feedback format="html">
        <text><![CDATA[IQR is Q3 minus Q1, describing the middle 50%.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The average value]]></text>
      <feedback format="html">
        <text><![CDATA[Mean measures average, not IQR.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The most common value]]></text>
      <feedback format="html">
        <text><![CDATA[Mode measures most frequent value.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The total number of values]]></text>
      <feedback format="html">
        <text><![CDATA[IQR measures spread, not count.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U02_L02_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U02_L02_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.STAT.DVD.4</p><p>Set A has values close together, and Set B has values far apart. Which set has greater variability?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Set A]]></text>
      <feedback format="html">
        <text><![CDATA[Close values show less spread.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Both must have the same variability]]></text>
      <feedback format="html">
        <text><![CDATA[The described spreads are different.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Set B]]></text>
      <feedback format="html">
        <text><![CDATA[Values that are farther apart show greater spread.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Variability cannot be compared]]></text>
      <feedback format="html">
        <text><![CDATA[Spread can be compared using range, IQR, MAD, or standard deviation.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U02_L02_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U02_L02_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.STAT.DVD.4</p><p>Why is variability important when comparing two data sets with the same median?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[It shows whether values are clustered or spread out]]></text>
      <feedback format="html">
        <text><![CDATA[Center alone does not show consistency or spread.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It changes the median automatically]]></text>
      <feedback format="html">
        <text><![CDATA[Variability can differ even when medians are the same.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It replaces the need for context]]></text>
      <feedback format="html">
        <text><![CDATA[Context is still needed to interpret spread.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It only applies to categorical data]]></text>
      <feedback format="html">
        <text><![CDATA[Variability describes numerical data spread.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>