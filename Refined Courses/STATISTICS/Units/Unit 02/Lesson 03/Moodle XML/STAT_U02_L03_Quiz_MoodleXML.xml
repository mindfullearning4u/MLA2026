    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Median]]></text>
      <feedback format="html">
        <text><![CDATA[The median is based on position and is less affected by extreme values.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Mean]]></text>
      <feedback format="html">
        <text><![CDATA[Mean can be pulled by outliers.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Range]]></text>
      <feedback format="html">
        <text><![CDATA[Range measures spread and is very affected by outliers.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Maximum]]></text>
      <feedback format="html">
        <text><![CDATA[Maximum may be the outlier.]]></text>
      </feedback>
    </answer>
  </question>
