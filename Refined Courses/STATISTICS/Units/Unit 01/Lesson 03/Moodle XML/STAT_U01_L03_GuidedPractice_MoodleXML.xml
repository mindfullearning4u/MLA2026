  <question type="multichoice">
    <name>
      <text>STAT_U01_L03_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U01_L03_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.STAT.STQ.1</p><p>A class records the number of minutes each student spends reading in one night. Which display is appropriate for showing the distribution?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Two-way table]]></text>
      <feedback format="html">
        <text><![CDATA[A two-way table is for two categorical variables, not one numerical variable.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Pie chart]]></text>
      <feedback format="html">
        <text><![CDATA[A pie chart shows parts of a whole for categories, not a numerical distribution.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Dot plot]]></text>
      <feedback format="html">
        <text><![CDATA[A dot plot shows individual values for one numerical variable.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Scatterplot]]></text>
      <feedback format="html">
        <text><![CDATA[A scatterplot needs two numerical variables.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U01_L03_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U01_L03_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.STAT.STQ.1</p><p>A data set records study hours and test scores for each student. Which display fits the question about relationship?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Scatterplot]]></text>
      <feedback format="html">
        <text><![CDATA[A scatterplot shows the relationship between two numerical variables.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Histogram]]></text>
      <feedback format="html">
        <text><![CDATA[A histogram shows one numerical variable, not a relationship.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Bar chart]]></text>
      <feedback format="html">
        <text><![CDATA[A bar chart compares categories, not two numerical measurements.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Pie chart]]></text>
      <feedback format="html">
        <text><![CDATA[A pie chart summarizes categorical parts of a whole.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U01_L03_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U01_L03_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.STAT.STQ.1</p><p>Which display groups one numerical variable into intervals?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Bar chart]]></text>
      <feedback format="html">
        <text><![CDATA[Bar charts compare category counts, not numerical intervals.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Histogram]]></text>
      <feedback format="html">
        <text><![CDATA[Histograms group numerical values into intervals to show distribution.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Two-way table]]></text>
      <feedback format="html">
        <text><![CDATA[Two-way tables organize categorical combinations.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Scatterplot]]></text>
      <feedback format="html">
        <text><![CDATA[Scatterplots show paired numerical values rather than intervals.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U01_L03_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U01_L03_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.STAT.STQ.1</p><p>A coach wants a quick summary of median, quartiles, and range for player heights. Which display fits best?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Pie chart]]></text>
      <feedback format="html">
        <text><![CDATA[Pie charts show categorical parts of a whole.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Bar chart]]></text>
      <feedback format="html">
        <text><![CDATA[Bar charts compare category counts.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Scatterplot]]></text>
      <feedback format="html">
        <text><![CDATA[Scatterplots show relationships between two numerical variables.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Box plot]]></text>
      <feedback format="html">
        <text><![CDATA[A box plot summarizes center and spread using quartiles and extremes.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U01_L03_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U01_L03_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.STAT.STQ.1</p><p>Why would a bar chart be a weak choice for raw times in seconds?</p><p><img src="@@PLUGINFILE@@/STAT_U01_L03_GP_Q05_visual.png" alt="Statistics visual supports graph, table, distribution, or data-display interpretation without adding new assessment facts." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="STAT_U01_L03_GP_Q05_visual.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Times are numerical values, so a distribution display such as a dot plot or histogram fits better]]></text>
      <feedback format="html">
        <text><![CDATA[A bar chart is for categories; numerical times need a display that shows distribution.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Times cannot be displayed in any graph]]></text>
      <feedback format="html">
        <text><![CDATA[Numerical times can be displayed in dot plots, histograms, or box plots.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Bar charts are only for two numerical variables]]></text>
      <feedback format="html">
        <text><![CDATA[Bar charts are mainly for category counts.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[All numerical data require a scatterplot]]></text>
      <feedback format="html">
        <text><![CDATA[Scatterplots are for two numerical variables, not every numerical dataset.]]></text>
      </feedback>
    </answer>
  </question>
