  <question type="multichoice">
    <name>
      <text>STAT_U01_L04_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U01_L04_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.STAT.STQ.1</p><p>A survey records each student&#39;s favorite school lunch. Which display is appropriate?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Histogram]]></text>
      <feedback format="html">
        <text><![CDATA[A histogram is for numerical intervals, not category labels.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Bar chart]]></text>
      <feedback format="html">
        <text><![CDATA[A bar chart compares counts across lunch categories.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Scatterplot]]></text>
      <feedback format="html">
        <text><![CDATA[A scatterplot needs two numerical variables.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Box plot]]></text>
      <feedback format="html">
        <text><![CDATA[A box plot summarizes numerical data, not categories.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U01_L04_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U01_L04_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.STAT.STQ.1</p><p>Which display lists categories with the number of responses in each category?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Scatterplot]]></text>
      <feedback format="html">
        <text><![CDATA[A scatterplot shows paired numerical values.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Histogram]]></text>
      <feedback format="html">
        <text><![CDATA[A histogram groups numerical values into intervals.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Frequency table]]></text>
      <feedback format="html">
        <text><![CDATA[A frequency table organizes categories and counts.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Dot plot]]></text>
      <feedback format="html">
        <text><![CDATA[A dot plot shows one numerical variable.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U01_L04_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U01_L04_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.STAT.STQ.1</p><p>A school compares preferred study location by grade level. Which display organizes the two categorical variables?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Two-way table]]></text>
      <feedback format="html">
        <text><![CDATA[A two-way table organizes counts for combinations of two categorical variables.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Histogram]]></text>
      <feedback format="html">
        <text><![CDATA[A histogram is for one numerical variable.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Box plot]]></text>
      <feedback format="html">
        <text><![CDATA[A box plot summarizes a numerical distribution.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Scatterplot]]></text>
      <feedback format="html">
        <text><![CDATA[A scatterplot shows two numerical variables.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U01_L04_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U01_L04_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.STAT.STQ.1</p><p>A club wants to show the percent of members choosing each project type out of the whole club. Which display could fit?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Scatterplot]]></text>
      <feedback format="html">
        <text><![CDATA[A scatterplot is for two numerical variables.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Histogram]]></text>
      <feedback format="html">
        <text><![CDATA[A histogram shows numerical intervals.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Box plot]]></text>
      <feedback format="html">
        <text><![CDATA[A box plot summarizes numerical data.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Pie chart]]></text>
      <feedback format="html">
        <text><![CDATA[A pie chart can show how one categorical variable is divided into parts of a whole.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U01_L04_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U01_L04_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.STAT.STQ.1</p><div class='assessment-visual'><p><strong>Categorical data check:</strong></p><table border='1' cellpadding='5' cellspacing='0' style='border-collapse:collapse;margin:8px 0;'><tr><th>Category</th><th>Count</th><th>Display fit</th></tr><tr><td>Pop</td><td>9</td><td>Bar chart or two-way table</td></tr><tr><td>Rock</td><td>7</td><td>Bar chart or two-way table</td></tr><tr><td>Jazz</td><td>4</td><td>Bar chart or two-way table</td></tr></table><p>A histogram groups numerical intervals. Categories are labels, not number intervals.</p></div><p>Why is a histogram not appropriate for favorite music genre?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Genre is categorical, so category counts should be shown with a bar chart or table]]></text>
      <feedback format="html">
        <text><![CDATA[Histograms require numerical intervals, while genre names are categories.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Genres are numerical measurements]]></text>
      <feedback format="html">
        <text><![CDATA[Genres are labels, not measurements.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Histograms are only for two variables]]></text>
      <feedback format="html">
        <text><![CDATA[Histograms display one numerical variable.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Music data can never be displayed]]></text>
      <feedback format="html">
        <text><![CDATA[Music preferences can be displayed as categorical data.]]></text>
      </feedback>
    </answer>
  </question>
