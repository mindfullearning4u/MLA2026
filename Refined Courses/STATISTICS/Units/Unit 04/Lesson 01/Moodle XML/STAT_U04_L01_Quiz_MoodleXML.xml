    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U04_L01_Q05</p><p><strong>MLA Standard:</strong> MLA.STAT.PSU.1</p><p>What does A or B mean?</p>]]></text>
