  <question type="multichoice">
    <name>
      <text>STAT_U04_L01_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U04_L01_Q01</p><p><strong>MLA Standard:</strong> MLA.STAT.PSU.1</p><p>What is the sample space for flipping one coin?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[1, 2, 3, 4, 5, 6]]></text>
      <feedback format="html">
        <text><![CDATA[That is the sample space for a number cube.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[H, T]]></text>
      <feedback format="html">
        <text><![CDATA[Heads and tails are the two possible outcomes.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[H only]]></text>
      <feedback format="html">
        <text><![CDATA[This leaves out tails.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[T only]]></text>
      <feedback format="html">
        <text><![CDATA[This leaves out heads.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U04_L01_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U04_L01_Q02</p><p><strong>MLA Standard:</strong> MLA.STAT.PSU.1</p><p>For S = (1, 2, 3, 4, 5, 6), which event represents rolling an even number?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[(1, 3, 5)]]></text>
      <feedback format="html">
        <text><![CDATA[Those are odd outcomes.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(4, 5, 6)]]></text>
      <feedback format="html">
        <text><![CDATA[Those are outcomes greater than 3.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[(2, 4, 6)]]></text>
      <feedback format="html">
        <text><![CDATA[These are the even outcomes in the sample space.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(1, 2, 3, 4, 5, 6)]]></text>
      <feedback format="html">
        <text><![CDATA[That is the full sample space.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>STAT_U04_L01_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> STAT_U04_L01_Q03</p><p><strong>MLA Standard:</strong> MLA.STAT.PSU.1</p><p>If A = (1, 2, 3) and B = (3, 4, 5), what is A and B?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[(1, 2, 3, 4, 5)]]></text>
      <feedback format="html">
        <text><![CDATA[That is A or B, not A and B.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(1, 2)]]></text>
      <feedback format="html">
        <text><![CDATA[These are only in A.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(4, 5)]]></text>
      <feedback format="html">
        <text><![CDATA[These are only in B.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[(3)]]></text>
      <feedback format="html">
        <text><![CDATA[The intersection contains outcomes in both events.]]></text>
      </feedback>
    </answer>
  </question>
