  <question type="multichoice">
    <name><text>ENG1_U05_L03_Q01</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG1_U05_L03_Q01</p><p><strong>MLA Standard:</strong> MLA.ENG1.V.03</p><p><strong>Sentence:</strong> The mayor described the proposal as bold. What is the most likely connotation of bold?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG1_U05_L03_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. clearly negative</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. A negative word would criticize the proposal more directly.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. only literal color</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Bold can name a color, but proposal context points to attitude.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. unrelated to tone</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Word choice is directly connected to tone here.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>D. positive or admiring</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Bold often suggests confidence or courage, so it can create an admiring tone.</p>]]></text></feedback>
    </answer>
  </question>
