<quiz>
  <question type="multichoice">
    <name><text>ENG1_U02_L04_GP_Q01</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG1_U02_L04_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.ENG1.R.09</p><p><strong>Passage:</strong> The classroom buzzed like a hive before the announcement. <strong>Question:</strong> What type of figurative language is used?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG1_U02_L04_GP_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Hyperlink</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. A hyperlink is a digital link, not figurative language.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. Simile</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The classroom is compared to a hive using like.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Literal statement</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The classroom does not literally buzz like a hive.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Dialogue</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. No character speaks in this sentence.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG1_U02_L04_GP_Q02</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG1_U02_L04_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.ENG1.R.09</p><p><strong>Passage:</strong> The fog wrapped the street in a gray blanket. <strong>Question:</strong> What mood is created?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG1_U02_L04_GP_Q02</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Excited and loud</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The fog and gray blanket suggest quiet, not excitement.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. Silly and playful</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The language is soft and shadowy, not playful.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Angry and violent</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The image is not forceful or violent.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>D. Quiet and mysterious</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The image of fog wrapping the street creates a hidden, mysterious feeling.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG1_U02_L04_GP_Q03</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG1_U02_L04_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.ENG1.R.09</p><p><strong>Passage:</strong> The old house groaned as the wind pushed against its walls. <strong>Question:</strong> Which phrase is personification?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG1_U02_L04_GP_Q03</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. old house</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This describes the house but does not give it a human-like action.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. the wind pushed</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Wind can push physically, so this is not the clearest personification.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>C. house groaned</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The house is given a human-like sound.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. its walls</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This names part of the house.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG1_U02_L04_GP_Q04</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG1_U02_L04_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.ENG1.R.09</p><p><strong>Passage:</strong> Her hope was a candle in the dark hallway. <strong>Question:</strong> What does the metaphor suggest?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG1_U02_L04_GP_Q04</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Hope is made of wax.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This reads the metaphor too literally.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. The hallway is on fire.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The candle is a comparison, not a literal event.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>C. Hope gives a small light during difficulty.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The candle in darkness suggests hope remains even in a hard situation.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. The character has no hope.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The candle represents a small amount of hope.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG1_U02_L04_GP_Q05</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG1_U02_L04_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.ENG1.R.09</p><p><strong>Passage:</strong> The rain tapped softly on the roof while the lamp warmed the room. <strong>Question:</strong> What mood do the details create?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG1_U02_L04_GP_Q05</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>A. Calm</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The gentle sound and warm lamp create a peaceful mood.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. Frantic</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Soft tapping and warm light do not suggest panic.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Furious</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Nothing in the passage suggests anger.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Confusing</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The sensory details are clear and comforting.</p>]]></text></feedback>
    </answer>
  </question>
</quiz>

