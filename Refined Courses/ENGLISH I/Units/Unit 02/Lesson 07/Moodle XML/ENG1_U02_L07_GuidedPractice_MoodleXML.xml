<quiz>
  <question type="multichoice">
    <name><text>ENG1_U02_L07_GP_Q01</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG1_U02_L07_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.ENG1.W.01</p><p><strong>Passage:</strong> When the lights dimmed, I gripped the speech card until the corners bent. <strong>Question:</strong> Which point of view is used?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG1_U02_L07_GP_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Third-person omniscient</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The passage does not reveal many characters&#39; thoughts.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. First person</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The narrator uses I to tell the moment directly.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Second person</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The passage does not address the reader as you.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Objective third person</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The narrator is inside the experience.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG1_U02_L07_GP_Q02</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG1_U02_L07_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.ENG1.W.01</p><p><strong>Passage:</strong> First, Lena heard the bell. Then she saw the empty hallway. <strong>Question:</strong> What do the transition words show?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG1_U02_L07_GP_Q02</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Character appearance</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. First and then do not describe appearance.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. Figurative language</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The words are transitions, not comparisons.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>C. Sequence of events</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The words show order in time.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Dialogue</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. No character speaks.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG1_U02_L07_GP_Q03</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG1_U02_L07_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.ENG1.W.01</p><p><strong>Passage:</strong> The hallway swallowed my footsteps. <strong>Question:</strong> What mood does the figurative language create?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG1_U02_L07_GP_Q03</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Cheerful</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Swallowed suggests something uncomfortable.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. Calm</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The image is more tense than peaceful.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Silly</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The language is not playful.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>D. Nervous</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The hallway seems powerful and quiet, which creates nervous mood.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG1_U02_L07_GP_Q04</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG1_U02_L07_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.ENG1.W.01</p><p><strong>Passage:</strong> I walked in I dropped my books everyone stared. <strong>Question:</strong> Which revision is clearest?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG1_U02_L07_GP_Q04</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. I walked in I dropped my books everyone stared.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This keeps the run-on.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. I walked in, I dropped my books, everyone stared.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This is a comma splice.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Walking in dropped books staring.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This is not a complete sentence.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>D. I walked in, dropped my books, and everyone stared.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. This sentence is clear and correctly joined.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG1_U02_L07_GP_Q05</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG1_U02_L07_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.ENG1.W.01</p><p><strong>Passage:</strong> A character must apologize after taking credit for a friend&#39;s idea. <strong>Question:</strong> Which detail would best build conflict?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG1_U02_L07_GP_Q05</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>A. The friend thanks the character before learning the truth.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. This increases tension around honesty and guilt.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. The character likes blue pencils.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This does not connect to the apology conflict.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. The classroom has four windows.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This setting detail does not build the central conflict.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. The character eats lunch.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This does not develop the apology problem.</p>]]></text></feedback>
    </answer>
  </question>
</quiz>

