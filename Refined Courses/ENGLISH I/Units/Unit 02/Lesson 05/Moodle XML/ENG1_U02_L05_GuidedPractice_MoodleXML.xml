    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. A private shopping trip</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The passage shows public danger, not shopping.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
