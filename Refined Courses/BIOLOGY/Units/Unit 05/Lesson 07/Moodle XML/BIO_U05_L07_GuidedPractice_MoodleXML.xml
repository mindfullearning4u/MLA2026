  <question type="multichoice">
    <name>
      <text>BIO_U05_L07_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U05_L07_GP_Q05&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.BIO.EVO.04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Fossil-data evidence:&lt;/strong&gt; Use the fictionalized embedded table.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Specimen&lt;/th&gt;&lt;th&gt;Age Ma&lt;/th&gt;&lt;th&gt;Cranial cm3&lt;/th&gt;&lt;th&gt;Bipedal Score&lt;/th&gt;&lt;th&gt;Jaw Projection&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;A&lt;/td&gt;&lt;td&gt;4.4&lt;/td&gt;&lt;td&gt;350&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;B&lt;/td&gt;&lt;td&gt;3.2&lt;/td&gt;&lt;td&gt;430&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C&lt;/td&gt;&lt;td&gt;1.9&lt;/td&gt;&lt;td&gt;650&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D&lt;/td&gt;&lt;td&gt;0.6&lt;/td&gt;&lt;td&gt;1100&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;E&lt;/td&gt;&lt;td&gt;0.1&lt;/td&gt;&lt;td&gt;1350&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;Which conclusion stays within the evidence?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>More recent specimens in this sample generally have larger cranial capacities.</text>
      <feedback format="html">
        <text>Correct. It describes a measured sample trend.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>A directly became B.</text>
      <feedback format="html">
        <text>The table does not establish direct ancestry.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>C was more intelligent than B.</text>
      <feedback format="html">
        <text>Cranial capacity alone is not a direct intelligence measure.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Every hominin species is represented.</text>
      <feedback format="html">
        <text>Five fictional specimens cannot represent every species.</text>
      </feedback>
    </answer>
