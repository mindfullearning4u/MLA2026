  <question type="multichoice">
    <name>
      <text>BIO_U05_L07_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U05_L07_GP_Q01&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.BIO.EVO.04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Fossil-data evidence:&lt;/strong&gt; Use the fictionalized embedded table.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Specimen&lt;/th&gt;&lt;th&gt;Age Ma&lt;/th&gt;&lt;th&gt;Cranial cm3&lt;/th&gt;&lt;th&gt;Bipedal Score&lt;/th&gt;&lt;th&gt;Jaw Projection&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;A&lt;/td&gt;&lt;td&gt;4.4&lt;/td&gt;&lt;td&gt;350&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;B&lt;/td&gt;&lt;td&gt;3.2&lt;/td&gt;&lt;td&gt;430&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C&lt;/td&gt;&lt;td&gt;1.9&lt;/td&gt;&lt;td&gt;650&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D&lt;/td&gt;&lt;td&gt;0.6&lt;/td&gt;&lt;td&gt;1100&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;E&lt;/td&gt;&lt;td&gt;0.1&lt;/td&gt;&lt;td&gt;1350&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;Which specimen is oldest?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>A</text>
      <feedback format="html">
        <text>Correct. 4.4 Ma is the greatest age before present.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>B</text>
      <feedback format="html">
        <text>3.2 Ma is younger than 4.4 Ma.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>D</text>
      <feedback format="html">
        <text>0.6 Ma is much more recent.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>E</text>
      <feedback format="html">
        <text>0.1 Ma is the most recent.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>BIO_U05_L07_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U05_L07_GP_Q02&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.BIO.EVO.04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Fossil-data evidence:&lt;/strong&gt; Use the fictionalized embedded table.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Specimen&lt;/th&gt;&lt;th&gt;Age Ma&lt;/th&gt;&lt;th&gt;Cranial cm3&lt;/th&gt;&lt;th&gt;Bipedal Score&lt;/th&gt;&lt;th&gt;Jaw Projection&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;A&lt;/td&gt;&lt;td&gt;4.4&lt;/td&gt;&lt;td&gt;350&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;B&lt;/td&gt;&lt;td&gt;3.2&lt;/td&gt;&lt;td&gt;430&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C&lt;/td&gt;&lt;td&gt;1.9&lt;/td&gt;&lt;td&gt;650&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D&lt;/td&gt;&lt;td&gt;0.6&lt;/td&gt;&lt;td&gt;1100&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;E&lt;/td&gt;&lt;td&gt;0.1&lt;/td&gt;&lt;td&gt;1350&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;What is the cranial-capacity difference between A and E?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>650 cm3</text>
      <feedback format="html">
        <text>This is Specimen C capacity.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>920 cm3</text>
      <feedback format="html">
        <text>This is not 1350 minus 350.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>1000 cm3</text>
      <feedback format="html">
        <text>Correct: 1350 minus 350 equals 1000 cm3.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>1700 cm3</text>
      <feedback format="html">
        <text>This adds the two capacities.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>BIO_U05_L07_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U05_L07_GP_Q03&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.BIO.EVO.04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Fossil-data evidence:&lt;/strong&gt; Use the fictionalized embedded table.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Specimen&lt;/th&gt;&lt;th&gt;Age Ma&lt;/th&gt;&lt;th&gt;Cranial cm3&lt;/th&gt;&lt;th&gt;Bipedal Score&lt;/th&gt;&lt;th&gt;Jaw Projection&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;A&lt;/td&gt;&lt;td&gt;4.4&lt;/td&gt;&lt;td&gt;350&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;B&lt;/td&gt;&lt;td&gt;3.2&lt;/td&gt;&lt;td&gt;430&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C&lt;/td&gt;&lt;td&gt;1.9&lt;/td&gt;&lt;td&gt;650&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D&lt;/td&gt;&lt;td&gt;0.6&lt;/td&gt;&lt;td&gt;1100&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;E&lt;/td&gt;&lt;td&gt;0.1&lt;/td&gt;&lt;td&gt;1350&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;Which statement describes the bipedal-score trend?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>It generally rises from 2 to 5 across the ordered sample.</text>
      <feedback format="html">
        <text>Correct. The values are 2, 3, 4, 4, and 5.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>It falls from 5 to 1.</text>
      <feedback format="html">
        <text>Those are jaw-projection values.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Every score is different.</text>
      <feedback format="html">
        <text>C and D both have 4.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>It proves a direct lineage.</text>
      <feedback format="html">
        <text>A trend does not prove direct ancestry.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>BIO_U05_L07_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U05_L07_GP_Q04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.BIO.EVO.04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Fossil-data evidence:&lt;/strong&gt; Use the fictionalized embedded table.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Specimen&lt;/th&gt;&lt;th&gt;Age Ma&lt;/th&gt;&lt;th&gt;Cranial cm3&lt;/th&gt;&lt;th&gt;Bipedal Score&lt;/th&gt;&lt;th&gt;Jaw Projection&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;A&lt;/td&gt;&lt;td&gt;4.4&lt;/td&gt;&lt;td&gt;350&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;B&lt;/td&gt;&lt;td&gt;3.2&lt;/td&gt;&lt;td&gt;430&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C&lt;/td&gt;&lt;td&gt;1.9&lt;/td&gt;&lt;td&gt;650&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D&lt;/td&gt;&lt;td&gt;0.6&lt;/td&gt;&lt;td&gt;1100&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;E&lt;/td&gt;&lt;td&gt;0.1&lt;/td&gt;&lt;td&gt;1350&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;Which specimens share the same bipedal score?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>A and B</text>
      <feedback format="html">
        <text>Their scores are 2 and 3.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>B and C</text>
      <feedback format="html">
        <text>Their scores are 3 and 4.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>C and D</text>
      <feedback format="html">
        <text>Correct. Both are scored 4.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>D and E</text>
      <feedback format="html">
        <text>Their scores are 4 and 5.</text>
      </feedback>
    </answer>
