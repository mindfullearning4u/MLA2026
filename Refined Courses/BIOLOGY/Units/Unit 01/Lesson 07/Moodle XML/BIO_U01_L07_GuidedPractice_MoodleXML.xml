  </question>
  <question type="multichoice">
    <name>
      <text>BIO_U01_L07_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U01_L07_GP_Q01&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.BIO.ENE.01&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Virtual-lab evidence:&lt;/strong&gt; Use the embedded data below.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Solvent&lt;/th&gt;&lt;th&gt;Solute&lt;/th&gt;&lt;th&gt;Particles Added&lt;/th&gt;&lt;th&gt;Particles Dispersed&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Water (polar)&lt;/td&gt;&lt;td&gt;Charged&lt;/td&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;20&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Water (polar)&lt;/td&gt;&lt;td&gt;Nonpolar&lt;/td&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Oil (nonpolar)&lt;/td&gt;&lt;td&gt;Charged&lt;/td&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Oil (nonpolar)&lt;/td&gt;&lt;td&gt;Nonpolar&lt;/td&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;18&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;Which factor is the independent variable in Investigation A?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>Solvent type</text>
      <feedback format="html">
        <text>Correct. The model changes solvent type between water and oil.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Number of particles dispersed</text>
      <feedback format="html">
        <text>This is the dependent variable because it is the measured result.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Number of particles added</text>
      <feedback format="html">
        <text>This was controlled at 20 particles in every trial.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Observation time</text>
      <feedback format="html">
        <text>This was held constant so it is a controlled condition.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>BIO_U01_L07_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U01_L07_GP_Q02&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.BIO.ENE.01&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Virtual-lab evidence:&lt;/strong&gt; Use the embedded data below.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Solvent&lt;/th&gt;&lt;th&gt;Solute&lt;/th&gt;&lt;th&gt;Particles Added&lt;/th&gt;&lt;th&gt;Particles Dispersed&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Water (polar)&lt;/td&gt;&lt;td&gt;Charged&lt;/td&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;20&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Water (polar)&lt;/td&gt;&lt;td&gt;Nonpolar&lt;/td&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Oil (nonpolar)&lt;/td&gt;&lt;td&gt;Charged&lt;/td&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Oil (nonpolar)&lt;/td&gt;&lt;td&gt;Nonpolar&lt;/td&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;18&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;Which measurement is the dependent variable?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>Solvent polarity</text>
      <feedback format="html">
        <text>Polarity describes the solvent condition, not the measured outcome.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Solute label</text>
      <feedback format="html">
        <text>The solute label identifies a trial condition.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>Particles dispersed</text>
      <feedback format="html">
        <text>Correct. The number dispersed is the outcome measured after each trial.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Twenty particles added</text>
      <feedback format="html">
        <text>The number added was controlled at 20.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>BIO_U01_L07_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U01_L07_GP_Q03&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.BIO.ENE.01&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Virtual-lab evidence:&lt;/strong&gt; Use the embedded data below.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Solvent&lt;/th&gt;&lt;th&gt;Solute&lt;/th&gt;&lt;th&gt;Particles Added&lt;/th&gt;&lt;th&gt;Particles Dispersed&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Water (polar)&lt;/td&gt;&lt;td&gt;Charged&lt;/td&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;20&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Water (polar)&lt;/td&gt;&lt;td&gt;Nonpolar&lt;/td&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Oil (nonpolar)&lt;/td&gt;&lt;td&gt;Charged&lt;/td&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Oil (nonpolar)&lt;/td&gt;&lt;td&gt;Nonpolar&lt;/td&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;18&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;Which comparison is the strongest evidence that polar water dispersed charged particles better than nonpolar oil?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>Water dispersed 20 charged particles; oil dispersed 0.</text>
      <feedback format="html">
        <text>Correct. It compares the same charged solute under the two solvent conditions.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Both solvents received 20 particles.</text>
      <feedback format="html">
        <text>This is a controlled condition, not the measured difference.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Oil dispersed 18 nonpolar particles.</text>
      <feedback format="html">
        <text>This describes nonpolar particles and does not answer the charged-particle question.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Water and oil have different names.</text>
      <feedback format="html">
        <text>Names are not biological evidence.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>BIO_U01_L07_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U01_L07_GP_Q04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.BIO.ENE.01&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Virtual-lab evidence:&lt;/strong&gt; Use the embedded data below.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Solvent&lt;/th&gt;&lt;th&gt;Solute&lt;/th&gt;&lt;th&gt;Particles Added&lt;/th&gt;&lt;th&gt;Particles Dispersed&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Water (polar)&lt;/td&gt;&lt;td&gt;Charged&lt;/td&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;20&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Water (polar)&lt;/td&gt;&lt;td&gt;Nonpolar&lt;/td&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Oil (nonpolar)&lt;/td&gt;&lt;td&gt;Charged&lt;/td&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Oil (nonpolar)&lt;/td&gt;&lt;td&gt;Nonpolar&lt;/td&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;18&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;What pattern is shown for the nonpolar solute?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>Water dispersed 18 and oil dispersed 2.</text>
      <feedback format="html">
        <text>The values are reversed. Read the two nonpolar rows.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>Oil dispersed 18 and water dispersed 2.</text>
      <feedback format="html">
        <text>Correct. Nonpolar oil dispersed more of the nonpolar solute in this model.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Both dispersed all 20.</text>
      <feedback format="html">
        <text>The table shows 2 and 18, not 20 and 20.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Neither dispersed any particles.</text>
      <feedback format="html">
        <text>Both trials dispersed at least some particles.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>BIO_U01_L07_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U01_L07_GP_Q05&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.BIO.ENE.01&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Virtual-lab evidence:&lt;/strong&gt; Use the embedded data below.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Material&lt;/th&gt;&lt;th&gt;Initial Temperature&lt;/th&gt;&lt;th&gt;Final Temperature&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Water&lt;/td&gt;&lt;td&gt;20°C&lt;/td&gt;&lt;td&gt;26°C&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Dry sand&lt;/td&gt;&lt;td&gt;20°C&lt;/td&gt;&lt;td&gt;38°C&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;What was the temperature change for water?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>6°C</text>
      <feedback format="html">
        <text>Correct: 26°C − 20°C = 6°C.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>18°C</text>
      <feedback format="html">
        <text>18°C is the change for sand.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>26°C</text>
      <feedback format="html">
        <text>26°C is the final temperature, not the change.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>46°C</text>
      <feedback format="html">
        <text>Temperature change requires subtraction, not addition.</text>
      </feedback>
    </answer>
  </question>
</quiz>