<quiz>
  <question type="category"><category><text>$course$/BIOLOGY/Units/Unit 02/Lesson 07/GuidedPractice</text></category></question>
  <question type="multichoice">
    <name>
      <text>BIO_U02_L07_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U02_L07_GP_Q01&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.BIO.CEL.05&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Virtual-lab evidence:&lt;/strong&gt; Use the embedded fictional data.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Condition&lt;/th&gt;&lt;th&gt;Exposed&lt;/th&gt;&lt;th&gt;Infected&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;No prevention modeled&lt;/td&gt;&lt;td&gt;40&lt;/td&gt;&lt;td&gt;28&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Hand hygiene modeled&lt;/td&gt;&lt;td&gt;40&lt;/td&gt;&lt;td&gt;14&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Hand hygiene and barrier modeled&lt;/td&gt;&lt;td&gt;40&lt;/td&gt;&lt;td&gt;6&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;What is the transmission percentage for the hand-hygiene condition?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>15%</text>
      <feedback format="html">
        <text>15% is the combined-condition result.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>35%</text>
      <feedback format="html">
        <text>Correct: 14 divided by 40 times 100 equals 35%.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>40%</text>
      <feedback format="html">
        <text>Forty is the exposed count, not the percentage infected.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>70%</text>
      <feedback format="html">
        <text>70% is the no-prevention result.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>BIO_U02_L07_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U02_L07_GP_Q02&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.BIO.CEL.05&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Virtual-lab evidence:&lt;/strong&gt; Use the embedded fictional data.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Condition&lt;/th&gt;&lt;th&gt;Exposed&lt;/th&gt;&lt;th&gt;Infected&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;No prevention modeled&lt;/td&gt;&lt;td&gt;40&lt;/td&gt;&lt;td&gt;28&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Hand hygiene modeled&lt;/td&gt;&lt;td&gt;40&lt;/td&gt;&lt;td&gt;14&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Hand hygiene and barrier modeled&lt;/td&gt;&lt;td&gt;40&lt;/td&gt;&lt;td&gt;6&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;Which condition is the independent variable?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>Prevention condition</text>
      <feedback format="html">
        <text>Correct. The model changes the prevention condition.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Number infected</text>
      <feedback format="html">
        <text>This is a measured outcome.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Number exposed</text>
      <feedback format="html">
        <text>This is controlled at 40 in each trial.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Transmission percentage</text>
      <feedback format="html">
        <text>This is calculated from the measured outcome.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>BIO_U02_L07_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U02_L07_GP_Q03&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.BIO.CEL.05&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Virtual-lab evidence:&lt;/strong&gt; Use the embedded fictional data.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Condition&lt;/th&gt;&lt;th&gt;Exposed&lt;/th&gt;&lt;th&gt;Infected&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;No prevention modeled&lt;/td&gt;&lt;td&gt;40&lt;/td&gt;&lt;td&gt;28&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Hand hygiene modeled&lt;/td&gt;&lt;td&gt;40&lt;/td&gt;&lt;td&gt;14&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Hand hygiene and barrier modeled&lt;/td&gt;&lt;td&gt;40&lt;/td&gt;&lt;td&gt;6&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;Which evidence best supports the claim that the combined modeled condition had the lowest transmission?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>It had 6 infections among 40 exposed, or 15%.</text>
      <feedback format="html">
        <text>Correct. It cites both the count and calculated percentage.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>It included two actions in its name.</text>
      <feedback format="html">
        <text>A condition name is not outcome evidence.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>All trials exposed 40 people.</text>
      <feedback format="html">
        <text>This is a control, not evidence of the lowest outcome.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>The model used a pathogen.</text>
      <feedback format="html">
        <text>This is background information, not a comparison.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>BIO_U02_L07_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U02_L07_GP_Q04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.BIO.CEL.05&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Virtual-lab evidence:&lt;/strong&gt; Use the embedded fictional data.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Day&lt;/th&gt;&lt;th&gt;First Exposure (AU)&lt;/th&gt;&lt;th&gt;Prior Exposure (AU)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;8&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;20&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;45&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;18&lt;/td&gt;&lt;td&gt;70&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;35&lt;/td&gt;&lt;td&gt;82&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;10&lt;/td&gt;&lt;td&gt;52&lt;/td&gt;&lt;td&gt;75&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;On Day 6, how did the two modeled responses compare?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>First exposure was 70 AU and prior exposure was 18 AU.</text>
      <feedback format="html">
        <text>The group values are reversed.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Both were 70 AU.</text>
      <feedback format="html">
        <text>The table shows different values.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>First exposure was 18 AU and prior exposure was 70 AU.</text>
      <feedback format="html">
        <text>Correct. The prior-exposure response was 52 AU higher on Day 6.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Neither group had antibodies.</text>
      <feedback format="html">
        <text>Both groups had measurable values.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>BIO_U02_L07_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U02_L07_GP_Q05&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.BIO.CEL.05&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Virtual-lab evidence:&lt;/strong&gt; Use the embedded fictional data.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Day&lt;/th&gt;&lt;th&gt;First Exposure (AU)&lt;/th&gt;&lt;th&gt;Prior Exposure (AU)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;8&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;20&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;45&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;18&lt;/td&gt;&lt;td&gt;70&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;35&lt;/td&gt;&lt;td&gt;82&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;10&lt;/td&gt;&lt;td&gt;52&lt;/td&gt;&lt;td&gt;75&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;Which explanation is consistent with immune memory?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>Prior exposure was followed by an earlier and stronger modeled antibody response.</text>
      <feedback format="html">
        <text>Correct. The prior-exposure line rises earlier and remains higher through Day 10.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Immune memory means a person can never be infected.</text>
      <feedback format="html">
        <text>Immune memory does not mean zero risk.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Antibodies are pathogens.</text>
      <feedback format="html">
        <text>Antibodies are immune proteins, not pathogens.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>The first-exposure group had the highest level on every day.</text>
      <feedback format="html">
        <text>The prior-exposure values are higher on every listed day.</text>
      </feedback>
    </answer>
  </question>
</quiz>
