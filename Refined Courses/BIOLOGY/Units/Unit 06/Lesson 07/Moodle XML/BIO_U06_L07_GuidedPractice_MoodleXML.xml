  <question type="multichoice">
    <name>
      <text>BIO_U06_L07_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U06_L07_GP_Q01&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standards:&lt;/strong&gt; MLA.BIO.ECO.03; MLA.BIO.SCI.02&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Monitoring evidence:&lt;/strong&gt; Use the fictional embedded table.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Site&lt;/th&gt;&lt;th&gt;DO mg/L&lt;/th&gt;&lt;th&gt;Nitrate mg/L&lt;/th&gt;&lt;th&gt;Turbidity NTU&lt;/th&gt;&lt;th&gt;Richness&lt;/th&gt;&lt;th&gt;Invasive Cover&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;S1&lt;/td&gt;&lt;td&gt;9.2&lt;/td&gt;&lt;td&gt;0.6&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;22&lt;/td&gt;&lt;td&gt;5%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;S2&lt;/td&gt;&lt;td&gt;7.1&lt;/td&gt;&lt;td&gt;4.8&lt;/td&gt;&lt;td&gt;12&lt;/td&gt;&lt;td&gt;14&lt;/td&gt;&lt;td&gt;12%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;S3&lt;/td&gt;&lt;td&gt;5.4&lt;/td&gt;&lt;td&gt;3.9&lt;/td&gt;&lt;td&gt;18&lt;/td&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;25%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;S4&lt;/td&gt;&lt;td&gt;6.8&lt;/td&gt;&lt;td&gt;2.2&lt;/td&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;16&lt;/td&gt;&lt;td&gt;18%&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;Which site has the highest nitrate?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>S1 at 0.6</text>
      <feedback format="html">
        <text>S1 is the lowest.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>S2 at 4.8</text>
      <feedback format="html">
        <text>Correct. S2 has 4.8 mg/L.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>S3 at 3.9</text>
      <feedback format="html">
        <text>S3 is lower than S2.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>S4 at 2.2</text>
      <feedback format="html">
        <text>S4 is lower than S2 and S3.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>BIO_U06_L07_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U06_L07_GP_Q02&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standards:&lt;/strong&gt; MLA.BIO.ECO.03; MLA.BIO.SCI.02&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Monitoring evidence:&lt;/strong&gt; Use the fictional embedded table.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Site&lt;/th&gt;&lt;th&gt;DO mg/L&lt;/th&gt;&lt;th&gt;Nitrate mg/L&lt;/th&gt;&lt;th&gt;Turbidity NTU&lt;/th&gt;&lt;th&gt;Richness&lt;/th&gt;&lt;th&gt;Invasive Cover&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;S1&lt;/td&gt;&lt;td&gt;9.2&lt;/td&gt;&lt;td&gt;0.6&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;22&lt;/td&gt;&lt;td&gt;5%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;S2&lt;/td&gt;&lt;td&gt;7.1&lt;/td&gt;&lt;td&gt;4.8&lt;/td&gt;&lt;td&gt;12&lt;/td&gt;&lt;td&gt;14&lt;/td&gt;&lt;td&gt;12%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;S3&lt;/td&gt;&lt;td&gt;5.4&lt;/td&gt;&lt;td&gt;3.9&lt;/td&gt;&lt;td&gt;18&lt;/td&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;25%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;S4&lt;/td&gt;&lt;td&gt;6.8&lt;/td&gt;&lt;td&gt;2.2&lt;/td&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;16&lt;/td&gt;&lt;td&gt;18%&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;How much lower is dissolved oxygen at S3 than at S1?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>2.1 mg/L</text>
      <feedback format="html">
        <text>This is the S1-to-S2 difference.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>3.8 mg/L</text>
      <feedback format="html">
        <text>Correct: 9.2 minus 5.4 equals 3.8 mg/L.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>5.4 mg/L</text>
      <feedback format="html">
        <text>This is the S3 value.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>14.6 mg/L</text>
      <feedback format="html">
        <text>This adds the values.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>BIO_U06_L07_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U06_L07_GP_Q03&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standards:&lt;/strong&gt; MLA.BIO.ECO.03; MLA.BIO.SCI.02&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Monitoring evidence:&lt;/strong&gt; Use the fictional embedded table.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Site&lt;/th&gt;&lt;th&gt;DO mg/L&lt;/th&gt;&lt;th&gt;Nitrate mg/L&lt;/th&gt;&lt;th&gt;Turbidity NTU&lt;/th&gt;&lt;th&gt;Richness&lt;/th&gt;&lt;th&gt;Invasive Cover&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;S1&lt;/td&gt;&lt;td&gt;9.2&lt;/td&gt;&lt;td&gt;0.6&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;22&lt;/td&gt;&lt;td&gt;5%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;S2&lt;/td&gt;&lt;td&gt;7.1&lt;/td&gt;&lt;td&gt;4.8&lt;/td&gt;&lt;td&gt;12&lt;/td&gt;&lt;td&gt;14&lt;/td&gt;&lt;td&gt;12%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;S3&lt;/td&gt;&lt;td&gt;5.4&lt;/td&gt;&lt;td&gt;3.9&lt;/td&gt;&lt;td&gt;18&lt;/td&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;25%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;S4&lt;/td&gt;&lt;td&gt;6.8&lt;/td&gt;&lt;td&gt;2.2&lt;/td&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;16&lt;/td&gt;&lt;td&gt;18%&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;Which site combines highest turbidity with lowest richness?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>S1</text>
      <feedback format="html">
        <text>S1 has lowest turbidity and highest richness.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>S2</text>
      <feedback format="html">
        <text>S2 is intermediate.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>S3</text>
      <feedback format="html">
        <text>Correct. S3 has 18 NTU and richness 9.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>S4</text>
      <feedback format="html">
        <text>S4 shows partial recovery.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>BIO_U06_L07_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U06_L07_GP_Q04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standards:&lt;/strong&gt; MLA.BIO.ECO.03; MLA.BIO.SCI.02&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Monitoring evidence:&lt;/strong&gt; Use the fictional embedded table.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Site&lt;/th&gt;&lt;th&gt;DO mg/L&lt;/th&gt;&lt;th&gt;Nitrate mg/L&lt;/th&gt;&lt;th&gt;Turbidity NTU&lt;/th&gt;&lt;th&gt;Richness&lt;/th&gt;&lt;th&gt;Invasive Cover&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;S1&lt;/td&gt;&lt;td&gt;9.2&lt;/td&gt;&lt;td&gt;0.6&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;22&lt;/td&gt;&lt;td&gt;5%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;S2&lt;/td&gt;&lt;td&gt;7.1&lt;/td&gt;&lt;td&gt;4.8&lt;/td&gt;&lt;td&gt;12&lt;/td&gt;&lt;td&gt;14&lt;/td&gt;&lt;td&gt;12%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;S3&lt;/td&gt;&lt;td&gt;5.4&lt;/td&gt;&lt;td&gt;3.9&lt;/td&gt;&lt;td&gt;18&lt;/td&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;25%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;S4&lt;/td&gt;&lt;td&gt;6.8&lt;/td&gt;&lt;td&gt;2.2&lt;/td&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;16&lt;/td&gt;&lt;td&gt;18%&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;Which evidence supports partial downstream recovery at S4 compared with S3?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>DO rises 5.4 to 6.8, turbidity falls 18 to 9, and richness rises 9 to 16.</text>
      <feedback format="html">
        <text>Correct. It cites three improving indicators.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Nitrate rises from 3.9 to 4.8.</text>
      <feedback format="html">
        <text>This compares S3 with S2 and reverses site order.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Invasive cover falls to 5%.</text>
      <feedback format="html">
        <text>S4 invasive cover is 18%, not 5%.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Every variable returns to S1 values.</text>
      <feedback format="html">
        <text>S4 does not match S1 on every variable.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>BIO_U06_L07_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U06_L07_GP_Q05&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standards:&lt;/strong&gt; MLA.BIO.ECO.03; MLA.BIO.SCI.02&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Monitoring evidence:&lt;/strong&gt; Use the fictional embedded table.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Site&lt;/th&gt;&lt;th&gt;DO mg/L&lt;/th&gt;&lt;th&gt;Nitrate mg/L&lt;/th&gt;&lt;th&gt;Turbidity NTU&lt;/th&gt;&lt;th&gt;Richness&lt;/th&gt;&lt;th&gt;Invasive Cover&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;S1&lt;/td&gt;&lt;td&gt;9.2&lt;/td&gt;&lt;td&gt;0.6&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;22&lt;/td&gt;&lt;td&gt;5%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;S2&lt;/td&gt;&lt;td&gt;7.1&lt;/td&gt;&lt;td&gt;4.8&lt;/td&gt;&lt;td&gt;12&lt;/td&gt;&lt;td&gt;14&lt;/td&gt;&lt;td&gt;12%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;S3&lt;/td&gt;&lt;td&gt;5.4&lt;/td&gt;&lt;td&gt;3.9&lt;/td&gt;&lt;td&gt;18&lt;/td&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;25%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;S4&lt;/td&gt;&lt;td&gt;6.8&lt;/td&gt;&lt;td&gt;2.2&lt;/td&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;16&lt;/td&gt;&lt;td&gt;18%&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;Which conclusion is appropriately cautious?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>The site pattern supports further source investigation and repeated monitoring.</text>
      <feedback format="html">
        <text>Correct. It uses the pattern while acknowledging uncertainty.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Agriculture is proven to be the only nitrate source.</text>
      <feedback format="html">
        <text>One survey cannot prove a single source.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>One day proves a permanent trend.</text>
      <feedback format="html">
        <text>Long-term trends require repeated sampling.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>S3 has no organisms.</text>
      <feedback format="html">
        <text>Richness 9 shows organisms were observed.</text>
      </feedback>
    </answer>
  </question>
