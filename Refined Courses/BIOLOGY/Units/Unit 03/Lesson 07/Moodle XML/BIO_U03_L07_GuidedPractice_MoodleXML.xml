  <question type="multichoice">
    <name>
      <text>BIO_U03_L07_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U03_L07_GP_Q01&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standards:&lt;/strong&gt; MLA.BIO.ENE.05; MLA.BIO.LAB.03&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Virtual-lab evidence:&lt;/strong&gt; Use the embedded data.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Air Temperature&lt;/th&gt;&lt;th&gt;Water Evaporated in 60 min&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;15 C&lt;/td&gt;&lt;td&gt;4 mL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;25 C&lt;/td&gt;&lt;td&gt;9 mL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;35 C&lt;/td&gt;&lt;td&gt;17 mL&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;What is the dependent variable?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>Air temperature</text>
      <feedback format="html">
        <text>Temperature is the independent variable.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>Water evaporated in 60 minutes</text>
      <feedback format="html">
        <text>Correct. Evaporated volume is the measured outcome.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Starting water volume</text>
      <feedback format="html">
        <text>Starting volume was controlled.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Container surface area</text>
      <feedback format="html">
        <text>Surface area was controlled.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>BIO_U03_L07_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U03_L07_GP_Q02&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standards:&lt;/strong&gt; MLA.BIO.ENE.05; MLA.BIO.LAB.03&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Virtual-lab evidence:&lt;/strong&gt; Use the embedded data.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Air Temperature&lt;/th&gt;&lt;th&gt;Water Evaporated in 60 min&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;15 C&lt;/td&gt;&lt;td&gt;4 mL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;25 C&lt;/td&gt;&lt;td&gt;9 mL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;35 C&lt;/td&gt;&lt;td&gt;17 mL&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;How much more water evaporated at 35 C than at 15 C?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>4 mL</text>
      <feedback format="html">
        <text>This is the 15 C result.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>8 mL</text>
      <feedback format="html">
        <text>This is the increase from 25 C to 35 C.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>13 mL</text>
      <feedback format="html">
        <text>Correct: 17 minus 4 equals 13 mL.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>21 mL</text>
      <feedback format="html">
        <text>This adds the values rather than comparing them.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>BIO_U03_L07_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U03_L07_GP_Q03&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standards:&lt;/strong&gt; MLA.BIO.ENE.05; MLA.BIO.LAB.03&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Virtual-lab evidence:&lt;/strong&gt; Use the embedded data.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Scenario&lt;/th&gt;&lt;th&gt;Photosynthesis Removes&lt;/th&gt;&lt;th&gt;Respiration Adds&lt;/th&gt;&lt;th&gt;Decomposition Adds&lt;/th&gt;&lt;th&gt;Combustion Adds&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Stable forest&lt;/td&gt;&lt;td&gt;120&lt;/td&gt;&lt;td&gt;70&lt;/td&gt;&lt;td&gt;30&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Deforestation&lt;/td&gt;&lt;td&gt;55&lt;/td&gt;&lt;td&gt;60&lt;/td&gt;&lt;td&gt;45&lt;/td&gt;&lt;td&gt;25&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Reforestation&lt;/td&gt;&lt;td&gt;140&lt;/td&gt;&lt;td&gt;65&lt;/td&gt;&lt;td&gt;30&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;What is the net atmospheric change for the stable-forest scenario?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>-20 units</text>
      <feedback format="html">
        <text>Correct: (70+30+0)-120 equals -20 units.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>20 units</text>
      <feedback format="html">
        <text>The sign must be negative because removal exceeds addition.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>100 units</text>
      <feedback format="html">
        <text>This is total atmospheric input before photosynthesis.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>220 units</text>
      <feedback format="html">
        <text>This incorrectly adds every number.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>BIO_U03_L07_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U03_L07_GP_Q04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standards:&lt;/strong&gt; MLA.BIO.ENE.05; MLA.BIO.LAB.03&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Virtual-lab evidence:&lt;/strong&gt; Use the embedded data.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Scenario&lt;/th&gt;&lt;th&gt;Photosynthesis Removes&lt;/th&gt;&lt;th&gt;Respiration Adds&lt;/th&gt;&lt;th&gt;Decomposition Adds&lt;/th&gt;&lt;th&gt;Combustion Adds&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Stable forest&lt;/td&gt;&lt;td&gt;120&lt;/td&gt;&lt;td&gt;70&lt;/td&gt;&lt;td&gt;30&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Deforestation&lt;/td&gt;&lt;td&gt;55&lt;/td&gt;&lt;td&gt;60&lt;/td&gt;&lt;td&gt;45&lt;/td&gt;&lt;td&gt;25&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Reforestation&lt;/td&gt;&lt;td&gt;140&lt;/td&gt;&lt;td&gt;65&lt;/td&gt;&lt;td&gt;30&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;What is the net atmospheric change for deforestation?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>-75 units</text>
      <feedback format="html">
        <text>Inputs exceed removal, so the sign is positive.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>-20 units</text>
      <feedback format="html">
        <text>This is the stable-forest result.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>55 units</text>
      <feedback format="html">
        <text>This is the photosynthesis value.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>75 units</text>
      <feedback format="html">
        <text>Correct: (60+45+25)-55 equals +75 units.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>BIO_U03_L07_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U03_L07_GP_Q05&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standards:&lt;/strong&gt; MLA.BIO.ENE.05; MLA.BIO.LAB.03&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Virtual-lab evidence:&lt;/strong&gt; Use the embedded data.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Scenario&lt;/th&gt;&lt;th&gt;Photosynthesis Removes&lt;/th&gt;&lt;th&gt;Respiration Adds&lt;/th&gt;&lt;th&gt;Decomposition Adds&lt;/th&gt;&lt;th&gt;Combustion Adds&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Stable forest&lt;/td&gt;&lt;td&gt;120&lt;/td&gt;&lt;td&gt;70&lt;/td&gt;&lt;td&gt;30&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Deforestation&lt;/td&gt;&lt;td&gt;55&lt;/td&gt;&lt;td&gt;60&lt;/td&gt;&lt;td&gt;45&lt;/td&gt;&lt;td&gt;25&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Reforestation&lt;/td&gt;&lt;td&gt;140&lt;/td&gt;&lt;td&gt;65&lt;/td&gt;&lt;td&gt;30&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;Which process moves carbon from the atmosphere into the biosphere in this model?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>Photosynthesis</text>
      <feedback format="html">
        <text>Correct. Photosynthesis removes atmospheric carbon and stores it in biological molecules.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Respiration</text>
      <feedback format="html">
        <text>Respiration adds carbon to the atmosphere.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Decomposition</text>
      <feedback format="html">
        <text>Decomposition adds carbon to the atmosphere in this model.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Combustion</text>
      <feedback format="html">
        <text>Combustion adds carbon to the atmosphere.</text>
      </feedback>
    </answer>
  </question>
</quiz>