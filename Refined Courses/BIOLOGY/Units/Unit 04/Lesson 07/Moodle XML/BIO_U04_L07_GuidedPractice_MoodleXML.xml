  <question type="multichoice">
    <name>
      <text>BIO_U04_L07_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U04_L07_GP_Q05&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standards:&lt;/strong&gt; MLA.BIO.GEN.03; MLA.BIO.GEN.04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Virtual-lab evidence:&lt;/strong&gt; Use the fictional embedded data.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Lane&lt;/th&gt;&lt;th&gt;Bands&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Reference control&lt;/td&gt;&lt;td&gt;600 bp&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Variant control&lt;/td&gt;&lt;td&gt;420 bp&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Sample A&lt;/td&gt;&lt;td&gt;600 bp&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Sample B&lt;/td&gt;&lt;td&gt;420 bp&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Sample C&lt;/td&gt;&lt;td&gt;600 bp and 420 bp&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;What can Sample C support?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>Both reference and variant fragments were detected in the fictional screen.</text>
      <feedback format="html">
        <text>Correct. It describes the observed bands without exceeding the evidence.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>A definite medical diagnosis</text>
      <feedback format="html">
        <text>A fragment screen alone is not a diagnosis.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>A required treatment</text>
      <feedback format="html">
        <text>Treatment decisions require additional evidence and professionals.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Disclosure without consent</text>
      <feedback format="html">
        <text>Genetic information requires privacy and consent safeguards.</text>
      </feedback>
    </answer>
