  <question type="multichoice">
    <name>
      <text>BIO_U04_L07_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U04_L07_GP_Q01&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standards:&lt;/strong&gt; MLA.BIO.GEN.03; MLA.BIO.GEN.04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Virtual-lab evidence:&lt;/strong&gt; Use the fictional embedded data.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Condition&lt;/th&gt;&lt;th&gt;Interphase&lt;/th&gt;&lt;th&gt;Prophase&lt;/th&gt;&lt;th&gt;Metaphase&lt;/th&gt;&lt;th&gt;Anaphase&lt;/th&gt;&lt;th&gt;Telophase&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Early embryo&lt;/td&gt;&lt;td&gt;45&lt;/td&gt;&lt;td&gt;25&lt;/td&gt;&lt;td&gt;15&lt;/td&gt;&lt;td&gt;10&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Adult tissue&lt;/td&gt;&lt;td&gt;85&lt;/td&gt;&lt;td&gt;7&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Unregulated model&lt;/td&gt;&lt;td&gt;50&lt;/td&gt;&lt;td&gt;22&lt;/td&gt;&lt;td&gt;13&lt;/td&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;6&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Treatment model&lt;/td&gt;&lt;td&gt;70&lt;/td&gt;&lt;td&gt;14&lt;/td&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;What is the mitotic index of regulated adult tissue?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>15%</text>
      <feedback format="html">
        <text>Correct: (7+4+2+2) divided by 100 times 100 equals 15%.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>30%</text>
      <feedback format="html">
        <text>30% is the treatment-model result.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>50%</text>
      <feedback format="html">
        <text>50% is the unregulated-model result.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>85%</text>
      <feedback format="html">
        <text>85 is the interphase count.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>BIO_U04_L07_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U04_L07_GP_Q02&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standards:&lt;/strong&gt; MLA.BIO.GEN.03; MLA.BIO.GEN.04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Virtual-lab evidence:&lt;/strong&gt; Use the fictional embedded data.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Condition&lt;/th&gt;&lt;th&gt;Interphase&lt;/th&gt;&lt;th&gt;Prophase&lt;/th&gt;&lt;th&gt;Metaphase&lt;/th&gt;&lt;th&gt;Anaphase&lt;/th&gt;&lt;th&gt;Telophase&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Early embryo&lt;/td&gt;&lt;td&gt;45&lt;/td&gt;&lt;td&gt;25&lt;/td&gt;&lt;td&gt;15&lt;/td&gt;&lt;td&gt;10&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Adult tissue&lt;/td&gt;&lt;td&gt;85&lt;/td&gt;&lt;td&gt;7&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Unregulated model&lt;/td&gt;&lt;td&gt;50&lt;/td&gt;&lt;td&gt;22&lt;/td&gt;&lt;td&gt;13&lt;/td&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;6&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Treatment model&lt;/td&gt;&lt;td&gt;70&lt;/td&gt;&lt;td&gt;14&lt;/td&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;Which condition has the highest mitotic index?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>Early embryo at 55%</text>
      <feedback format="html">
        <text>Correct. The four mitotic-stage counts total 55.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Adult tissue at 15%</text>
      <feedback format="html">
        <text>This is the lowest result.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Unregulated model at 50%</text>
      <feedback format="html">
        <text>This is high but 5 points below the embryo model.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Treatment model at 30%</text>
      <feedback format="html">
        <text>This is below both the embryo and unregulated models.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>BIO_U04_L07_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; BIO_U04_L07_GP_Q03&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standards:&lt;/strong&gt; MLA.BIO.GEN.03; MLA.BIO.GEN.04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Virtual-lab evidence:&lt;/strong&gt; Use the fictional embedded data.&lt;/p&gt;&lt;table border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;Condition&lt;/th&gt;&lt;th&gt;Interphase&lt;/th&gt;&lt;th&gt;Prophase&lt;/th&gt;&lt;th&gt;Metaphase&lt;/th&gt;&lt;th&gt;Anaphase&lt;/th&gt;&lt;th&gt;Telophase&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Early embryo&lt;/td&gt;&lt;td&gt;45&lt;/td&gt;&lt;td&gt;25&lt;/td&gt;&lt;td&gt;15&lt;/td&gt;&lt;td&gt;10&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Adult tissue&lt;/td&gt;&lt;td&gt;85&lt;/td&gt;&lt;td&gt;7&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Unregulated model&lt;/td&gt;&lt;td&gt;50&lt;/td&gt;&lt;td&gt;22&lt;/td&gt;&lt;td&gt;13&lt;/td&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;6&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Treatment model&lt;/td&gt;&lt;td&gt;70&lt;/td&gt;&lt;td&gt;14&lt;/td&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;Why does a high embryo mitotic index not by itself show disease?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>Rapid regulated division supports normal development.</text>
      <feedback format="html">
        <text>Correct. Biological context and regulation matter.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Embryos contain no DNA.</text>
      <feedback format="html">
        <text>Embryonic cells contain DNA.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Mitosis occurs only in disease.</text>
      <feedback format="html">
        <text>Mitosis also supports growth and repair.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Every high index is a diagnosis.</text>
      <feedback format="html">
        <text>A count alone is not a diagnosis.</text>
      </feedback>
    </answer>
  </question>
