    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> PC_U01_L06_GP03</p><p><strong>MLA Standard:</strong> MLA.PC.EX.1</p><p>In y = 500(1.08)t, what does 1.08 represent</p>]]></text>
