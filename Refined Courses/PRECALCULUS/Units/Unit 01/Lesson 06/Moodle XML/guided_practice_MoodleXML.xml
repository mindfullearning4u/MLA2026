      <feedback format="html">
        <text><![CDATA[A factor greater than 1 represents growth, not decay.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[the initial amount]]></text>
      <feedback format="html">
        <text><![CDATA[The initial amount is 500.\]]></text>
      </feedback>
    </answer>
