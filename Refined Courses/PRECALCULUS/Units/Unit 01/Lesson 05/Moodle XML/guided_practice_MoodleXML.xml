  <question type="multichoice">
    <name>
      <text>PC_U01_L05_GP01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> PC_U01_L05_GP01</p><p><strong>MLA Standard:</strong> MLA.PC.FA.11</p><p>What is the inverse of f(x) = x + 7</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[f(x) = x + 7]]></text>
      <feedback format="html">
        <text><![CDATA[This repeats the original function instead of undoing the addition.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[f(x) = 7x]]></text>
      <feedback format="html">
        <text><![CDATA[This changes addition into multiplication, which does not undo x + 7.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[f(x) = x - 7]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Subtracting 7 undoes adding 7.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[f(x) = x / 7]]></text>
      <feedback format="html">
        <text><![CDATA[Division by 7 would undo multiplication by 7, not addition of 7.\]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>PC_U01_L05_GP02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> PC_U01_L05_GP02</p><p><strong>MLA Standard:</strong> MLA.PC.FA.11</p><p>If f(3) = 10 and f has an inverse, what must f(10) equal</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[7]]></text>
      <feedback format="html">
        <text><![CDATA[This subtracts the numbers but does not use inverse meaning.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[3]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. An inverse reverses the ordered pair, so output 10 maps back to input 3.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[30]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies the numbers but does not reverse the function relationship.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[10]]></text>
      <feedback format="html">
        <text><![CDATA[This keeps the output as the output instead of reversing input and output.\]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>PC_U01_L05_GP03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> PC_U01_L05_GP03</p><p><strong>MLA Standard:</strong> MLA.PC.FA.11</p><p>Which composition verifies that g is the inverse of f</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[f(x) - g(x) = x]]></text>
      <feedback format="html">
        <text><![CDATA[Subtraction does not show that the functions undo each other.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[f(x) + g(x) = 0]]></text>
      <feedback format="html">
        <text><![CDATA[Adding functions does not verify inverse functions.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[f(x)g(x) = 1]]></text>
      <feedback format="html">
        <text><![CDATA[Multiplying outputs does not verify inverse functions.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[f(g(x)) = x and g(f(x)) = x]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Both compositions returning x verifies inverse functions.\]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>PC_U01_L05_GP04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> PC_U01_L05_GP04</p><p><strong>MLA Standard:</strong> MLA.PC.FA.12</p><p>Why does f(x) = x&#178; need a domain restriction to have an inverse function</p><p><img src="@@PLUGINFILE@@/PC_U01_L05_GP04_graph.png" alt="Parabola graph supports quadratic, vertex, zero, boundary, or shading interpretation." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="PC_U01_L05_GP04_graph.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[It is not one-to-one over all real numbers.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Inputs such as -2 and 2 produce the same output, so the full function is not invertible.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It has no graph.]]></text>
      <feedback format="html">
        <text><![CDATA[The function has a graph; the issue is failing the horizontal line test.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It has no outputs.]]></text>
      <feedback format="html">
        <text><![CDATA[The function has outputs, but some outputs come from two inputs.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It is linear.]]></text>
      <feedback format="html">
        <text><![CDATA[The function is quadratic, not linear.\]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>PC_U01_L05_GP05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> PC_U01_L05_GP05</p><p><strong>MLA Standard:</strong> MLA.PC.FA.13</p><p>A function converts dollars to euros. What would its inverse represent</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Dollars plus euros]]></text>
      <feedback format="html">
        <text><![CDATA[An inverse reverses a conversion, not adds quantities.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Euros squared]]></text>
      <feedback format="html">
        <text><![CDATA[Squaring is not the reverse of currency conversion.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Dollars converted to dollars]]></text>
      <feedback format="html">
        <text><![CDATA[The inverse changes the output unit back to the original input unit.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Euros converted back to dollars]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The inverse reverses the original dollars-to-euros conversion.\]]></text>
      </feedback>
    </answer>
  </question>
