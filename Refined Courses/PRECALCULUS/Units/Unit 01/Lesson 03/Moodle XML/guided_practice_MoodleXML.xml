  <question type="multichoice">
    <name>
      <text>PC_U01_L03_GP01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> PC_U01_L03_GP01</p><p><strong>MLA Standard:</strong> MLA.PC.FA.4</p><p>What is the domain of f(x) = sqrt(x - 8)</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x &lt;= 8]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the inequality. The radicand must be nonnegative, so x - 8 must be at least 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[all real numbers]]></text>
      <feedback format="html">
        <text><![CDATA[Even-index radical functions often have restrictions because the radicand cannot be negative.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x &gt; 0]]></text>
      <feedback format="html">
        <text><![CDATA[This ignores the shift inside the radical. The boundary comes from x - 8 = 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x &gt;= 8]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. x - 8 &gt;= 0 gives x &gt;= 8.\]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>PC_U01_L03_GP02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> PC_U01_L03_GP02</p><p><strong>MLA Standard:</strong> MLA.PC.FA.5</p><p>Which value is excluded from the domain of g(x) = 5 / (x + 4)</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[-4]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. x + 4 cannot equal 0, so x = -4 is excluded.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[0]]></text>
      <feedback format="html">
        <text><![CDATA[The numerator can be 5 when x = 0; the denominator is not zero there.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[5]]></text>
      <feedback format="html">
        <text><![CDATA[The numerator does not create a domain restriction.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4]]></text>
      <feedback format="html">
        <text><![CDATA[This uses the opposite sign. The denominator is zero when x = -4.\]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>PC_U01_L03_GP03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> PC_U01_L03_GP03</p><p><strong>MLA Standard:</strong> MLA.PC.FA.5</p><p>For h(x) = 1 / (x - 2), which vertical asymptote is indicated</p><p><img src="@@PLUGINFILE@@/PC_U01_L03_GP03_visual.png" alt="Precalculus support visual reinforces the graph, diagram, coordinate representation, or table named in the question." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="PC_U01_L03_GP03_visual.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[x = 2]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The denominator is zero at x = 2, giving a vertical asymptote.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 0]]></text>
      <feedback format="html">
        <text><![CDATA[The denominator is not zero when x = 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -2]]></text>
      <feedback format="html">
        <text><![CDATA[This sign comes from solving the denominator incorrectly.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y = 2]]></text>
      <feedback format="html">
        <text><![CDATA[A vertical asymptote is written as x equals a value, not y equals a value.\]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>PC_U01_L03_GP04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> PC_U01_L03_GP04</p><p><strong>MLA Standard:</strong> MLA.PC.FA.4</p><p>In a context modeled by d(t) = sqrt(t), why is t restricted to t &gt;= 0</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The denominator cannot equal zero.]]></text>
      <feedback format="html">
        <text><![CDATA[This applies to rational functions, not this radical model.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The radicand must be nonnegative and time values are not negative in the model.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Both the radical structure and the context support t &gt;= 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Square root functions always have domain t &lt;= 0.]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the usual restriction for sqrt(t).]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The output must be negative.]]></text>
      <feedback format="html">
        <text><![CDATA[The square root output is nonnegative, not negative.\]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>PC_U01_L03_GP05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> PC_U01_L03_GP05</p><p><strong>MLA Standard:</strong> MLA.PC.FA.5</p><p>What is the domain restriction for r(x) = (x + 1) / (x - 6)</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x cannot equal -1]]></text>
      <feedback format="html">
        <text><![CDATA[The numerator being zero creates an x-intercept, not a domain restriction.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x cannot equal 6]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The denominator x - 6 cannot equal 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x cannot equal 0]]></text>
      <feedback format="html">
        <text><![CDATA[The denominator is not zero at x = 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x cannot equal 1]]></text>
      <feedback format="html">
        <text><![CDATA[This value does not make the denominator zero.\]]></text>
      </feedback>
    </answer>
  </question>
</quiz>