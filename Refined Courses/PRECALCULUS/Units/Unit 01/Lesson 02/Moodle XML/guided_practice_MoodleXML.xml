  <question type="multichoice">
    <name>
      <text>PC_U01_L02_GP01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> PC_U01_L02_GP01</p><p><strong>MLA Standard:</strong> MLA.PC.FA.1</p><p>What are the zeros of p(x) = (x - 3)(x + 2)</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[3 and 2]]></text>
      <feedback format="html">
        <text><![CDATA[The factor x + 2 gives zero -2, not 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[-3 and 2]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the signs from both factors.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[3 and -2]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Setting each factor equal to zero gives x = 3 and x = -2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[-3 and -2]]></text>
      <feedback format="html">
        <text><![CDATA[The factor x - 3 gives zero 3, not -3.\]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>PC_U01_L02_GP02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> PC_U01_L02_GP02</p><p><strong>MLA Standard:</strong> MLA.PC.FA.1</p><p>A polynomial has even degree and a positive leading coefficient. Which end behavior is expected</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Both ends up]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Even degree and positive leading coefficient means the graph rises on both ends.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Both ends down]]></text>
      <feedback format="html">
        <text><![CDATA[Both ends down matches even degree with a negative leading coefficient.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Left end up and right end down]]></text>
      <feedback format="html">
        <text><![CDATA[That end behavior matches an odd degree polynomial with negative leading coefficient.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Left end down and right end up]]></text>
      <feedback format="html">
        <text><![CDATA[That end behavior matches an odd degree polynomial with positive leading coefficient.\]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>PC_U01_L02_GP03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> PC_U01_L02_GP03</p><p><strong>MLA Standard:</strong> MLA.PC.FA.2</p><p>In p(x) = (x - 1)&#178;(x + 4), what does the exponent 2 on (x - 1) indicate</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The degree is 2 only.]]></text>
      <feedback format="html">
        <text><![CDATA[The whole polynomial has degree 3 because the exponents add to 3.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The graph crosses the x-axis at x = 1.]]></text>
      <feedback format="html">
        <text><![CDATA[An even multiplicity usually means the graph touches and turns at the zero.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The zero x = 1 has even multiplicity.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The exponent 2 shows that x = 1 has even multiplicity.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The y-intercept is 2.]]></text>
      <feedback format="html">
        <text><![CDATA[Multiplicity does not identify the y-intercept.\]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>PC_U01_L02_GP04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> PC_U01_L02_GP04</p><p><strong>MLA Standard:</strong> MLA.PC.FA.3</p><p>A polynomial model for height has zeros at t = 0 and t = 6. What can the zero t = 6 represent in context</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The y-intercept is 6.]]></text>
      <feedback format="html">
        <text><![CDATA[A y-intercept occurs at t = 0, not necessarily at t = 6.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The maximum height is 6.]]></text>
      <feedback format="html">
        <text><![CDATA[A zero identifies an input where the output is 0, not the maximum height.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The model has degree 6.]]></text>
      <feedback format="html">
        <text><![CDATA[A zero at t = 6 does not determine the degree of the polynomial.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The height is 0 at 6 seconds.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A zero of a height model means the height value is 0 at that input.\]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>PC_U01_L02_GP05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> PC_U01_L02_GP05</p><p><strong>MLA Standard:</strong> MLA.PC.FA.1</p><p>Which polynomial has degree 5</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[p(x) = 4x&#178; - 2x + 1]]></text>
      <feedback format="html">
        <text><![CDATA[The highest exponent is 3, so the degree is 3.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[p(x) = (x - 2)&#178;(x + 1)&#179;]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The exponents add to 5.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[p(x) = x&#178;(x - 1)&#178;]]></text>
      <feedback format="html">
        <text><![CDATA[The total degree is 4, not 5.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[p(x) = 5x - 7]]></text>
      <feedback format="html">
        <text><![CDATA[The highest exponent is 1, so the degree is 1.\]]></text>
      </feedback>
    </answer>
  </question>
