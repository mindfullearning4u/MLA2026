<quiz>
  <question type="category">
    <category>
      <text>$course$/PRECALCULUS/Units/Unit 06/Lesson 03/guided_practice</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>PC_U06_L05_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> PC_U06_L05_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.PC.SEQ.5</p><p>Which rule is recursive for 6, 10, 14, 18, ...</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[a_1 = 6; a_n = a_(n-1) + 4]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. It gives the first term and uses the previous term plus 4.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[a_n = 6 + (n - 1)4]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. This is an explicit rule, not a recursive rule.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[a_1 = 4; a_n = a_(n-1) + 6]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. This reverses the first term and the common difference.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[a_n = 6(4)ⁿ⁻&#185;]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. This is a geometric explicit rule, but the sequence is arithmetic.\]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>PC_U06_L05_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> PC_U06_L05_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.PC.SEQ.5</p><p>What must every recursive rule include</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[An initial term and a rule for the next term]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A recursive rule needs a starting value and a rule for continuing.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Only the final term]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. The final term does not define how the sequence continues.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Only a graph]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. A graph may help, but it is not the required notation.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Only the common difference]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. A common difference alone does not tell where the sequence starts.\]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>PC_U06_L05_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> PC_U06_L05_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.PC.SEQ.5</p><p>Which rule finds a far-away term directly</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Recursive rule]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. Recursive rules build term by term from previous terms.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Initial condition only]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. An initial condition only gives the start.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Common ratio only]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. A common ratio alone does not provide a full rule.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Explicit rule]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. An explicit rule uses n to calculate a term directly.\]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>PC_U06_L05_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> PC_U06_L05_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.PC.SEQ.5</p><p>Given a_1 = 2 and a_n = 3a_(n-1), what is a_3</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[18]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. a_2 = 6 and a_3 = 18.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[9]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. This adds or squares incorrectly. Multiply the previous term by 3 each time.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[12]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. This adds 10 or doubles incorrectly. Follow the recursive rule.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[6]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. 6 is a_2, not a_3.\]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>PC_U06_L05_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> PC_U06_L05_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.PC.SEQ.5</p><p>Which statement best compares explicit and recursive notation</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Explicit finds a term directly; recursive uses previous terms]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. This describes the key difference between the two notations.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Explicit always multiplies; recursive always adds]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. Either notation can describe arithmetic or geometric patterns.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Recursive rules never need a first term]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. Recursive rules need a starting value.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Both notations are only used for arithmetic sequences]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. Both notations can represent many sequence types.\]]></text>
      </feedback>
    </answer>
  </question>
</quiz>