  <question type="multichoice">
    <name>
      <text>PC_U06_L06_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> PC_U06_L06_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.PC.SEQ.3</p><p>Expand the sum from k=1 to 3 of 4k.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[1 + 2 + 3]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. This lists the index values but does not substitute them into 4k.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4 + 12]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. This skips the middle index value k=2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4 + 8 + 12 + 16]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. This includes k=4 even though the upper bound is 3.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[4 + 8 + 12]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Substitute k=1, 2, and 3 into 4k.\]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>PC_U06_L06_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> PC_U06_L06_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.PC.SEQ.3</p><p>Evaluate the sum from k=1 to 4 of k+2.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[18]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. This adds too much, likely by using an extra term.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. This is the number of terms, not the sum.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[14]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The terms are 3, 4, 5, and 6, and their sum is 14.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[10]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. This does not include all substituted terms.\]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>PC_U06_L06_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> PC_U06_L06_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.PC.SEQ.4</p><p>The series 3 + 6 + 12 + 24 is best described as what type of series</p><p><img src="@@PLUGINFILE@@/PC_U06_L06_GP_Q03_visual.png" alt="Precalculus support visual reinforces the graph, diagram, coordinate representation, or table named in the question." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="PC_U06_L06_GP_Q03_visual.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Linear]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. A constant difference would be linear or arithmetic, but this has a constant ratio.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Geometric]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Each term is multiplied by 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Arithmetic]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. The differences are not constant.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Recursive only]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. A recursive rule could describe it, but the series type is geometric.\]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>PC_U06_L06_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> PC_U06_L06_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.PC.SEQ.5</p><p>In the sum from n=2 to 5 of n, what are the lower and upper bounds</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Lower 5, upper 2]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. This reverses the bounds.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Lower n, upper n&#178;]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. n is the index and n is the term rule.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Lower 2, upper 5]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The index starts at 2 and ends at 5.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Lower 2, upper n]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. The upper bound is the ending number, not the index variable.\]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>PC_U06_L06_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> PC_U06_L06_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.PC.SEQ.3</p><p>Why is sigma notation useful</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[It removes the need to know terms]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. You still need to understand the term rule and index values.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It changes every series into a product]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. Sigma notation represents addition, not multiplication.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[It writes long sums compactly]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Sigma notation is a compact way to represent repeated addition.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It only works for one-term sums]]></text>
      <feedback format="html">
        <text><![CDATA[Incorrect. Sigma notation is most useful when there are multiple terms.\]]></text>
      </feedback>
    </answer>
  </question>
</quiz>