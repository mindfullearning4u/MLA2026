  <question type="multichoice">
    <name>
      <text>ALG2_U05_L08_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L08_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A2.SYS.1; MLA.A2.SYS.2</p><p>Solve the system y=x+2 and y=6.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[x=4]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Substitute y=6 into 6=x+2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x=2]]></text>
      <feedback format="html">
        <text><![CDATA[This uses the intercept only.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x=6]]></text>
      <feedback format="html">
        <text><![CDATA[This is the y-value, not x.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x=8]]></text>
      <feedback format="html">
        <text><![CDATA[This adds instead of subtracting.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L08_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L08_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A2.FN.4; MLA.A2.FN.5; MLA.A2.FN.6</p><p>How does y=(x-3)&#178; transform y=x&#178;?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Left 3]]></text>
      <feedback format="html">
        <text><![CDATA[The sign inside parentheses is interpreted oppositely.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Right 3]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. x-3 shifts the graph right 3 units.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Up 3]]></text>
      <feedback format="html">
        <text><![CDATA[There is no outside +3.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Down 3]]></text>
      <feedback format="html">
        <text><![CDATA[There is no outside -3.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L08_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L08_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A2.FN.7; MLA.A2.FN.8</p><p>If f(x)=x+1 and g(x)=4x, what is f(g(2))?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[8]]></text>
      <feedback format="html">
        <text><![CDATA[This stops after g(2).]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[7]]></text>
      <feedback format="html">
        <text><![CDATA[This applies functions in the wrong way.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[9]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. g(2)=8 and f(8)=9.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[12]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies after adding.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L08_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L08_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A2.FN.9; MLA.A2.FN.10</p><p>Find the inverse of f(x)=x-5.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[f⁻&#185;(x)=x-5]]></text>
      <feedback format="html">
        <text><![CDATA[This repeats the original.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[f⁻&#185;(x)=5x]]></text>
      <feedback format="html">
        <text><![CDATA[This does not undo subtracting 5.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[f⁻&#185;(x)=1/(x-5)]]></text>
      <feedback format="html">
        <text><![CDATA[Inverse notation is not reciprocal.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[f⁻&#185;(x)=x+5]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Add 5 to undo subtracting 5.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L08_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L08_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A2.FN.3; MLA.A2.FN.11; MLA.A2.FN.12</p><p>Which solution is viable if a time model gives t=-4 and t=9?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[t=9 only]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Negative time is not viable.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[t=-4 only]]></text>
      <feedback format="html">
        <text><![CDATA[Negative time is not viable.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Both values]]></text>
      <feedback format="html">
        <text><![CDATA[One value violates the context.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Neither value]]></text>
      <feedback format="html">
        <text><![CDATA[The positive time is viable.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>