  <question type="multichoice">
    <name>
      <text>ALG2_U05_L03_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L03_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A2.SYS.4</p><p>Solve y=x&#178; and y=4.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[(-2,4) and (2,4)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Set x&#178;=4, so x=-2 or x=2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(4,16)]]></text>
      <feedback format="html">
        <text><![CDATA[This is on the parabola but not y=4.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(0,4)]]></text>
      <feedback format="html">
        <text><![CDATA[This is on y=4 but not on the parabola.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(2,2)]]></text>
      <feedback format="html">
        <text><![CDATA[This is not on y=4.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L03_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L03_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A2.SYS.4</p><p>Solve y=x&#178; and y=x+2.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[(1,3)]]></text>
      <feedback format="html">
        <text><![CDATA[This point is on the line but not the parabola.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[(-1,1) and (2,4)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Set x&#178;=x+2 and factor x&#178;-x-2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(0,2)]]></text>
      <feedback format="html">
        <text><![CDATA[This point is on the line but not the parabola.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[No solution]]></text>
      <feedback format="html">
        <text><![CDATA[The graphs intersect twice.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L03_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L03_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A2.SYS.4</p><p>If x represents time, which solution should be rejected?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x=0]]></text>
      <feedback format="html">
        <text><![CDATA[Zero time can be meaningful as an initial time.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x=3]]></text>
      <feedback format="html">
        <text><![CDATA[Positive time can be meaningful.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x=-2]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Negative time is not meaningful in this context.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x=8]]></text>
      <feedback format="html">
        <text><![CDATA[Positive time can be meaningful.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L03_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L03_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A2.SYS.4</p><p>What does a solution of a nonlinear system represent graphically?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Only a vertex]]></text>
      <feedback format="html">
        <text><![CDATA[A vertex may or may not be an intersection.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Only a y-intercept]]></text>
      <feedback format="html">
        <text><![CDATA[Intersections can occur anywhere.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A point outside both graphs]]></text>
      <feedback format="html">
        <text><![CDATA[That cannot satisfy both equations.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[An intersection point]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A solution is a point shared by all graphs.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L03_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L03_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A2.SYS.4</p><p>Which point satisfies y=x&#178; and y=2x?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[(0,0) and (2,4)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Set x&#178;=2x, so x=0 or x=2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(1,2)]]></text>
      <feedback format="html">
        <text><![CDATA[This satisfies y=2x but not y=x&#178;.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(2,2)]]></text>
      <feedback format="html">
        <text><![CDATA[This satisfies neither equation fully.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[No solution]]></text>
      <feedback format="html">
        <text><![CDATA[The graphs intersect twice.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>