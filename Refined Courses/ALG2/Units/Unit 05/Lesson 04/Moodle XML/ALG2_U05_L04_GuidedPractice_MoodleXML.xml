<quiz>
  <question type="category">
    <category>
      <text>$course$/ALG2/Units/Unit 05/Lesson 04/ALG2_U05_L04_GuidedPractice</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L04_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L04_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A2.FN.4; MLA.A2.FN.5; MLA.A2.FN.6</p><p>Describe g(x)=f(x)+3.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Shift up 3]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Adding outside changes outputs upward.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Shift down 3]]></text>
      <feedback format="html">
        <text><![CDATA[That would be f(x)-3.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Shift left 3]]></text>
      <feedback format="html">
        <text><![CDATA[Horizontal shifts happen inside the input.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Shift right 3]]></text>
      <feedback format="html">
        <text><![CDATA[That would involve f(x-3).]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L04_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L04_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A2.FN.4; MLA.A2.FN.5; MLA.A2.FN.6</p><p>Describe g(x)=f(x-4).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Shift left 4]]></text>
      <feedback format="html">
        <text><![CDATA[Inside shifts use the opposite sign.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Shift right 4]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Subtracting inside the input shifts the graph right.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Shift up 4]]></text>
      <feedback format="html">
        <text><![CDATA[Vertical shifts occur outside.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Reflect across x-axis]]></text>
      <feedback format="html">
        <text><![CDATA[Reflection would use a negative outside.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L04_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L04_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A2.FN.4; MLA.A2.FN.5; MLA.A2.FN.6</p><p>Describe g(x)=-f(x).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Reflect across the y-axis]]></text>
      <feedback format="html">
        <text><![CDATA[That would be f(-x).]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Shift down 1]]></text>
      <feedback format="html">
        <text><![CDATA[A negative is not a vertical shift.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Reflect across the x-axis]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A negative outside changes output signs.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Shift right 1]]></text>
      <feedback format="html">
        <text><![CDATA[A negative outside is not horizontal.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L04_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L04_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A2.FN.4; MLA.A2.FN.5; MLA.A2.FN.6</p><p>Describe g(x)=f(x+2)-5.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Shift right 2 and down 5]]></text>
      <feedback format="html">
        <text><![CDATA[Inside signs reverse.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Shift left 2 and up 5]]></text>
      <feedback format="html">
        <text><![CDATA[The outside -5 shifts down.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Shift right 5 and down 2]]></text>
      <feedback format="html">
        <text><![CDATA[This mixes the values.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Shift left 2 and down 5]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Adding inside shifts left; subtracting outside shifts down.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L04_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L04_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A2.FN.4; MLA.A2.FN.5; MLA.A2.FN.6</p><p>Which rule shifts f left 6?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[g(x)=f(x+6)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Adding inside shifts left.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[g(x)=f(x-6)]]></text>
      <feedback format="html">
        <text><![CDATA[This shifts right 6.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[g(x)=f(x)+6]]></text>
      <feedback format="html">
        <text><![CDATA[This shifts up 6.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[g(x)=f(x)-6]]></text>
      <feedback format="html">
        <text><![CDATA[This shifts down 6.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>