<quiz>
  <question type="category">
    <category>
      <text>$course$/ALG2/Units/Unit 05/Lesson 01/ALG2_U05_L01_GuidedPractice</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L01_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L01_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A2.SYS.1; MLA.A2.SYS.2</p><p>Solve the system y = x + 3 and y = 2x + 1.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[(2, 5)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Set x + 3 = 2x + 1 to get x = 2, then y = 5.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(1, 4)]]></text>
      <feedback format="html">
        <text><![CDATA[This point satisfies y = x + 3 but not y = 2x + 1.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(3, 6)]]></text>
      <feedback format="html">
        <text><![CDATA[This point satisfies y = x + 3 but not the second equation.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(2, 4)]]></text>
      <feedback format="html">
        <text><![CDATA[The x-value is correct, but y should be 5.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L01_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L01_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A2.SYS.1; MLA.A2.SYS.2</p><p>Which point solves 2x + y = 7 and x - y = 2?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[(1, 3)]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the coordinates and fails the second equation.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[(3, 1)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Substituting gives 2(3)+1=7 and 3-1=2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(2, 3)]]></text>
      <feedback format="html">
        <text><![CDATA[This satisfies neither equation completely.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(4, -1)]]></text>
      <feedback format="html">
        <text><![CDATA[This satisfies x - y = 5, not 2.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L01_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L01_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A2.SYS.1; MLA.A2.SYS.2</p><p>Solve y = x&#178; and y = 4.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[(4, 16)]]></text>
      <feedback format="html">
        <text><![CDATA[This point is on y = x&#178; but not y = 4.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(0, 4)]]></text>
      <feedback format="html">
        <text><![CDATA[This is on y = 4 but not y = x&#178;.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[(-2, 4) and (2, 4)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Set x&#178; = 4, so x = -2 or x = 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(2, 2)]]></text>
      <feedback format="html">
        <text><![CDATA[This point is not on either equation as stated.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L01_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L01_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A2.SYS.1; MLA.A2.SYS.2</p><p>What does an intersection point of two graphs represent in a system?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[A point that satisfies only the first equation]]></text>
      <feedback format="html">
        <text><![CDATA[A system solution must satisfy every equation.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The y-intercept of both graphs]]></text>
      <feedback format="html">
        <text><![CDATA[Intersections are not always y-intercepts.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A point where neither equation is true]]></text>
      <feedback format="html">
        <text><![CDATA[That cannot be a system solution.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[A point that satisfies both equations]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. At an intersection, both equations have the same x- and y-values.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L01_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L01_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A2.SYS.1; MLA.A2.SYS.2</p><p>Solve y = x + 1 and y = x&#178; - 1.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[(-1, 0) and (2, 3)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Set x + 1 = x&#178; - 1, so x&#178; - x - 2 = 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(0, 1) and (1, 0)]]></text>
      <feedback format="html">
        <text><![CDATA[These points do not satisfy both equations.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(1, 2) only]]></text>
      <feedback format="html">
        <text><![CDATA[This point satisfies y = x + 1 but not the quadratic.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[No solution]]></text>
      <feedback format="html">
        <text><![CDATA[The line and parabola intersect twice.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>