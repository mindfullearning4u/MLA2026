  <question type="multichoice">
    <name>
      <text>ALG2_U05_L01_Q07</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L01_Q07</p><p><strong>MLA Standard:</strong> MLA.A2.SYS.1; MLA.A2.SYS.2</p><p>How many solutions can a line and a parabola have?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Always 1]]></text>
      <feedback format="html">
        <text><![CDATA[A line can intersect a parabola in different ways.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Always 2]]></text>
      <feedback format="html">
        <text><![CDATA[Tangency or no intersection are possible.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[0, 1, or 2]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A line can miss, touch, or cross a parabola twice.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Exactly 0]]></text>
      <feedback format="html">
        <text><![CDATA[Intersections can occur.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L01_Q08</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L01_Q08</p><p><strong>MLA Standard:</strong> MLA.A2.SYS.1; MLA.A2.SYS.2</p><p>What must be true for (a,b) to solve a system?</p>]]></text>
