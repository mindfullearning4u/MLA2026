    <name>
      <text>ALG2_U05_L01_Q16</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L01_Q16</p><p><strong>MLA Standard:</strong> MLA.A2.SYS.1; MLA.A2.SYS.2</p><p>What does a solution mean in a revenue-cost system?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The maximum revenue always]]></text>
      <feedback format="html">
        <text><![CDATA[Intersections do not always indicate maxima.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The cost y-intercept only]]></text>
      <feedback format="html">
        <text><![CDATA[A solution is not only an intercept.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A point that satisfies neither model]]></text>
      <feedback format="html">
        <text><![CDATA[That is not a system solution.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The break-even point where revenue equals cost]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. At the intersection, the two modeled quantities are equal.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L01_Q17</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L01_Q17</p><p><strong>MLA Standard:</strong> MLA.A2.SYS.1; MLA.A2.SYS.2</p><p>Solve x+y=8 and y=2x-1.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[(3,5)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Substitute y=2x-1 into x+y=8 to get 3x=9.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(5,3)]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses coordinates and fails y=2x-1.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(2,6)]]></text>
      <feedback format="html">
        <text><![CDATA[This satisfies x+y=8 but not y=2x-1.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(4,4)]]></text>
      <feedback format="html">
        <text><![CDATA[This fails y=2x-1.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L01_Q18</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L01_Q18</p><p><strong>MLA Standard:</strong> MLA.A2.SYS.1; MLA.A2.SYS.2</p><p>Solve y=3x and y=x&#178;.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[(1,3)]]></text>
      <feedback format="html">
        <text><![CDATA[This is on y=3x but not the parabola.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[(0,0) and (3,9)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Set 3x=x&#178;, so x(x-3)=0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(3,3)]]></text>
      <feedback format="html">
        <text><![CDATA[This is not on y=3x.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[No solution]]></text>
      <feedback format="html">
        <text><![CDATA[The graphs intersect at two points.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L01_Q19</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L01_Q19</p><p><strong>MLA Standard:</strong> MLA.A2.SYS.1; MLA.A2.SYS.2</p><p>Which point solves y=x+5 and y=2x+1?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[(9,4)]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses coordinates.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(1,6)]]></text>
      <feedback format="html">
        <text><![CDATA[This satisfies first equation only.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[(4,9)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Set x+5=2x+1, so x=4 and y=9.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(5,10)]]></text>
      <feedback format="html">
        <text><![CDATA[This fails the second equation.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L01_Q20</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L01_Q20</p><p><strong>MLA Standard:</strong> MLA.A2.SYS.1; MLA.A2.SYS.2</p><p>Solve 3x+y=10 and x-y=2.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[(1,3)]]></text>
      <feedback format="html">
        <text><![CDATA[This fails x-y=2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(2,4)]]></text>
      <feedback format="html">
        <text><![CDATA[This fails both equations.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(4,-1)]]></text>
      <feedback format="html">
        <text><![CDATA[This fails 3x+y=10.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[(3,1)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. From x-y=2, y=x-2; substitute to get 4x-2=10.]]></text>
      </feedback>
    </answer>
  </question>
