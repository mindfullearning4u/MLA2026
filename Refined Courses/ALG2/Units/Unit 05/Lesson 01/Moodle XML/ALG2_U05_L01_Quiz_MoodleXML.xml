      <text>ALG2_U05_L01_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L01_Q01</p><p><strong>MLA Standard:</strong> MLA.A2.SYS.1; MLA.A2.SYS.2</p><p>Solve y=x+2 and y=3x-2.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[(2,4)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Set x+2=3x-2, so x=2 and y=4.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(1,3)]]></text>
      <feedback format="html">
        <text><![CDATA[This satisfies the first equation but not the second.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(2,2)]]></text>
      <feedback format="html">
        <text><![CDATA[This has the correct x but wrong y.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(4,2)]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the relationship.]]></text>
      </feedback>
    </answer>
  </question>
