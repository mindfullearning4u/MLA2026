    <answer fraction="0" format="html">
      <text><![CDATA[It satisfies at least one equation.]]></text>
      <feedback format="html">
        <text><![CDATA[One equation is not enough.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It is always an x-intercept.]]></text>
      <feedback format="html">
        <text><![CDATA[System solutions are not always x-intercepts.]]></text>
