<quiz>
  <question type="category">
    <category>
      <text>$course$/ALG2/Units/Unit 05/Lesson 06/ALG2_U05_L06_GuidedPractice</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L06_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L06_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A2.FN.9; MLA.A2.FN.10</p><p>Find the inverse of f(x)=x+4.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[f⁻&#185;(x)=x-4]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Subtract 4 to undo adding 4.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[f⁻&#185;(x)=x+4]]></text>
      <feedback format="html">
        <text><![CDATA[This does not undo the original function.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[f⁻&#185;(x)=1/(x+4)]]></text>
      <feedback format="html">
        <text><![CDATA[Inverse function does not mean reciprocal.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[f⁻&#185;(x)=4x]]></text>
      <feedback format="html">
        <text><![CDATA[This does not undo adding 4.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L06_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L06_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A2.FN.9; MLA.A2.FN.10</p><p>Find the inverse of f(x)=2x.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[f⁻&#185;(x)=2x]]></text>
      <feedback format="html">
        <text><![CDATA[This repeats the original function.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[f⁻&#185;(x)=x/2]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Divide by 2 to undo multiplying by 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[f⁻&#185;(x)=x-2]]></text>
      <feedback format="html">
        <text><![CDATA[This undoes adding 2, not multiplying by 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[f⁻&#185;(x)=1/(2x)]]></text>
      <feedback format="html">
        <text><![CDATA[This is a reciprocal, not inverse function.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L06_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L06_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A2.FN.9; MLA.A2.FN.10</p><p>Find the inverse of f(x)=3x+6.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[f⁻&#185;(x)=3x-6]]></text>
      <feedback format="html">
        <text><![CDATA[This does not undo both operations.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[f⁻&#185;(x)=(x+6)/3]]></text>
      <feedback format="html">
        <text><![CDATA[The sign on 6 is wrong.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[f⁻&#185;(x)=(x-6)/3]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Switch x and y, then solve for y.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[f⁻&#185;(x)=1/(3x+6)]]></text>
      <feedback format="html">
        <text><![CDATA[Inverse notation is not reciprocal.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L06_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L06_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A2.FN.9; MLA.A2.FN.10</p><p>Which check verifies inverses?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[f(x)+g(x)=x]]></text>
      <feedback format="html">
        <text><![CDATA[Addition is not the inverse check.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[f(x)g(x)=1]]></text>
      <feedback format="html">
        <text><![CDATA[That checks reciprocals in special cases, not inverse functions.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[f(x)=g(x)]]></text>
      <feedback format="html">
        <text><![CDATA[Inverse functions usually are not identical.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[f(g(x))=x and g(f(x))=x]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Both compositions must return the original input.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U05_L06_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U05_L06_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A2.FN.9; MLA.A2.FN.10</p><p>What does f⁻&#185;(x) mean?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[The inverse function of f]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. It reverses the input-output relationship of f.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The reciprocal of f(x)]]></text>
      <feedback format="html">
        <text><![CDATA[That would be 1/f(x).]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The negative of f(x)]]></text>
      <feedback format="html">
        <text><![CDATA[That would be -f(x).]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The derivative of f]]></text>
      <feedback format="html">
        <text><![CDATA[Derivative notation is different.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>