  <question type="multichoice">
    <name>
      <text>ALG2_U02_L08_GP01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U02_L08_GP01</p><p><strong>MLA Standard:</strong> MLA.A2.PF.8</p><p>Which polynomial has both ends rising?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[f(x) = 2x⁴ - x + 1]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Even degree and positive leading coefficient make both ends rise.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[f(x) = -2x⁴ + 1]]></text>
      <feedback format="html">
        <text><![CDATA[Even degree with a negative leading coefficient makes both ends fall.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[f(x) = x&#179; - 1]]></text>
      <feedback format="html">
        <text><![CDATA[Odd degree has opposite end behavior.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[f(x) = -x&#179; + 1]]></text>
      <feedback format="html">
        <text><![CDATA[Odd degree has opposite end behavior.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U02_L08_GP02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U02_L08_GP02</p><p><strong>MLA Standard:</strong> Support-only review; no new primary MLA standard</p><p>What does an even multiplicity zero usually do on a graph?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The graph crosses the x-axis.]]></text>
      <feedback format="html">
        <text><![CDATA[Crossing is typical of odd multiplicity.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The graph touches and turns at the x-axis.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Even multiplicity commonly causes a bounce.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The graph has no x-intercept.]]></text>
      <feedback format="html">
        <text><![CDATA[A zero is an x-intercept when it is real.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The graph becomes linear.]]></text>
      <feedback format="html">
        <text><![CDATA[Multiplicity does not make the whole graph linear.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U02_L08_GP03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U02_L08_GP03</p><p><strong>MLA Standard:</strong> MLA.A2.PF.4</p><p>A quadratic model has vertex (3, -5) and opens upward. What is the minimum value?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[3]]></text>
      <feedback format="html">
        <text><![CDATA[The x-coordinate gives where the minimum occurs.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[-3]]></text>
      <feedback format="html">
        <text><![CDATA[This is not the y-value of the vertex.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[-5]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The y-coordinate of the vertex is the minimum value.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[5]]></text>
      <feedback format="html">
        <text><![CDATA[The sign of the y-value matters.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U02_L08_GP04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U02_L08_GP04</p><p><strong>MLA Standard:</strong> MLA.A2.PF.2</p><p>Which interval solves x&#178; - 4 &gt;= 0?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[-2 &lt;= x &lt;= 2]]></text>
      <feedback format="html">
        <text><![CDATA[That is where the graph is on or below the x-axis.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[-2 &lt; x &lt; 2]]></text>
      <feedback format="html">
        <text><![CDATA[This interval excludes zeros and has the wrong sign.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[all real numbers]]></text>
      <feedback format="html">
        <text><![CDATA[The graph is negative between the zeros.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x &lt;= -2 or x &gt;= 2]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The graph is on or above the x-axis outside the zeros.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U02_L08_GP05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U02_L08_GP05</p><p><strong>MLA Standard:</strong> Support-only application; no new primary MLA standard</p><p>A polynomial model has an x-intercept at 6 hours. What can that mean in context?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The model is always increasing after 6 hours.]]></text>
      <feedback format="html">
        <text><![CDATA[An intercept does not guarantee increasing behavior.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The output quantity is 0 at 6 hours.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. An x-intercept means the function value is 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The maximum value is 6.]]></text>
      <feedback format="html">
        <text><![CDATA[An x-intercept is not necessarily a maximum.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The leading coefficient is 6.]]></text>
      <feedback format="html">
        <text><![CDATA[An intercept does not identify the leading coefficient.]]></text>
      </feedback>
    </answer>
  </question>
