  <question type="multichoice">
    <name>
      <text>ALG2_U02_L03_GP01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U02_L03_GP01</p><p><strong>MLA Standard:</strong> MLA.A2.PF.8</p><p>What is the end behavior of f(x) = x⁴ - 3x + 1?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[both ends rise]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Even degree with positive leading coefficient means both ends rise.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[both ends fall]]></text>
      <feedback format="html">
        <text><![CDATA[This would require a negative leading coefficient.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[left falls, right rises]]></text>
      <feedback format="html">
        <text><![CDATA[This is odd positive behavior.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[left rises, right falls]]></text>
      <feedback format="html">
        <text><![CDATA[This is odd negative behavior.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U02_L03_GP02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U02_L03_GP02</p><p><strong>MLA Standard:</strong> MLA.A2.PF.8</p><p>What is the end behavior of f(x) = -x&#179; + 2x?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[both ends rise]]></text>
      <feedback format="html">
        <text><![CDATA[Odd degree has opposite end behavior.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[left falls, right rises]]></text>
      <feedback format="html">
        <text><![CDATA[This is positive odd behavior.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[left rises, right falls]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Odd degree with negative leading coefficient rises left and falls right.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[both ends fall]]></text>
      <feedback format="html">
        <text><![CDATA[Even negative behavior falls both ends.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U02_L03_GP03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U02_L03_GP03</p><p><strong>MLA Standard:</strong> MLA.A2.PF.8</p><p>Which feature controls end behavior most directly?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[constant term]]></text>
      <feedback format="html">
        <text><![CDATA[The constant term does not control long-run behavior.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[degree and leading coefficient]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The leading term dominates for large x-values.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y-intercept]]></text>
      <feedback format="html">
        <text><![CDATA[The y-intercept is local information.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[middle term]]></text>
      <feedback format="html">
        <text><![CDATA[Middle terms do not dominate end behavior.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U02_L03_GP04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U02_L03_GP04</p><p><strong>MLA Standard:</strong> MLA.A2.PF.8</p><p>For f(x) = 5x⁷ - 4, what happens as x increases without bound?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[f(x) decreases without bound]]></text>
      <feedback format="html">
        <text><![CDATA[Positive odd degree rises right.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[f(x) approaches -4]]></text>
      <feedback format="html">
        <text><![CDATA[The constant term does not control end behavior.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[f(x) stays constant]]></text>
      <feedback format="html">
        <text><![CDATA[The function is not constant.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[f(x) increases without bound]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Positive odd degree rises to the right.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U02_L03_GP05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U02_L03_GP05</p><p><strong>MLA Standard:</strong> MLA.A2.PF.8</p><p>For f(x) = -2x⁸ + x, what happens on both ends?</p>]]></text>
