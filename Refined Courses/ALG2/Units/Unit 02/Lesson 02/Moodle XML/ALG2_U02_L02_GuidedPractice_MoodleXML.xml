  <question type="multichoice">
    <name>
      <text>ALG2_U02_L02_GP01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U02_L02_GP01</p><p><strong>MLA Standard:</strong> MLA.A2.PF.4</p><p>What is the vertex of f(x) = (x - 4)&#178; - 9?</p><p><img src="@@PLUGINFILE@@/ALG2_U02_L02_GP01_graph.png" alt="Parabola graph supports quadratic, vertex, zero, boundary, or shading interpretation." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="ALG2_U02_L02_GP01_graph.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[(4, -9)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Vertex form gives (4, -9).]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(-4, -9)]]></text>
      <feedback format="html">
        <text><![CDATA[The sign is reversed.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(4, 9)]]></text>
      <feedback format="html">
        <text><![CDATA[The k-value should be -9.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(-9, 4)]]></text>
      <feedback format="html">
        <text><![CDATA[Coordinates are reversed.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U02_L02_GP02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U02_L02_GP02</p><p><strong>MLA Standard:</strong> MLA.A2.PF.4</p><p>What is the axis of symmetry for f(x) = (x + 2)&#178; + 5?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 2]]></text>
      <feedback format="html">
        <text><![CDATA[The sign is reversed.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y = -2]]></text>
      <feedback format="html">
        <text><![CDATA[The axis is vertical.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x = -2]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The vertex x-coordinate is -2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y = 5]]></text>
      <feedback format="html">
        <text><![CDATA[This is not the axis.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U02_L02_GP03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U02_L02_GP03</p><p><strong>MLA Standard:</strong> MLA.A2.PF.4</p><p>For h(t) = -16(t - 3)&#178; + 144, what is the maximum height?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[3]]></text>
      <feedback format="html">
        <text><![CDATA[This is the time.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[144]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The maximum output is 144.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[-16]]></text>
      <feedback format="html">
        <text><![CDATA[This is the leading factor.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[0]]></text>
      <feedback format="html">
        <text><![CDATA[The maximum is not 0.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U02_L02_GP04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U02_L02_GP04</p><p><strong>MLA Standard:</strong> MLA.A2.PF.4</p><p>If f(x) = x&#178; - 6x + 8, what are the x-intercepts?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[(-2, 0) and (-4, 0)]]></text>
      <feedback format="html">
        <text><![CDATA[Signs are reversed.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(0, 2) and (0, 4)]]></text>
      <feedback format="html">
        <text><![CDATA[These are y-axis points.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(6, 0) and (8, 0)]]></text>
      <feedback format="html">
        <text><![CDATA[These are coefficients.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[(2, 0) and (4, 0)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Zeros are 2 and 4.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U02_L02_GP05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U02_L02_GP05</p><p><strong>MLA Standard:</strong> MLA.A2.PF.4</p><p>For a projectile that starts at t = 0 and lands at t = 5, what domain is meaningful?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[all real numbers]]></text>
      <feedback format="html">
        <text><![CDATA[Context restricts time.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[0 &lt;= t &lt;= 5]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Launch to landing.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[t &gt;= 5]]></text>
      <feedback format="html">
        <text><![CDATA[This excludes the flight.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[t &lt;= 0]]></text>
      <feedback format="html">
        <text><![CDATA[This excludes most of the flight.]]></text>
      </feedback>
    </answer>
  </question>
