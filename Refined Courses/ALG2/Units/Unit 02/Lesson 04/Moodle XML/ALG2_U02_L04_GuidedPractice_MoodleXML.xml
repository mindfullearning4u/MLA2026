  <question type="multichoice">
    <name>
      <text>ALG2_U02_L04_GP01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U02_L04_GP01</p><p><strong>MLA Standard:</strong> Support-only review; no new primary MLA standard</p><p>What are the zeros of f(x) = (x - 5)(x + 1)?</p><p><img src="@@PLUGINFILE@@/ALG2_U02_L04_GP01_graph.png" alt="Parabola graph supports quadratic, vertex, zero, boundary, or shading interpretation." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="ALG2_U02_L04_GP01_graph.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[x = 5 and x = -1]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Set each factor equal to 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -5 and x = 1]]></text>
      <feedback format="html">
        <text><![CDATA[The signs are reversed.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 0 and x = 5]]></text>
      <feedback format="html">
        <text><![CDATA[x = 0 is not a zero here.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 5 and x = 1]]></text>
      <feedback format="html">
        <text><![CDATA[Only x = 5 is correct.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U02_L04_GP02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U02_L04_GP02</p><p><strong>MLA Standard:</strong> Support-only review; no new primary MLA standard</p><p>What is the multiplicity of x = 3 in f(x) = (x - 3)&#178;(x + 4)?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[1]]></text>
      <feedback format="html">
        <text><![CDATA[The exponent on the factor is not 1.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[3]]></text>
      <feedback format="html">
        <text><![CDATA[This is the zero value, not the multiplicity.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[2]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The factor x - 3 is repeated twice.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4]]></text>
      <feedback format="html">
        <text><![CDATA[The other factor does not change this multiplicity.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U02_L04_GP03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U02_L04_GP03</p><p><strong>MLA Standard:</strong> Support-only review; no new primary MLA standard</p><p>At a zero with even multiplicity, what does the graph usually do?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[crosses the x-axis]]></text>
      <feedback format="html">
        <text><![CDATA[That is typical of odd multiplicity.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[touches and turns around]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Even multiplicity usually touches and turns.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[has no x-intercept]]></text>
      <feedback format="html">
        <text><![CDATA[It is still an x-intercept.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[becomes the y-intercept]]></text>
      <feedback format="html">
        <text><![CDATA[The zero remains an x-intercept.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U02_L04_GP04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U02_L04_GP04</p><p><strong>MLA Standard:</strong> Support-only review; no new primary MLA standard</p><p>At a zero with odd multiplicity, what does the graph usually do?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[touches only]]></text>
      <feedback format="html">
        <text><![CDATA[This is typical of even multiplicity.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[turns before the axis]]></text>
      <feedback format="html">
        <text><![CDATA[Odd multiplicity crosses the axis.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[stays above the axis]]></text>
      <feedback format="html">
        <text><![CDATA[This is not guaranteed.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[crosses the x-axis]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Odd multiplicity usually crosses.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U02_L04_GP05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U02_L04_GP05</p><p><strong>MLA Standard:</strong> Support-only review; no new primary MLA standard</p><p>Which zero comes from the factor x + 6?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 6]]></text>
      <feedback format="html">
        <text><![CDATA[The sign is reversed.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x = -6]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. x + 6 = 0 gives x = -6.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 0]]></text>
      <feedback format="html">
        <text><![CDATA[This does not make x + 6 equal 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 1]]></text>
      <feedback format="html">
        <text><![CDATA[This does not make x + 6 equal 0.]]></text>
      </feedback>
    </answer>
  </question>
