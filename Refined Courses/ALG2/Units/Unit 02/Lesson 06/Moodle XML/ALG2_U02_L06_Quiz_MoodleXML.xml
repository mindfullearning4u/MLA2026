    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U02_L06_Q16</p><p><strong>MLA Standard:</strong> Support-only application; no new primary MLA standard</p><p>If R(x) - C(x) = 0 in a business model, what does that represent?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[maximum loss]]></text>
      <feedback format="html">
        <text><![CDATA[A zero difference is not a maximum loss.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[initial cost]]></text>
      <feedback format="html">
        <text><![CDATA[Initial cost is C(0).]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[domain restriction]]></text>
      <feedback format="html">
        <text><![CDATA[The equation describes equality, not domain.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[break-even]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Revenue minus cost equal to 0 means profit is 0.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
