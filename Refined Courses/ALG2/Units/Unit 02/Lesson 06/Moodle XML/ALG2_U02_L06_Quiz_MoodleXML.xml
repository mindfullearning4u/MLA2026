    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[the greatest revenue amount]]></text>
      <feedback format="html">
        <text><![CDATA[The y-coordinate gives the maximum revenue.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[a zero of the model]]></text>
