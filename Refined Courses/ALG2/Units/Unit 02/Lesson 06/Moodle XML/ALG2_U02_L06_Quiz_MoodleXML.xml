    <answer fraction="0" format="html">
      <text><![CDATA[the initial temperature always]]></text>
      <feedback format="html">
        <text><![CDATA[Initial temperature is T(0).]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
