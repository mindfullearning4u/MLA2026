    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[lengths cannot be negative]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A physical length must be zero or positive.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[negative numbers are never solutions]]></text>
      <feedback format="html">
        <text><![CDATA[Negative numbers can solve equations.]]></text>
      </feedback>
    </answer>
