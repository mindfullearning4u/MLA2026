  <question type="multichoice">
    <name>
      <text>ALG2_U02_L06_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U02_L06_Q01</p><p><strong>MLA Standard:</strong> Support-only application; no new primary MLA standard</p><p>A polynomial height model has H(0) = 6. What does 6 represent?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[the initial height]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. H(0) is the output at time 0, so it represents the starting height.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[the landing time]]></text>
      <feedback format="html">
        <text><![CDATA[Landing time is usually a zero.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[the maximum height]]></text>
      <feedback format="html">
        <text><![CDATA[A maximum is a vertex or peak value.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[the degree]]></text>
      <feedback format="html">
        <text><![CDATA[Function output does not identify degree.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U02_L06_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U02_L06_Q02</p><p><strong>MLA Standard:</strong> Support-only application; no new primary MLA standard</p><p>If P(t) models profit and P(t) = 0, what does t represent?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[maximum profit]]></text>
      <feedback format="html">
        <text><![CDATA[Maximum profit occurs at a peak.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[a break-even time]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Profit equal to zero means revenue and cost are equal.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[initial profit]]></text>
      <feedback format="html">
        <text><![CDATA[Initial profit is P(0).]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[the degree of the model]]></text>
      <feedback format="html">
        <text><![CDATA[The input t does not identify degree.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U02_L06_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U02_L06_Q03</p><p><strong>MLA Standard:</strong> Support-only application; no new primary MLA standard</p><p>A ball height model has zeros at t = 0 and t = 5. What is a reasonable domain?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[all real numbers]]></text>
      <feedback format="html">
        <text><![CDATA[Negative time and time after landing may not fit.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[t &lt; 0]]></text>
      <feedback format="html">
        <text><![CDATA[Negative time is not meaningful.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[0 &lt;= t &lt;= 5]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The model is physically meaningful from launch until landing.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[t &gt;= 5 only]]></text>
      <feedback format="html">
        <text><![CDATA[That begins at landing.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U02_L06_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U02_L06_Q04</p><p><strong>MLA Standard:</strong> Support-only application; no new primary MLA standard</p><p>A revenue model reaches a maximum at x = 40. What does x = 40 represent?</p>]]></text>
