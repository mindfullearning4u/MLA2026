    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U02_L06_GP04</p><p><strong>MLA Standard:</strong> Support-only application; no new primary MLA standard</p><p>If P(x) models profit, what does P(x) = 0 represent?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[maximum loss]]></text>
      <feedback format="html">
        <text><![CDATA[A maximum loss would be a minimum value.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[domain restriction]]></text>
      <feedback format="html">
        <text><![CDATA[A domain restriction limits inputs.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[negative profit]]></text>
      <feedback format="html">
        <text><![CDATA[Negative profit is below zero.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[break-even point]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Profit of 0 is break-even.]]></text>
      </feedback>
    </answer>
