<?xml version="1.0" encoding="utf-8"?>
<quiz>
  <question type="category">
    <category>
      <text>$course$/ALG2/Units/Unit 06/Lesson 05/ALG2_U06_L05_Quiz</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L05_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L05_Q01</p><p><strong>MLA Standard:</strong> MLA.A2.FN.2</p><p>Which model type fits data with a constant difference?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[linear]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A constant difference means a constant rate of change.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[exponential]]></text>
      <feedback format="html">
        <text><![CDATA[Exponential models use a constant ratio or percent change.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[quadratic]]></text>
      <feedback format="html">
        <text><![CDATA[Quadratic models have changing first differences.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[rational]]></text>
      <feedback format="html">
        <text><![CDATA[Rational models often involve denominator behavior and asymptotes.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L05_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L05_Q02</p><p><strong>MLA Standard:</strong> MLA.A2.FN.2</p><p>Which model type fits data with a constant ratio?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[linear]]></text>
      <feedback format="html">
        <text><![CDATA[Linear models use a constant difference.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[exponential]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A constant ratio indicates repeated multiplication.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[absolute value]]></text>
      <feedback format="html">
        <text><![CDATA[Absolute value models have a V-shaped graph, not a repeated ratio.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[constant]]></text>
      <feedback format="html">
        <text><![CDATA[A constant model has no changing ratio between distinct nonzero values.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L05_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L05_Q03</p><p><strong>MLA Standard:</strong> MLA.A2.FN.2</p><p>Which model is best for a ball&#39;s height over time when it rises and falls?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[linear]]></text>
      <feedback format="html">
        <text><![CDATA[A linear model cannot represent both rising and falling with one turning point.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[exponential]]></text>
      <feedback format="html">
        <text><![CDATA[Exponential models do not show the parabolic path of projectile height.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[quadratic]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Projectile height is commonly modeled by a quadratic function.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[rational]]></text>
      <feedback format="html">
        <text><![CDATA[A rational model is not the usual model for projectile height.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L05_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L05_Q04</p><p><strong>MLA Standard:</strong> MLA.A2.FN.2</p><p>Which model is best when a cost starts at 50 dollars and increases by 12 dollars per item?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[y=50(1.12)ˣ]]></text>
      <feedback format="html">
        <text><![CDATA[This models percent growth, not fixed dollar increase.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y=12(50)ˣ]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the starting value and creates exponential behavior.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y=50/x+12]]></text>
      <feedback format="html">
        <text><![CDATA[This is rational and does not match fixed added cost.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[y=12x+50]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The slope is 12 and the initial cost is 50.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L05_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L05_Q05</p><p><strong>MLA Standard:</strong> MLA.A2.FN.2</p><p>Which model is best when a population starts at 500 and grows 3% per year?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[P=500(1.03)ᵗ]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The model has initial value 500 and 3% growth.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[P=500+3t]]></text>
      <feedback format="html">
        <text><![CDATA[This adds 3 units per year, not 3%.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[P=3(500)ᵗ]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the starting value and growth information.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[P=500(0.97)ᵗ]]></text>
      <feedback format="html">
        <text><![CDATA[This models 3% decay, not growth.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L05_Q06</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L05_Q06</p><p><strong>MLA Standard:</strong> MLA.A2.FN.2</p><p>Model A has residuals close to 0 with no pattern. What does that suggest?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Model A should be rejected immediately.]]></text>
      <feedback format="html">
        <text><![CDATA[Small random residuals usually support the model.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Model A may be a good fit.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Small residuals without pattern suggest reasonable fit.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Model A has no equation.]]></text>
      <feedback format="html">
        <text><![CDATA[Residuals do not determine whether an equation exists.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Model A must be quadratic.]]></text>
      <feedback format="html">
        <text><![CDATA[Residuals alone do not force a quadratic model.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L05_Q07</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L05_Q07</p><p><strong>MLA Standard:</strong> MLA.A2.FN.2</p><p>Model A has curved residuals after a linear regression. What should you consider?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Keep the linear model because residuals never matter.]]></text>
      <feedback format="html">
        <text><![CDATA[Residual patterns are important for judging fit.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Use the model with the largest prediction instead.]]></text>
      <feedback format="html">
        <text><![CDATA[Largest output is not evidence of fit.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Try a nonlinear model.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Curved residuals suggest a linear model may be missing structure.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Remove all data points.]]></text>
      <feedback format="html">
        <text><![CDATA[Removing data without reason is not a valid model comparison step.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L05_Q08</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L05_Q08</p><p><strong>MLA Standard:</strong> MLA.A2.FN.2</p><p>Which comparison uses context correctly?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The larger equation is better because it has more symbols.]]></text>
      <feedback format="html">
        <text><![CDATA[Equation length does not prove model quality.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The model with the biggest prediction is always best.]]></text>
      <feedback format="html">
        <text><![CDATA[A larger prediction may be unreasonable.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Units and constraints do not affect model choice.]]></text>
      <feedback format="html">
        <text><![CDATA[Units and constraints are part of context.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The model should match the data pattern and the real situation.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Both mathematical fit and context matter.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L05_Q09</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L05_Q09</p><p><strong>MLA Standard:</strong> MLA.A2.FN.2</p><p>Which model has a horizontal asymptote and may fit data that levels off?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[rational or logistic-style model]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Leveling behavior often requires a model with limiting behavior.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[linear model]]></text>
      <feedback format="html">
        <text><![CDATA[Linear models keep increasing or decreasing at a constant rate.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[simple exponential growth]]></text>
      <feedback format="html">
        <text><![CDATA[Exponential growth does not level off on its own.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[quadratic model]]></text>
      <feedback format="html">
        <text><![CDATA[Quadratic models eventually rise or fall without leveling off.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L05_Q10</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L05_Q10</p><p><strong>MLA Standard:</strong> MLA.A2.FN.2</p><p>A value halves each week. Which model form matches the context?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[y=a-0.5x]]></text>
      <feedback format="html">
        <text><![CDATA[This subtracts a fixed amount, not halves repeatedly.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[y=a(0.5)ˣ]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Halving each week is repeated multiplication by 0.5.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y=ax&#178;]]></text>
      <feedback format="html">
        <text><![CDATA[A quadratic model does not represent repeated halving.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y=a/x]]></text>
      <feedback format="html">
        <text><![CDATA[A reciprocal model is not the same as halving each equal time step.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L05_Q11</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L05_Q11</p><p><strong>MLA Standard:</strong> MLA.A2.FN.2</p><p>A model must predict the number of people. Which constraint matters most?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Outputs can be any negative decimal.]]></text>
      <feedback format="html">
        <text><![CDATA[People cannot be negative decimals in this context.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Inputs must always be negative.]]></text>
      <feedback format="html">
        <text><![CDATA[The context determines inputs; they are not always negative.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Outputs should be nonnegative whole numbers when counting people.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Counts of people require nonnegative whole-number interpretations.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Units do not matter for people.]]></text>
      <feedback format="html">
        <text><![CDATA[Units are essential for interpreting the output.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L05_Q12</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L05_Q12</p><p><strong>MLA Standard:</strong> MLA.A2.FN.2</p><p>Which is strongest evidence that a model is inappropriate?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[It uses variables.]]></text>
      <feedback format="html">
        <text><![CDATA[Variables are normal in models.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It has a decimal coefficient.]]></text>
      <feedback format="html">
        <text><![CDATA[Decimal coefficients can be meaningful.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It has a graph.]]></text>
      <feedback format="html">
        <text><![CDATA[Graphs are useful model representations.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[It predicts negative distance in a context where distance cannot be negative.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Predictions that violate context show a model limitation.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L05_Q13</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L05_Q13</p><p><strong>MLA Standard:</strong> MLA.A2.FN.2</p><p>Which model best matches fixed monthly savings of 75 dollars after an initial 200 dollars?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[S=200+75m]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Fixed monthly saving creates a linear model.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[S=200(1.75)ᵐ]]></text>
      <feedback format="html">
        <text><![CDATA[This models 75% growth each month.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[S=75(200)ᵐ]]></text>
      <feedback format="html">
        <text><![CDATA[This creates exponential behavior and reverses quantities.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[S=200/m+75]]></text>
      <feedback format="html">
        <text><![CDATA[This is rational and does not match fixed saving.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L05_Q14</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L05_Q14</p><p><strong>MLA Standard:</strong> MLA.A2.FN.2</p><p>Which model best matches a car losing 15% of its value each year?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[V=15000-15t]]></text>
      <feedback format="html">
        <text><![CDATA[This subtracts 15 dollars per year, not 15%.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[V=15000(0.85)ᵗ]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Losing 15% leaves 85% each year.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[V=15000(1.15)ᵗ]]></text>
      <feedback format="html">
        <text><![CDATA[This models 15% growth.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[V=15000/t]]></text>
      <feedback format="html">
        <text><![CDATA[This rational model does not describe annual percent depreciation.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L05_Q15</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L05_Q15</p><p><strong>MLA Standard:</strong> MLA.A2.FN.2</p><p>When comparing models from a graph, which feature is most useful?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Font size of labels]]></text>
      <feedback format="html">
        <text><![CDATA[Formatting does not determine model fit.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Color of the grid]]></text>
      <feedback format="html">
        <text><![CDATA[Grid color is not mathematical evidence.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Shape and trend of the data]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Shape and trend help identify model type.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Order of the answer choices]]></text>
      <feedback format="html">
        <text><![CDATA[Answer order has no connection to model fit.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L05_Q16</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L05_Q16</p><p><strong>MLA Standard:</strong> MLA.A2.FN.2</p><p>Which prediction is usually more reliable?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Far outside the data range]]></text>
      <feedback format="html">
        <text><![CDATA[Far extrapolation is usually less reliable.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[From a model that ignores context]]></text>
      <feedback format="html">
        <text><![CDATA[Ignoring context weakens predictions.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[From a model with patterned residuals]]></text>
      <feedback format="html">
        <text><![CDATA[Patterned residuals suggest poor fit.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Inside the data range with small residuals]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Interpolation with small residuals is generally more reliable.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L05_Q17</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L05_Q17</p><p><strong>MLA Standard:</strong> MLA.A2.FN.2</p><p>Which residual list shows the better fit?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[-1, 0, 2, -1]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. These residuals are close to 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[-12, 8, 10, -9]]></text>
      <feedback format="html">
        <text><![CDATA[These residuals are much farther from 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[25, 30, 35, 40]]></text>
      <feedback format="html">
        <text><![CDATA[These are large positive errors, not close fits.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[-20, -20, -20, -20]]></text>
      <feedback format="html">
        <text><![CDATA[These show consistent underprediction by a large amount.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L05_Q18</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L05_Q18</p><p><strong>MLA Standard:</strong> MLA.A2.FN.2</p><p>Which question should be asked before trusting an extrapolated prediction?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Is the prediction larger than all other answers?]]></text>
      <feedback format="html">
        <text><![CDATA[Size alone does not make a prediction trustworthy.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Is it reasonable to assume the pattern continues beyond the data?]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Extrapolation depends on whether the pattern can continue.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Does the equation have at least two variables?]]></text>
      <feedback format="html">
        <text><![CDATA[Variable count is not the key issue.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Can units be ignored?]]></text>
      <feedback format="html">
        <text><![CDATA[Units should not be ignored in model interpretation.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L05_Q19</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L05_Q19</p><p><strong>MLA Standard:</strong> MLA.A2.FN.2</p><p>Which model best matches a relationship with one turning point?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[linear]]></text>
      <feedback format="html">
        <text><![CDATA[Linear models do not have turning points.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[exponential]]></text>
      <feedback format="html">
        <text><![CDATA[Basic exponential models do not turn around.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[quadratic]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Quadratic models have one turning point.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[constant]]></text>
      <feedback format="html">
        <text><![CDATA[Constant models stay flat and do not turn.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L05_Q20</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L05_Q20</p><p><strong>MLA Standard:</strong> MLA.A2.FN.2</p><p>Which model best matches inverse variation?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[y=mx+b]]></text>
      <feedback format="html">
        <text><![CDATA[This is linear because it has a constant rate of change.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y=a(b)ˣ]]></text>
      <feedback format="html">
        <text><![CDATA[This is exponential because the input appears in the exponent.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y=ax&#178;]]></text>
      <feedback format="html">
        <text><![CDATA[This is quadratic because the input is squared, not divided into a constant.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[y=k/x]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Inverse variation is modeled by y=k/x.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>