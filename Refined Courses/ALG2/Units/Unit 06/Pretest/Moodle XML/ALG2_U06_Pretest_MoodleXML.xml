<?xml version='1.0' encoding='utf-8'?>
<quiz>
  <question type="category">
    <category>
      <text>$course$/ALG2/Units/Unit 06/Pretest/ALG2_U06_Pretest</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_Pretest_Q01</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_Pretest_Q01&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FM.1; MLA.A2.EX.4; MLA.A2.FN.2 (Unit 6 readiness)&lt;/p&gt;&lt;p&gt;A savings account starts with $500 and increases by $40 each month. Which model gives the balance B after m months?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>B=500+40m</text>
      <feedback format="html">
        <text>Correct. The starting balance is 500 and the balance increases by 40 each month.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>B=40+500m</text>
      <feedback format="html">
        <text>This reverses the starting balance and monthly increase.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>B=500(40)ᵐ</text>
      <feedback format="html">
        <text>This is exponential, but the situation adds a constant amount.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>B=500-40m</text>
      <feedback format="html">
        <text>This models a balance that decreases each month.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_Pretest_Q02</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_Pretest_Q02&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FM.1; MLA.A2.EX.4; MLA.A2.FN.2 (Unit 6 readiness)&lt;/p&gt;&lt;p&gt;The sequence 6, 12, 24, 48 is best described as which type of pattern?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>Arithmetic with common difference 6</text>
      <feedback format="html">
        <text>The differences are not constant after the first pair.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>Geometric with common ratio 2</text>
      <feedback format="html">
        <text>Correct. Each term is multiplied by 2 to get the next term.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Quadratic with constant second difference</text>
      <feedback format="html">
        <text>The values show a constant ratio, not a constant second difference.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Constant because the ratio does not change</text>
      <feedback format="html">
        <text>The ratio is constant, but the terms are not constant.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_Pretest_Q03</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_Pretest_Q03&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FM.1&lt;/p&gt;&lt;p&gt;A scatterplot shows points clustered around a straight line that slopes upward. Which model should be considered first?&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Representation:&lt;/strong&gt;&lt;/p&gt;&lt;table border=1 cellpadding=4 cellspacing=0&gt;&lt;tr&gt;&lt;th&gt;x&lt;/th&gt;&lt;th&gt;1&lt;/th&gt;&lt;th&gt;2&lt;/th&gt;&lt;th&gt;3&lt;/th&gt;&lt;th&gt;4&lt;/th&gt;&lt;th&gt;5&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;y&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;7&lt;/td&gt;&lt;td&gt;10&lt;/td&gt;&lt;td&gt;13&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>Exponential decay</text>
      <feedback format="html">
        <text>The relationship is increasing, not decreasing by a percent.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Quadratic with a turning point</text>
      <feedback format="html">
        <text>The description does not show a curved pattern or vertex.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>Linear</text>
      <feedback format="html">
        <text>Correct. A straight upward trend supports a linear model.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Constant</text>
      <feedback format="html">
        <text>The output changes as the input increases.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_Pretest_Q04</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_Pretest_Q04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.EX.4&lt;/p&gt;&lt;p&gt;A regression equation is y=250(1.08)ˣ. What does 1.08 represent?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>An initial value of 1.08</text>
      <feedback format="html">
        <text>The initial value is 250.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>A fixed increase of 1.08 units</text>
      <feedback format="html">
        <text>The model is multiplicative, not additive.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>An 8% decrease per input unit</text>
      <feedback format="html">
        <text>A decrease of 8% would use a factor of 0.92.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>An 8% increase per input unit</text>
      <feedback format="html">
        <text>Correct. Multiplying by 1.08 means the quantity increases by 8% each unit.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_Pretest_Q05</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_Pretest_Q05&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FN.2&lt;/p&gt;&lt;p&gt;Two models are compared. Model A has smaller residuals and matches the context. Model B has larger residuals but a shorter equation. Which is the better choice?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>Model A</text>
      <feedback format="html">
        <text>Correct. Smaller errors and contextual fit are stronger evidence than equation length.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Model B</text>
      <feedback format="html">
        <text>A shorter equation is not automatically a better model.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Both must be rejected</text>
      <feedback format="html">
        <text>A model with small residuals and contextual fit can be useful.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>The models cannot be compared</text>
      <feedback format="html">
        <text>Models can be compared using residuals and context.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_Pretest_Q06</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_Pretest_Q06&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FM.1&lt;/p&gt;&lt;p&gt;What does a residual measure in a data model?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>The original input value</text>
      <feedback format="html">
        <text>A residual compares observed and predicted outputs.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>The difference between observed and predicted values</text>
      <feedback format="html">
        <text>Correct. Residuals measure prediction error.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>The number of data points</text>
      <feedback format="html">
        <text>The count of data points is not a residual.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>The name of the regression equation</text>
      <feedback format="html">
        <text>A residual is a numerical error value.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_Pretest_Q07</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_Pretest_Q07&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.EX.4&lt;/p&gt;&lt;p&gt;A population model is P=1000(0.95)ᵗ. What happens each time t increases by 1?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>The population increases by 95%</text>
      <feedback format="html">
        <text>A factor of 0.95 is less than 1, so it indicates decay.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>The population decreases by 95%</text>
      <feedback format="html">
        <text>The population keeps 95%, so it loses 5%.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>The population decreases by 5%</text>
      <feedback format="html">
        <text>Correct. Multiplying by 0.95 means a 5% decrease each period.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>The population increases by 5 people</text>
      <feedback format="html">
        <text>The change is a percent, not a fixed number of people.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_Pretest_Q08</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_Pretest_Q08&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FN.2&lt;/p&gt;&lt;p&gt;Which evidence best supports choosing one function model over another?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>The equation uses the letter x</text>
      <feedback format="html">
        <text>Variable names do not determine model quality.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>The graph is drawn in a darker color</text>
      <feedback format="html">
        <text>Graph color is not mathematical evidence.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>The answer choices are shorter</text>
      <feedback format="html">
        <text>Answer length does not determine model fit.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>The model fits the data pattern and gives reasonable predictions</text>
      <feedback format="html">
        <text>Correct. Model choice should use fit, context, and prediction reasonableness.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_Pretest_Q09</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_Pretest_Q09&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FM.1; MLA.A2.EX.4; MLA.A2.FN.2 (Unit 6 readiness)&lt;/p&gt;&lt;p&gt;A model predicts 18.6 buses are needed for a trip. What is the most reasonable final answer?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>19 buses</text>
      <feedback format="html">
        <text>Correct. The number of buses must be a whole number and must meet the need.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>18 buses</text>
      <feedback format="html">
        <text>Rounding down would not provide enough buses.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>18.6 buses</text>
      <feedback format="html">
        <text>A fractional number of buses is not practical.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>20.6 buses</text>
      <feedback format="html">
        <text>This is not a whole-number bus count.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_Pretest_Q10</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_Pretest_Q10&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FM.1; MLA.A2.EX.4; MLA.A2.FN.2 (Unit 6 readiness)&lt;/p&gt;&lt;p&gt;Which statement is the strongest final interpretation of a model result?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>x=7</text>
      <feedback format="html">
        <text>This gives a value but no units, context, or limitation.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>The model predicts 7 years, assuming the rate stays constant</text>
      <feedback format="html">
        <text>Correct. This includes the value, units, and an important assumption.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>The equation was solved</text>
      <feedback format="html">
        <text>This does not state or interpret the result.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>The largest answer is best</text>
      <feedback format="html">
        <text>Model conclusions depend on context, not answer size.</text>
      </feedback>
    </answer>
  </question>
</quiz>