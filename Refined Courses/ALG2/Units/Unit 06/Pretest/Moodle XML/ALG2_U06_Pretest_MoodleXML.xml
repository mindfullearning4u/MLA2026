  <question type="multichoice">
    <name>
      <text>ALG2_U06_Pretest_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_Pretest_Q01</p><p><strong>MLA Standard:</strong> Support-only review; no new primary MLA standard</p><p>A savings account starts with $500 and increases by $40 each month. Which model gives the balance B after m months?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[B=500+40m]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The starting balance is 500 and the balance increases by 40 each month.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[B=40+500m]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the starting balance and monthly increase.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[B=500(40)ᵐ]]></text>
      <feedback format="html">
        <text><![CDATA[This is exponential, but the situation adds a constant amount.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[B=500-40m]]></text>
      <feedback format="html">
        <text><![CDATA[This models a balance that decreases each month.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_Pretest_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_Pretest_Q02</p><p><strong>MLA Standard:</strong> Support-only readiness; no new primary MLA standard</p><p>The sequence 6, 12, 24, 48 is best described as which type of pattern?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Arithmetic with common difference 6]]></text>
      <feedback format="html">
        <text><![CDATA[The differences are not constant after the first pair.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Geometric with common ratio 2]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Each term is multiplied by 2 to get the next term.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Quadratic with constant second difference]]></text>
      <feedback format="html">
        <text><![CDATA[The values show a constant ratio, not a constant second difference.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Constant because the ratio does not change]]></text>
      <feedback format="html">
        <text><![CDATA[The ratio is constant, but the terms are not constant.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_Pretest_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_Pretest_Q03</p><p><strong>MLA Standard:</strong> MLA.A2.FM.1</p><p>A scatterplot shows points clustered around a straight line that slopes upward. Which model should be considered first?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Exponential decay]]></text>
      <feedback format="html">
        <text><![CDATA[The relationship is increasing, not decreasing by a percent.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Quadratic with a turning point]]></text>
      <feedback format="html">
        <text><![CDATA[The description does not show a curved pattern or vertex.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Linear]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A straight upward trend supports a linear model.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Constant]]></text>
      <feedback format="html">
        <text><![CDATA[The output changes as the input increases.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_Pretest_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_Pretest_Q04</p><p><strong>MLA Standard:</strong> MLA.A2.EX.4</p><p>A regression equation is y=250(1.08)ˣ. What does 1.08 represent?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[An initial value of 1.08]]></text>
      <feedback format="html">
        <text><![CDATA[The initial value is 250.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A fixed increase of 1.08 units]]></text>
      <feedback format="html">
        <text><![CDATA[The model is multiplicative, not additive.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[An 8% decrease per input unit]]></text>
      <feedback format="html">
        <text><![CDATA[A decrease of 8% would use a factor of 0.92.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[An 8% increase per input unit]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Multiplying by 1.08 means the quantity increases by 8% each unit.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_Pretest_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_Pretest_Q05</p><p><strong>MLA Standard:</strong> MLA.A2.FN.2</p><p>Two models are compared. Model A has smaller residuals and matches the context. Model B has larger residuals but a shorter equation. Which is the better choice?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Model A]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Smaller errors and contextual fit are stronger evidence than equation length.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Model B]]></text>
      <feedback format="html">
        <text><![CDATA[A shorter equation is not automatically a better model.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Both must be rejected]]></text>
      <feedback format="html">
        <text><![CDATA[A model with small residuals and contextual fit can be useful.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The models cannot be compared]]></text>
      <feedback format="html">
        <text><![CDATA[Models can be compared using residuals and context.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_Pretest_Q06</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_Pretest_Q06</p><p><strong>MLA Standard:</strong> MLA.A2.FM.1</p><p>What does a residual measure in a data model?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The original input value]]></text>
      <feedback format="html">
        <text><![CDATA[A residual compares observed and predicted outputs.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The difference between observed and predicted values]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Residuals measure prediction error.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The number of data points]]></text>
      <feedback format="html">
        <text><![CDATA[The count of data points is not a residual.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The name of the regression equation]]></text>
      <feedback format="html">
        <text><![CDATA[A residual is a numerical error value.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_Pretest_Q07</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_Pretest_Q07</p><p><strong>MLA Standard:</strong> MLA.A2.EX.4</p><p>A population model is P=1000(0.95)ᵗ. What happens each time t increases by 1?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The population increases by 95%]]></text>
      <feedback format="html">
        <text><![CDATA[A factor of 0.95 is less than 1, so it indicates decay.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The population decreases by 95%]]></text>
      <feedback format="html">
        <text><![CDATA[The population keeps 95%, so it loses 5%.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The population decreases by 5%]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Multiplying by 0.95 means a 5% decrease each period.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The population increases by 5 people]]></text>
      <feedback format="html">
        <text><![CDATA[The change is a percent, not a fixed number of people.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_Pretest_Q08</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_Pretest_Q08</p><p><strong>MLA Standard:</strong> MLA.A2.FN.2</p><p>Which evidence best supports choosing one function model over another?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The equation uses the letter x]]></text>
      <feedback format="html">
        <text><![CDATA[Variable names do not determine model quality.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The graph is drawn in a darker color]]></text>
      <feedback format="html">
        <text><![CDATA[Graph color is not mathematical evidence.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The answer choices are shorter]]></text>
      <feedback format="html">
        <text><![CDATA[Answer length does not determine model fit.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The model fits the data pattern and gives reasonable predictions]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Model choice should use fit, context, and prediction reasonableness.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_Pretest_Q09</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_Pretest_Q09</p><p><strong>MLA Standard:</strong> Support-only synthesis; no new primary MLA standard</p><p>A model predicts 18.6 buses are needed for a trip. What is the most reasonable final answer?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[19 buses]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The number of buses must be a whole number and must meet the need.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[18 buses]]></text>
      <feedback format="html">
        <text><![CDATA[Rounding down would not provide enough buses.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[18.6 buses]]></text>
      <feedback format="html">
        <text><![CDATA[A fractional number of buses is not practical.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[20.6 buses]]></text>
      <feedback format="html">
        <text><![CDATA[This is not a whole-number bus count.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_Pretest_Q10</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_Pretest_Q10</p><p><strong>MLA Standard:</strong> Unit 6 standards synthesis; no new primary MLA standard</p><p>Which statement is the strongest final interpretation of a model result?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x=7]]></text>
      <feedback format="html">
        <text><![CDATA[This gives a value but no units, context, or limitation.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The model predicts 7 years, assuming the rate stays constant]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. This includes the value, units, and an important assumption.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The equation was solved]]></text>
      <feedback format="html">
        <text><![CDATA[This does not state or interpret the result.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The largest answer is best]]></text>
      <feedback format="html">
        <text><![CDATA[Model conclusions depend on context, not answer size.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>