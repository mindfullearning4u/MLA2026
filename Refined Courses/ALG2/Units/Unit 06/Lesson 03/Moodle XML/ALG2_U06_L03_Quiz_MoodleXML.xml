    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q09</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L03_Q09</p><p><strong>MLA Standard:</strong> MLA.A2.FM.1</p><p>Which residual pattern suggests a linear model may be a poor fit?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Residuals form a curved pattern.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A pattern in residuals suggests the model is missing structure.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Residuals are scattered randomly around 0.]]></text>
      <feedback format="html">
        <text><![CDATA[Random residuals around 0 support the model fit.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Residuals are small and mixed positive and negative.]]></text>
      <feedback format="html">
        <text><![CDATA[Small mixed residuals are generally a good sign.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Residuals include both decimals and whole numbers.]]></text>
      <feedback format="html">
        <text><![CDATA[Number type does not determine model fit.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q10</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L03_Q10</p><p><strong>MLA Standard:</strong> MLA.A2.FM.1</p><p>Which data behavior best supports a quadratic model?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
