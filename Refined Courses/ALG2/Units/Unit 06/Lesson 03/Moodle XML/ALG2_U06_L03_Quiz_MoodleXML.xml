    <answer fraction="0" format="html">
      <text>y=14x+2</text>
      <feedback format="html">
        <text>When x=0, this model gives 2.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>y=2x+7</text>
      <feedback format="html">
        <text>When x=0, this model gives 7.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
