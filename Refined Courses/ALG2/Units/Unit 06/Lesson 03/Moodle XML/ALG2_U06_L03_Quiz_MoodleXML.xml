    <answer fraction="0" format="html">
      <text><![CDATA[y=20(1.15)ˣ]]></text>
      <feedback format="html">
        <text><![CDATA[The factor is greater than 1, so this increases.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y=20+1.15x]]></text>
