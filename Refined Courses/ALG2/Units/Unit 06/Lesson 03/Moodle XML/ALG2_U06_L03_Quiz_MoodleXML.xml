    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[120 units]]></text>
      <feedback format="html">
        <text><![CDATA[The context gives dollars, so units should be specific.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[120 percent]]></text>
      <feedback format="html">
        <text><![CDATA[The model output is a dollar amount, not a percent.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[about $120]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The prediction should use the correct contextual units.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
