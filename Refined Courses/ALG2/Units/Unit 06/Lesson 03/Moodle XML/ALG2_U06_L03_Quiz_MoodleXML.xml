    <answer fraction="0" format="html">
      <text><![CDATA[Constant first differences.]]></text>
      <feedback format="html">
        <text><![CDATA[That supports a linear model.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[A curved pattern with one turning point.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Quadratic models often show a parabolic shape with a turning point.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A constant ratio between y-values.]]></text>
      <feedback format="html">
        <text><![CDATA[That supports an exponential model.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[No visible relationship.]]></text>
      <feedback format="html">
        <text><![CDATA[No visible pattern does not support a quadratic model.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q11</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L03_Q11</p><p><strong>MLA Standard:</strong> MLA.A2.FM.1</p><p>A model predicts 120 for a context measured in dollars. How should the prediction be reported?</p>]]></text>
