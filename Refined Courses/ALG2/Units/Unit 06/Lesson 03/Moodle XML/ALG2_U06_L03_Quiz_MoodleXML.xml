      <feedback format="html">
        <text><![CDATA[This labels the input variable, not the predicted output.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q12</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L03_Q12</p><p><strong>MLA Standard:</strong> MLA.A2.FM.1</p><p>Why can extrapolation be risky?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[It always uses exact data values.]]></text>
      <feedback format="html">
        <text><![CDATA[Extrapolation uses a model outside the observed data range.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It never uses a model.]]></text>
      <feedback format="html">
        <text><![CDATA[Extrapolation does use a model or pattern.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It only predicts inside the data range.]]></text>
      <feedback format="html">
        <text><![CDATA[That describes interpolation.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The pattern may not continue outside the data range.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The model may stop being valid beyond observed values.]]></text>
      </feedback>
    </answer>
  </question>
