  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q17</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L03_Q17</p><p><strong>MLA Standard:</strong> MLA.A2.FM.1</p><p>What does a positive residual mean?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[The actual value is greater than the predicted value.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Actual minus predicted is positive when actual is larger.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The predicted value is greater than the actual value.]]></text>
      <feedback format="html">
        <text><![CDATA[That would make the residual negative.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The model has no error.]]></text>
      <feedback format="html">
        <text><![CDATA[A positive residual is still an error unless it equals 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The x-value is positive.]]></text>
      <feedback format="html">
        <text><![CDATA[Residual sign is about prediction error, not the sign of x.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q18</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L03_Q18</p><p><strong>MLA Standard:</strong> MLA.A2.FM.1</p><p>What does a negative residual mean?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The actual value is greater than predicted.]]></text>
      <feedback format="html">
        <text><![CDATA[That would produce a positive residual.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The actual value is less than predicted.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Actual minus predicted is negative when actual is smaller.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The model cannot be used at all.]]></text>
      <feedback format="html">
        <text><![CDATA[One negative residual does not automatically invalidate the model.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The data point has a negative x-value.]]></text>
      <feedback format="html">
        <text><![CDATA[Residual sign does not describe the input value.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q19</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L03_Q19</p><p><strong>MLA Standard:</strong> MLA.A2.FM.1</p><p>Which is the best reason to include context when interpreting a model?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Context changes arithmetic rules.]]></text>
      <feedback format="html">
        <text><![CDATA[The calculations stay the same, but meaning depends on context.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Context removes the need for units.]]></text>
      <feedback format="html">
        <text><![CDATA[Context makes units more important, not less important.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Context tells what the variables and predictions represent.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A model is useful only when its quantities are interpreted.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Context guarantees every prediction is accurate.]]></text>
      <feedback format="html">
        <text><![CDATA[Context helps judge reasonableness but does not guarantee accuracy.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q20</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L03_Q20</p><p><strong>MLA Standard:</strong> MLA.A2.FM.1</p><p>Which statement best describes a good model choice?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Choose the model with the largest output.]]></text>
      <feedback format="html">
        <text><![CDATA[Largest output does not mean best fit.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Choose the most complicated model every time.]]></text>
      <feedback format="html">
        <text><![CDATA[A complicated model may overfit or ignore context.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Choose the model with no variables.]]></text>
      <feedback format="html">
        <text><![CDATA[A useful model usually represents relationships with variables.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Choose a model that fits the pattern and makes sense in context.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Fit and context both matter.]]></text>
      </feedback>
    </answer>
  </question>
