<?xml version='1.0' encoding='utf-8'?>
<quiz>
  <question type="category">
    <category>
      <text>$course$/ALG2/Units/Unit 06/Lesson 03/ALG2_U06_L03_Quiz</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q01</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_L03_Q01&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FM.1&lt;/p&gt;&lt;p&gt;Which model type is suggested by data with a constant rate of change?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>linear</text>
      <feedback format="html">
        <text>Correct. A constant rate of change is the defining pattern of a linear model.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>exponential</text>
      <feedback format="html">
        <text>Exponential models have a constant ratio, not a constant difference.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>quadratic</text>
      <feedback format="html">
        <text>Quadratic models usually have changing first differences.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>logarithmic</text>
      <feedback format="html">
        <text>Logarithmic data increases or decreases more slowly over time.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q02</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_L03_Q02&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FM.1&lt;/p&gt;&lt;p&gt;A data set doubles about every step. Which model type is most reasonable?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>linear</text>
      <feedback format="html">
        <text>Linear data changes by equal differences, not repeated factors.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>exponential</text>
      <feedback format="html">
        <text>Correct. Repeated multiplication by about 2 suggests exponential growth.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>quadratic</text>
      <feedback format="html">
        <text>Quadratic growth does not usually double by a constant factor each step.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>constant</text>
      <feedback format="html">
        <text>A constant model would not change each step.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q03</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_L03_Q03&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FM.1&lt;/p&gt;&lt;p&gt;Actual value is 71 and predicted value is 75. What is the residual?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>4</text>
      <feedback format="html">
        <text>This subtracts actual from predicted instead of predicted from actual.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>146</text>
      <feedback format="html">
        <text>This adds the actual and predicted values.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>-4</text>
      <feedback format="html">
        <text>Correct. Residual = actual - predicted = 71 - 75 = -4.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>75</text>
      <feedback format="html">
        <text>This is only the predicted value.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q04</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_L03_Q04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FM.1&lt;/p&gt;&lt;p&gt;What does a residual of 0 mean?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>The model has no equation.</text>
      <feedback format="html">
        <text>A residual of 0 is about one prediction, not whether an equation exists.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>The actual value is 0.</text>
      <feedback format="html">
        <text>The residual can be 0 even when the data value is not 0.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>The predicted value is 0.</text>
      <feedback format="html">
        <text>The prediction can be nonzero and still match the actual value.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>The prediction matches the actual value.</text>
      <feedback format="html">
        <text>Correct. Actual minus predicted equals 0 when they are equal.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q05</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_L03_Q05&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FM.1&lt;/p&gt;&lt;p&gt;Which prediction is extrapolation?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>Predicting sales for month 15 from data collected for months 1 through 10.</text>
      <feedback format="html">
        <text>Correct. Month 15 is outside the observed data range.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Predicting sales for month 6 from data collected for months 1 through 10.</text>
      <feedback format="html">
        <text>Month 6 is inside the data range, so this is interpolation.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Finding the residual for month 3.</text>
      <feedback format="html">
        <text>Residuals measure prediction errors, not prediction location.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Reading the actual value for month 4.</text>
      <feedback format="html">
        <text>Reading data is not making a model prediction.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q06</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_L03_Q06&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FM.1&lt;/p&gt;&lt;p&gt;Which prediction is interpolation?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>Predicting year 2035 from data ending in 2025.</text>
      <feedback format="html">
        <text>This is outside the observed range, so it is extrapolation.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>Predicting x=4 from data collected for x=1 through x=8.</text>
      <feedback format="html">
        <text>Correct. x=4 lies inside the observed data range.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Predicting a value with no data pattern.</text>
      <feedback format="html">
        <text>Interpolation still needs a model or data pattern.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Predicting x=20 from data ending at x=10.</text>
      <feedback format="html">
        <text>This is outside the observed range.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q07</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_L03_Q07&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FM.1&lt;/p&gt;&lt;p&gt;For y=4x+9, what is the predicted value when x=6?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>24</text>
      <feedback format="html">
        <text>This uses only 4x and omits the intercept.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>19</text>
      <feedback format="html">
        <text>This adds 4, 6, and 9 incorrectly.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>33</text>
      <feedback format="html">
        <text>Correct. y=4(6)+9=33.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>54</text>
      <feedback format="html">
        <text>This multiplies x by the intercept instead of using the model.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q08</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_L03_Q08&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FM.1&lt;/p&gt;&lt;p&gt;For y=2(3)ˣ, what is the predicted value when x=3?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>18</text>
      <feedback format="html">
        <text>This uses 2 times 3 times 3 instead of the exponent.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>24</text>
      <feedback format="html">
        <text>This adds an extra factor incorrectly.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>9</text>
      <feedback format="html">
        <text>This calculates 3 squared, not the full expression.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>54</text>
      <feedback format="html">
        <text>Correct. y=2(3)&amp;#179;=54.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q09</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_L03_Q09&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FM.1&lt;/p&gt;&lt;p&gt;Which residual pattern suggests a linear model may be a poor fit?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>Residuals form a curved pattern.</text>
      <feedback format="html">
        <text>Correct. A pattern in residuals suggests the model is missing structure.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Residuals are scattered randomly around 0.</text>
      <feedback format="html">
        <text>Random residuals around 0 support the model fit.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Residuals are small and mixed positive and negative.</text>
      <feedback format="html">
        <text>Small mixed residuals are generally a good sign.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Residuals include both decimals and whole numbers.</text>
      <feedback format="html">
        <text>Number type does not determine model fit.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q10</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_L03_Q10&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FM.1&lt;/p&gt;&lt;p&gt;Which data behavior best supports a quadratic model?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>Constant first differences.</text>
      <feedback format="html">
        <text>That supports a linear model.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>A curved pattern with one turning point.</text>
      <feedback format="html">
        <text>Correct. Quadratic models often show a parabolic shape with a turning point.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>A constant ratio between y-values.</text>
      <feedback format="html">
        <text>That supports an exponential model.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>No visible relationship.</text>
      <feedback format="html">
        <text>No visible pattern does not support a quadratic model.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q11</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_L03_Q11&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FM.1&lt;/p&gt;&lt;p&gt;A model predicts 120 for a context measured in dollars. How should the prediction be reported?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>120 units</text>
      <feedback format="html">
        <text>The context gives dollars, so units should be specific.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>120 percent</text>
      <feedback format="html">
        <text>The model output is a dollar amount, not a percent.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>about $120</text>
      <feedback format="html">
        <text>Correct. The prediction should use the correct contextual units.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>x=120</text>
      <feedback format="html">
        <text>This labels the input variable, not the predicted output.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q12</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_L03_Q12&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FM.1&lt;/p&gt;&lt;p&gt;Why can extrapolation be risky?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>It always uses exact data values.</text>
      <feedback format="html">
        <text>Extrapolation uses a model outside the observed data range.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>It never uses a model.</text>
      <feedback format="html">
        <text>Extrapolation does use a model or pattern.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>It only predicts inside the data range.</text>
      <feedback format="html">
        <text>That describes interpolation.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>The pattern may not continue outside the data range.</text>
      <feedback format="html">
        <text>Correct. The model may stop being valid beyond observed values.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q13</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_L03_Q13&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FM.1&lt;/p&gt;&lt;p&gt;Which table suggests a linear model?&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Representation:&lt;/strong&gt;&lt;/p&gt;&lt;table border=1 cellpadding=4 cellspacing=0&gt;&lt;tr&gt;&lt;th&gt;Option&lt;/th&gt;&lt;th&gt;Values&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;A&lt;/td&gt;&lt;td&gt;5, 8, 11&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;B&lt;/td&gt;&lt;td&gt;3, 9, 27&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C&lt;/td&gt;&lt;td&gt;1, 4, 9&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D&lt;/td&gt;&lt;td&gt;8, 8, 8&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;table class="mla-assessment-table" style="border-collapse:collapse;margin:8px 0;"&gt;&lt;tr&gt;&lt;th style="border:1px solid #555;padding:4px 8px;"&gt;x&lt;/th&gt;&lt;td style="border:1px solid #555;padding:4px 8px;text-align:center;"&gt;1&lt;/td&gt;&lt;td style="border:1px solid #555;padding:4px 8px;text-align:center;"&gt;2&lt;/td&gt;&lt;td style="border:1px solid #555;padding:4px 8px;text-align:center;"&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;th style="border:1px solid #555;padding:4px 8px;"&gt;y&lt;/th&gt;&lt;td style="border:1px solid #555;padding:4px 8px;text-align:center;"&gt;5&lt;/td&gt;&lt;td style="border:1px solid #555;padding:4px 8px;text-align:center;"&gt;8&lt;/td&gt;&lt;td style="border:1px solid #555;padding:4px 8px;text-align:center;"&gt;11&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;</text>
      <feedback format="html">
        <text>Correct. The y-values increase by 3 each time.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;table class="mla-assessment-table" style="border-collapse:collapse;margin:8px 0;"&gt;&lt;tr&gt;&lt;th style="border:1px solid #555;padding:4px 8px;"&gt;x&lt;/th&gt;&lt;td style="border:1px solid #555;padding:4px 8px;text-align:center;"&gt;1&lt;/td&gt;&lt;td style="border:1px solid #555;padding:4px 8px;text-align:center;"&gt;2&lt;/td&gt;&lt;td style="border:1px solid #555;padding:4px 8px;text-align:center;"&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;th style="border:1px solid #555;padding:4px 8px;"&gt;y&lt;/th&gt;&lt;td style="border:1px solid #555;padding:4px 8px;text-align:center;"&gt;3&lt;/td&gt;&lt;td style="border:1px solid #555;padding:4px 8px;text-align:center;"&gt;9&lt;/td&gt;&lt;td style="border:1px solid #555;padding:4px 8px;text-align:center;"&gt;27&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;</text>
      <feedback format="html">
        <text>This shows a constant ratio of 3.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;table class="mla-assessment-table" style="border-collapse:collapse;margin:8px 0;"&gt;&lt;tr&gt;&lt;th style="border:1px solid #555;padding:4px 8px;"&gt;x&lt;/th&gt;&lt;td style="border:1px solid #555;padding:4px 8px;text-align:center;"&gt;1&lt;/td&gt;&lt;td style="border:1px solid #555;padding:4px 8px;text-align:center;"&gt;2&lt;/td&gt;&lt;td style="border:1px solid #555;padding:4px 8px;text-align:center;"&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;th style="border:1px solid #555;padding:4px 8px;"&gt;y&lt;/th&gt;&lt;td style="border:1px solid #555;padding:4px 8px;text-align:center;"&gt;1&lt;/td&gt;&lt;td style="border:1px solid #555;padding:4px 8px;text-align:center;"&gt;4&lt;/td&gt;&lt;td style="border:1px solid #555;padding:4px 8px;text-align:center;"&gt;9&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;</text>
      <feedback format="html">
        <text>This follows a quadratic pattern.</text>
      </feedback>
    </answer>
