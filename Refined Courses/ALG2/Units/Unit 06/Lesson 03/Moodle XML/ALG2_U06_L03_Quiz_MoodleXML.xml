  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q15</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_L03_Q15&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FM.1&lt;/p&gt;&lt;p&gt;Which model has an initial value of 14 when x=0?&lt;/p&gt;</text>
