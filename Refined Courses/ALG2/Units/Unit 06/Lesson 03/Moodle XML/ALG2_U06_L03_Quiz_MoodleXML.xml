  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q15</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L03_Q15</p><p><strong>MLA Standard:</strong> MLA.A2.FM.1</p><p>Which model has an initial value of 14 when x=0?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[y=14x+2]]></text>
      <feedback format="html">
        <text><![CDATA[When x=0, this model gives 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y=2x+7]]></text>
      <feedback format="html">
        <text><![CDATA[When x=0, this model gives 7.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[y=5x+14]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The y-intercept is 14, so the predicted value at x=0 is 14.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y=14x]]></text>
      <feedback format="html">
        <text><![CDATA[When x=0, this model gives 0.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
