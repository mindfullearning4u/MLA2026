  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L03_Q01</p><p><strong>MLA Standard:</strong> MLA.A2.FM.1</p><p>Which model type is suggested by data with a constant rate of change?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[linear]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A constant rate of change is the defining pattern of a linear model.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[exponential]]></text>
      <feedback format="html">
        <text><![CDATA[Exponential models have a constant ratio, not a constant difference.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[quadratic]]></text>
      <feedback format="html">
        <text><![CDATA[Quadratic models usually have changing first differences.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[logarithmic]]></text>
      <feedback format="html">
        <text><![CDATA[Logarithmic data increases or decreases more slowly over time.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L03_Q02</p><p><strong>MLA Standard:</strong> MLA.A2.FM.1</p><p>A data set doubles about every step. Which model type is most reasonable?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[linear]]></text>
      <feedback format="html">
        <text><![CDATA[Linear data changes by equal differences, not repeated factors.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[exponential]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Repeated multiplication by about 2 suggests exponential growth.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[quadratic]]></text>
      <feedback format="html">
        <text><![CDATA[Quadratic growth does not usually double by a constant factor each step.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[constant]]></text>
      <feedback format="html">
        <text><![CDATA[A constant model would not change each step.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L03_Q03</p><p><strong>MLA Standard:</strong> MLA.A2.FM.1</p><p>Actual value is 71 and predicted value is 75. What is the residual?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[4]]></text>
      <feedback format="html">
        <text><![CDATA[This subtracts actual from predicted instead of predicted from actual.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[146]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the actual and predicted values.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[-4]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Residual = actual - predicted = 71 - 75 = -4.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[75]]></text>
      <feedback format="html">
        <text><![CDATA[This is only the predicted value.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L03_Q04</p><p><strong>MLA Standard:</strong> MLA.A2.FM.1</p><p>What does a residual of 0 mean?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The model has no equation.]]></text>
      <feedback format="html">
        <text><![CDATA[A residual of 0 is about one prediction, not whether an equation exists.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The actual value is 0.]]></text>
      <feedback format="html">
        <text><![CDATA[The residual can be 0 even when the data value is not 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The predicted value is 0.]]></text>
      <feedback format="html">
        <text><![CDATA[The prediction can be nonzero and still match the actual value.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The prediction matches the actual value.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Actual minus predicted equals 0 when they are equal.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L03_Q05</p><p><strong>MLA Standard:</strong> MLA.A2.FM.1</p><p>Which prediction is extrapolation?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Predicting sales for month 15 from data collected for months 1 through 10.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Month 15 is outside the observed data range.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Predicting sales for month 6 from data collected for months 1 through 10.]]></text>
      <feedback format="html">
        <text><![CDATA[Month 6 is inside the data range, so this is interpolation.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Finding the residual for month 3.]]></text>
      <feedback format="html">
        <text><![CDATA[Residuals measure prediction errors, not prediction location.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Reading the actual value for month 4.]]></text>
      <feedback format="html">
        <text><![CDATA[Reading data is not making a model prediction.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q06</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L03_Q06</p><p><strong>MLA Standard:</strong> MLA.A2.FM.1</p><p>Which prediction is interpolation?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Predicting year 2035 from data ending in 2025.]]></text>
      <feedback format="html">
        <text><![CDATA[This is outside the observed range, so it is extrapolation.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Predicting x=4 from data collected for x=1 through x=8.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. x=4 lies inside the observed data range.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Predicting a value with no data pattern.]]></text>
      <feedback format="html">
        <text><![CDATA[Interpolation still needs a model or data pattern.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Predicting x=20 from data ending at x=10.]]></text>
      <feedback format="html">
        <text><![CDATA[This is outside the observed range.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q07</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L03_Q07</p><p><strong>MLA Standard:</strong> MLA.A2.FM.1</p><p>For y=4x+9, what is the predicted value when x=6?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[24]]></text>
      <feedback format="html">
        <text><![CDATA[This uses only 4x and omits the intercept.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[19]]></text>
      <feedback format="html">
        <text><![CDATA[This adds 4, 6, and 9 incorrectly.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[33]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. y=4(6)+9=33.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[54]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies x by the intercept instead of using the model.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_Q08</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L03_Q08</p><p><strong>MLA Standard:</strong> MLA.A2.FM.1</p><p>For y=2(3)ˣ, what is the predicted value when x=3?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[18]]></text>
      <feedback format="html">
        <text><![CDATA[This uses 2 times 3 times 3 instead of the exponent.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[24]]></text>
      <feedback format="html">
        <text><![CDATA[This adds an extra factor incorrectly.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[9]]></text>
      <feedback format="html">
