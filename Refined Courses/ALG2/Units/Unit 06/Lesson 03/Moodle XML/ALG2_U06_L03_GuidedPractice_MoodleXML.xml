<quiz>
  <question type="category">
    <category>
      <text>$course$/ALG2/Units/Unit 06/Lesson 03/ALG2_U06_L03_GuidedPractice</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L03_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A2.FM.1</p><p>A scatterplot has points that rise at a nearly constant rate. Which model type is most reasonable?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[linear]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A nearly constant rate of change is modeled well by a linear function.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[quadratic]]></text>
      <feedback format="html">
        <text><![CDATA[Quadratic data usually curves and has changing first differences.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[exponential]]></text>
      <feedback format="html">
        <text><![CDATA[Exponential data changes by a repeated factor, not a constant amount.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[no model]]></text>
      <feedback format="html">
        <text><![CDATA[A clear increasing pattern supports trying a model.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L03_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A2.FM.1</p><p>A model predicts 38, and the actual value is 42. What is the residual?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[-4]]></text>
      <feedback format="html">
        <text><![CDATA[This subtracts actual from predicted instead of actual minus predicted.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[4]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Residual = actual - predicted = 42 - 38 = 4.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[38]]></text>
      <feedback format="html">
        <text><![CDATA[This is the predicted value, not the prediction error.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[80]]></text>
      <feedback format="html">
        <text><![CDATA[This adds actual and predicted instead of finding the difference.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L03_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A2.FM.1</p><p>Using a model to predict inside the observed data range is called what?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[extrapolation]]></text>
      <feedback format="html">
        <text><![CDATA[Extrapolation predicts outside the observed data range.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[residual analysis]]></text>
      <feedback format="html">
        <text><![CDATA[Residual analysis checks prediction errors.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[interpolation]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Interpolation makes a prediction within the observed data range.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[correlation]]></text>
      <feedback format="html">
        <text><![CDATA[Correlation describes strength and direction, not prediction location.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L03_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A2.FM.1</p><p>Which evidence best supports choosing an exponential model?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The data has a constant difference.]]></text>
      <feedback format="html">
        <text><![CDATA[A constant difference supports a linear model.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The residuals form a strong curve.]]></text>
      <feedback format="html">
        <text><![CDATA[Curved residuals suggest the chosen model may not fit.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The data has no visible trend.]]></text>
      <feedback format="html">
        <text><![CDATA[No visible trend does not support an exponential model.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The data changes by a nearly constant ratio.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A repeated ratio is a clue for exponential behavior.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L03_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A2.FM.1</p><p>For y=6x+14, what is the predicted value when x=5?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[44]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Substitute x=5 to get y=6(5)+14=44.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[30]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies 6 and 5 but omits the intercept.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[19]]></text>
      <feedback format="html">
        <text><![CDATA[This adds x and 14 instead of using the model.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[84]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies 14 by 6 instead of substituting x.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>