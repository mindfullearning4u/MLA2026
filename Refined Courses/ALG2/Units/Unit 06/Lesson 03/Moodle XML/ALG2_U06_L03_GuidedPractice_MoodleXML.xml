<?xml version='1.0' encoding='utf-8'?>
<quiz>
  <question type="category">
    <category>
      <text>$course$/ALG2/Units/Unit 06/Lesson 03/ALG2_U06_L03_GuidedPractice</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_L03_GP_Q01&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FM.1&lt;/p&gt;&lt;p&gt;A scatterplot has points that rise at a nearly constant rate. Which model type is most reasonable?&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Representation:&lt;/strong&gt;&lt;/p&gt;&lt;table border=1 cellpadding=4 cellspacing=0&gt;&lt;tr&gt;&lt;th&gt;x&lt;/th&gt;&lt;th&gt;1&lt;/th&gt;&lt;th&gt;2&lt;/th&gt;&lt;th&gt;3&lt;/th&gt;&lt;th&gt;4&lt;/th&gt;&lt;th&gt;5&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;y&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;7&lt;/td&gt;&lt;td&gt;10&lt;/td&gt;&lt;td&gt;13&lt;/td&gt;&lt;td&gt;16&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>linear</text>
      <feedback format="html">
        <text>Correct. A nearly constant rate of change is modeled well by a linear function.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>quadratic</text>
      <feedback format="html">
        <text>Quadratic data usually curves and has changing first differences.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>exponential</text>
      <feedback format="html">
        <text>Exponential data changes by a repeated factor, not a constant amount.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>no model</text>
      <feedback format="html">
        <text>A clear increasing pattern supports trying a model.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_L03_GP_Q02&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FM.1&lt;/p&gt;&lt;p&gt;A model predicts 38, and the actual value is 42. What is the residual?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>-4</text>
      <feedback format="html">
        <text>This subtracts actual from predicted instead of actual minus predicted.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>4</text>
      <feedback format="html">
        <text>Correct. Residual = actual - predicted = 42 - 38 = 4.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>38</text>
      <feedback format="html">
        <text>This is the predicted value, not the prediction error.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>80</text>
      <feedback format="html">
        <text>This adds actual and predicted instead of finding the difference.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_L03_GP_Q03&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FM.1&lt;/p&gt;&lt;p&gt;Using a model to predict inside the observed data range is called what?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>extrapolation</text>
      <feedback format="html">
        <text>Extrapolation predicts outside the observed data range.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>residual analysis</text>
      <feedback format="html">
        <text>Residual analysis checks prediction errors.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>interpolation</text>
      <feedback format="html">
        <text>Correct. Interpolation makes a prediction within the observed data range.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>correlation</text>
      <feedback format="html">
        <text>Correlation describes strength and direction, not prediction location.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_L03_GP_Q04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FM.1&lt;/p&gt;&lt;p&gt;Which evidence best supports choosing an exponential model?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>The data has a constant difference.</text>
      <feedback format="html">
        <text>A constant difference supports a linear model.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>The residuals form a strong curve.</text>
      <feedback format="html">
        <text>Curved residuals suggest the chosen model may not fit.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>The data has no visible trend.</text>
      <feedback format="html">
        <text>No visible trend does not support an exponential model.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>The data changes by a nearly constant ratio.</text>
      <feedback format="html">
        <text>Correct. A repeated ratio is a clue for exponential behavior.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L03_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U06_L03_GP_Q05&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.FM.1&lt;/p&gt;&lt;p&gt;For y=6x+14, what is the predicted value when x=5?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>44</text>
      <feedback format="html">
        <text>Correct. Substitute x=5 to get y=6(5)+14=44.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>30</text>
      <feedback format="html">
        <text>This multiplies 6 and 5 but omits the intercept.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>19</text>
      <feedback format="html">
        <text>This adds x and 14 instead of using the model.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>84</text>
      <feedback format="html">
        <text>This multiplies 14 by 6 instead of substituting x.</text>
      </feedback>
    </answer>
  </question>
</quiz>