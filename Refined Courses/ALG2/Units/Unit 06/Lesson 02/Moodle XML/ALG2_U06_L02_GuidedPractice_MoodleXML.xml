      <text>ALG2_U06_L02_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L02_GP_Q01</p><p><strong>MLA Standard:</strong> Support-only readiness; no new primary MLA standard</p><p>Which sequence is arithmetic?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[4, 9, 14, 19]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Each term increases by the constant difference 5.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4, 8, 16, 32]]></text>
      <feedback format="html">
        <text><![CDATA[This is geometric because each term is multiplied by 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4, 7, 12, 19]]></text>
      <feedback format="html">
        <text><![CDATA[The differences are not constant.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4, 16, 64, 256]]></text>
      <feedback format="html">
        <text><![CDATA[This is geometric because each term is multiplied by 4.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U06_L02_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L02_GP_Q02</p><p><strong>MLA Standard:</strong> Support-only readiness; no new primary MLA standard</p><p>Which sequence is geometric?</p>]]></text>
