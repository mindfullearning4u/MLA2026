    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[3, 6, 9, 12]]></text>
      <feedback format="html">
        <text><![CDATA[This has a constant difference, so it is arithmetic.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[3, 6, 12, 24]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Each term is multiplied by 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[3, 7, 11, 15]]></text>
      <feedback format="html">
        <text><![CDATA[This has a constant difference of 4.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[3, 5, 8, 12]]></text>
      <feedback format="html">
        <text><![CDATA[The differences are not constant and there is no constant ratio.]]></text>
      </feedback>
    </answer>
