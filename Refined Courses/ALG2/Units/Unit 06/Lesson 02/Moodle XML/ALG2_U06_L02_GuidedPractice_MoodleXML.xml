  <question type="multichoice">
    <name>
      <text>ALG2_U06_L02_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U06_L02_GP_Q03</p><p><strong>MLA Standard:</strong> Support-only readiness; no new primary MLA standard</p><p>For 7, 11, 15, 19, ..., what is the common difference?</p>]]></text>
