  <question type="multichoice">
    <name>
      <text>ALG2_U03_L06_GP01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L06_GP01</p><p><strong>MLA Standard:</strong> MLA.A2.RR.4</p><p>Solve 5/x = 10.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[x = 1/2]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Restriction x != 0; multiplying by x gives 5 = 10x.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 2]]></text>
      <feedback format="html">
        <text><![CDATA[This is the reciprocal of the correct value.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 5]]></text>
      <feedback format="html">
        <text><![CDATA[This does not satisfy the equation.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 0]]></text>
      <feedback format="html">
        <text><![CDATA[x = 0 is not allowed.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L06_GP02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L06_GP02</p><p><strong>MLA Standard:</strong> MLA.A2.RR.4</p><p>Solve 2/(x - 4) = 1.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 2]]></text>
      <feedback format="html">
        <text><![CDATA[This subtracts instead of adding 4.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x = 6]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Restriction x != 4; multiplying by x - 4 gives 2 = x - 4.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 4]]></text>
      <feedback format="html">
        <text><![CDATA[This makes the denominator zero.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -6]]></text>
      <feedback format="html">
        <text><![CDATA[This does not satisfy the equation.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L06_GP03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L06_GP03</p><p><strong>MLA Standard:</strong> MLA.A2.RR.4</p><p>Solve 1/x + 1/2 = 3/2.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 0]]></text>
      <feedback format="html">
        <text><![CDATA[x = 0 is restricted.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 2]]></text>
      <feedback format="html">
        <text><![CDATA[This makes the left side 1, not 3/2.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x = 1]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Subtract 1/2 to get 1/x = 1, so x = 1.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -1]]></text>
      <feedback format="html">
        <text><![CDATA[This makes 1/x negative.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L06_GP04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L06_GP04</p><p><strong>MLA Standard:</strong> MLA.A2.RR.4</p><p>Solve 3/(x + 1) = x/(x + 1).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -1]]></text>
      <feedback format="html">
        <text><![CDATA[This value is restricted.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 1]]></text>
      <feedback format="html">
        <text><![CDATA[This does not satisfy 3 = x.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[no solution]]></text>
      <feedback format="html">
        <text><![CDATA[x = 3 checks in the original equation.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x = 3, x != -1]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Multiplying by x + 1 gives 3 = x, and x = 3 is allowed.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L06_GP05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L06_GP05</p><p><strong>MLA Standard:</strong> MLA.A2.RR.4</p><p>Why is x = 2 invalid for an equation with denominator x - 2?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[it makes the denominator zero]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Rational equations cannot use values that make an original denominator zero.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[it is always negative]]></text>
      <feedback format="html">
        <text><![CDATA[x = 2 is positive.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[it makes every numerator zero]]></text>
      <feedback format="html">
        <text><![CDATA[The issue is the denominator, not every numerator.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[it cannot be checked]]></text>
      <feedback format="html">
        <text><![CDATA[It can be checked and found invalid.]]></text>
      </feedback>
    </answer>
  </question>
