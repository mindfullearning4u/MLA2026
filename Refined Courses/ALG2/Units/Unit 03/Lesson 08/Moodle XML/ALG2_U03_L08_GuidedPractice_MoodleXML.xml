  <question type="multichoice">
    <name>
      <text>ALG2_U03_L08_GP01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L08_GP01</p><p><strong>MLA Standard:</strong> Unit 3 standards synthesis; no new primary MLA standard</p><p>Simplify sqrt(72).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[6sqrt(2)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. 72 = 36*2 and the square root of 36 is 6.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[36sqrt(2)]]></text>
      <feedback format="html">
        <text><![CDATA[The square root of 36 is 6, not 36.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[8sqrt(9)]]></text>
      <feedback format="html">
        <text><![CDATA[The perfect square factor should be rooted.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[12sqrt(6)]]></text>
      <feedback format="html">
        <text><![CDATA[This does not square back to 72.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L08_GP02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L08_GP02</p><p><strong>MLA Standard:</strong> Unit 3 standards synthesis; no new primary MLA standard</p><p>What is the domain of f(x)=sqrt(x-6)?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x &lt;= 6]]></text>
      <feedback format="html">
        <text><![CDATA[That allows negative radicands.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x &gt;= 6]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The radicand must be nonnegative: x - 6 &gt;= 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x != 6]]></text>
      <feedback format="html">
        <text><![CDATA[x = 6 is allowed.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[all real numbers]]></text>
      <feedback format="html">
        <text><![CDATA[Inputs less than 6 are not allowed.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L08_GP03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L08_GP03</p><p><strong>MLA Standard:</strong> Unit 3 standards synthesis; no new primary MLA standard</p><p>Solve sqrt(x+3)=5.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 2]]></text>
      <feedback format="html">
        <text><![CDATA[This subtracts from 5 instead of 25.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 28]]></text>
      <feedback format="html">
        <text><![CDATA[This adds 3 instead of subtracting it.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x = 22]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Square both sides to get x + 3 = 25.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 5]]></text>
      <feedback format="html">
        <text><![CDATA[This is the square root value, not x.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L08_GP04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L08_GP04</p><p><strong>MLA Standard:</strong> Unit 3 standards synthesis; no new primary MLA standard</p><p>Simplify (x&#178;-16)/(x-4).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x - 4, x != 4]]></text>
      <feedback format="html">
        <text><![CDATA[The remaining factor is x + 4.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x + 4, no restriction]]></text>
      <feedback format="html">
        <text><![CDATA[The original denominator excludes 4.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x&#178;+4]]></text>
      <feedback format="html">
        <text><![CDATA[The numerator must be factored.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x + 4, x != 4]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Factor and cancel x - 4 while keeping the original restriction.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L08_GP05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L08_GP05</p><p><strong>MLA Standard:</strong> Unit 3 standards synthesis; no new primary MLA standard</p><p>What is the vertical asymptote of f(x)=7/(x+2)?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[x = -2]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Set x + 2 equal to 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 2]]></text>
      <feedback format="html">
        <text><![CDATA[The sign is reversed.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y = -2]]></text>
      <feedback format="html">
        <text><![CDATA[Vertical asymptotes use x = value.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y = 7]]></text>
      <feedback format="html">
        <text><![CDATA[The numerator is not the asymptote.]]></text>
      </feedback>
    </answer>
  </question>
