    <answer fraction="0" format="html">
      <text><![CDATA[the graph crosses x=2]]></text>
      <feedback format="html">
        <text><![CDATA[The function is undefined at x=2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[the graph has horizontal asymptote x=2]]></text>
      <feedback format="html">
        <text><![CDATA[Horizontal asymptotes use y = value.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[the graph approaches a vertical asymptote]]></text>
