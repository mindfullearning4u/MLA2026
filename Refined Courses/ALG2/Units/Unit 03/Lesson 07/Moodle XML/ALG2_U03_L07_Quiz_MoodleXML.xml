<?xml version='1.0' encoding='utf-8'?>
<quiz>
  <question type="category">
    <category>
      <text>$course$/ALG2/Units/Unit 03/Lesson 07/ALG2_U03_L07_Quiz</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L07_Q01</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U03_L07_Q01&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.RR.5; MLA.A2.RR.6&lt;/p&gt;&lt;p&gt;What is the vertical asymptote of f(x)=4/(x-6)?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>x = 6</text>
      <feedback format="html">
        <text>Correct. The denominator is zero at x = 6.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>x = -6</text>
      <feedback format="html">
        <text>The sign is reversed.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>y = 6</text>
      <feedback format="html">
        <text>Vertical asymptotes use x = value.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>x = 4</text>
      <feedback format="html">
        <text>The numerator does not set the vertical asymptote.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L07_Q02</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U03_L07_Q02&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.RR.5; MLA.A2.RR.6&lt;/p&gt;&lt;p&gt;What is the domain of f(x)=2/(x+9)?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>x != 9</text>
      <feedback format="html">
        <text>The sign is reversed.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>x != -9</text>
      <feedback format="html">
        <text>Correct. The denominator x + 9 cannot be zero.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>all real numbers</text>
      <feedback format="html">
        <text>x = -9 is not allowed.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>x &amp;gt;= -9</text>
      <feedback format="html">
        <text>That is not the rational-domain restriction.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L07_Q03</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U03_L07_Q03&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.RR.5; MLA.A2.RR.6&lt;/p&gt;&lt;p&gt;What is the horizontal asymptote of f(x)=7/x?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>x = 0</text>
      <feedback format="html">
        <text>That is the vertical asymptote.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>y = 7</text>
      <feedback format="html">
        <text>The output does not approach 7.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>y = 0</text>
      <feedback format="html">
        <text>Correct. As x grows large, 7/x approaches 0.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>x = 7</text>
      <feedback format="html">
        <text>This is not an asymptote of 7/x.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L07_Q04</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U03_L07_Q04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.RR.5; MLA.A2.RR.6&lt;/p&gt;&lt;p&gt;What is the horizontal asymptote of f(x)=(5x-1)/(2x+3)?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>x = -3/2</text>
      <feedback format="html">
        <text>That is the vertical asymptote.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>y = 0</text>
      <feedback format="html">
        <text>Equal degrees do not give 0 here.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>y = 5</text>
      <feedback format="html">
        <text>This ignores the denominator leading coefficient.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>y = 5/2</text>
      <feedback format="html">
        <text>Correct. Equal degrees use the ratio of leading coefficients.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L07_Q05</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U03_L07_Q05&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.RR.5; MLA.A2.RR.6&lt;/p&gt;&lt;p&gt;Which input is restricted for f(x)=3/(x-8)?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>x = 8</text>
      <feedback format="html">
        <text>Correct. x - 8 = 0 when x = 8.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>x = -8</text>
      <feedback format="html">
        <text>The sign is reversed.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>x = 3</text>
      <feedback format="html">
        <text>The numerator does not restrict the domain.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>x = 0</text>
      <feedback format="html">
        <text>The denominator is not zero at 0.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L07_Q06</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U03_L07_Q06&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.RR.5; MLA.A2.RR.6&lt;/p&gt;&lt;p&gt;A rational model C(n)=240/n gives cost per person. What does n=0 mean?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>cost is 0</text>
      <feedback format="html">
        <text>Division by zero is undefined.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>not allowed because zero people cannot share the cost</text>
      <feedback format="html">
        <text>Correct. The denominator cannot be zero, and the context has no zero-person group.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>cost is 240</text>
      <feedback format="html">
        <text>240/0 is not 240.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>it is the horizontal asymptote</text>
      <feedback format="html">
        <text>n=0 is a restricted input.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L07_Q07</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U03_L07_Q07&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.RR.5; MLA.A2.RR.6&lt;/p&gt;&lt;p&gt;What happens to f(x)=1/(x-2) as x gets close to 2?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>the graph crosses x=2</text>
      <feedback format="html">
        <text>The function is undefined at x=2.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>the graph has horizontal asymptote x=2</text>
      <feedback format="html">
        <text>Horizontal asymptotes use y = value.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>the graph approaches a vertical asymptote</text>
      <feedback format="html">
        <text>Correct. The denominator approaches 0, so outputs grow without bound in magnitude.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>the function equals 0</text>
      <feedback format="html">
        <text>1/(x-2) is not 0 near x=2.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L07_Q08</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U03_L07_Q08&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.RR.5; MLA.A2.RR.6&lt;/p&gt;&lt;p&gt;What is the vertical asymptote of f(x)=(x+1)/(x+4)?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>x = 1</text>
      <feedback format="html">
        <text>The numerator zero is not the vertical asymptote.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>x = 4</text>
      <feedback format="html">
        <text>The sign is reversed.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>y = 1</text>
      <feedback format="html">
        <text>This is the horizontal asymptote.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>x = -4</text>
      <feedback format="html">
        <text>Correct. The denominator is zero when x = -4.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L07_Q09</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U03_L07_Q09&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.RR.5; MLA.A2.RR.6&lt;/p&gt;&lt;p&gt;What is the horizontal asymptote of f(x)=(x+1)/(x+4)?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>y = 1</text>
      <feedback format="html">
        <text>Correct. Equal degrees have leading coefficient ratio 1/1.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>x = -4</text>
      <feedback format="html">
        <text>That is the vertical asymptote.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>y = 0</text>
      <feedback format="html">
        <text>Equal degrees do not approach 0 here.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>y = 4</text>
      <feedback format="html">
        <text>The constant is not the horizontal asymptote.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L07_Q10</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U03_L07_Q10&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.RR.5; MLA.A2.RR.6&lt;/p&gt;&lt;p&gt;Which graph feature comes from a denominator factor that does not cancel?&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Representation:&lt;/strong&gt;&lt;/p&gt;&lt;table border=1 cellpadding=4 cellspacing=0&gt;&lt;tr&gt;&lt;th&gt;Rational graph feature&lt;/th&gt;&lt;th&gt;Meaning&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Uncancelled denominator factor&lt;/td&gt;&lt;td&gt;Vertical asymptote&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Canceled common factor&lt;/td&gt;&lt;td&gt;Hole/removable discontinuity&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>x-intercept</text>
      <feedback format="html">
        <text>x-intercepts come from numerator zeros.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>vertical asymptote</text>
      <feedback format="html">
        <text>Correct. A non-canceled denominator factor creates a restricted input and often a vertical asymptote.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>y-intercept</text>
      <feedback format="html">
        <text>The y-intercept comes from f(0).</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>slope</text>
      <feedback format="html">
        <text>Rational functions are not analyzed by one line slope.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L07_Q11</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U03_L07_Q11&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.RR.5; MLA.A2.RR.6&lt;/p&gt;&lt;p&gt;What is the domain of f(x)=(x-1)/((x+3)(x-5))?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>x != 1</text>
      <feedback format="html">
        <text>The numerator does not restrict the domain.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>x != 3 and x != -5</text>
      <feedback format="html">
        <text>Both signs are reversed.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>x != -3 and x != 5</text>
      <feedback format="html">
        <text>Correct. Both denominator factors create restrictions.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>all real numbers</text>
      <feedback format="html">
        <text>The denominator is zero at -3 and 5.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L07_Q12</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U03_L07_Q12&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.RR.5; MLA.A2.RR.6&lt;/p&gt;&lt;p&gt;For f(x)=6/(x+1), what is the vertical asymptote?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>x = 1</text>
      <feedback format="html">
        <text>The sign is reversed.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>y = -1</text>
      <feedback format="html">
        <text>Vertical asymptotes use x = value.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>y = 6</text>
      <feedback format="html">
        <text>The numerator is not the vertical asymptote.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>x = -1</text>
      <feedback format="html">
        <text>Correct. Set x + 1 equal to 0.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L07_Q13</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U03_L07_Q13&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.RR.5; MLA.A2.RR.6&lt;/p&gt;&lt;p&gt;For f(x)=6/(x+1), what is the horizontal asymptote?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>y = 0</text>
      <feedback format="html">
        <text>Correct. A constant over a linear expression approaches 0 as x grows.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>x = -1</text>
      <feedback format="html">
        <text>That is the vertical asymptote.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>y = 6</text>
      <feedback format="html">
        <text>The output does not approach 6.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>x = 0</text>
      <feedback format="html">
        <text>Horizontal asymptotes use y = value.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L07_Q14</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U03_L07_Q14&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.RR.5; MLA.A2.RR.6&lt;/p&gt;&lt;p&gt;If R(t)=100/(t+5), what input is restricted?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>t = 5</text>
      <feedback format="html">
        <text>The sign is reversed.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>t = -5</text>
      <feedback format="html">
        <text>Correct. The denominator is zero when t + 5 = 0.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>t = 100</text>
      <feedback format="html">
        <text>The numerator does not create the restriction.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>t = 0</text>
      <feedback format="html">
        <text>The denominator is 5 at t = 0.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L07_Q15</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U03_L07_Q15&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.RR.5; MLA.A2.RR.6&lt;/p&gt;&lt;p&gt;In a time model T(r)=60/r, what happens as rate r increases?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>time increases without bound</text>
      <feedback format="html">
        <text>That happens as r approaches 0, not as r increases.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>time stays 60</text>
      <feedback format="html">
        <text>The denominator changes the output.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>time decreases toward 0</text>
      <feedback format="html">
        <text>Correct. A larger denominator makes the quotient smaller.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>r becomes restricted at 60</text>
      <feedback format="html">
        <text>The restriction is r = 0.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L07_Q16</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U03_L07_Q16&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.RR.5; MLA.A2.RR.6&lt;/p&gt;&lt;p&gt;What is the y-intercept of f(x)=2/(x+1)?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>(0, 1)</text>
      <feedback format="html">
        <text>The output is 2, not 1.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>(-1, 0)</text>
      <feedback format="html">
        <text>x = -1 is restricted, not an intercept.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>(2, 0)</text>
      <feedback format="html">
        <text>This switches input and output.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>(0, 2)</text>
      <feedback format="html">
        <text>Correct. Substitute x = 0 to get 2/1 = 2.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L07_Q17</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U03_L07_Q17&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.RR.5; MLA.A2.RR.6&lt;/p&gt;&lt;p&gt;Which statement is true for f(x)=1/(x+3)?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>x = -3 is not in the domain</text>
      <feedback format="html">
        <text>Correct. The denominator is zero at x = -3.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>x = 3 is not in the domain</text>
      <feedback format="html">
        <text>The sign is reversed.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>all real numbers are in the domain</text>
      <feedback format="html">
        <text>One value is restricted.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>y = -3 is a vertical asymptote</text>
      <feedback format="html">
        <text>Vertical asymptotes use x = value.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L07_Q18</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U03_L07_Q18&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.RR.5; MLA.A2.RR.6&lt;/p&gt;&lt;p&gt;What is the vertical asymptote of f(x)=9/(2x-4)?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>x = -2</text>
      <feedback format="html">
        <text>The sign is wrong.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>x = 2</text>
      <feedback format="html">
        <text>Correct. Solve 2x - 4 = 0.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>x = 4</text>
      <feedback format="html">
        <text>This ignores the coefficient 2.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>y = 2</text>
      <feedback format="html">
        <text>A vertical asymptote uses x = value.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L07_Q19</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U03_L07_Q19&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.RR.5; MLA.A2.RR.6&lt;/p&gt;&lt;p&gt;What does a horizontal asymptote describe?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>a restricted input</text>
      <feedback format="html">
        <text>That is usually a vertical asymptote.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>where the graph crosses the x-axis</text>
      <feedback format="html">
        <text>That is an x-intercept.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>long-run output behavior</text>
      <feedback format="html">
        <text>Correct. It shows what y-value the function approaches as x becomes very large or very small.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>the exact value at every x</text>
      <feedback format="html">
        <text>An asymptote is approached, not necessarily reached.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L07_Q20</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U03_L07_Q20&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.RR.5; MLA.A2.RR.6&lt;/p&gt;&lt;p&gt;What is the horizontal asymptote of f(x)=(2x+7)/(x-3)?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>x = 3</text>
      <feedback format="html">
        <text>That is the vertical asymptote.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>y = 7</text>
      <feedback format="html">
        <text>This uses the constant.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>y = 0</text>
      <feedback format="html">
        <text>Equal degrees do not approach 0 here.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>y = 2</text>
      <feedback format="html">
        <text>Correct. The ratio of leading coefficients is 2/1.</text>
      </feedback>
    </answer>
  </question>
</quiz>