    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L07_Q16</p><p><strong>MLA Standard:</strong> MLA.A2.RR.5; MLA.A2.RR.6</p><p>What is the y-intercept of f(x)=2/(x+1)?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[(0, 1)]]></text>
      <feedback format="html">
        <text><![CDATA[The output is 2, not 1.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(-1, 0)]]></text>
      <feedback format="html">
        <text><![CDATA[x = -1 is restricted, not an intercept.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(2, 0)]]></text>
      <feedback format="html">
        <text><![CDATA[This switches input and output.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[(0, 2)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Substitute x = 0 to get 2/1 = 2.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L07_Q17</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L07_Q17</p><p><strong>MLA Standard:</strong> MLA.A2.RR.5; MLA.A2.RR.6</p><p>Which statement is true for f(x)=1/(x+3)?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[x = -3 is not in the domain]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The denominator is zero at x = -3.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 3 is not in the domain]]></text>
      <feedback format="html">
        <text><![CDATA[The sign is reversed.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[all real numbers are in the domain]]></text>
      <feedback format="html">
        <text><![CDATA[One value is restricted.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y = -3 is a vertical asymptote]]></text>
      <feedback format="html">
        <text><![CDATA[Vertical asymptotes use x = value.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L07_Q18</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L07_Q18</p><p><strong>MLA Standard:</strong> MLA.A2.RR.5; MLA.A2.RR.6</p><p>What is the vertical asymptote of f(x)=9/(2x-4)?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -2]]></text>
      <feedback format="html">
        <text><![CDATA[The sign is wrong.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x = 2]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Solve 2x - 4 = 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 4]]></text>
      <feedback format="html">
        <text><![CDATA[This ignores the coefficient 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y = 2]]></text>
      <feedback format="html">
        <text><![CDATA[A vertical asymptote uses x = value.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L07_Q19</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L07_Q19</p><p><strong>MLA Standard:</strong> MLA.A2.RR.5; MLA.A2.RR.6</p><p>What does a horizontal asymptote describe?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[a restricted input]]></text>
      <feedback format="html">
        <text><![CDATA[That is usually a vertical asymptote.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[where the graph crosses the x-axis]]></text>
      <feedback format="html">
        <text><![CDATA[That is an x-intercept.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[long-run output behavior]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. It shows what y-value the function approaches as x becomes very large or very small.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[the exact value at every x]]></text>
      <feedback format="html">
        <text><![CDATA[An asymptote is approached, not necessarily reached.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L07_Q20</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L07_Q20</p><p><strong>MLA Standard:</strong> MLA.A2.RR.5; MLA.A2.RR.6</p><p>What is the horizontal asymptote of f(x)=(2x+7)/(x-3)?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 3]]></text>
      <feedback format="html">
        <text><![CDATA[That is the vertical asymptote.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y = 7]]></text>
      <feedback format="html">
        <text><![CDATA[This uses the constant.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[y = 0]]></text>
      <feedback format="html">
        <text><![CDATA[Equal degrees do not approach 0 here.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[y = 2]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The ratio of leading coefficients is 2/1.]]></text>
      </feedback>
    </answer>
  </question>
