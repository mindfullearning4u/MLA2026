    <answer fraction="0" format="html">
      <text><![CDATA[cost is 0]]></text>
      <feedback format="html">
        <text><![CDATA[Division by zero is undefined.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[not allowed because zero people cannot share the cost]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The denominator cannot be zero, and the context has no zero-person group.]]></text>
      </feedback>
    </answer>
