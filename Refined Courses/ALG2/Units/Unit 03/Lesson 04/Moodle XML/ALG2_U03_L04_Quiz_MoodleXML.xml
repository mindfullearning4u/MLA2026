  <question type="multichoice">
    <name>
      <text>ALG2_U03_L04_Q18</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L04_Q18</p><p><strong>MLA Standard:</strong> MLA.A2.AE.6</p><p>Multiply (x/(x - 2))((x - 2)/(x + 1)).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x/(x - 2), x != 2]]></text>
      <feedback format="html">
        <text><![CDATA[The x - 2 factor cancels.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x/(x + 1), x != 2 and x != -1]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Cancel x - 2 and keep restrictions from original denominators.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x/(x + 1), no restriction]]></text>
      <feedback format="html">
        <text><![CDATA[Original denominators create restrictions.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[1/(x + 1)]]></text>
      <feedback format="html">
        <text><![CDATA[The numerator x remains.]]></text>
      </feedback>
    </answer>
