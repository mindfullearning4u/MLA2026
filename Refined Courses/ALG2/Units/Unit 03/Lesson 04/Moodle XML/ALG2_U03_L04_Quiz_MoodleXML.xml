  <question type="multichoice">
    <name>
      <text>ALG2_U03_L04_Q19</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L04_Q19</p><p><strong>MLA Standard:</strong> MLA.A2.AE.6</p><p>Which expression is undefined at x = 6?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[(x - 6)/4]]></text>
      <feedback format="html">
        <text><![CDATA[The denominator is 4, not zero.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x + 6]]></text>
      <feedback format="html">
        <text><![CDATA[This polynomial is defined for all real x.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[4/(x - 6)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The denominator is zero when x = 6.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[6/x]]></text>
      <feedback format="html">
        <text><![CDATA[This is undefined at x = 0, not x = 6.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L04_Q20</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L04_Q20</p><p><strong>MLA Standard:</strong> MLA.A2.AE.6</p><p>Simplify (x&#178; - 4)/(x&#178; + 3x + 2).</p>]]></text>
