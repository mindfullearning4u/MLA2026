    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L04_Q17</p><p><strong>MLA Standard:</strong> MLA.A2.AE.6</p><p>Simplify (12x&#178;y)/(3xy), assuming variables in denominators are nonzero.</p>]]></text>
