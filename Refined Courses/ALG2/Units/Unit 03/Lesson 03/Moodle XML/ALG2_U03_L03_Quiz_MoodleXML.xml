    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -3]]></text>
      <feedback format="html">
        <text><![CDATA[x = -3 fails because the right side is negative.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x = 4]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Squaring gives x + 12 = x&#178;, so x = 4 or -3; only x = 4 checks.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -3 and x = 4]]></text>
      <feedback format="html">
        <text><![CDATA[Only x = 4 checks in the original equation.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[no solution]]></text>
      <feedback format="html">
        <text><![CDATA[x = 4 satisfies the original equation.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L03_Q15</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L03_Q15</p><p><strong>MLA Standard:</strong> MLA.A2.RR.1; MLA.A2.RR.3</p><p>A solution to a radical model is t = -4 seconds. What should happen in context?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[keep it because all algebraic solutions work]]></text>
      <feedback format="html">
        <text><![CDATA[Context restrictions must be checked.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[change it to t = 4]]></text>
      <feedback format="html">
        <text><![CDATA[Changing the sign changes the solution.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[reject it because time cannot be negative]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Elapsed time is usually restricted to nonnegative values.]]></text>
