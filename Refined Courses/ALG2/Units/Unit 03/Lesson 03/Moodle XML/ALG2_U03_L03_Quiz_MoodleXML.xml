  <question type="multichoice">
    <name>
      <text>ALG2_U03_L03_Q08</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L03_Q08</p><p><strong>MLA Standard:</strong> MLA.A2.RR.1; MLA.A2.RR.3</p><p>A model h = sqrt(64t) gives height-related output h. If h = 16, find t.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[t = 2]]></text>
      <feedback format="html">
        <text><![CDATA[This divides 16 by 8 but does not square first.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[t = 8]]></text>
      <feedback format="html">
        <text><![CDATA[This does not solve 256 = 64t.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[t = 16]]></text>
      <feedback format="html">
        <text><![CDATA[This is the output value, not t.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[t = 4]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. 16 = sqrt(64t), so 256 = 64t and t = 4.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L03_Q09</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L03_Q09</p><p><strong>MLA Standard:</strong> MLA.A2.RR.1; MLA.A2.RR.3</p><p>What is the first algebraic step for sqrt(x + 8) = 9?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[square both sides]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The radical is already isolated, so square both sides to undo the square root.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[subtract 8 from both sides]]></text>
      <feedback format="html">
        <text><![CDATA[The 8 is inside the radical, so this is not the first step.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[divide by 9]]></text>
      <feedback format="html">
        <text><![CDATA[There is no coefficient to divide by.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[cube both sides]]></text>
      <feedback format="html">
        <text><![CDATA[A square root is undone by squaring.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L03_Q10</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L03_Q10</p><p><strong>MLA Standard:</strong> MLA.A2.RR.1; MLA.A2.RR.3</p><p>What makes a candidate solution extraneous in a radical equation?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[it is always outside every radical domain]]></text>
      <feedback format="html">
        <text><![CDATA[Some candidates are in the domain but still fail the original equation.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[it does not satisfy the original equation]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A candidate solution must make the original radical equation true.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[it is negative]]></text>
      <feedback format="html">
        <text><![CDATA[Negative values are not automatically extraneous; the original equation decides.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[it makes the radicand zero]]></text>
      <feedback format="html">
        <text><![CDATA[A radicand of zero can be valid if the whole original equation checks.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L03_Q11</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L03_Q11</p><p><strong>MLA Standard:</strong> MLA.A2.RR.1; MLA.A2.RR.3</p><p>Solve sqrt(x + 10) - 2 = 4.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 6]]></text>
      <feedback format="html">
        <text><![CDATA[This stops after isolating the square root.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 14]]></text>
      <feedback format="html">
        <text><![CDATA[This squares 4 before isolating the radical.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x = 26]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Add 2 to get sqrt(x + 10) = 6, then square to get x + 10 = 36.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 38]]></text>
      <feedback format="html">
        <text><![CDATA[This adds 10 instead of subtracting it after squaring.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L03_Q12</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L03_Q12</p><p><strong>MLA Standard:</strong> MLA.A2.RR.1; MLA.A2.RR.3</p><p>Solve 2sqrt(x - 1) = 10.</p>]]></text>
