    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 5]]></text>
      <feedback format="html">
        <text><![CDATA[This adds 1 to 4 instead of cubing 4.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x = 65]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Cubing gives x - 1 = 64, so x = 65.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 63]]></text>
      <feedback format="html">
        <text><![CDATA[This subtracts 1 after cubing instead of adding it.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 16]]></text>
      <feedback format="html">
        <text><![CDATA[This uses 4 squared, not 4 cubed.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L03_Q07</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L03_Q07</p><p><strong>MLA Standard:</strong> MLA.A2.RR.1; MLA.A2.RR.3</p><p>Solve sqrt(x/2) = 3.</p>]]></text>
