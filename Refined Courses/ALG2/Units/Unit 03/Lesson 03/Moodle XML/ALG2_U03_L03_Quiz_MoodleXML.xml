    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 10]]></text>
      <feedback format="html">
        <text><![CDATA[This does not account for squaring 7.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x = 23]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Squaring gives 2x + 3 = 49, so x = 23.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 26]]></text>
      <feedback format="html">
        <text><![CDATA[This forgets to divide by 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 46]]></text>
      <feedback format="html">
        <text><![CDATA[This subtracts 3 but does not divide by 2.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L03_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L03_Q03</p><p><strong>MLA Standard:</strong> MLA.A2.RR.1; MLA.A2.RR.3</p><p>Solve sqrt(x + 1) = x - 1.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 0]]></text>
      <feedback format="html">
        <text><![CDATA[x = 0 is extraneous because the right side is -1.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 0 and x = 3]]></text>
      <feedback format="html">
        <text><![CDATA[Both arise after squaring, but x = 0 fails the original equation.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x = 3]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Squaring gives x + 1 = x&#178; - 2x + 1, so x(x - 3) = 0; only x = 3 checks.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[no solution]]></text>
      <feedback format="html">
        <text><![CDATA[x = 3 satisfies the original equation.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L03_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L03_Q04</p><p><strong>MLA Standard:</strong> MLA.A2.RR.1; MLA.A2.RR.3</p><p>Solve sqrt(4x - 3) = 5.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 5]]></text>
      <feedback format="html">
        <text><![CDATA[This does not make the radicand 25.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 22]]></text>
      <feedback format="html">
        <text><![CDATA[This misses division by 4.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 28]]></text>
      <feedback format="html">
        <text><![CDATA[This is 4x, not x.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x = 7]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Squaring gives 4x - 3 = 25, so 4x = 28 and x = 7.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L03_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L03_Q05</p><p><strong>MLA Standard:</strong> MLA.A2.RR.1; MLA.A2.RR.3</p><p>Which solution checks for sqrt(x + 4) = x - 2?</p>]]></text>
