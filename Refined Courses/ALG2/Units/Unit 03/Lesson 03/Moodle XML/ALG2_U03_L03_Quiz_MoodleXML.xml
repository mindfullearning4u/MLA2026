    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[x = 5]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Squaring gives x = 0 or x = 5, but x = 0 makes the right side negative.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 0]]></text>
      <feedback format="html">
        <text><![CDATA[x = 0 is extraneous because 2 is not equal to -2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 0 and x = 5]]></text>
      <feedback format="html">
        <text><![CDATA[Only x = 5 checks in the original equation.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[no solution]]></text>
      <feedback format="html">
        <text><![CDATA[x = 5 satisfies the original equation.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L03_Q06</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L03_Q06</p><p><strong>MLA Standard:</strong> MLA.A2.RR.1; MLA.A2.RR.3</p><p>Solve cuberoot(x - 1) = 4.</p>]]></text>
