  <question type="multichoice">
    <name>
      <text>ALG2_U03_L03_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L03_Q01</p><p><strong>MLA Standard:</strong> MLA.A2.RR.1; MLA.A2.RR.3</p><p>Solve sqrt(x - 4) = 6.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[x = 40]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Squaring gives x - 4 = 36, so x = 40.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 10]]></text>
      <feedback format="html">
        <text><![CDATA[This adds 4 to 6 rather than to 36.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 32]]></text>
      <feedback format="html">
        <text><![CDATA[This subtracts 4 after squaring instead of adding it.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 2]]></text>
      <feedback format="html">
        <text><![CDATA[This does not satisfy the original radical equation.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L03_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L03_Q02</p><p><strong>MLA Standard:</strong> MLA.A2.RR.1; MLA.A2.RR.3</p><p>Solve sqrt(2x + 3) = 7.</p>]]></text>
