  <question type="multichoice">
    <name>
      <text>ALG2_U03_L01_GP01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L01_GP01</p><p><strong>MLA Standard:</strong> MLA.A2.AE.7; MLA.A2.AE.8</p><p>Simplify sqrt(50).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[5sqrt(2)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. 50 = 25 times 2, and sqrt(25) = 5.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[25sqrt(2)]]></text>
      <feedback format="html">
        <text><![CDATA[The square root of 25 is 5, not 25.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[2sqrt(25)]]></text>
      <feedback format="html">
        <text><![CDATA[The perfect-square factor should be rooted.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[10sqrt(5)]]></text>
      <feedback format="html">
        <text><![CDATA[This does not square back to 50.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L01_GP02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L01_GP02</p><p><strong>MLA Standard:</strong> MLA.A2.AE.7; MLA.A2.AE.8</p><p>Rewrite x&#178;⁄&#179; in radical form.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[sqrt(x&#179;)]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the numerator and denominator.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[cuberoot(x&#178;)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The denominator 3 is the root index and the numerator 2 is the power.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[sqrt(x&#179;)]]></text>
      <feedback format="html">
        <text><![CDATA[This uses the numerator as the root index.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[3x&#178;]]></text>
      <feedback format="html">
        <text><![CDATA[A rational exponent does not become multiplication by the denominator.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L01_GP03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L01_GP03</p><p><strong>MLA Standard:</strong> MLA.A2.AE.7; MLA.A2.AE.8</p><p>Evaluate 125&#185;⁄&#179;.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[25]]></text>
      <feedback format="html">
        <text><![CDATA[This is not the cube root of 125.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[15]]></text>
      <feedback format="html">
        <text><![CDATA[This is not a root of 125.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[5]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. 5&#179; = 125.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[3]]></text>
      <feedback format="html">
        <text><![CDATA[The denominator tells the root index, not the answer.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L01_GP04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L01_GP04</p><p><strong>MLA Standard:</strong> MLA.A2.AE.7; MLA.A2.AE.8</p><p>Simplify sqrt(108).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[18sqrt(6)]]></text>
      <feedback format="html">
        <text><![CDATA[The square root of 36 is 6, not 36 or 18.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[3sqrt(12)]]></text>
      <feedback format="html">
        <text><![CDATA[This is not fully simplified because 12 has a square factor.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[54sqrt(2)]]></text>
      <feedback format="html">
        <text><![CDATA[This does not simplify the square factor correctly.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[6sqrt(3)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. 108 = 36 times 3, so sqrt(108) = 6sqrt(3).]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U03_L01_GP05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U03_L01_GP05</p><p><strong>MLA Standard:</strong> MLA.A2.AE.7; MLA.A2.AE.8</p><p>Evaluate 16&#179;⁄⁴.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[8]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The fourth root of 16 is 2, and 2&#179; = 8.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[12]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies the exponent parts instead of applying a root and power.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[64]]></text>
      <feedback format="html">
        <text><![CDATA[This uses 4 cubed but ignores the fourth root.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4]]></text>
      <feedback format="html">
        <text><![CDATA[This stops at the fourth root and does not apply the power 3.]]></text>
      </feedback>
    </answer>
  </question>
