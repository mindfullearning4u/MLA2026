  <question type="multichoice">
    <name>
      <text>ALG2_U04_L01_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U04_L01_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A2.EX.1</p><p>Which table shows exponential behavior?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[1, 3, 9, 27]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The outputs multiply by 3 each step, so the pattern is exponential.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[2, 5, 8, 11]]></text>
      <feedback format="html">
        <text><![CDATA[This pattern adds 3 each step, so it is linear.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4, 9, 14, 19]]></text>
      <feedback format="html">
        <text><![CDATA[This pattern adds 5 each step, so it is linear.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[10, 8, 6, 4]]></text>
      <feedback format="html">
        <text><![CDATA[This pattern subtracts 2 each step, so it is linear.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L01_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U04_L01_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A2.EX.1</p><p>In f(x) = 6(4)ˣ, what is the initial value?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[4]]></text>
      <feedback format="html">
        <text><![CDATA[This is the base, not the initial value.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[6]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The initial value is a, the output when x = 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[10]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the two parameters instead of identifying the initial value.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[24]]></text>
      <feedback format="html">
        <text><![CDATA[This is f(1), not f(0).]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L01_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U04_L01_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A2.EX.1</p><p>A pattern starts at 5 and triples each step. Which function models it?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[f(x) = 3(5)ˣ]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the initial value and base.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[f(x) = 5 + 3x]]></text>
      <feedback format="html">
        <text><![CDATA[This models adding 3, not multiplying by 3.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[f(x) = 5(3)ˣ]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The initial value is 5 and the repeated factor is 3.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[f(x) = 15x]]></text>
      <feedback format="html">
        <text><![CDATA[This is linear and does not include repeated multiplication.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L01_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U04_L01_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A2.EX.1</p><p>What is f(3) for f(x) = 2(3)ˣ?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[18]]></text>
      <feedback format="html">
        <text><![CDATA[This uses 3 squared instead of 3 cubed.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[27]]></text>
      <feedback format="html">
        <text><![CDATA[This finds only 3 cubed and ignores the initial factor 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[162]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies by an extra factor of 3.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[54]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Compute 2 times 3 cubed, so 2 times 27 = 54.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L01_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U04_L01_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A2.EX.1</p><p>A population begins at 80 and doubles every hour. Which model fits?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[P(t) = 80(2)ᵗ]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The initial amount is 80 and doubling means the base is 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[P(t) = 2(80)ᵗ]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the initial amount and base.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[P(t) = 80 + 2t]]></text>
      <feedback format="html">
        <text><![CDATA[This models adding 2 each hour, not doubling.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[P(t) = 160t]]></text>
      <feedback format="html">
        <text><![CDATA[This is linear and does not represent repeated doubling.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>