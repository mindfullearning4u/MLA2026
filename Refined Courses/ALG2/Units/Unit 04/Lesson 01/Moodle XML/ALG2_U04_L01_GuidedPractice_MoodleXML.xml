<quiz>
  <question type="category">
    <category>
      <text>$course$/ALG2/Units/Unit 04/Lesson 01/ALG2_U04_L01_GuidedPractice</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L01_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U04_L01_GP_Q01&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.EX.1&lt;/p&gt;&lt;p&gt;Which table shows exponential behavior?&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Representation:&lt;/strong&gt;&lt;/p&gt;&lt;table border=1 cellpadding=4 cellspacing=0&gt;&lt;tr&gt;&lt;th&gt;Option&lt;/th&gt;&lt;th&gt;Values&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;A&lt;/td&gt;&lt;td&gt;1, 3, 9, 27&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;B&lt;/td&gt;&lt;td&gt;2, 5, 8, 11&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C&lt;/td&gt;&lt;td&gt;4, 9, 14, 19&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D&lt;/td&gt;&lt;td&gt;10, 8, 6, 4&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>1, 3, 9, 27</text>
      <feedback format="html">
        <text>Correct. The outputs multiply by 3 each step, so the pattern is exponential.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>2, 5, 8, 11</text>
      <feedback format="html">
        <text>This pattern adds 3 each step, so it is linear.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>4, 9, 14, 19</text>
      <feedback format="html">
        <text>This pattern adds 5 each step, so it is linear.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>10, 8, 6, 4</text>
      <feedback format="html">
        <text>This pattern subtracts 2 each step, so it is linear.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L01_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U04_L01_GP_Q02&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.EX.1&lt;/p&gt;&lt;p&gt;In f(x) = 6(4)ˣ, what is the initial value?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>4</text>
      <feedback format="html">
        <text>This is the base, not the initial value.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>6</text>
      <feedback format="html">
        <text>Correct. The initial value is a, the output when x = 0.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>10</text>
      <feedback format="html">
        <text>This adds the two parameters instead of identifying the initial value.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>24</text>
      <feedback format="html">
        <text>This is f(1), not f(0).</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L01_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U04_L01_GP_Q03&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.EX.1&lt;/p&gt;&lt;p&gt;A pattern starts at 5 and triples each step. Which function models it?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>f(x) = 3(5)ˣ</text>
      <feedback format="html">
        <text>This reverses the initial value and base.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>f(x) = 5 + 3x</text>
      <feedback format="html">
        <text>This models adding 3, not multiplying by 3.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>f(x) = 5(3)ˣ</text>
      <feedback format="html">
        <text>Correct. The initial value is 5 and the repeated factor is 3.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>f(x) = 15x</text>
      <feedback format="html">
        <text>This is linear and does not include repeated multiplication.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L01_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U04_L01_GP_Q04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.EX.1&lt;/p&gt;&lt;p&gt;What is f(3) for f(x) = 2(3)ˣ?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>18</text>
      <feedback format="html">
        <text>This uses 3 squared instead of 3 cubed.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>27</text>
      <feedback format="html">
        <text>This finds only 3 cubed and ignores the initial factor 2.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>162</text>
      <feedback format="html">
        <text>This multiplies by an extra factor of 3.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>54</text>
      <feedback format="html">
        <text>Correct. Compute 2 times 3 cubed, so 2 times 27 = 54.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L01_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U04_L01_GP_Q05&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.EX.1&lt;/p&gt;&lt;p&gt;A population begins at 80 and doubles every hour. Which model fits?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>P(t) = 80(2)ᵗ</text>
      <feedback format="html">
        <text>Correct. The initial amount is 80 and doubling means the base is 2.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>P(t) = 2(80)ᵗ</text>
      <feedback format="html">
        <text>This reverses the initial amount and base.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>P(t) = 80 + 2t</text>
      <feedback format="html">
        <text>This models adding 2 each hour, not doubling.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>P(t) = 160t</text>
      <feedback format="html">
        <text>This is linear and does not represent repeated doubling.</text>
      </feedback>
    </answer>
  </question>
</quiz>