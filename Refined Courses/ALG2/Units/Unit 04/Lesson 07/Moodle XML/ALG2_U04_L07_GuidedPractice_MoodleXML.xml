  <question type="multichoice">
    <name>
      <text>ALG2_U04_L07_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U04_L07_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A2.LOG.3</p><p>A population starts at 2000 and grows 3% per year. Which model fits?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[P(t)=2000(1.03)ᵗ]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The initial amount is 2000 and 3% growth gives factor 1.03.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[P(t)=2000(0.97)ᵗ]]></text>
      <feedback format="html">
        <text><![CDATA[This models 3% decay.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[P(t)=1.03(2000)ᵗ]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses initial amount and factor.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[P(t)=2000+3t]]></text>
      <feedback format="html">
        <text><![CDATA[This is linear growth.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L07_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U04_L07_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A2.LOG.3</p><p>A substance starts at 120 grams and keeps 80% each hour. Which model fits?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[A(t)=120(1.20)ᵗ]]></text>
      <feedback format="html">
        <text><![CDATA[This models 20% growth.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[A(t)=120(0.80)ᵗ]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Keeping 80% each hour means the repeated factor is 0.80.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A(t)=0.80(120)ᵗ]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses initial amount and factor.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A(t)=120-80t]]></text>
      <feedback format="html">
        <text><![CDATA[This subtracts a fixed amount and can become negative quickly.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L07_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U04_L07_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A2.LOG.3</p><p>Solve 500(1.04)ᵗ=750 for t.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[t = log(1.04)/log(750/500)]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the change-of-base ratio.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[t = 750/(500)(1.04)]]></text>
      <feedback format="html">
        <text><![CDATA[This does not isolate the exponent.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[t = log(750/500)/log(1.04)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Divide by 500, then use logarithms to solve for the exponent.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[t = 750 - 500 - 1.04]]></text>
      <feedback format="html">
        <text><![CDATA[This treats the model as linear.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L07_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U04_L07_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A2.LOG.3</p><p>In V(t)=30000(0.88)ᵗ, what does 0.88 mean?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[88% is lost each year.]]></text>
      <feedback format="html">
        <text><![CDATA[If 88% were lost, the factor would be 0.12.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The starting value is 0.88.]]></text>
      <feedback format="html">
        <text><![CDATA[The starting value is 30000.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The model grows by 88%.]]></text>
      <feedback format="html">
        <text><![CDATA[A factor less than 1 indicates decay.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[88% of the value remains each year.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A factor of 0.88 means the value keeps 88% and loses 12% per year.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L07_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U04_L07_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A2.LOG.3</p><p>Why are logarithms useful in exponential application problems?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[They solve for an unknown exponent or time.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Logarithms undo exponential expressions, so they help find time.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[They always find the initial value.]]></text>
      <feedback format="html">
        <text><![CDATA[Initial values usually come from context or the coefficient.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[They turn every model linear.]]></text>
      <feedback format="html">
        <text><![CDATA[They solve equations but do not change the model type.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[They remove the need for units.]]></text>
      <feedback format="html">
        <text><![CDATA[Application answers still need units and interpretation.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>