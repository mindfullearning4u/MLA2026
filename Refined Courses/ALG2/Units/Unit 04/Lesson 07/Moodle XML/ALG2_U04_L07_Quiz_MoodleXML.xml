      <text>ALG2_U04_L07_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U04_L07_Q01</p><p><strong>MLA Standard:</strong> MLA.A2.LOG.3</p><p>A city population of 50000 grows by 2% annually. Which model fits?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[P(t)=50000(1.02)ᵗ]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Use the initial population and growth factor 1.02.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[P(t)=50000(0.98)ᵗ]]></text>
      <feedback format="html">
        <text><![CDATA[This models 2% decay.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[P(t)=1.02(50000)ᵗ]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the parameters.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[P(t)=50000+2t]]></text>
      <feedback format="html">
        <text><![CDATA[This is linear.]]></text>
      </feedback>
    </answer>
  </question>
