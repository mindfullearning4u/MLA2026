  <question type="multichoice">
    <name>
      <text>ALG2_U04_L05_Q16</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U04_L05_Q16</p><p><strong>MLA Standard:</strong> MLA.A2.LOG.4</p><p>Which rewrite is valid?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[log_2(x + y) = log_2(x) + log_2(y)]]></text>
      <feedback format="html">
        <text><![CDATA[There is no sum property.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[log_2(x - y) = log_2(x) - log_2(y)]]></text>
      <feedback format="html">
        <text><![CDATA[There is no subtraction-inside property.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[log_2(x/y) = log_2(y) - log_2(x)]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the quotient.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[log_2(xy) = log_2(x) + log_2(y)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. This is the product property.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L05_Q17</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U04_L05_Q17</p><p><strong>MLA Standard:</strong> MLA.A2.LOG.4</p><p>Which rewrite is invalid?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[log_3(a + b) = log_3(a) + log_3(b)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. There is no logarithm property for splitting addition inside the argument.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[log_3(ab) = log_3(a) + log_3(b)]]></text>
      <feedback format="html">
        <text><![CDATA[This is valid by the product property.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[log_3(a/b) = log_3(a) - log_3(b)]]></text>
      <feedback format="html">
        <text><![CDATA[This is valid by the quotient property.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[log_3(a&#178;) = 2log_3(a)]]></text>
      <feedback format="html">
        <text><![CDATA[This is valid by the power property.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L05_Q18</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U04_L05_Q18</p><p><strong>MLA Standard:</strong> MLA.A2.LOG.4</p><p>Rewrite log_4(17) using natural logarithms.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[ln(4)/ln(17)]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses input and base.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[ln(17)/ln(4)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Change of base can use any consistent log base.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[ln(68)]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies input and base incorrectly.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[ln(17 - 4)]]></text>
      <feedback format="html">
        <text><![CDATA[This is not change of base.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L05_Q19</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U04_L05_Q19</p><p><strong>MLA Standard:</strong> MLA.A2.LOG.4</p><p>Condense log_2(x) + log_2(y) - log_2(z).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[log_2(x + y - z)]]></text>
      <feedback format="html">
        <text><![CDATA[Log properties do not preserve addition or subtraction inside the argument.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[log_2(xz/y)]]></text>
      <feedback format="html">
        <text><![CDATA[This puts the quotient in the wrong order.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[log_2(xy/z)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Addition gives multiplication and subtraction gives division.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[log_2(z/xy)]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the full quotient.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L05_Q20</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U04_L05_Q20</p><p><strong>MLA Standard:</strong> MLA.A2.LOG.4</p><p>Expand log_6((a&#178;b)/c).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[log_6(2a) + log_6(b) - log_6(c)]]></text>
      <feedback format="html">
        <text><![CDATA[The exponent should become a coefficient.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[2log_6(ab) - log_6(c)]]></text>
      <feedback format="html">
        <text><![CDATA[The exponent applies only to a.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[2log_6(a) - log_6(bc)]]></text>
      <feedback format="html">
        <text><![CDATA[This places b in the denominator incorrectly.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[2log_6(a) + log_6(b) - log_6(c)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Use power, product, and quotient properties.]]></text>
      </feedback>
    </answer>
  </question>
