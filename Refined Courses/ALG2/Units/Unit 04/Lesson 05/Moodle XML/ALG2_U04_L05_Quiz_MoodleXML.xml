  <question type="multichoice">
    <name>
      <text>ALG2_U04_L05_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U04_L05_Q01</p><p><strong>MLA Standard:</strong> MLA.A2.LOG.4</p><p>Expand log_4(ab).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[log_4(a) + log_4(b)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Use the product property.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[log_4(a) - log_4(b)]]></text>
      <feedback format="html">
        <text><![CDATA[This is the quotient pattern.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[log_4(a + b)]]></text>
      <feedback format="html">
        <text><![CDATA[This changes multiplication to addition inside one log.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[log_4(a/b)]]></text>
      <feedback format="html">
        <text><![CDATA[This is not equivalent to a product.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L05_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U04_L05_Q02</p><p><strong>MLA Standard:</strong> MLA.A2.LOG.4</p><p>Expand log_3(x/y).</p>]]></text>
