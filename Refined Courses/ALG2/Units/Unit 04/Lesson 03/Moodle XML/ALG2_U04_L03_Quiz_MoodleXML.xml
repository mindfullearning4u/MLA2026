  <question type="multichoice">
    <name>
      <text>ALG2_U04_L03_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U04_L03_Q04</p><p><strong>MLA Standard:</strong> MLA.A2.FM.2; MLA.A2.FM.3; MLA.A2.FM.4</p><p>In V(t)=18000(0.85)ᵗ, what does 0.85 mean?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[85% is lost each year.]]></text>
      <feedback format="html">
        <text><![CDATA[If 85% were lost, the factor would be 0.15.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The starting value is 0.85.]]></text>
      <feedback format="html">
        <text><![CDATA[The starting value is 18000.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The value grows by 85%.]]></text>
      <feedback format="html">
        <text><![CDATA[A factor below 1 indicates decay, not growth.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[85% of the value remains each year.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A factor of 0.85 means the value keeps 85% each period.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L03_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U04_L03_Q05</p><p><strong>MLA Standard:</strong> MLA.A2.FM.2; MLA.A2.FM.3; MLA.A2.FM.4</p><p>In A(t)=500(1.03)ᵗ, what is the annual rate?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[3% growth]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The factor 1.03 means 1 + 0.03, or 3% growth.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[103% growth]]></text>
      <feedback format="html">
        <text><![CDATA[The new amount is 103% of the previous amount, which is 3% growth.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[3% decay]]></text>
      <feedback format="html">
        <text><![CDATA[The factor is greater than 1, so it is growth.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[0.03% growth]]></text>
      <feedback format="html">
        <text><![CDATA[0.03 as a decimal equals 3%.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L03_Q06</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U04_L03_Q06</p><p><strong>MLA Standard:</strong> MLA.A2.FM.2; MLA.A2.FM.3; MLA.A2.FM.4</p><p>A computer worth 1600 loses 25% each year. Which model fits?</p>]]></text>
