    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U04_L03_Q03</p><p><strong>MLA Standard:</strong> MLA.A2.FM.2; MLA.A2.FM.3; MLA.A2.FM.4</p><p>What factor represents 12% depreciation?</p>]]></text>
