  <question type="multichoice">
    <name>
      <text>ALG2_U04_L03_Q08</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U04_L03_Q08</p><p><strong>MLA Standard:</strong> MLA.A2.FM.2; MLA.A2.FM.3; MLA.A2.FM.4</p><p>Which statement best describes compound interest?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Interest is added only once.]]></text>
      <feedback format="html">
        <text><![CDATA[That does not describe compounding.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The balance decreases every year.]]></text>
      <feedback format="html">
        <text><![CDATA[Compound interest usually models growth unless other payments change the balance.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The rate is ignored.]]></text>
      <feedback format="html">
        <text><![CDATA[The rate determines the growth factor.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Interest earns additional interest over time.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Compound interest applies growth to the updated balance each period.]]></text>
      </feedback>
    </answer>
  </question>
