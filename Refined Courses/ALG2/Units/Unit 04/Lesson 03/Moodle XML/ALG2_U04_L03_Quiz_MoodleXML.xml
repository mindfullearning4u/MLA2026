  <question type="multichoice">
    <name>
      <text>ALG2_U04_L03_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U04_L03_Q01</p><p><strong>MLA Standard:</strong> MLA.A2.FM.2; MLA.A2.FM.3; MLA.A2.FM.4</p><p>What model represents 1200 dollars earning 5% annually?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[A(t)=1200(1.05)ᵗ]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The principal is 1200 and the annual growth factor is 1.05.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A(t)=1200(0.95)ᵗ]]></text>
      <feedback format="html">
        <text><![CDATA[This models 5% decrease.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A(t)=1.05(1200)ᵗ]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses principal and factor.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A(t)=1200+5t]]></text>
      <feedback format="html">
        <text><![CDATA[This is linear growth.]]></text>
      </feedback>
    </answer>
  </question>
