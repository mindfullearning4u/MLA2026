  <question type="multichoice">
    <name>
      <text>ALG2_U04_L04_Q17</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U04_L04_Q17&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.LOG.2&lt;/p&gt;&lt;p&gt;Which graph feature belongs to y=log_10(x)?&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Representation:&lt;/strong&gt;&lt;/p&gt;&lt;table border=1 cellpadding=4 cellspacing=0&gt;&lt;tr&gt;&lt;th&gt;Graph feature&lt;/th&gt;&lt;th&gt;y = log_10(x)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Domain&lt;/td&gt;&lt;td&gt;x &gt; 0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Vertical asymptote&lt;/td&gt;&lt;td&gt;x = 0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;x-intercept&lt;/td&gt;&lt;td&gt;(1, 0)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>Vertical asymptote x = 0</text>
      <feedback format="html">
        <text>Correct. Basic logarithmic functions approach x = 0 from the right.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Horizontal asymptote y = 0</text>
      <feedback format="html">
        <text>That belongs to the exponential inverse.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Vertex at (0,0)</text>
      <feedback format="html">
        <text>Logarithmic graphs do not have a vertex.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Domain all real numbers</text>
      <feedback format="html">
        <text>The domain is positive x-values.</text>
      </feedback>
    </answer>
  </question>
