<quiz>
  <question type="category">
    <category>
      <text>$course$/ALG2/Units/Unit 04/Lesson 04/ALG2_U04_L04_Quiz</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L04_Q01</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U04_L04_Q01&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.LOG.2&lt;/p&gt;&lt;p&gt;What is log_2(8)?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>3</text>
      <feedback format="html">
        <text>Correct. 2 raised to the third power equals 8.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>2</text>
      <feedback format="html">
        <text>2 squared is 4, not 8.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>4</text>
      <feedback format="html">
        <text>2 to the fourth power is 16.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>16</text>
      <feedback format="html">
        <text>This is not the exponent needed.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L04_Q02</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U04_L04_Q02&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.LOG.2&lt;/p&gt;&lt;p&gt;What is log_3(81)?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>3</text>
      <feedback format="html">
        <text>3 cubed is 27.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>4</text>
      <feedback format="html">
        <text>Correct. 3 to the fourth power equals 81.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>9</text>
      <feedback format="html">
        <text>3 to the ninth power is much larger than 81.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>27</text>
      <feedback format="html">
        <text>This is not the exponent needed.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L04_Q03</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U04_L04_Q03&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.LOG.2&lt;/p&gt;&lt;p&gt;What is log_10(1000)?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>2</text>
      <feedback format="html">
        <text>10 squared equals 100.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>10</text>
      <feedback format="html">
        <text>10 to the tenth power is too large.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>3</text>
      <feedback format="html">
        <text>Correct. 10 cubed equals 1000.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>100</text>
      <feedback format="html">
        <text>This is not the exponent needed.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L04_Q04</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U04_L04_Q04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.LOG.2&lt;/p&gt;&lt;p&gt;Which exponential form matches log_4(64)=3?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>64&amp;#179; = 4</text>
      <feedback format="html">
        <text>This reverses input and base.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>3⁴ = 64</text>
      <feedback format="html">
        <text>This uses the output as the base.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>4 + 3 = 64</text>
      <feedback format="html">
        <text>Logarithms convert to exponent equations, not addition.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>4&amp;#179; = 64</text>
      <feedback format="html">
        <text>Correct. The base 4 raised to the logarithm output 3 equals 64.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L04_Q05</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U04_L04_Q05&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.LOG.2&lt;/p&gt;&lt;p&gt;Which logarithmic form matches 5&amp;#178; = 25?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>log_5(25)=2</text>
      <feedback format="html">
        <text>Correct. The base is 5, the input is 25, and the output is 2.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>log_25(5)=2</text>
      <feedback format="html">
        <text>This reverses base and input.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>log_5(2)=25</text>
      <feedback format="html">
        <text>This makes the exponent the input.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>log_2(25)=5</text>
      <feedback format="html">
        <text>This uses the exponent as the base.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L04_Q06</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U04_L04_Q06&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.LOG.2&lt;/p&gt;&lt;p&gt;What is the domain of y=log_2(x)?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>x &amp;gt;= 0</text>
      <feedback format="html">
        <text>Zero is not allowed.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>x &amp;gt; 0</text>
      <feedback format="html">
        <text>Correct. Logarithmic inputs must be positive.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>all real numbers</text>
      <feedback format="html">
        <text>Negative and zero inputs are not in the basic log domain.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>x != 2</text>
      <feedback format="html">
        <text>The base does not create this restriction.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L04_Q07</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U04_L04_Q07&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.LOG.2&lt;/p&gt;&lt;p&gt;What is the range of y=log_2(x)?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>x &amp;gt; 0</text>
      <feedback format="html">
        <text>That describes the domain, not the range.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>y &amp;gt; 0</text>
      <feedback format="html">
        <text>Logarithm outputs can be negative, zero, or positive.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>all real numbers</text>
      <feedback format="html">
        <text>Correct. Logarithmic outputs can be any real number.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>y != 0</text>
      <feedback format="html">
        <text>The output can be 0 when x = 1.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L04_Q08</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U04_L04_Q08&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.LOG.2&lt;/p&gt;&lt;p&gt;What is the vertical asymptote of y=log_3(x)?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>y = 0</text>
      <feedback format="html">
        <text>That is the horizontal asymptote of the exponential inverse.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>x = 3</text>
      <feedback format="html">
        <text>The base does not become the vertical asymptote.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>y = 3</text>
      <feedback format="html">
        <text>This does not describe the asymptote.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>x = 0</text>
      <feedback format="html">
        <text>Correct. The basic logarithmic graph approaches the y-axis.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L04_Q09</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U04_L04_Q09&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.LOG.2&lt;/p&gt;&lt;p&gt;Which point is on y=log_2(x)?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>(8, 3)</text>
      <feedback format="html">
        <text>Correct. Because log_2(8)=3.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>(3, 8)</text>
      <feedback format="html">
        <text>This reverses the coordinates.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>(2, 8)</text>
      <feedback format="html">
        <text>log_2(2)=1, not 8.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>(0, 2)</text>
      <feedback format="html">
        <text>x=0 is not in the domain.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L04_Q10</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U04_L04_Q10&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.LOG.2&lt;/p&gt;&lt;p&gt;What is log_4(1)?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>1</text>
      <feedback format="html">
        <text>4 to the first power is 4.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>0</text>
      <feedback format="html">
        <text>Correct. Any positive base to the zero power equals 1.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>4</text>
      <feedback format="html">
        <text>4 to the fourth power is 256.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>undefined</text>
      <feedback format="html">
        <text>The logarithm of 1 is defined for valid positive bases not equal to 1.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L04_Q11</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U04_L04_Q11&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.LOG.2&lt;/p&gt;&lt;p&gt;What is log_7(7)?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>0</text>
      <feedback format="html">
        <text>7 to the zero power equals 1.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>7</text>
      <feedback format="html">
        <text>7 to the seventh power is too large.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>1</text>
      <feedback format="html">
        <text>Correct. 7 to the first power equals 7.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>49</text>
      <feedback format="html">
        <text>This is not the needed exponent.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L04_Q12</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U04_L04_Q12&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.LOG.2&lt;/p&gt;&lt;p&gt;Which statement is true about y=log_2(x) and y=2ˣ?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>They are the same graph.</text>
      <feedback format="html">
        <text>Inverse graphs reflect across y = x, so they are not identical.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Both have domain x &amp;gt; 0.</text>
      <feedback format="html">
        <text>The exponential domain is all real numbers.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Both have range y &amp;gt; 0.</text>
      <feedback format="html">
        <text>The logarithmic range is all real numbers.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>They are inverse functions.</text>
      <feedback format="html">
        <text>Correct. They reverse inputs and outputs.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L04_Q13</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U04_L04_Q13&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.LOG.2&lt;/p&gt;&lt;p&gt;What is log_5(125)?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>3</text>
      <feedback format="html">
        <text>Correct. 5 cubed equals 125.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>2</text>
      <feedback format="html">
        <text>5 squared equals 25.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>4</text>
      <feedback format="html">
        <text>5 to the fourth is 625.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>25</text>
      <feedback format="html">
        <text>This is not the exponent needed.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L04_Q14</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U04_L04_Q14&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.LOG.2&lt;/p&gt;&lt;p&gt;Which form matches log_b(a)=c?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>aᶜ = b</text>
      <feedback format="html">
        <text>This reverses the base and input.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>bᶜ = a</text>
      <feedback format="html">
        <text>Correct. The base raised to the log output equals the input.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>b + c = a</text>
      <feedback format="html">
        <text>The relationship is exponential, not additive.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>cᵇ = a</text>
      <feedback format="html">
        <text>This uses the output as the base.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L04_Q15</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U04_L04_Q15&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.LOG.2&lt;/p&gt;&lt;p&gt;What is log_2(1/8)?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>3</text>
      <feedback format="html">
        <text>2 cubed equals 8, not 1/8.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>-8</text>
      <feedback format="html">
        <text>This is not the exponent needed.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>-3</text>
      <feedback format="html">
        <text>Correct. 2 to the negative third power equals 1/8.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>1/3</text>
      <feedback format="html">
        <text>2 to the one-third power is not 1/8.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U04_L04_Q16</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; ALG2_U04_L04_Q16&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.A2.LOG.2&lt;/p&gt;&lt;p&gt;What is log_9(9)?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>0</text>
      <feedback format="html">
        <text>9 to the zero power equals 1.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>2</text>
      <feedback format="html">
        <text>9 squared equals 81.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>18</text>
