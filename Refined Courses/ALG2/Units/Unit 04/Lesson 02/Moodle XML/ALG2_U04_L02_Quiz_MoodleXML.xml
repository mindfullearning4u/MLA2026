    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[A(t)=600(0.97)ᵗ]]></text>
      <feedback format="html">
        <text><![CDATA[This models 3% decay.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A(t)=1.03(600)ᵗ]]></text>
