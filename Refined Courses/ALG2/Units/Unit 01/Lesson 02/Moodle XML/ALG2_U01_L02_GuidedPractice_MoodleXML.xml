<quiz>
  <question type="category">
    <category>
      <text>$course$/ALG2/Units/Unit 01/Lesson 02/ALG2_U01_L02_GuidedPractice</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L02_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L02_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A2.AE.2; MLA.A2.AE.4</p><p>Simplify (3x&#178; + 2x - 5) + (x&#178; - 7x + 9).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[4x&#178; - 5x + 4]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Combine like terms: 3x squared plus x squared is 4x squared, 2x minus 7x is -5x, and -5 plus 9 is 4.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4x&#178; + 9x + 4]]></text>
      <feedback format="html">
        <text><![CDATA[This adds 2x and 7x instead of combining 2x and -7x.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[3x⁴ - 5x + 4]]></text>
      <feedback format="html">
        <text><![CDATA[This incorrectly adds exponents when adding like terms. Exponents stay the same when like terms are combined.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4x&#178; - 5x - 14]]></text>
      <feedback format="html">
        <text><![CDATA[This combines the variable terms correctly but multiplies the constants instead of adding them.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L02_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L02_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A2.AE.2; MLA.A2.AE.4</p><p>Simplify (5x&#178; - 3x + 8) - (2x&#178; + x - 6).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[3x&#178; - 2x + 2]]></text>
      <feedback format="html">
        <text><![CDATA[This does not distribute the subtraction sign to every term in the second polynomial.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[7x&#178; - 2x + 2]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the x squared terms and does not subtract the second polynomial.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[3x&#178; - 4x + 14]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Distribute the subtraction sign to get 5x squared - 3x + 8 - 2x squared - x + 6, then combine like terms.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[3x&#178; + 4x + 14]]></text>
      <feedback format="html">
        <text><![CDATA[The x-term sign is incorrect. -3x - x equals -4x.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L02_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L02_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A2.AE.2; MLA.A2.AE.4</p><p>Simplify 3x(2x&#178; - 5x + 4).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[6x&#178; - 15x + 12]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies coefficients but does not add exponents when multiplying by x.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[6x&#179; - 15x&#178; + 12x]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Distribute 3x to each term and add exponents for powers with the same base.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[6x&#179; - 5x&#178; + 4x]]></text>
      <feedback format="html">
        <text><![CDATA[This does not multiply every coefficient by 3.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[6x&#179; + 15x&#178; + 12x]]></text>
      <feedback format="html">
        <text><![CDATA[The middle term should be negative because 3x times -5x is -15x squared.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L02_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L02_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A2.AE.2; MLA.A2.AE.4</p><p>Simplify (x + 4)(x - 6).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x&#178; - 24]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies only the first and last terms and misses the middle products.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x&#178; + 10x - 24]]></text>
      <feedback format="html">
        <text><![CDATA[This uses +6x instead of -6x when multiplying x by -6.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x&#178; + 2x - 24]]></text>
      <feedback format="html">
        <text><![CDATA[The middle terms should combine to -2x, not +2x.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x&#178; - 2x - 24]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. x squared - 6x + 4x - 24 combines to x squared - 2x - 24.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L02_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L02_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A2.AE.2; MLA.A2.AE.4</p><p>A rectangle has length x + 3 and width x + 5. What polynomial represents the area?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[2x + 8]]></text>
      <feedback format="html">
        <text><![CDATA[This adds length and width, but area requires multiplication.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x&#178; + 8x + 15]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Area is (x + 3)(x + 5), which equals x squared + 8x + 15.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x&#178; + 15]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies only the first and last terms and misses the middle terms.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x&#178; - 8x + 15]]></text>
      <feedback format="html">
        <text><![CDATA[The middle term should be positive because both binomial constants are positive.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>