  <question type="multichoice">
    <name>
      <text>ALG2_U01_L02_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L02_Q01</p><p><strong>MLA Standard:</strong> MLA.A2.AE.2; MLA.A2.AE.4</p><p>Simplify (4x&#178; + 3x - 8) + (2x&#178; - 5x + 1).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[6x&#178; + 8x - 7]]></text>
      <feedback format="html">
        <text><![CDATA[This adds 3x and 5x instead of combining 3x and -5x.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[6x&#178; - 2x - 7]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Combine like terms: 4x squared plus 2x squared, 3x minus 5x, and -8 plus 1.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[8x&#178; - 2x - 7]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies the x squared coefficients instead of adding them.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[6x&#178; - 2x + 9]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the constants incorrectly.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L02_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L02_Q02</p><p><strong>MLA Standard:</strong> MLA.A2.AE.2; MLA.A2.AE.4</p><p>Simplify (7x&#179; - 2x + 4) + (-3x&#179; + 5x - 9).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[10x&#179; + 3x - 5]]></text>
      <feedback format="html">
        <text><![CDATA[This adds 7x cubed and 3x cubed instead of using -3x cubed.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4x⁶ + 3x - 5]]></text>
      <feedback format="html">
        <text><![CDATA[This incorrectly adds exponents when adding like terms.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4x&#179; - 7x - 5]]></text>
      <feedback format="html">
        <text><![CDATA[This combines the x terms incorrectly.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[4x&#179; + 3x - 5]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. 7x cubed minus 3x cubed is 4x cubed, -2x plus 5x is 3x, and 4 minus 9 is -5.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L02_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L02_Q03</p><p><strong>MLA Standard:</strong> MLA.A2.AE.2; MLA.A2.AE.4</p><p>Simplify (5x&#178; - 4x + 6) - (2x&#178; + x - 3).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[3x&#178; - 5x + 9]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Subtract every term in the second polynomial, then combine like terms.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[3x&#178; - 3x + 3]]></text>
      <feedback format="html">
        <text><![CDATA[This does not distribute the subtraction sign to every term in the second polynomial.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[7x&#178; - 5x + 9]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the x squared terms instead of subtracting.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[3x&#178; + 5x + 9]]></text>
      <feedback format="html">
        <text><![CDATA[The x-term sign is incorrect.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L02_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L02_Q04</p><p><strong>MLA Standard:</strong> MLA.A2.AE.2; MLA.A2.AE.4</p><p>Simplify (8x&#178; + 3x - 1) - (x&#178; - 6x + 5).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[7x&#178; - 3x - 6]]></text>
      <feedback format="html">
        <text><![CDATA[This does not change the sign of -6x when subtracting.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[9x&#178; + 9x - 6]]></text>
      <feedback format="html">
        <text><![CDATA[This adds x squared instead of subtracting it.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[7x&#178; + 9x - 6]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Distribute the subtraction sign to get -x squared + 6x - 5, then combine.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[7x&#178; + 9x + 4]]></text>
      <feedback format="html">
        <text><![CDATA[This does not subtract the constant 5 correctly.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L02_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L02_Q05</p><p><strong>MLA Standard:</strong> MLA.A2.AE.2; MLA.A2.AE.4</p><p>Simplify 4x(3x&#178; - 2x + 7).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[12x&#179; - 8x&#178; + 28x]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Distribute 4x to each term.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[12x&#178; - 8x + 28]]></text>
      <feedback format="html">
        <text><![CDATA[This does not add the exponent from the outside x.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[12x&#179; - 2x&#178; + 7x]]></text>
      <feedback format="html">
        <text><![CDATA[This does not multiply every coefficient by 4.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[12x&#179; + 8x&#178; + 28x]]></text>
      <feedback format="html">
        <text><![CDATA[The middle term should be negative.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L02_Q06</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L02_Q06</p><p><strong>MLA Standard:</strong> MLA.A2.AE.2; MLA.A2.AE.4</p><p>Simplify -2x(5x&#178; - 3x + 4).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[-10x&#178; + 6x - 8]]></text>
      <feedback format="html">
        <text><![CDATA[This does not add the exponent from the outside x.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[-10x&#179; - 6x&#178; - 8x]]></text>
      <feedback format="html">
        <text><![CDATA[The middle term should be positive because a negative times a negative is positive.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[10x&#179; - 6x&#178; + 8x]]></text>
      <feedback format="html">
        <text><![CDATA[This ignores the negative sign on -2x.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[-10x&#179; + 6x&#178; - 8x]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Multiply each term by -2x.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L02_Q07</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L02_Q07</p><p><strong>MLA Standard:</strong> MLA.A2.AE.2; MLA.A2.AE.4</p><p>Simplify (x + 7)(x + 2).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x&#178; + 14]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies only the first and last terms.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x&#178; + 9x + 14]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The middle terms are 2x and 7x, which combine to 9x.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x&#178; + 5x + 14]]></text>
      <feedback format="html">
        <text><![CDATA[The middle terms were subtracted instead of added.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x&#178; + 14x + 9]]></text>
      <feedback format="html">
        <text><![CDATA[The constant and middle coefficient are switched.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L02_Q08</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L02_Q08</p><p><strong>MLA Standard:</strong> MLA.A2.AE.2; MLA.A2.AE.4</p><p>Simplify (x - 5)(x + 3).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x&#178; - 15]]></text>
      <feedback format="html">
        <text><![CDATA[This misses the middle products.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x&#178; + 8x - 15]]></text>
      <feedback format="html">
        <text><![CDATA[This treats -5x as +5x.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x&#178; - 2x - 15]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. x squared + 3x - 5x - 15 combines to x squared - 2x - 15.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x&#178; + 2x - 15]]></text>
      <feedback format="html">
        <text><![CDATA[The middle term sign is incorrect.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L02_Q09</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L02_Q09</p><p><strong>MLA Standard:</strong> MLA.A2.AE.2; MLA.A2.AE.4</p><p>Simplify (2x + 1)(x + 6).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[2x&#178; + 12x + 6]]></text>
      <feedback format="html">
        <text><![CDATA[This misses the 1 times x product.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[2x&#178; + 7x + 6]]></text>
      <feedback format="html">
        <text><![CDATA[This adds 6x and x instead of 12x and x.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[2x&#178; + 13x + 7]]></text>
      <feedback format="html">
        <text><![CDATA[The constant should be 1 times 6, which is 6.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[2x&#178; + 13x + 6]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. 2x times x is 2x squared, 2x times 6 is 12x, and 1 times x is x.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L02_Q10</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L02_Q10</p><p><strong>MLA Standard:</strong> MLA.A2.AE.2; MLA.A2.AE.4</p><p>Simplify (3x - 4)(x - 2).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[3x&#178; - 10x + 8]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. 3x squared - 6x - 4x + 8 combines to 3x squared - 10x + 8.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[3x&#178; - 6x + 8]]></text>
      <feedback format="html">
        <text><![CDATA[This misses the -4x product.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[3x&#178; + 10x + 8]]></text>
      <feedback format="html">
        <text><![CDATA[The middle terms should be negative.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[3x&#178; - 2x + 8]]></text>
      <feedback format="html">
        <text><![CDATA[The middle terms were combined incorrectly.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L02_Q11</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L02_Q11</p><p><strong>MLA Standard:</strong> MLA.A2.AE.2; MLA.A2.AE.4</p><p>Which pair of terms are like terms?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[3x&#178; and 3x]]></text>
      <feedback format="html">
        <text><![CDATA[The exponents on x are different.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[7x and 7y]]></text>
      <feedback format="html">
        <text><![CDATA[The variables are different.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[-5x&#179; and 8x&#179;]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Both terms have x raised to the third power.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4 and 4x]]></text>
      <feedback format="html">
        <text><![CDATA[One term has a variable and the other does not.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L02_Q12</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L02_Q12</p><p><strong>MLA Standard:</strong> MLA.A2.AE.2; MLA.A2.AE.4</p><p>What is the degree of 6x⁴ - 2x&#178; + 9?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[6]]></text>
      <feedback format="html">
        <text><![CDATA[This is the leading coefficient, not the degree.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[4]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The highest exponent is 4.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[2]]></text>
      <feedback format="html">
        <text><![CDATA[This is an exponent in the expression, but it is not the highest exponent.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[9]]></text>
      <feedback format="html">
        <text><![CDATA[This is the constant term, not the degree.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L02_Q13</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L02_Q13</p><p><strong>MLA Standard:</strong> MLA.A2.AE.2; MLA.A2.AE.4</p><p>Which expression is written in standard form?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[2x&#179; - 4x&#178; + x - 8]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The exponents decrease from 3 to 2 to 1 to 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[5 + 2x&#178; - x]]></text>
      <feedback format="html">
        <text><![CDATA[Standard form writes terms in descending order by exponent.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x - 3x&#178; + 7]]></text>
      <feedback format="html">
        <text><![CDATA[The x squared term should come before the x term.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4 - x + x⁴]]></text>
      <feedback format="html">
        <text><![CDATA[The x to the fourth term should come first.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L02_Q14</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L02_Q14</p><p><strong>MLA Standard:</strong> MLA.A2.AE.2; MLA.A2.AE.4</p><p>A rectangle has length x + 9 and width x + 4. What polynomial represents the area?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[2x + 13]]></text>
      <feedback format="html">
        <text><![CDATA[This adds length and width instead of multiplying.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x&#178; + 36]]></text>
      <feedback format="html">
        <text><![CDATA[This misses the middle products.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x&#178; + 13x + 36]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Area is (x + 9)(x + 4).]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x&#178; - 13x + 36]]></text>
      <feedback format="html">
        <text><![CDATA[Both constants are positive, so the middle term should be positive.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L02_Q15</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L02_Q15</p><p><strong>MLA Standard:</strong> MLA.A2.AE.2; MLA.A2.AE.4</p><p>A rectangle has length 2x + 5 and width x + 3. What polynomial represents the area?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[3x + 8]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the side lengths instead of multiplying them.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[2x&#178; + 15]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies only the first and last terms.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[2x&#178; + 6x + 15]]></text>
      <feedback format="html">
        <text><![CDATA[This misses the 5x product.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[2x&#178; + 11x + 15]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. (2x + 5)(x + 3) = 2x squared + 6x + 5x + 15.]]></text>
      </feedback>
    </answer>
