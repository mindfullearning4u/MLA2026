      <text>ALG2_U01_L02_Q17</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L02_Q17</p><p><strong>MLA Standard:</strong> MLA.A2.AE.2; MLA.A2.AE.4</p><p>Which expression is equivalent to (x + 4)(x + 4)?</p>]]></text>
