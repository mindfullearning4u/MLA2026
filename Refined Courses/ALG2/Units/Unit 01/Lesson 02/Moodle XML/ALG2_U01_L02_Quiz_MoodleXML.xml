    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L02_Q16</p><p><strong>MLA Standard:</strong> MLA.A2.AE.2; MLA.A2.AE.4</p><p>Find the perimeter of a rectangle with length 3x + 2 and width x + 5.</p>]]></text>
