<quiz>
  <question type="category">
    <category>
      <text>$course$/ALG2/Units/Unit 01/Lesson 03/ALG2_U01_L03_GuidedPractice</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L03_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L03_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.A2.AE.1; MLA.A2.AE.5</p><p>Factor 6x&#179; + 9x&#178;.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[3x&#178;(2x + 3)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The greatest common factor is 3x squared.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[3x(2x&#178; + 3x)]]></text>
      <feedback format="html">
        <text><![CDATA[This factors out 3x, but it does not use the greatest common factor.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x&#178;(6x + 9)]]></text>
      <feedback format="html">
        <text><![CDATA[This misses the numerical common factor 3.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[3x&#178;(2x - 3)]]></text>
      <feedback format="html">
        <text><![CDATA[The sign inside the factor should be positive because both original terms are positive.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L03_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L03_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.A2.AE.1; MLA.A2.AE.5</p><p>Factor x&#178; - 49.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[(x - 7)(x - 7)]]></text>
      <feedback format="html">
        <text><![CDATA[This expands to x squared - 14x + 49, not x squared - 49.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(x + 7)(x + 7)]]></text>
      <feedback format="html">
        <text><![CDATA[This expands to x squared + 14x + 49.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[(x - 7)(x + 7)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. This is the difference of squares x squared minus 7 squared.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x(x - 49)]]></text>
      <feedback format="html">
        <text><![CDATA[This expands to x squared - 49x, not x squared - 49.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L03_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L03_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.A2.AE.1; MLA.A2.AE.5</p><p>Factor x&#178; + 7x + 12.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[(x + 2)(x + 6)]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies to 12 but the middle term would be 8x.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[(x + 3)(x + 4)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. 3 and 4 multiply to 12 and add to 7.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(x - 3)(x - 4)]]></text>
      <feedback format="html">
        <text><![CDATA[This gives a positive constant but a negative middle term.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(x + 1)(x + 12)]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies to 12 but the middle term would be 13x.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L03_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L03_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.A2.AE.1; MLA.A2.AE.5</p><p>Factor x&#178; - x - 20.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[(x - 4)(x + 5)]]></text>
      <feedback format="html">
        <text><![CDATA[This gives a middle term of x, not -x.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(x - 10)(x + 2)]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies to -20 but gives a middle term of -8x.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(x - 4)(x - 5)]]></text>
      <feedback format="html">
        <text><![CDATA[This gives a positive constant, not -20.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[(x + 4)(x - 5)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. 4 and -5 multiply to -20 and add to -1.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L03_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L03_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.A2.AE.1; MLA.A2.AE.5</p><p>Which factored form is equivalent to x&#178; + 8x + 12?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[(x + 1)(x + 12)]]></text>
      <feedback format="html">
        <text><![CDATA[This expands to x squared + 13x + 12.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[(x + 2)(x + 6)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. 2 and 6 multiply to 12 and add to 8.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(x - 2)(x - 6)]]></text>
      <feedback format="html">
        <text><![CDATA[This expands to x squared - 8x + 12.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(x + 3)(x + 4)]]></text>
      <feedback format="html">
        <text><![CDATA[This expands to x squared + 7x + 12.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>