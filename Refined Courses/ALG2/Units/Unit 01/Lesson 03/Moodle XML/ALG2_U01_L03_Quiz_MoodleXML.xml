        <text><![CDATA[The binomial is still a difference of squares.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[2(x - 3)(x + 3)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. This is fully factored over the real numbers.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x&#178; - 9]]></text>
      <feedback format="html">
        <text><![CDATA[This expression is not factored.]]></text>
