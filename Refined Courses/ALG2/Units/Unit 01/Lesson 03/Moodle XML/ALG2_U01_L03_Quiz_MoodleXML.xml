  <question type="multichoice">
    <name>
      <text>ALG2_U01_L03_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L03_Q01</p><p><strong>MLA Standard:</strong> MLA.A2.AE.1; MLA.A2.AE.5</p><p>Factor 8x&#179; - 12x&#178;.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[4x(2x&#178; - 3x)]]></text>
      <feedback format="html">
        <text><![CDATA[This factors out 4x but not the greatest common factor.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[4x&#178;(2x - 3)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The greatest common factor is 4x squared.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[2x&#178;(4x - 6)]]></text>
      <feedback format="html">
        <text><![CDATA[This is not fully factored because 4x - 6 still has a common factor of 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4x&#178;(2x + 3)]]></text>
      <feedback format="html">
        <text><![CDATA[The sign inside the factor should be negative.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L03_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L03_Q02</p><p><strong>MLA Standard:</strong> MLA.A2.AE.1; MLA.A2.AE.5</p><p>Factor 12x&#178; + 18x.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[3x(4x + 6)]]></text>
      <feedback format="html">
        <text><![CDATA[This is not fully factored because 4x + 6 still has a common factor of 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[6x(2x - 3)]]></text>
      <feedback format="html">
        <text><![CDATA[The sign should be positive because both original terms are positive.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x(12x + 18)]]></text>
      <feedback format="html">
        <text><![CDATA[This misses the numerical greatest common factor.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[6x(2x + 3)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The greatest common factor is 6x.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L03_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L03_Q03</p><p><strong>MLA Standard:</strong> MLA.A2.AE.1; MLA.A2.AE.5</p><p>Factor x&#178; - 64.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[(x - 8)(x + 8)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. This is x squared minus 8 squared.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(x - 8)(x - 8)]]></text>
      <feedback format="html">
        <text><![CDATA[This expands to x squared - 16x + 64.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(x + 8)(x + 8)]]></text>
      <feedback format="html">
        <text><![CDATA[This expands to x squared + 16x + 64.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x(x - 64)]]></text>
      <feedback format="html">
        <text><![CDATA[This expands to x squared - 64x.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L03_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L03_Q04</p><p><strong>MLA Standard:</strong> MLA.A2.AE.1; MLA.A2.AE.5</p><p>Factor 4x&#178; - 25.</p>]]></text>
