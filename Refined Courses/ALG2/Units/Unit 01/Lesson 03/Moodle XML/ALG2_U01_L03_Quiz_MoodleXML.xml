    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L03_Q05</p><p><strong>MLA Standard:</strong> MLA.A2.AE.1; MLA.A2.AE.5</p><p>Factor x&#178; + 10x + 21.</p>]]></text>
