      <text>ALG2_U01_L04_Q11</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L04_Q11</p><p><strong>MLA Standard:</strong> MLA.A2.PF.1</p><p>What are the solutions of x&#178; + 4 = 0?</p>]]></text>
