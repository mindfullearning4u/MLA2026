  <question type="multichoice">
    <name>
      <text>ALG2_U01_L04_Q08</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L04_Q08</p><p><strong>MLA Standard:</strong> MLA.A2.PF.1</p><p>A quadratic equation has discriminant 0. What does this mean?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[It has two different real solutions.]]></text>
      <feedback format="html">
        <text><![CDATA[Two different real solutions occur when the discriminant is positive.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It has two complex non-real solutions.]]></text>
      <feedback format="html">
        <text><![CDATA[Complex non-real solutions occur when the discriminant is negative.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[It has one repeated real solution.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A discriminant of zero makes the square-root part of the quadratic formula equal zero.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It has no solution in any number system.]]></text>
      <feedback format="html">
        <text><![CDATA[Quadratic equations still have solutions; the discriminant identifies their type.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L04_Q09</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L04_Q09</p><p><strong>MLA Standard:</strong> MLA.A2.PF.1</p><p>A quadratic equation has discriminant 25. What type of solutions does it have?</p>]]></text>
