    <name>
      <text>ALG2_U01_L04_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L04_Q04</p><p><strong>MLA Standard:</strong> MLA.A2.PF.1</p><p>What is sqrt(-50) simplified?</p>]]></text>
