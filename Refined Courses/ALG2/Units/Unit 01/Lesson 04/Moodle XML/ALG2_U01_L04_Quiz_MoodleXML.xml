    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L04_Q13</p><p><strong>MLA Standard:</strong> MLA.A2.PF.1</p><p>What are the solutions of x&#178; - 8x + 20 = 0?</p>]]></text>
