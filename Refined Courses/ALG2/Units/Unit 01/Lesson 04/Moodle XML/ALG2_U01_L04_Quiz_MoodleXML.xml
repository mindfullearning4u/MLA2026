      <feedback format="html">
        <text><![CDATA[A repeated real solution occurs only when the discriminant is zero.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Two complex non-real solutions]]></text>
      <feedback format="html">
        <text><![CDATA[Complex non-real solutions occur when the discriminant is negative.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[No real or complex solutions]]></text>
      <feedback format="html">
        <text><![CDATA[A quadratic equation has solutions in the complex number system.]]></text>
      </feedback>
    </answer>
