  <question type="multichoice">
    <name>
      <text>ALG2_U01_L04_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L04_Q01</p><p><strong>MLA Standard:</strong> MLA.A2.PF.1</p><p>Which statement correctly defines the imaginary unit i?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[i = -1]]></text>
      <feedback format="html">
        <text><![CDATA[The imaginary unit is not equal to -1.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[i&#178; = -1]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The imaginary unit is defined so that i squared equals -1.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[i&#178; = 1]]></text>
      <feedback format="html">
        <text><![CDATA[This would make i behave like 1 or -1, not an imaginary unit.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[i = 0]]></text>
      <feedback format="html">
        <text><![CDATA[The imaginary unit is not zero.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L04_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L04_Q02</p><p><strong>MLA Standard:</strong> MLA.A2.PF.1</p><p>What is sqrt(-25) simplified?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[-5]]></text>
      <feedback format="html">
        <text><![CDATA[Squaring -5 gives positive 25, not negative 25.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[-25i]]></text>
      <feedback format="html">
        <text><![CDATA[This uses the radicand instead of its square root and has the wrong magnitude.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[25i]]></text>
      <feedback format="html">
        <text><![CDATA[The square root of 25 is 5, not 25.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[5i]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. sqrt(-25) equals sqrt(25) times i, which is 5i.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L04_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L04_Q03</p><p><strong>MLA Standard:</strong> MLA.A2.PF.1</p><p>What is sqrt(-12) simplified?</p>]]></text>
