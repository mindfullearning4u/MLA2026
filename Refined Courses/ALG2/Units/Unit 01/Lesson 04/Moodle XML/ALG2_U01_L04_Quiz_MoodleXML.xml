  <question type="multichoice">
    <name>
      <text>ALG2_U01_L04_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L04_Q05</p><p><strong>MLA Standard:</strong> MLA.A2.PF.1</p><p>Which number is the complex conjugate of 7 - 4i?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[7 + 4i]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A complex conjugate keeps the real part and changes the sign of the imaginary part.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[-7 + 4i]]></text>
      <feedback format="html">
        <text><![CDATA[This changes both the real part and the imaginary sign.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[-7 - 4i]]></text>
      <feedback format="html">
        <text><![CDATA[This changes the real part, which should stay the same.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4 - 7i]]></text>
      <feedback format="html">
        <text><![CDATA[This switches the real and imaginary parts.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L04_Q06</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L04_Q06</p><p><strong>MLA Standard:</strong> MLA.A2.PF.1</p><p>What is the discriminant of x&#178; - 2x + 5 = 0?</p>]]></text>
