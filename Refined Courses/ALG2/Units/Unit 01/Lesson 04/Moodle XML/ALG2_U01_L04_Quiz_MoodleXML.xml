    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[24]]></text>
      <feedback format="html">
        <text><![CDATA[This adds 4ac instead of subtracting it.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[16]]></text>
      <feedback format="html">
        <text><![CDATA[The magnitude is 16, but the sign should be negative.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[-24]]></text>
