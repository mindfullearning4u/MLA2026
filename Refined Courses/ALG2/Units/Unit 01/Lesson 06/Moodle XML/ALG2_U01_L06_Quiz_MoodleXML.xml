  <question type="multichoice">
    <name>
      <text>ALG2_U01_L06_Q07</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L06_Q07</p><p><strong>MLA Standard:</strong> MLA.A2.PF.7</p><p>Solve x&#179; + 2x&#178; - 5x - 6 = 0, given that x = -1 is a solution.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -1 only]]></text>
      <feedback format="html">
        <text><![CDATA[A cubic equation can have more than one solution.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x = -3, -1, 2]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Dividing by x + 1 gives x squared + x - 6, which factors as (x + 3)(x - 2).]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -2, 1, 3]]></text>
      <feedback format="html">
        <text><![CDATA[These are the opposite signs of the roots.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -3, 1, 2]]></text>
      <feedback format="html">
        <text><![CDATA[This includes 1 instead of -1.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
