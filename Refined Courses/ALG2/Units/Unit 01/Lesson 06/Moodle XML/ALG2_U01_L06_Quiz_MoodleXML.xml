      <text>ALG2_U01_L06_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L06_Q01</p><p><strong>MLA Standard:</strong> MLA.A2.PF.7</p><p>Solve x&#179; - 4x = 0.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -2 and x = 2]]></text>
      <feedback format="html">
        <text><![CDATA[This leaves out x = 0 from the factor x.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x = -2, 0, 2]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Factor x(x squared - 4), then x(x - 2)(x + 2) = 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 0 and x = 4]]></text>
      <feedback format="html">
        <text><![CDATA[The quadratic factor gives plus or minus 2, not 4.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -4, 0, 4]]></text>
      <feedback format="html">
        <text><![CDATA[These use the coefficient 4 instead of square roots.]]></text>
      </feedback>
    </answer>
  </question>
