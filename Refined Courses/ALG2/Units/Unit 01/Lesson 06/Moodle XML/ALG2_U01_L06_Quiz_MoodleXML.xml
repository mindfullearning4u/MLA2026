  <question type="multichoice">
    <name>
      <text>ALG2_U01_L06_Q18</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L06_Q18</p><p><strong>MLA Standard:</strong> MLA.A2.PF.7</p><p>A graph of a polynomial shows x-intercepts at -2, 1, and 4. Which list gives the real solutions?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[x = -2, 1, 4]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Real zeros appear as x-intercepts.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 2, -1, -4]]></text>
      <feedback format="html">
        <text><![CDATA[These are the opposite signs of the x-intercepts.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -2i, i, 4i]]></text>
      <feedback format="html">
        <text><![CDATA[Imaginary values do not appear as x-intercepts.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -4, -1, 2]]></text>
      <feedback format="html">
        <text><![CDATA[These do not match the intercepts.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L06_Q19</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L06_Q19</p><p><strong>MLA Standard:</strong> MLA.A2.PF.7</p><p>Why might a graph not show every solution of a polynomial equation?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Because real solutions never appear on graphs]]></text>
      <feedback format="html">
        <text><![CDATA[Real solutions do appear as x-intercepts.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Because complex non-real solutions are not x-intercepts]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A real-coordinate graph shows real zeros, not complex non-real zeros.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Because polynomial equations have no roots]]></text>
      <feedback format="html">
        <text><![CDATA[Polynomial equations can have roots.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Because x-intercepts are always imaginary]]></text>
      <feedback format="html">
        <text><![CDATA[X-intercepts are real coordinate points.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L06_Q20</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L06_Q20</p><p><strong>MLA Standard:</strong> MLA.A2.PF.7</p><p>Solve (x - 2)(x + 7)(x&#178; + 1) = 0.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 2 and x = -7]]></text>
      <feedback format="html">
        <text><![CDATA[This leaves out the complex solutions from x squared plus 1.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -2, 7, i, -i]]></text>
      <feedback format="html">
        <text><![CDATA[The real roots have the wrong signs.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 1 and x = -1]]></text>
      <feedback format="html">
        <text><![CDATA[These do not solve x squared plus 1 = 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x = 2, -7, i, -i]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The linear factors give 2 and -7, and x squared plus 1 gives plus or minus i.]]></text>
      </feedback>
    </answer>
  </question>
