  <question type="multichoice">
    <name>
      <text>ALG2_U01_L06_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L06_Q03</p><p><strong>MLA Standard:</strong> MLA.A2.PF.7</p><p>Solve x&#179; + 3x&#178; = 0.</p>]]></text>
