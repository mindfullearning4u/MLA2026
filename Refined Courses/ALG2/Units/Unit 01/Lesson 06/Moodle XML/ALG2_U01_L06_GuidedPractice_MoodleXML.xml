<quiz>
  <question type="category">
    <category>
      <text>$course$/ALG2/Units/Unit 01/Lesson 06/ALG2_U01_L06_GuidedPractice</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L06_GP01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L06_GP01</p><p><strong>MLA Standard:</strong> MLA.A2.PF.7</p><p>Solve x&#179; - 9x = 0.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[x = -3, 0, 3]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Factor x(x squared - 9), then x(x - 3)(x + 3) = 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -3 and x = 3]]></text>
      <feedback format="html">
        <text><![CDATA[This leaves out x = 0 from the factor x.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 0 and x = 9]]></text>
      <feedback format="html">
        <text><![CDATA[The factor x squared - 9 gives plus or minus 3, not 9.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -9, 0, 9]]></text>
      <feedback format="html">
        <text><![CDATA[These values come from the coefficient 9, not from solving x squared - 9 = 0.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L06_GP02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L06_GP02</p><p><strong>MLA Standard:</strong> MLA.A2.PF.7</p><p>Solve x&#179; - 4x&#178; + x + 6 = 0, given that x = 2 is a solution.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 2 only]]></text>
      <feedback format="html">
        <text><![CDATA[A cubic equation can have more than one solution.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -3, 1, 2]]></text>
      <feedback format="html">
        <text><![CDATA[These do not match the factors after division by x - 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x = -1, 2, 3]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Dividing by x - 2 gives x squared - 2x - 3, which factors as (x - 3)(x + 1).]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -2, 1, 3]]></text>
      <feedback format="html">
        <text><![CDATA[This set uses the wrong known factor.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L06_GP03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L06_GP03</p><p><strong>MLA Standard:</strong> MLA.A2.PF.7</p><p>Solve x⁴ - 16 = 0 over the complex number system.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -2 and x = 2]]></text>
      <feedback format="html">
        <text><![CDATA[These are only the real solutions and leave out the complex solutions.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x = -2, 2, -2i, 2i]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Factor as (x - 2)(x + 2)(x squared + 4), then solve each factor.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -4, 4, -4i, 4i]]></text>
      <feedback format="html">
        <text><![CDATA[These values come from 16 instead of the square root of 4.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -2i and x = 2i]]></text>
      <feedback format="html">
        <text><![CDATA[These are only the complex non-real solutions.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L06_GP04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L06_GP04</p><p><strong>MLA Standard:</strong> MLA.A2.PF.7</p><p>Which solution has multiplicity 2 in (x - 5)&#178;(x + 1) = 0?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -1]]></text>
      <feedback format="html">
        <text><![CDATA[This solution comes from x + 1, which appears once.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -5]]></text>
      <feedback format="html">
        <text><![CDATA[The factor x - 5 gives x = 5, not -5.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 1]]></text>
      <feedback format="html">
        <text><![CDATA[The factor x + 1 gives x = -1, not 1.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x = 5]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The factor x - 5 appears twice, so x = 5 has multiplicity 2.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L06_GP05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L06_GP05</p><p><strong>MLA Standard:</strong> MLA.A2.PF.7</p><p>Solve x&#179; + x&#178; + 4x + 4 = 0.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -1, -2, 2]]></text>
      <feedback format="html">
        <text><![CDATA[The quadratic factor is x squared plus 4, which gives complex solutions.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x = -1, -2i, 2i]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Factor by grouping to get (x + 1)(x squared + 4) = 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 1, -2i, 2i]]></text>
      <feedback format="html">
        <text><![CDATA[The linear factor x + 1 gives x = -1.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -4 and x = 4]]></text>
      <feedback format="html">
        <text><![CDATA[These values do not solve the equation.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>