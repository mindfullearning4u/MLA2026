  <question type="multichoice">
    <name>
      <text>ALG2_U01_L08_GP01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L08_GP01</p><p><strong>MLA Standard:</strong> MLA.A2.FN.1</p><p>If f(x) = 2x&#178; - 3, what is f(4)?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[29]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. 2(4 squared) - 3 = 32 - 3 = 29.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[13]]></text>
      <feedback format="html">
        <text><![CDATA[This substitutes 4 but does not square it before multiplying.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[32]]></text>
      <feedback format="html">
        <text><![CDATA[This omits subtracting 3.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[5]]></text>
      <feedback format="html">
        <text><![CDATA[This uses 2 times 4 minus 3, not 2 times 4 squared minus 3.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L08_GP02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L08_GP02</p><p><strong>MLA Standard:</strong> MLA.A2.AE.2; MLA.A2.AE.4</p><p>Multiply (x + 5)(x - 2).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x&#178; + 7x - 10]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the outer and inner coefficients incorrectly.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x&#178; - 3x - 10]]></text>
      <feedback format="html">
        <text><![CDATA[The middle term should be positive 3x.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x&#178; + 3x - 10]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. x squared minus 2x plus 5x minus 10 combines to x squared plus 3x minus 10.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x&#178; + 10]]></text>
      <feedback format="html">
        <text><![CDATA[This omits the middle terms and has the wrong constant operation.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L08_GP03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L08_GP03</p><p><strong>MLA Standard:</strong> MLA.A2.AE.1; MLA.A2.AE.5</p><p>Factor x&#178; - 25.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[(x - 25)(x + 1)]]></text>
      <feedback format="html">
        <text><![CDATA[This does not multiply back to x squared minus 25.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[(x - 5)(x + 5)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. This is a difference of squares.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(x - 5)(x - 5)]]></text>
      <feedback format="html">
        <text><![CDATA[This expands to x squared minus 10x plus 25.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x(x - 25)]]></text>
      <feedback format="html">
        <text><![CDATA[This expands to x squared minus 25x.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L08_GP04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L08_GP04</p><p><strong>MLA Standard:</strong> MLA.A2.PF.1</p><p>Solve x&#178; + 16 = 0.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -4 and x = 4]]></text>
      <feedback format="html">
        <text><![CDATA[These solve x squared minus 16 equals 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -16i and x = 16i]]></text>
      <feedback format="html">
        <text><![CDATA[This uses 16 instead of the square root of 16.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 0 and x = 16]]></text>
      <feedback format="html">
        <text><![CDATA[These do not satisfy the equation.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x = -4i and x = 4i]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. x squared equals -16, so x equals plus or minus 4i.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_L08_GP05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_L08_GP05</p><p><strong>MLA Standard:</strong> MLA.A2.AE.3; MLA.A2.PF.7</p><p>Solve x&#179; - 9x = 0.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -3 and x = 3]]></text>
      <feedback format="html">
        <text><![CDATA[This leaves out the solution x = 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x = -3, 0, 3]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Factor x(x squared - 9), then x(x - 3)(x + 3) = 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 0 and x = 9]]></text>
      <feedback format="html">
        <text><![CDATA[The quadratic factor gives plus or minus 3.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -9, 0, 9]]></text>
      <feedback format="html">
        <text><![CDATA[These use the coefficient 9 instead of its square root.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>