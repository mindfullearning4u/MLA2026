    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_Pretest_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_Pretest_Q01</p><p><strong>MLA Standard:</strong> MLA.A2.FN.1</p><p>If f(x) = 2x - 7, what is f(6)?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[19]]></text>
      <feedback format="html">
        <text><![CDATA[This adds 7 instead of subtracting 7.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[5]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. 2(6) - 7 = 12 - 7 = 5.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[12]]></text>
      <feedback format="html">
        <text><![CDATA[This omits subtracting 7.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[-1]]></text>
      <feedback format="html">
        <text><![CDATA[This uses 6 - 7 instead of 2(6) - 7.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_Pretest_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_Pretest_Q02</p><p><strong>MLA Standard:</strong> MLA.A2.AE.2; MLA.A2.AE.4</p><p>Simplify (3x&#178; + 4x - 1) + (2x&#178; - x + 6).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[5x&#178; + 5x + 5]]></text>
      <feedback format="html">
        <text><![CDATA[The x terms should combine to 3x.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[6x⁴ + 3x + 5]]></text>
      <feedback format="html">
        <text><![CDATA[Adding like terms does not multiply exponents.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x&#178; + 3x - 7]]></text>
      <feedback format="html">
        <text><![CDATA[This subtracts instead of adding.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[5x&#178; + 3x + 5]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Combine like terms.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_Pretest_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_Pretest_Q03</p><p><strong>MLA Standard:</strong> MLA.A2.AE.1</p><p>Which expression shows the greatest common factor factored from 8x&#179; + 12x&#178;?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[4x&#178;(2x + 3)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The GCF is 4x squared.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[2x&#178;(4x + 6)]]></text>
      <feedback format="html">
        <text><![CDATA[This factors a common factor but not the greatest common factor.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4x(2x&#178; + 3x)]]></text>
      <feedback format="html">
        <text><![CDATA[This does not factor out the greatest possible power of x.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x&#178;(8x + 12x)]]></text>
      <feedback format="html">
        <text><![CDATA[The second term inside should not include x.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_Pretest_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_Pretest_Q04</p><p><strong>MLA Standard:</strong> MLA.A2.AE.5</p><p>Factor x&#178; - 49.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[(x - 49)(x + 1)]]></text>
      <feedback format="html">
        <text><![CDATA[This does not multiply back to x squared minus 49.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(x - 7)(x - 7)]]></text>
      <feedback format="html">
        <text><![CDATA[This expands to x squared minus 14x plus 49.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[(x - 7)(x + 7)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. This is a difference of squares.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x(x - 49)]]></text>
      <feedback format="html">
        <text><![CDATA[This expands to x squared minus 49x.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_Pretest_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_Pretest_Q05</p><p><strong>MLA Standard:</strong> MLA.A2.PF.1</p><p>Simplify sqrt(-36).</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[6i]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The square root of -36 is 6i.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[-6]]></text>
      <feedback format="html">
        <text><![CDATA[Squaring -6 gives positive 36, not -36.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[-36i]]></text>
      <feedback format="html">
        <text><![CDATA[This uses the radicand instead of its square root.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[36i]]></text>
      <feedback format="html">
        <text><![CDATA[The square root of 36 is 6, not 36.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_Pretest_Q06</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_Pretest_Q06</p><p><strong>MLA Standard:</strong> MLA.A2.AE.3</p><p>When dividing by x - 4 using synthetic division, what value is used?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[-4]]></text>
      <feedback format="html">
        <text><![CDATA[This would match x + 4.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[0]]></text>
      <feedback format="html">
        <text><![CDATA[This would match x.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[1]]></text>
      <feedback format="html">
        <text><![CDATA[This would match x - 1.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[4]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The divisor x - 4 uses the value 4.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_Pretest_Q07</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_Pretest_Q07</p><p><strong>MLA Standard:</strong> MLA.A2.PF.7</p><p>Solve x&#179; - 4x = 0.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -2 and x = 2]]></text>
      <feedback format="html">
        <text><![CDATA[This leaves out x = 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[x = -2, 0, 2]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Factor x(x squared - 4), then x(x - 2)(x + 2) = 0.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 0 and x = 4]]></text>
      <feedback format="html">
        <text><![CDATA[The quadratic factor gives plus or minus 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -4, 0, 4]]></text>
      <feedback format="html">
        <text><![CDATA[These use the coefficient 4 instead of its square root.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_Pretest_Q08</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_Pretest_Q08</p><p><strong>MLA Standard:</strong> MLA.A2.AE.5; MLA.A2.PF.1</p><p>What is the complex factored form of x&#178; + 16?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[(x - 4)(x + 4)]]></text>
      <feedback format="html">
        <text><![CDATA[This expands to x squared minus 16.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[(x + 16i)(x - 16i)]]></text>
      <feedback format="html">
        <text><![CDATA[This expands to x squared plus 256.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[(x - 4i)(x + 4i)]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The product is x squared plus 16.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x(x + 16)]]></text>
      <feedback format="html">
        <text><![CDATA[This expands to x squared plus 16x.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_Pretest_Q09</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_Pretest_Q09</p><p><strong>MLA Standard:</strong> MLA.A2.FN.1; MLA.A2.AE.1</p><p>Which statement best describes the range from ordered pairs (-1, 5), (0, 3), and (2, 5)?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[the set -1, 0, 2]]></text>
      <feedback format="html">
        <text><![CDATA[This is the domain.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[the set 3, 5]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The range is the set of output values, with duplicates listed once.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[the list 5, 3, 5]]></text>
      <feedback format="html">
        <text><![CDATA[A set does not repeat duplicate values.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[the set -1, 0, 2, 3, 5]]></text>
      <feedback format="html">
        <text><![CDATA[This combines inputs and outputs.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>ALG2_U01_Pretest_Q10</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> ALG2_U01_Pretest_Q10</p><p><strong>MLA Standard:</strong> MLA.A2.AE.4; MLA.A2.PF.7</p><p>A rectangle has width x, length x + 5, and area 84. What is the reasonable width?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[x = 7]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. x(x + 5) = 84 gives x = 7 or x = -12, and only 7 is a reasonable width.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = -12]]></text>
      <feedback format="html">
        <text><![CDATA[This solves the equation but is not a reasonable width.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 12]]></text>
      <feedback format="html">
        <text><![CDATA[This is the length when x = 7, not the width.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[x = 84]]></text>
      <feedback format="html">
        <text><![CDATA[This is the area, not the width.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>