    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG2_U06_L01_Q01</p><p><strong>MLA Standard:</strong> MLA.ENG2.C.01</p><p>Which question helps a speaker identify purpose?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG2_U06_L01_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. How tall is the room?</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This does not identify the reason for speaking.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. Why am I speaking?</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Purpose is the reason for speaking.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. What color is the paper?</p>]]></text>
