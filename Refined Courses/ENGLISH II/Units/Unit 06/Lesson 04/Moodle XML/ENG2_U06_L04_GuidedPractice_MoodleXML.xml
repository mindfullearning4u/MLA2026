<quiz>
  <question type="multichoice">
    <name><text>ENG2_U06_L04_GP_Q01</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG2_U06_L04_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.ENG2.C.02</p><p>Which slide heading best states a finding?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG2_U06_L04_GP_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Survey</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This names a source type but not the finding.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. Many Students Remain on Campus After Dismissal</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. This heading tells the audience what the evidence shows.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Stuff About School</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This is vague and informal.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Slide Two</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This labels position, not meaning.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG2_U06_L04_GP_Q02</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG2_U06_L04_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.ENG2.C.02</p><p>Which visual feature best helps the audience compare survey numbers?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG2_U06_L04_GP_Q02</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. A busy background image.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This distracts from the numbers.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. Moving text on every line.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This can distract the audience.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. A decorative border with no labels.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Decoration does not clarify the evidence.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>D. A simple labeled bar chart.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. A bar chart helps the audience compare quantities.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG2_U06_L04_GP_Q03</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG2_U06_L04_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.ENG2.W.03</p><p>Which slide text is most concise and explanatory?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG2_U06_L04_GP_Q03</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>A. Supervised study space turns waiting time into safe academic time.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. This is concise and explanatory.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. There are lots of things and students and places and the idea is important.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This is wordy and unclear.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Stuff matters.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This is too vague.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. The slide has a chart and colors.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This describes the slide rather than explaining the reasoning.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG2_U06_L04_GP_Q04</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG2_U06_L04_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.ENG2.C.01</p><p>Why should slides avoid full paragraphs of speech text?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG2_U06_L04_GP_Q04</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Full paragraphs always prove the claim better.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Long slide text often overloads the audience.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. The speaker should never explain anything.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The speaker should explain the slide.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>C. Slides should support the speaker with concise points, not replace the speaker.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Slides guide audience understanding while the speaker explains.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Evidence should be hidden from the audience.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Evidence should be clear.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG2_U06_L04_GP_Q05</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG2_U06_L04_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.ENG2.C.02</p><p>Which slide sequence is clearest?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG2_U06_L04_GP_Q05</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Conclusion, random image, evidence, topic.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This sequence is confusing.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. Finding, evidence, reasoning, conclusion.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. This sequence builds understanding logically.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Decoration, decoration, decoration, closing.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Decoration does not communicate findings.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Evidence only, with no reasoning or conclusion.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The audience needs reasoning and closure.</p>]]></text></feedback>
    </answer>
  </question>
</quiz>

