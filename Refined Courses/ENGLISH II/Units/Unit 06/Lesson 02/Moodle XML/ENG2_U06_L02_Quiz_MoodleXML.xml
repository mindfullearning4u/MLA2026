    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>Opening, claim, evidence, reasoning, closing.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. This order gives listeners a clear path.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Evidence only with no claim.</p>]]></text>
