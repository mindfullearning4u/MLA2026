  </question>
  <question type="multichoice">
    <name><text>ENG2_U05_L04_GP_Q05</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG2_U05_L04_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.ENG2.V.03</p><p>Why should a writer use context after checking a thesaurus?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG2_U05_L04_GP_Q05</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Because every synonym always fits.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Synonyms are not always interchangeable.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. Because context determines which related word is most precise.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Context helps the writer choose the word that actually fits.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Because word meaning does not matter.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Meaning is the reason for using context.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Because reference materials are never useful.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. They are useful when used carefully.</p>]]></text></feedback>
    </answer>
  </question>
