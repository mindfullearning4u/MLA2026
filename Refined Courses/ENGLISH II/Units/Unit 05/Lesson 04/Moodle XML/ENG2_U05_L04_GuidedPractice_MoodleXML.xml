<quiz>
  <question type="multichoice">
    <name><text>ENG2_U05_L04_GP_Q01</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG2_U05_L04_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.ENG2.V.03</p><p><strong>Sentence:</strong> &quot;During the science demonstration, students had to _____ how the liquid changed color.&quot; Which word is most precise?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG2_U05_L04_GP_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. ignore</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Ignore has the opposite meaning.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. observe</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Observe means watch carefully to learn or understand, which fits the science context.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. forget</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Forget does not fit the task.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. decorate</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Decorate is unrelated.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG2_U05_L04_GP_Q02</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG2_U05_L04_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.ENG2.V.03</p><p>Which pair is made of antonyms?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG2_U05_L04_GP_Q02</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. precise and exact</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. These are synonyms.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. observe and watch</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. These are related synonyms.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. analyze and examine</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. These are related synonyms.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>D. vague and precise</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Vague and precise have opposite meanings.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG2_U05_L04_GP_Q03</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG2_U05_L04_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.ENG2.R.10</p><p>Dictionary entry: Analyze means to examine carefully by separating into parts. Which paraphrase is accurate for &quot;Students will analyze the paragraph&#39;s structure&quot;?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG2_U05_L04_GP_Q03</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>A. Students will examine the paragraph&#39;s parts carefully.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. This paraphrase uses the dictionary meaning accurately.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. Students will ignore the paragraph.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Analyze does not mean ignore.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Students will copy the paragraph without thinking.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Analyze requires careful examination.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Students will decorate the paragraph.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This is unrelated.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG2_U05_L04_GP_Q04</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG2_U05_L04_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.ENG2.V.02</p><p>Which word family connection can help with the meaning of structure?</p>]]></text></questiontext>
