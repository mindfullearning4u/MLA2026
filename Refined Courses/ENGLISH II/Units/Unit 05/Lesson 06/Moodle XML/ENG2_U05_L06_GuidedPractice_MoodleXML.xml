  <question type="multichoice">
    <name><text>ENG2_U05_L06_GP_Q01</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG2_U05_L06_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.ENG2.W.04</p><p>Ideas: Some students ride late buses. They need a place to study. Which revision best connects the ideas?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG2_U05_L06_GP_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>However, some students ride late buses, they need a place to study.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. However signals contrast and the sentence is awkward.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>Because some students ride late buses, they need a place to study after school.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Because correctly shows the reason relationship.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Some students ride late buses, they need a place to study.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This is a comma splice.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Students buses study because late.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This is unclear.</p>]]></text></feedback>
    </answer>
  </question>
