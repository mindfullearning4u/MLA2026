  <question type="multichoice">
    <name><text>ENG2_U05_L06_GP_Q03</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG2_U05_L06_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.ENG2.L.01</p><p>Which sentence is correctly joined?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG2_U05_L06_GP_Q03</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>The library closes early; as a result, students sometimes work in hallways.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The semicolon and transition correctly join related complete thoughts.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>The library closes early, students work in hallways.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This is a comma splice.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>The library closes early students work in hallways.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This is a run-on.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Because the library closes early.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This is a fragment.</p>]]></text></feedback>
    </answer>
  </question>
