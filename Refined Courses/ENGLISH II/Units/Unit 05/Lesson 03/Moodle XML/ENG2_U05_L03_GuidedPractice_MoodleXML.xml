<quiz>
  <question type="multichoice">
    <name><text>ENG2_U05_L03_GP_Q01</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG2_U05_L03_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.ENG2.V.03</p><p><strong>Passage:</strong> The team entered the empty auditorium. Dust rested on the seats, and a single spotlight flickered above the stage. Maya whispered, &quot;This place feels forgotten.&quot; What is the connotation of forgotten in this passage?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG2_U05_L03_GP_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. bright and cheerful</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The context creates an uneasy mood, not a cheerful one.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. lonely and neglected</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Forgotten suggests more than being empty; it creates a lonely, neglected feeling.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. crowded and noisy</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The auditorium is empty, not crowded.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. ordinary and neutral</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Forgotten carries a stronger feeling than neutral.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG2_U05_L03_GP_Q02</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG2_U05_L03_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.ENG2.V.03</p><p>Which word has the most negative connotation?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG2_U05_L03_GP_Q02</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. thin</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Thin can be neutral.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. slender</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Slender often has a positive or neutral connotation.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. lean</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Lean can be positive or neutral.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>D. scrawny</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Scrawny often sounds critical or negative.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG2_U05_L03_GP_Q03</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG2_U05_L03_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.ENG2.R.09</p><p><strong>Sentence:</strong> &quot;The cabin was cozy.&quot; What mood does cozy most likely create?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG2_U05_L03_GP_Q03</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>A. warmth and comfort</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Cozy has a positive connotation that creates a comfortable mood.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. fear</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Cozy does not usually create fear.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. anger</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Cozy does not suggest anger.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. confusion</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Cozy does not suggest confusion.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG2_U05_L03_GP_Q04</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG2_U05_L03_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.ENG2.R.12</p><p>Why might a writer choose cramped instead of small?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG2_U05_L03_GP_Q04</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. To make the space sound comfortable.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Cramped usually sounds uncomfortable.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. To make the space sound larger.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Cramped does not suggest a larger space.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>C. To create a negative feeling of discomfort.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Cramped suggests a small space that feels uncomfortable.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. To make the sentence neutral.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Cramped has a negative association.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG2_U05_L03_GP_Q05</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG2_U05_L03_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.ENG2.V.01</p><p>What is denotation?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG2_U05_L03_GP_Q05</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. the feeling connected to a word</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. That is connotation.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. the literal dictionary meaning of a word</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Denotation is the direct dictionary meaning.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. the author&#39;s attitude</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Tone is the author&#39;s attitude, so this choice does not identify the requested word-meaning concept.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. the feeling created for the reader</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Mood is the feeling created for the reader, so this choice does not identify the requested word-meaning concept.</p>]]></text></feedback>
    </answer>
  </question>
