  <question type="multichoice">
    <name><text>ENG2_U04_PRE_Q01</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG2_U04_PRE_Q01</p><p><strong>MLA Standard:</strong> MLA.ENG2.RS.01</p><p>Source set: A student is researching whether pre-order lunch forms can reduce unwanted trays. Which research question is most focused?</p>]]></text></questiontext>
