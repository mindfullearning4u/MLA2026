    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG2_U04_PRE_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. What is lunch?</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This question is too broad and not useful for research.</p>]]></text></feedback>
    </answer>
