<quiz>
  <question type="multichoice">
    <name><text>ENG2_U02_L07_GP_Q01</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG2_U02_L07_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.ENG2.W.01</p><p><strong>Passage:</strong> Jalen walked toward the classroom. Ten steps. The clock clicked once, loud as a lock. Five steps. <strong>Question:</strong> What is the effect of &quot;Ten steps. Five steps.&quot;?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG2_U02_L07_GP_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>It summarizes the whole story.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The lines focus on one tense moment, not the whole story.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>It slows the pace and builds tension.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The short sentences make each step feel important.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>It removes all suspense.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The counted steps increase suspense.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>It changes the setting.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The setting remains the hallway.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG2_U02_L07_GP_Q02</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG2_U02_L07_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.ENG2.W.01</p><p><strong>Passage:</strong> The clock above the door clicked once, loud as a lock. <strong>Question:</strong> Which detail most clearly creates tension?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG2_U02_L07_GP_Q02</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>The hallway is long.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This may describe setting, but it is not as tense as the clock comparison.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Jalen owns a backpack.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This detail does not create strong tension by itself.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>The class has a desk.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This is not part of the tense moment.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>The clock clicked &quot;loud as a lock.&quot;</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The sound comparison makes the moment feel final and tense.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG2_U02_L07_GP_Q03</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG2_U02_L07_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.ENG2.W.01</p><p><strong>Passage:</strong> Original <strong>Sentence:</strong> Jalen was nervous and went in. <strong>Question:</strong> Which revision best improves pacing?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG2_U02_L07_GP_Q03</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>Jalen&#39;s fingers paused on the cold knob. One breath. Then he opened the door.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The revision uses sensory detail and short sentences to slow the tense moment.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Jalen was nervous and went in.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This summarizes emotion too quickly.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Jalen did a thing at school.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This is vague and does not create mood or tension.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Jalen gave a presentation.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This skips the tense moment.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG2_U02_L07_GP_Q04</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG2_U02_L07_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.ENG2.W.01</p><p><strong>Passage:</strong> A narrative should spend the most time on the important moment and move quickly through less important action. <strong>Question:</strong> Which choice would speed up unimportant action?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG2_U02_L07_GP_Q04</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Add a full page about tying shoes.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This slows unimportant action.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Stop before the scene begins.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This does not control the scene effectively.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>Summarize the walk to school in one sentence.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Summary moves quickly through less important action.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Repeat the same detail six times.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Repetition slows pacing.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG2_U02_L07_GP_Q05</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG2_U02_L07_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.ENG2.W.01</p><p><strong>Passage:</strong> Jalen breathed in, opened the door, and said, &quot;I&#39;m ready.&quot; <strong>Question:</strong> What tone is created by Jalen&#39;s final words?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG2_U02_L07_GP_Q05</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>careless</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Jalen has been nervous and careful, not careless.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>determined</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. &quot;I&#39;m ready&quot; shows Jalen choosing to act despite fear.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>mocking</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The line is serious, not mocking.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>confused</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The line shows decision, not confusion.</p>]]></text></feedback>
    </answer>
  </question>
</quiz>

