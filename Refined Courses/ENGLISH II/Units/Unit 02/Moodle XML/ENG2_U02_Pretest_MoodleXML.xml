  <question type="multichoice">
    <name><text>ENG2_U02_PRE_Q01</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG2_U02_PRE_Q01</p><p><strong>MLA Standard:</strong> MLA.ENG2.R.01</p><p><strong>Passage:</strong> The old lantern guided neighbors during storms and later helped Mara prepare to speak. <strong>Question:</strong> What does the lantern most likely symbolize?</p>]]></text></questiontext>
