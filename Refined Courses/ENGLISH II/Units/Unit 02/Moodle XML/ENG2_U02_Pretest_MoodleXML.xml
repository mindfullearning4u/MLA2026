    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG2_U02_PRE_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. wealth and fame</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. No evidence connects the lantern to wealth.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. guidance and courage</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The lantern guides people literally and supports Mara symbolically.</p>]]></text></feedback>
    </answer>
