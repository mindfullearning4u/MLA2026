  <question type="multichoice">
    <name><text>ENG2_U02_PRE_Q05</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG2_U02_PRE_Q05</p><p><strong>MLA Standard:</strong> MLA.ENG2.R.04</p><p><strong>Passage:</strong> A door has no house and no key, but its knob shines where the speaker&#39;s hand might go. <strong>Question:</strong> Why is this ambiguous?</p>]]></text></questiontext>
