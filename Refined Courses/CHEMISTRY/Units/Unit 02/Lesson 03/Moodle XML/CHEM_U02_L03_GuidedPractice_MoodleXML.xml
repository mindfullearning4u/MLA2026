  <question type="multichoice">
    <name>
      <text>CHEM_U02_L03_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> CHEM_U02_L03_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.CHEM.ATO.02</p><p><strong>Stimulus:</strong></p><table><tr><th>Isotope</th><th>Protons</th><th>Mass number</th><th>Abundance</th></tr><tr><td>Chlorine-35</td><td>17</td><td>35</td><td>75%</td></tr><tr><td>Chlorine-37</td><td>17</td><td>37</td><td>25%</td></tr></table><p><strong>Question:</strong> Why are chlorine-35 and chlorine-37 isotopes of the same element?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[They have different protons.]]></text>
      <feedback format="html">
        <text><![CDATA[Different protons would mean different elements.]]></text>
      </feedback>
    </answer>    <answer fraction="0" format="html">
      <text><![CDATA[They have the same mass number.]]></text>
      <feedback format="html">
        <text><![CDATA[Their mass numbers differ: 35 and 37.]]></text>
      </feedback>
    </answer>    <answer fraction="100" format="html">
      <text><![CDATA[They have the same number of protons but different neutrons.]]></text>
      <feedback format="html">
        <text><![CDATA[Same protons means same element; different neutrons make isotopes.]]></text>
      </feedback>
    </answer>    <answer fraction="0" format="html">
      <text><![CDATA[They have no electrons.]]></text>
      <feedback format="html">
        <text><![CDATA[Electrons are not absent in neutral chlorine atoms.]]></text>
      </feedback>
    </answer>  </question>  <question type="multichoice">
    <name>
      <text>CHEM_U02_L03_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> CHEM_U02_L03_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.CHEM.ATO.02</p><p><strong>Stimulus:</strong></p><table><tr><th>Isotope</th><th>Protons</th><th>Mass number</th><th>Abundance</th></tr><tr><td>Chlorine-35</td><td>17</td><td>35</td><td>75%</td></tr><tr><td>Chlorine-37</td><td>17</td><td>37</td><td>25%</td></tr></table><p><strong>Question:</strong> How many neutrons are in chlorine-37?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[20]]></text>
      <feedback format="html">
        <text><![CDATA[Neutrons = mass number - protons = 37 - 17 = 20.]]></text>
      </feedback>
    </answer>    <answer fraction="0" format="html">
      <text><![CDATA[17]]></text>
      <feedback format="html">
        <text><![CDATA[17 is the proton number.]]></text>
      </feedback>
    </answer>    <answer fraction="0" format="html">
      <text><![CDATA[37]]></text>
      <feedback format="html">
        <text><![CDATA[37 is the mass number, not neutrons.]]></text>
      </feedback>
    </answer>    <answer fraction="0" format="html">
      <text><![CDATA[54]]></text>
      <feedback format="html">
        <text><![CDATA[54 adds mass number and protons incorrectly.]]></text>
      </feedback>
    </answer>  </question>  <question type="multichoice">
    <name>
      <text>CHEM_U02_L03_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> CHEM_U02_L03_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.CHEM.ATO.02</p><p><strong>Stimulus:</strong></p><table><tr><th>Isotope</th><th>Protons</th><th>Mass number</th><th>Abundance</th></tr><tr><td>Chlorine-35</td><td>17</td><td>35</td><td>75%</td></tr><tr><td>Chlorine-37</td><td>17</td><td>37</td><td>25%</td></tr></table><p><strong>Question:</strong> Why is chlorine's average atomic mass closer to 35 than 37 in the table?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Chlorine-37 has more neutrons.]]></text>
      <feedback format="html">
        <text><![CDATA[More neutrons does not control closeness by itself.]]></text>
      </feedback>
    </answer>    <answer fraction="0" format="html">
      <text><![CDATA[Both isotopes have electrons.]]></text>
      <feedback format="html">
        <text><![CDATA[Electrons do not explain weighted average mass.]]></text>
      </feedback>
    </answer>    <answer fraction="0" format="html">
      <text><![CDATA[The average ignores abundance.]]></text>
      <feedback format="html">
        <text><![CDATA[Average atomic mass uses abundance.]]></text>
      </feedback>
    </answer>    <answer fraction="100" format="html">
      <text><![CDATA[Chlorine-35 is more abundant.]]></text>
      <feedback format="html">
        <text><![CDATA[The more abundant isotope pulls the weighted average closer to its mass.]]></text>
      </feedback>
    </answer>  </question>  <question type="multichoice">
    <name>
      <text>CHEM_U02_L03_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> CHEM_U02_L03_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.CHEM.ATO.02</p><p><strong>Stimulus:</strong></p><table><tr><th>Isotope</th><th>Protons</th><th>Mass number</th><th>Abundance</th></tr><tr><td>Chlorine-35</td><td>17</td><td>35</td><td>75%</td></tr><tr><td>Chlorine-37</td><td>17</td><td>37</td><td>25%</td></tr></table><p><strong>Question:</strong> What is the weighted-average setup for the table?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[35 + 37]]></text>
      <feedback format="html">
        <text><![CDATA[A simple average ignores abundance.]]></text>
      </feedback>
    </answer>    <answer fraction="0" format="html">
      <text><![CDATA[17(35) + 17(37)]]></text>
      <feedback format="html">
        <text><![CDATA[Multiplying protons by masses is not the method.]]></text>
      </feedback>
    </answer>    <answer fraction="100" format="html">
      <text><![CDATA[35(0.75) + 37(0.25)]]></text>
      <feedback format="html">
        <text><![CDATA[Convert percent abundance to decimals and multiply by isotope mass.]]></text>
      </feedback>
    </answer>    <answer fraction="0" format="html">
      <text><![CDATA[75 + 25]]></text>
      <feedback format="html">
        <text><![CDATA[75 + 25 only checks percent total.]]></text>
      </feedback>
    </answer>  </question>  <question type="multichoice">
    <name>
      <text>CHEM_U02_L03_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> CHEM_U02_L03_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.CHEM.ATO.02</p><p><strong>Stimulus:</strong></p><table><tr><th>Isotope</th><th>Protons</th><th>Mass number</th><th>Abundance</th></tr><tr><td>Chlorine-35</td><td>17</td><td>35</td><td>75%</td></tr><tr><td>Chlorine-37</td><td>17</td><td>37</td><td>25%</td></tr></table><p><strong>Question:</strong> What particle count changes between isotopes of the same element?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Protons]]></text>
