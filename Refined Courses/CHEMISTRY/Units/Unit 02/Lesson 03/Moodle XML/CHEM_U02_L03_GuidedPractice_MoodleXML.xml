      <text><![CDATA[Neutrons]]></text>
      <feedback format="html">
        <text><![CDATA[Isotopes differ by neutron count.]]></text>
      </feedback>
    </answer>    <answer fraction="0" format="html">
      <text><![CDATA[Atomic number]]></text>
      <feedback format="html">
        <text><![CDATA[Atomic number equals protons and stays the same.]]></text>
      </feedback>
    </answer>    <answer fraction="0" format="html">
      <text><![CDATA[Element identity]]></text>
      <feedback format="html">
        <text><![CDATA[Element identity stays the same.]]></text>
      </feedback>
    </answer>  </question></quiz>



