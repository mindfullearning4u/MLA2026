    <answer fraction="0" format="html">
      <text><![CDATA[The claim that all data are wrong.]]></text>
      <feedback format="html">
        <text><![CDATA[Uncertainty does not mean all data are useless.]]></text>
      </feedback>
    </answer>    <answer fraction="100" format="html">
      <text><![CDATA[The reasonable limit of confidence in a measured value.]]></text>
