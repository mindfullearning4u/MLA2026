      <text>CHEM_U01_L04_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> CHEM_U01_L04_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.CHEM.LAB.03</p><p><strong>Stimulus:</strong></p><table><tr><th>Trial</th><th>Time (min)</th><th>Temperature (deg C)</th></tr><tr><td>1</td><td>0</td><td>22.0</td></tr><tr><td>2</td><td>2</td><td>26.5</td></tr><tr><td>3</td><td>4</td><td>31.0</td></tr><tr><td>4</td><td>6</td><td>35.5</td></tr></table><p><strong>Question:</strong> What trend does the table show?</p>]]></text>
