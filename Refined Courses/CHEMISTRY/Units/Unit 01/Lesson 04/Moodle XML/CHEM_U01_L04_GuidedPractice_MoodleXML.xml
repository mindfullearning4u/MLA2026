      <text>CHEM_U01_L04_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> CHEM_U01_L04_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.CHEM.LAB.03</p><p><strong>Stimulus:</strong></p><table><tr><th>Trial</th><th>Time (min)</th><th>Temperature (deg C)</th></tr><tr><td>1</td><td>0</td><td>22.0</td></tr><tr><td>2</td><td>2</td><td>26.5</td></tr><tr><td>3</td><td>4</td><td>31.0</td></tr><tr><td>4</td><td>6</td><td>35.5</td></tr></table><p><strong>Question:</strong> In the table, which variable belongs on the x-axis for a line graph?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Temperature (deg C)]]></text>
      <feedback format="html">
        <text><![CDATA[Temperature is the measured response and belongs on the y-axis.]]></text>
      </feedback>
    </answer>    <answer fraction="0" format="html">
      <text><![CDATA[Trial number only]]></text>
      <feedback format="html">
        <text><![CDATA[Trial number labels rows but does not show the main relationship.]]></text>
      </feedback>
    </answer>    <answer fraction="100" format="html">
      <text><![CDATA[Time (min)]]></text>
      <feedback format="html">
        <text><![CDATA[Time is the independent variable changing across the data set.]]></text>
      </feedback>
    </answer>    <answer fraction="0" format="html">
      <text><![CDATA[No variable is needed]]></text>
      <feedback format="html">
        <text><![CDATA[A graph needs labeled variables.]]></text>
      </feedback>
    </answer>  </question>  <question type="multichoice">
