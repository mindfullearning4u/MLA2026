<quiz>
  <question type="category">
    <category>
      <text>$course$/Math for College Readiness/Units/Unit 05/Lesson 05/MCR_U05_L05_GuidedPractice</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U05_L05_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U05_L05_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.MCR.PR.6</p><p>A meal has 3 sandwich choices and 2 drink choices. How many meal combinations are possible?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[6]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Multiply the choices: 3 sandwiches times 2 drinks = 6 meals.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[5]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the choices. Counting paired choices requires multiplication.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[3]]></text>
      <feedback format="html">
        <text><![CDATA[This counts only the sandwich choices and ignores drinks.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[2]]></text>
      <feedback format="html">
        <text><![CDATA[This counts only the drink choices and ignores sandwiches.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U05_L05_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U05_L05_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.MCR.PR.6</p><p>A code has 4 letter choices followed by 5 number choices. How many codes are possible?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[9]]></text>
      <feedback format="html">
        <text><![CDATA[This adds choices instead of multiplying decision steps.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[20]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Multiply 4 by 5 because each letter can pair with each number.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[45]]></text>
      <feedback format="html">
        <text><![CDATA[This joins the numbers instead of counting outcomes.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[1]]></text>
      <feedback format="html">
        <text><![CDATA[This ignores the number of choices.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U05_L05_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U05_L05_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.MCR.PR.7</p><p>Four students run for president and vice president. How many ordered results are possible?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[6]]></text>
      <feedback format="html">
        <text><![CDATA[This would be the number of two-person groups, but offices are ordered.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[8]]></text>
      <feedback format="html">
        <text><![CDATA[This doubles the number of students but does not count ordered results.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[12]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. President has 4 choices and vice president has 3 remaining choices.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[16]]></text>
      <feedback format="html">
        <text><![CDATA[This allows the same student to hold both offices, which is not allowed.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U05_L05_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U05_L05_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.MCR.PR.7</p><p>Four students are available and two are chosen for the same committee. How many groups are possible?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[12]]></text>
      <feedback format="html">
        <text><![CDATA[This counts order, but committee roles are the same.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[8]]></text>
      <feedback format="html">
        <text><![CDATA[This doubles the number of students and does not count groups correctly.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4]]></text>
      <feedback format="html">
        <text><![CDATA[This counts only the students, not pairs.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[6]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. There are 12 ordered pairs, but each group is counted twice, so 12 divided by 2 = 6.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U05_L05_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U05_L05_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.MCR.PR.7</p><p>Which situation is a permutation?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Choosing 3 people for the same committee]]></text>
      <feedback format="html">
        <text><![CDATA[Order does not matter for the same committee.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Awarding first, second, and third place]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Order matters because first, second, and third are different positions.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Selecting 2 snacks for a bag]]></text>
      <feedback format="html">
        <text><![CDATA[Order does not matter when the same snacks are selected.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Choosing 4 books to read over summer]]></text>
      <feedback format="html">
        <text><![CDATA[Unless a reading order is required, this is a selection where order does not matter.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>