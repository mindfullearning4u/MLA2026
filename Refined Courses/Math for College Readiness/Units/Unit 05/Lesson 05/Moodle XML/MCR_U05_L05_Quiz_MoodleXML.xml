  <question type="multichoice">
    <name>
      <text>MCR_U05_L05_Q06</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U05_L05_Q06</p><p><strong>MLA Standard:</strong> MLA.MCR.PR.7</p><p>Which situation has order that matters?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Choosing two equal members for a committee]]></text>
      <feedback format="html">
        <text><![CDATA[Equal committee roles do not depend on order.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Choosing a first-place and second-place winner]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. First place and second place are different positions.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Selecting three toppings for a pizza]]></text>
      <feedback format="html">
        <text><![CDATA[The selected toppings are usually the same no matter the order named.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Picking two books to donate]]></text>
      <feedback format="html">
        <text><![CDATA[The donation set is usually unchanged by order.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U05_L05_Q07</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U05_L05_Q07</p><p><strong>MLA Standard:</strong> MLA.MCR.PR.7</p><p>Which situation is best described as a combination?</p>]]></text>
