      <text><![CDATA[12]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. One letter choice and one digit choice give 3 times 4 = 12 codes.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[7]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the choices instead of multiplying.]]></text>
