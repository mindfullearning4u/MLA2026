      <text>MCR_U05_L05_Q13</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U05_L05_Q13</p><p><strong>MLA Standard:</strong> MLA.MCR.PR.7</p><p>What is the main question to ask before deciding between permutation and combination?</p>]]></text>
