  <question type="multichoice">
    <name>
      <text>MCR_U05_L05_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U05_L05_Q01</p><p><strong>MLA Standard:</strong> MLA.MCR.PR.6</p><p>A shirt comes in 4 colors and 3 sizes. How many shirt options are possible?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[12]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Multiply 4 colors by 3 sizes.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[7]]></text>
      <feedback format="html">
        <text><![CDATA[This adds choices instead of multiplying.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[4]]></text>
      <feedback format="html">
        <text><![CDATA[This counts only colors.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[3]]></text>
      <feedback format="html">
        <text><![CDATA[This counts only sizes.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U05_L05_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U05_L05_Q02</p><p><strong>MLA Standard:</strong> MLA.MCR.PR.6</p><p>A lunch has 2 entrees, 3 sides, and 2 drinks. How many lunches are possible?</p>]]></text>
