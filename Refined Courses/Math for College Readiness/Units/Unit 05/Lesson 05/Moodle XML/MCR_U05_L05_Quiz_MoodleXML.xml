    <answer fraction="0" format="html">
      <text><![CDATA[Assigning president and treasurer]]></text>
      <feedback format="html">
        <text><![CDATA[Different offices mean order or role matters.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Ranking three finalists]]></text>
      <feedback format="html">
        <text><![CDATA[Ranking depends on order.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Choosing three people for the same team]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The same team does not change when names are listed in a different order.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Awarding gold, silver, and bronze]]></text>
      <feedback format="html">
        <text><![CDATA[Awards are ordered positions.]]></text>
      </feedback>
    </answer>
  </question>
