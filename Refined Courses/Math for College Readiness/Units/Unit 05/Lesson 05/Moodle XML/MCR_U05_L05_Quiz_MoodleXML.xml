  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U05_L05_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U05_L05_Q03</p><p><strong>MLA Standard:</strong> MLA.MCR.PR.7</p><p>Five students run for president and vice president. How many ordered outcomes are possible?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[10]]></text>
      <feedback format="html">
        <text><![CDATA[This is too small because each first choice has four second choices.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[25]]></text>
      <feedback format="html">
        <text><![CDATA[This allows the same person to hold both offices.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[20]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. There are 5 choices for president and 4 remaining choices for vice president.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[5]]></text>
      <feedback format="html">
        <text><![CDATA[This counts only president choices.]]></text>
