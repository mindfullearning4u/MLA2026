    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[7]]></text>
      <feedback format="html">
        <text><![CDATA[This adds choices instead of multiplying decision steps.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[12]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Multiply 2 times 3 times 2 = 12.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[10]]></text>
      <feedback format="html">
        <text><![CDATA[This omits one decision step.]]></text>
