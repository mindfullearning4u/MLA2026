  <question type="multichoice">
    <name>
      <text>MCR_U05_L04_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U05_L04_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.MCR.PR.2</p><p>In a table, 18 Grade 11 students prefer online review out of 30 Grade 11 students. What is P(online given Grade 11)?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[18/30]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Given Grade 11 restricts the denominator to the 30 Grade 11 students.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[18/60]]></text>
      <feedback format="html">
        <text><![CDATA[This uses the grand total, but the condition restricts the group.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[30/18]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the conditional probability ratio.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[12/30]]></text>
      <feedback format="html">
        <text><![CDATA[This uses the Grade 11 paper count, not the online count.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U05_L04_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U05_L04_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.MCR.PR.2</p><p>In a table, 20 Grade 12 students prefer paper review out of 30 Grade 12 students. What is P(paper given Grade 12)?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[20/60]]></text>
      <feedback format="html">
        <text><![CDATA[This uses the grand total instead of the Grade 12 total.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[20/30]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The condition Grade 12 restricts the denominator to 30.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[30/20]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the ratio.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[10/30]]></text>
      <feedback format="html">
        <text><![CDATA[This is the Grade 12 online count, not paper.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U05_L04_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U05_L04_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.MCR.PR.2</p><p>In a table, 18 Grade 11 students prefer online review and 28 total students prefer online review. What is P(Grade 11 given online)?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[18/60]]></text>
      <feedback format="html">
        <text><![CDATA[This uses the grand total instead of the online total.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[28/18]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the ratio.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[18/28]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Given online restricts the denominator to the 28 online students.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[10/28]]></text>
      <feedback format="html">
        <text><![CDATA[This uses the Grade 12 online count, not Grade 11 online.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U05_L04_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U05_L04_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.MCR.PR.2</p><p>What does the word given usually tell you in a conditional probability question?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Use the grand total every time]]></text>
      <feedback format="html">
        <text><![CDATA[Given usually means the group is restricted, so the grand total may be wrong.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Add the row and column totals]]></text>
      <feedback format="html">
        <text><![CDATA[Adding totals does not identify the conditional denominator.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Ignore the table]]></text>
      <feedback format="html">
        <text><![CDATA[The table is needed to find the restricted count and total.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Restrict the denominator to a smaller group]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Given tells which group should be used as the denominator.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U05_L04_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U05_L04_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.MCR.PR.2</p><p>A table shows 12 juniors play soccer out of 20 juniors. What is P(soccer given junior)?</p><p><strong>Embedded representation:</strong></p><table border="1" cellpadding="6" cellspacing="0"><tr><th></th><th>Soccer</th><th>Not Soccer</th><th>Total</th></tr><tr><td>Juniors</td><td>12</td><td>8</td><td>20</td></tr><tr><td>Seniors</td><td>10</td><td>10</td><td>20</td></tr></table>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[8/20]]></text>
      <feedback format="html">
        <text><![CDATA[This is the junior non-soccer count.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[12/20]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Given junior restricts the denominator to 20 juniors.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[12/50]]></text>
      <feedback format="html">
        <text><![CDATA[This uses a possible grand total instead of the restricted junior total.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[20/12]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the ratio.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>
