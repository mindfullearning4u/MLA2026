  <question type="multichoice">
    <name>
      <text>MCR_U02_L04_Quiz_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U02_L04_Quiz_Q01</p><p><strong>MLA Standard:</strong> MLA.MCR.AR.6</p><p>Plan A is 11 + 5m and Plan B is 41 + 2m. Which equation finds the break-even point?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[11 + 5m = 41 + 2m]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Break-even means set the two total-cost models equal.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[11 + 5m &gt; 41 + 2m]]></text>
      <feedback format="html">
        <text><![CDATA[This compares greater than, but break-even requires equality.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[11m + 5 = 41m + 2]]></text>
      <feedback format="html">
        <text><![CDATA[This switches fixed costs and rates.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[11 + 41 = 5m + 2m]]></text>
      <feedback format="html">
        <text><![CDATA[This combines unrelated parts instead of setting plan totals equal.]]></text>
      </feedback>
    </answer>
  </question>
