<quiz>
  <question type="category">
    <category>
      <text>$course$/Math for College Readiness/Units/Unit 04/Lesson 05/MCR_U04_L05_GuidedPractice</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U04_L05_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U04_L05_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.MCR.FL.11</p><p>An insurance plan costs $80 per month. What is the annual premium cost?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[$960]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Multiply 80 by 12 months to get 960.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$80]]></text>
      <feedback format="html">
        <text><![CDATA[This is one monthly payment, not annual premium cost.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$92]]></text>
      <feedback format="html">
        <text><![CDATA[This adds 80 and 12 instead of multiplying.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$1,200]]></text>
      <feedback format="html">
        <text><![CDATA[This does not match 80 per month for 12 months.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U04_L05_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U04_L05_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.MCR.FL.11</p><p>Plan A has a $500 deductible. Plan B has a $1,200 deductible. Which has lower deductible risk?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Plan B]]></text>
      <feedback format="html">
        <text><![CDATA[Plan B has the higher deductible.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Plan A]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Plan A requires less out-of-pocket cost before coverage begins.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Both are equal]]></text>
      <feedback format="html">
        <text><![CDATA[The deductible amounts are different.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Cannot compare]]></text>
      <feedback format="html">
        <text><![CDATA[The deductible amounts are enough to compare this risk.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U04_L05_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U04_L05_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.MCR.FL.11</p><p>What is a premium?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[money paid only after a claim]]></text>
      <feedback format="html">
        <text><![CDATA[That describes possible out-of-pocket cost, not premium.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[the amount insurance always pays]]></text>
      <feedback format="html">
        <text><![CDATA[Coverage depends on the plan.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[a regular payment to keep insurance coverage]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A premium is paid regularly to maintain coverage.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[the same thing as risk]]></text>
      <feedback format="html">
        <text><![CDATA[Risk is chance of loss, not the payment.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U04_L05_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U04_L05_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.MCR.FL.11</p><p>Why might the plan with the lowest monthly premium not always be best?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[it always has the best coverage]]></text>
      <feedback format="html">
        <text><![CDATA[Lowest premium does not guarantee best coverage.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[it always has no deductible]]></text>
      <feedback format="html">
        <text><![CDATA[Low premium plans may have higher deductibles.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[it removes all risk]]></text>
      <feedback format="html">
        <text><![CDATA[Insurance reduces risk but does not remove all costs.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[it may have higher out-of-pocket costs when care is needed]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A lower premium can come with a higher deductible or other costs.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U04_L05_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U04_L05_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.MCR.FL.11</p><p>Annual premiums are $1,100 and the deductible is $700. What is a simple premium-plus-deductible comparison?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[$400]]></text>
      <feedback format="html">
        <text><![CDATA[This subtracts deductible from premiums.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[$1,800]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Add predictable premium cost and possible deductible: 1,100 + 700 = 1,800.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$700]]></text>
      <feedback format="html">
        <text><![CDATA[This is only the deductible.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$1,100]]></text>
      <feedback format="html">
        <text><![CDATA[This is only annual premium cost.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>