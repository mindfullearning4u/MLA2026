  <question type="multichoice">
    <name>
      <text>MCR_U04_L06_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U04_L06_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.MCR.FL.12</p><p>A person saves $75 per month for 12 months. What is the annual contribution?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[$900]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Multiply 75 by 12 months to get 900.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$75]]></text>
      <feedback format="html">
        <text><![CDATA[This is only one monthly contribution.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$87]]></text>
      <feedback format="html">
        <text><![CDATA[This adds 75 and 12.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$1,200]]></text>
      <feedback format="html">
        <text><![CDATA[This would be $100 per month for 12 months, not $75.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U04_L06_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U04_L06_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.MCR.FL.12</p><p>Contributions are $1,000 and growth is $60. What is the ending balance?</p><p><img src="@@PLUGINFILE@@/MCR_U04_L06_GP_Q02_visual.png" alt="Math for College Readiness support visual reinforces the model, graph, table, data display, or financial reasoning named in the question." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="MCR_U04_L06_GP_Q02_visual.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[$940]]></text>
      <feedback format="html">
        <text><![CDATA[This subtracts growth instead of adding it.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[$1,060]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Add contributions and growth: 1,000 + 60 = 1,060.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$1,000]]></text>
      <feedback format="html">
        <text><![CDATA[This ignores growth.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$60]]></text>
      <feedback format="html">
        <text><![CDATA[This is only the growth amount.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U04_L06_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U04_L06_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.MCR.FL.12</p><p>Why does time matter in long-term savings?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[time always removes risk]]></text>
      <feedback format="html">
        <text><![CDATA[Time does not remove financial risk.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[time makes contributions unnecessary]]></text>
      <feedback format="html">
        <text><![CDATA[Contributions still matter.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[money has more opportunities to grow over time]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. More time allows more contributions and possible compound growth.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[time guarantees a specific balance]]></text>
      <feedback format="html">
        <text><![CDATA[Growth estimates are not absolute guarantees.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U04_L06_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U04_L06_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.MCR.FL.12</p><p>Which tool helps organize yearly balance, contributions, and growth?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[deductible]]></text>
      <feedback format="html">
        <text><![CDATA[A deductible is an insurance cost.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[copay]]></text>
      <feedback format="html">
        <text><![CDATA[A copay is an insurance payment.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[finance charge]]></text>
      <feedback format="html">
        <text><![CDATA[A finance charge is borrowing cost.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[spreadsheet table]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A spreadsheet table can track repeated calculations over time.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U04_L06_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U04_L06_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.MCR.FL.12</p><p>Plan A ends with $5,400. Plan B ends with $5,850. Which ends higher, and by how much?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Plan A by $450]]></text>
      <feedback format="html">
        <text><![CDATA[Plan A is lower, not higher.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Plan B by $450]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Subtract 5,400 from 5,850 to get 450.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Plan B by $11,250]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the balances instead of comparing them.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[They are equal]]></text>
      <feedback format="html">
        <text><![CDATA[The final balances are different.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>