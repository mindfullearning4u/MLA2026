<quiz>
  <question type="category">
    <category>
      <text>$course$/Math for College Readiness/Units/Unit 01/Lesson 07/MCR_U01_L07_GuidedPractice</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U01_L07_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U01_L07_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.MCR.QR.3</p><p>A grade uses quizzes at 40% and projects at 60%. Scores are 80 for quizzes and 90 for projects. What is the weighted average?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[86]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. 80(0.40) + 90(0.60) = 32 + 54 = 86.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[85]]></text>
      <feedback format="html">
        <text><![CDATA[This is the simple average, but the categories have different weights.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[170]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the scores without applying weights.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[68]]></text>
      <feedback format="html">
        <text><![CDATA[This applies weights incorrectly and does not add the weighted products.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U01_L07_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U01_L07_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.MCR.QR.3</p><p>Which decimal weight is equivalent to 30%?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[3.0]]></text>
      <feedback format="html">
        <text><![CDATA[This represents 300%, not 30%.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[0.30]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Divide 30 by 100 to write 30% as 0.30.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[0.03]]></text>
      <feedback format="html">
        <text><![CDATA[This represents 3%, not 30%.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[30.0]]></text>
      <feedback format="html">
        <text><![CDATA[This is far too large for a decimal weight.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U01_L07_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U01_L07_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.MCR.QR.3</p><p>An option has scores 70, 85, and 95 with weights 50%, 30%, and 20%. What is the weighted score?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[83.3]]></text>
      <feedback format="html">
        <text><![CDATA[This is close to a simple average, but weights must be applied.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[250]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the scores without applying weights.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[79.5]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. 70(0.50) + 85(0.30) + 95(0.20) = 35 + 25.5 + 19 = 79.5.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[95]]></text>
      <feedback format="html">
        <text><![CDATA[This selects one score rather than calculating the weighted score.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U01_L07_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U01_L07_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.MCR.QR.3</p><p>Why should weights total 100%?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[So every score becomes the same]]></text>
      <feedback format="html">
        <text><![CDATA[Weights do not make scores the same; they show category importance.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[So the largest score is always chosen]]></text>
      <feedback format="html">
        <text><![CDATA[Weighted averages combine categories rather than choosing only the largest score.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[So no calculation is needed]]></text>
      <feedback format="html">
        <text><![CDATA[The calculation is still needed after checking weights.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[So the full decision is accounted for]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Weights totaling 100% represent the whole decision or whole grade.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U01_L07_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U01_L07_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.MCR.QR.3</p><p>Option A has a weighted score of 82. Option B has a weighted score of 79. Which option is better by weighted score?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Option B, because 79 is smaller]]></text>
      <feedback format="html">
        <text><![CDATA[A smaller weighted score is not better when higher scores represent stronger options.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Option A, because 82 is greater than 79]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. By weighted score, the higher total indicates the stronger option.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[They are equal because both are weighted scores]]></text>
      <feedback format="html">
        <text><![CDATA[The scores are not equal; 82 is greater than 79.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[There is no way to compare weighted scores]]></text>
      <feedback format="html">
        <text><![CDATA[Weighted scores are designed to support comparisons.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>