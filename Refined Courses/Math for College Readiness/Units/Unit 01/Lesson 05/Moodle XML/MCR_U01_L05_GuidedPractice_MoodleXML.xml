  <question type="multichoice">
    <name>
      <text>MCR_U01_L05_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U01_L05_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.MCR.QR.4</p><p>Use d = rt to solve for t.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[t = d/r]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Divide both sides by r to isolate t, so time equals distance divided by rate.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[t = dr]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies distance and rate, but isolating t requires dividing by r.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[t = r/d]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the quotient. Time is distance divided by rate.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[t = d + r]]></text>
      <feedback format="html">
        <text><![CDATA[This adds quantities but does not rearrange the multiplication formula.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U01_L05_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U01_L05_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.MCR.QR.5</p><p>If C(h) = 15h + 20, what is C(4)?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[39]]></text>
      <feedback format="html">
        <text><![CDATA[This adds 15, 4, and 20 instead of multiplying 15 by the input.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[80]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Substitute h = 4: C(4) = 15(4) + 20 = 80.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[60]]></text>
      <feedback format="html">
        <text><![CDATA[This calculates 15 x 4 but omits the added 20.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[95]]></text>
      <feedback format="html">
        <text><![CDATA[This uses 5 instead of 4 or adds an extra amount.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U01_L05_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U01_L05_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.MCR.QR.5</p><p>The function B(m) = 30m gives total membership cost in dollars for m months. What does B(6) = 180 mean?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The membership lasts 180 months]]></text>
      <feedback format="html">
        <text><![CDATA[This confuses the output cost with the input time.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The monthly cost is $180]]></text>
      <feedback format="html">
        <text><![CDATA[This confuses total cost with monthly cost.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[A 6-month membership costs $180]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The input is 6 months and the output is total cost in dollars.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The membership costs $6 for 180 months]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the input and output meanings.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U01_L05_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U01_L05_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.MCR.QR.4</p><p>Use A = lw to solve for w.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[w = Al]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies area and length, but isolating width requires division.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[w = l/A]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the relationship. Width equals area divided by length.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[w = A + l]]></text>
      <feedback format="html">
        <text><![CDATA[This adds quantities and does not isolate the variable from multiplication.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[w = A/l]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Divide both sides by l to isolate w.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U01_L05_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U01_L05_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.MCR.QR.5</p><p>If P(n) = 12n gives the total price in dollars for n tickets, what is P(8)?</p><p><img src="@@PLUGINFILE@@/MCR_U01_L05_GP_Q05_diagram.png" alt="Geometry diagram supports visual interpretation without adding new assessment facts." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="MCR_U01_L05_GP_Q05_diagram.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[$20]]></text>
      <feedback format="html">
        <text><![CDATA[This adds 12 and 8 instead of multiplying the ticket price by the number of tickets.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[$96]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. P(8) = 12(8) = 96, so 8 tickets cost $96.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$12]]></text>
      <feedback format="html">
        <text><![CDATA[This is the price per ticket, not the total price for 8 tickets.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$8]]></text>
      <feedback format="html">
        <text><![CDATA[This is the input value, not the output price.]]></text>
      </feedback>
    </answer>
  </question>
