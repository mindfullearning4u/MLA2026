  <question type="multichoice">
    <name>
      <text>MCR_U01_L05_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U01_L05_Q01</p><p><strong>MLA Standard:</strong> MLA.MCR.QR.4</p><p>Use d = rt to solve for r.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[r = d/t]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Divide both sides by t to isolate r, so rate equals distance divided by time.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[r = dt]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies distance and time, but rate requires division.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[r = t/d]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the quotient and gives the wrong meaning.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[r = d + t]]></text>
      <feedback format="html">
        <text><![CDATA[This adds quantities but does not rearrange the formula.]]></text>
      </feedback>
    </answer>
  </question>
