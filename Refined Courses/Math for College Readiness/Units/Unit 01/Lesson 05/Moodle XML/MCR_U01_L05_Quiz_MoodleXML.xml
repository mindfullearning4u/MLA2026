  <question type="multichoice">
    <name>
      <text>MCR_U01_L05_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U01_L05_Q04</p><p><strong>MLA Standard:</strong> MLA.MCR.QR.4</p><p>Use P = 2L + 2W to solve for L.</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[L = P - 2W]]></text>
      <feedback format="html">
        <text><![CDATA[This subtracts 2W but does not divide by 2 to isolate L.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[L = P/2 + W]]></text>
      <feedback format="html">
        <text><![CDATA[This divides too early and adds W instead of subtracting W.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[L = P/(2W)]]></text>
      <feedback format="html">
        <text><![CDATA[This divides by 2W, which changes the structure of the formula.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[L = (P - 2W)/2]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Subtract 2W, then divide by 2 to isolate L.]]></text>
      </feedback>
    </answer>
  </question>
