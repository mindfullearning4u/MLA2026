  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U01_L06_Q06</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U01_L06_Q06</p><p><strong>MLA Standard:</strong> MLA.MCR.QR.6</p><p>A plant grows from 8 inches to 20 inches over 6 weeks. What is the average rate of change?</p>]]></text>
