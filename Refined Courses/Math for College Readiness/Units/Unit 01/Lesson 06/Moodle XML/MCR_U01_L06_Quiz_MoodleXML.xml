    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[12 inches per week]]></text>
      <feedback format="html">
        <text><![CDATA[This is the total growth, not the weekly average.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[2 inches per week]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The plant grows 12 inches over 6 weeks, so 12 divided by 6 = 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[28 inches per week]]></text>
      <feedback format="html">
