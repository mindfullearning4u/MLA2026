  <question type="multichoice">
    <name>
      <text>MCR_U01_L06_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U01_L06_Q01</p><p><strong>MLA Standard:</strong> MLA.MCR.QR.6</p><p>A car travels 240 miles in 4 hours. What is the average speed?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[60 miles per hour]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Divide 240 miles by 4 hours to get 60 miles per hour.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[244 miles per hour]]></text>
      <feedback format="html">
        <text><![CDATA[This adds miles and hours instead of finding miles per hour.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[960 miles per hour]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies miles and hours, which does not find speed.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[236 miles per hour]]></text>
      <feedback format="html">
        <text><![CDATA[This subtracts hours from miles, which is not a rate.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U01_L06_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U01_L06_Q02</p><p><strong>MLA Standard:</strong> MLA.MCR.QR.6</p><p>A balance changes from $150 in week 1 to $210 in week 5. What is the average rate of change?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[$60 per week]]></text>
      <feedback format="html">
        <text><![CDATA[This is the total change, not the change per week.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[$15 per week]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The balance changes by $60 over 4 weeks, so 60 divided by 4 = 15.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$30 per week]]></text>
      <feedback format="html">
        <text><![CDATA[This divides by 2 instead of the 4-week interval.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$360 per week]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the balances and ignores the change in weeks.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U01_L06_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U01_L06_Q03</p><p><strong>MLA Standard:</strong> MLA.MCR.QR.6</p><p>A delivery cost changes from $21 at 3 miles to $33 at 9 miles. What is the average rate of change?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[$12 per mile]]></text>
      <feedback format="html">
        <text><![CDATA[This is the total change in cost, not divided by miles.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$6 per mile]]></text>
      <feedback format="html">
        <text><![CDATA[This is the change in miles, not the average cost change per mile.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[$2 per mile]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Cost changes by $12 over 6 miles, so 12 divided by 6 = 2.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$54 per mile]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the costs and does not calculate a rate.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U01_L06_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U01_L06_Q04</p><p><strong>MLA Standard:</strong> MLA.MCR.QR.6</p><p>For C(m) = 4m + 12, where C is cost in dollars and m is miles, what is the rate of change?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[$12 per mile]]></text>
      <feedback format="html">
        <text><![CDATA[This is the fixed fee, not the rate of change.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$16 per mile]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the coefficient and fixed fee.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$48 per mile]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies the coefficient and fixed fee.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[$4 per mile]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The coefficient 4 means cost increases by $4 for each mile.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U01_L06_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U01_L06_Q05</p><p><strong>MLA Standard:</strong> MLA.MCR.QR.6</p><p>A company charges $23 for 4 miles and $43 for 14 miles. What is the average rate of change?</p>]]></text>
