  <question type="multichoice">
    <name>
      <text>MCR_U01_L06_Q17</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U01_L06_Q17</p><p><strong>MLA Standard:</strong> MLA.MCR.QR.6</p><p>For P(t) = 25t + 100, where P is dollars and t is days, what is the rate of change?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
