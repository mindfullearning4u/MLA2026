      <text>MCR_U01_L06_Q12</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U01_L06_Q12</p><p><strong>MLA Standard:</strong> MLA.MCR.QR.6</p><p>What does a rate of $3 per item mean?</p>]]></text>
