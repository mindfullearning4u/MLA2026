    <answer fraction="100" format="html">
      <text><![CDATA[$25 per day]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The coefficient 25 shows dollars increase by 25 for each day.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$100 per day]]></text>
      <feedback format="html">
        <text><![CDATA[This is the starting amount, not the rate of change.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$125 per day]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the coefficient and starting amount.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[25 days per dollar]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the units.]]></text>
      </feedback>
    </answer>
