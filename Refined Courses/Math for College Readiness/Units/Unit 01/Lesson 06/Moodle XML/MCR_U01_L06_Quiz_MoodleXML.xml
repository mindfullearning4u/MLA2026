      <feedback format="html">
        <text><![CDATA[Correct. Cost change divided by mile change gives dollars per mile.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[miles plus dollars]]></text>
      <feedback format="html">
        <text><![CDATA[Adding units does not describe a rate.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
