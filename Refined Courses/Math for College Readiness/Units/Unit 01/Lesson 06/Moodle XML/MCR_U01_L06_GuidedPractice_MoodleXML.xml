<quiz>
  <question type="category">
    <category>
      <text>$course$/Math for College Readiness/Units/Unit 01/Lesson 06/MCR_U01_L06_GuidedPractice</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U01_L06_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U01_L06_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.MCR.QR.6</p><p>A car travels 180 miles in 3 hours. What is the average rate of change?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[60 miles per hour]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Divide 180 miles by 3 hours to get 60 miles per hour.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[183 miles per hour]]></text>
      <feedback format="html">
        <text><![CDATA[This adds miles and hours instead of dividing output change by input change.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[540 miles per hour]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies miles and hours, which does not find a rate.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[177 miles per hour]]></text>
      <feedback format="html">
        <text><![CDATA[This subtracts hours from miles, which does not create a meaningful rate.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U01_L06_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U01_L06_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.MCR.QR.6</p><p>A savings balance changes from $120 in week 2 to $180 in week 6. What is the average rate of change?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[$60 per week]]></text>
      <feedback format="html">
        <text><![CDATA[This is the total change, not the average change per week.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[$15 per week]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The balance changes by $60 over 4 weeks, so 60 divided by 4 = 15.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$30 per week]]></text>
      <feedback format="html">
        <text><![CDATA[This divides by 2 instead of the 4-week interval.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$300 per week]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the balances and does not find change over time.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U01_L06_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U01_L06_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.MCR.QR.6</p><p>A delivery cost is $19 for 2 miles and $29 for 7 miles. What is the average rate of change?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[$10 per mile]]></text>
      <feedback format="html">
        <text><![CDATA[This is the change in cost only, not divided by the change in miles.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$5 per mile]]></text>
      <feedback format="html">
        <text><![CDATA[This uses only the change in miles or an incomplete comparison.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[$2 per mile]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Cost changes by $10 over 5 miles, so the rate is $2 per mile.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$48 per mile]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the costs and ignores the interval.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U01_L06_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U01_L06_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.MCR.QR.6</p><p>For C(m) = 2m + 15, where C is cost in dollars and m is miles, what is the rate of change?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[$15 per mile]]></text>
      <feedback format="html">
        <text><![CDATA[This is the fixed fee, not the rate of change.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$17 per mile]]></text>
      <feedback format="html">
        <text><![CDATA[This adds the coefficient and fixed fee, but only the coefficient shows rate.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[$30 per mile]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies the coefficient and fixed fee, which does not describe the rate.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[$2 per mile]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The coefficient 2 means cost increases by $2 for each additional mile.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U01_L06_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U01_L06_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.MCR.QR.6</p><p>Why must average rate of change include units?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Units make the number larger]]></text>
      <feedback format="html">
        <text><![CDATA[Units do not change the value; they explain meaning.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Units show the output change per input change]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A rate such as dollars per mile or miles per hour needs both units.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Units should be removed after dividing]]></text>
      <feedback format="html">
        <text><![CDATA[Removing units makes the rate harder to interpret.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Units are only needed for distance problems]]></text>
      <feedback format="html">
        <text><![CDATA[Rates can involve money, time, distance, data, and many other quantities.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>