<quiz>
  <question type="category">
    <category>
      <text>$course$/Math for College Readiness/Units/Unit 06/Lesson 04/MCR_U06_L04_GuidedPractice</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U06_L04_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U06_L04_GP_Q01</p><p><strong>MLA Standard:</strong> Support-only extension of MLA.MCR.GM.4 through MLA.MCR.GM.6 and MLA.MCR.QR.2</p><p>An object has mass 50 grams and volume 10 cubic cm. What is its density?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[60 grams per cubic cm]]></text>
      <feedback format="html">
        <text><![CDATA[This adds mass and volume. Density is mass divided by volume.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[5 grams per cubic cm]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Density = 50 divided by 10 = 5 grams per cubic cm.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[500 grams per cubic cm]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies mass and volume. Density requires division.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[40 grams per cubic cm]]></text>
      <feedback format="html">
        <text><![CDATA[This subtracts volume from mass. Use mass divided by volume.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U06_L04_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U06_L04_GP_Q02</p><p><strong>MLA Standard:</strong> Support-only extension of MLA.MCR.GM.4 through MLA.MCR.GM.6 and MLA.MCR.QR.2</p><p>A material has density 6 grams per cubic cm and volume 8 cubic cm. What is the mass?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[14 grams]]></text>
      <feedback format="html">
        <text><![CDATA[This adds density and volume. Mass is density times volume.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[1.33 grams]]></text>
      <feedback format="html">
        <text><![CDATA[This divides volume by density. To find mass, multiply density by volume.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[48 cubic cm]]></text>
      <feedback format="html">
        <text><![CDATA[The number is correct, but mass should be labeled in grams.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[48 grams]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Mass = 6 x 8 = 48 grams.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U06_L04_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U06_L04_GP_Q03</p><p><strong>MLA Standard:</strong> Support-only extension of MLA.MCR.GM.4 through MLA.MCR.GM.6 and MLA.MCR.QR.2</p><p>A sample has mass 36 grams and density 4 grams per cubic cm. What is its volume?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[9 cubic cm]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Volume = mass divided by density = 36 divided by 4 = 9 cubic cm.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[40 cubic cm]]></text>
      <feedback format="html">
        <text><![CDATA[This adds mass and density. Use division to find volume.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[144 cubic cm]]></text>
      <feedback format="html">
        <text><![CDATA[This multiplies mass and density. Volume is mass divided by density.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[32 cubic cm]]></text>
      <feedback format="html">
        <text><![CDATA[This subtracts density from mass. That does not use the density relationship.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U06_L04_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U06_L04_GP_Q04</p><p><strong>MLA Standard:</strong> Support-only extension of MLA.MCR.GM.4 through MLA.MCR.GM.6 and MLA.MCR.QR.2</p><p>What does grams per cubic cm describe?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[length for each gram]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the meaning. Density compares mass to volume.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[volume for each foot]]></text>
      <feedback format="html">
        <text><![CDATA[This uses unrelated units. The unit compares grams and cubic cm.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[mass for each unit of volume]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Grams per cubic cm tells how many grams are in each cubic centimeter.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[area for each unit of time]]></text>
      <feedback format="html">
        <text><![CDATA[This does not match density units or the lesson concept.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>MCR_U06_L04_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> MCR_U06_L04_GP_Q05</p><p><strong>MLA Standard:</strong> Support-only extension of MLA.MCR.GM.4 through MLA.MCR.GM.6 and MLA.MCR.QR.2</p><p>Which formula finds density?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[mass x volume]]></text>
      <feedback format="html">
        <text><![CDATA[This finds a product, not density. Density compares mass to volume by division.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[mass / volume]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Density equals mass divided by volume.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[volume / mass]]></text>
      <feedback format="html">
        <text><![CDATA[This reverses the ratio. Density is mass per unit volume.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[mass + volume]]></text>
      <feedback format="html">
        <text><![CDATA[Adding does not create a ratio unit.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>