    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U01_Pretest_Q03</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. stuff&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This answer does not fully meet the lesson standard. Recheck the audience, purpose, evidence, or communication skill before choosing.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. evidence&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Evidence supports a claim.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. thing&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This answer does not fully meet the lesson standard. Recheck the audience, purpose, evidence, or communication skill before choosing.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. whatever&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This answer does not fully meet the lesson standard. Recheck the audience, purpose, evidence, or communication skill before choosing.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U01_Pretest_Q04</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U01_Pretest_Q04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.11&lt;/p&gt;&lt;p&gt;Which question best clarifies an assignment?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U01_Pretest_Q04</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. This is impossible.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not ask a specific question.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Why is this confusing?&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is too broad.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Can someone do it for me?&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This asks for completion, not clarification.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;D. Should I submit one paragraph or two?&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This asks about a specific expectation.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U01_Pretest_Q05</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U01_Pretest_Q05&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.06&lt;/p&gt;&lt;p&gt;Speech excerpt: &amp;quot;Our survey showed that most students want more practice time.&amp;quot; Which appeal is strongest?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U01_Pretest_Q05</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Emotion&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;The excerpt does not focus on feelings.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. Logic&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. The speaker uses survey evidence.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Trust&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;No role or experience is named.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Confusion&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Confusion is not a rhetorical appeal.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U01_Pretest_Q06</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U01_Pretest_Q06&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.05&lt;/p&gt;&lt;p&gt;Which word means the people receiving a message?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U01_Pretest_Q06</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. audience&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Audience means the listeners or viewers.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. purpose&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Purpose is the reason for communicating.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. evidence&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Evidence supports a claim.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. transition&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;A transition connects ideas.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U01_Pretest_Q07</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U01_Pretest_Q07&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.05&lt;/p&gt;&lt;p&gt;What does paraphrase mean?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U01_Pretest_Q07</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Copy exact words&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;That is repeating, not paraphrasing.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Change the idea&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;That changes meaning.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Ignore the speaker&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;That is not listening.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;D. Restate in your own words&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. A paraphrase keeps the meaning in new words.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U01_Pretest_Q08</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U01_Pretest_Q08&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.09&lt;/p&gt;&lt;p&gt;Why does audience matter?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U01_Pretest_Q08</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. It does not affect communication.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Audience strongly affects communication.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Every audience needs the same message.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Messages should fit audiences.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. It helps the speaker choose words and tone.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Audience guides communication choices.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Audience only matters in writing.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Audience matters in speaking too.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U01_Pretest_Q09</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U01_Pretest_Q09&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.08&lt;/p&gt;&lt;p&gt;Which response best builds on an idea?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U01_Pretest_Q09</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. Your point about audience connects to our opening; we could add a question there.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This connects and extends the idea.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. I was not listening.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not build.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Stop talking.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This blocks discussion.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. That idea is useless.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is disrespectful.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U01_Pretest_Q10</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U01_Pretest_Q10&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.06&lt;/p&gt;&lt;p&gt;Which appeal focuses on credibility?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U01_Pretest_Q10</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Emotion&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Emotion focuses on feelings.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. Trust&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Trust focuses on credibility.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Logic&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Logic focuses on reasons and evidence.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Tone&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Tone is attitude, not an appeal type here.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
</quiz>
