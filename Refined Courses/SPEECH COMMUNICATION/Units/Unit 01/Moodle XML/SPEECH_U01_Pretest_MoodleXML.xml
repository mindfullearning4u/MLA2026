<?xml version="1.0" encoding="utf-8"?>
<quiz>
  <question type="multichoice">
    <name>
      <text>SPEECH_U01_Pretest_Q01</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U01_Pretest_Q01&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.08&lt;/p&gt;&lt;p&gt;Which behavior best supports discussion?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U01_Pretest_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. Listening before responding&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Listening first supports accurate response.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Interrupting often&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Interrupting weakens discussion.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Ignoring the speaker&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Ignoring is not active listening.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Changing the topic&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Changing topics avoids the message.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U01_Pretest_Q02</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U01_Pretest_Q02&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.09&lt;/p&gt;&lt;p&gt;Which tone best fits asking a teacher for help?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U01_Pretest_Q02</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Sarcastic&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Sarcasm does not fit a help request.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Demanding&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Demanding tone may sound rude.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. Respectful&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. A teacher help request should be respectful.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Careless&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Careless tone is unclear.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U01_Pretest_Q03</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U01_Pretest_Q03&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.10&lt;/p&gt;&lt;p&gt;Which word is most academic for information that supports a claim?&lt;/p&gt;</text>
