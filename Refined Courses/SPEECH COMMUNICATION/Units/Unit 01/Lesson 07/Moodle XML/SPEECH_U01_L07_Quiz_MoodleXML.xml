<?xml version="1.0" encoding="utf-8"?>
<quiz>
  <question type="multichoice">
    <name>
      <text>SPEECH_U01_L07_Quiz_Q01</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U01_L07_Quiz_Q01&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.09&lt;/p&gt;&lt;p&gt;Which choice best shows audience-aware tone?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U01_L07_Quiz_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Use sarcasm so the audience laughs at the topic.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Sarcasm can weaken a serious safety message.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. Use a calm, respectful tone when explaining a serious school safety topic.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Tone should fit the serious purpose and school audience.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Use confusing words so the message sounds advanced.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Confusing language does not support the audience.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Use an angry tone so listeners feel blamed.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Blame can make the audience defensive.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U01_L07_Quiz_Q02</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U01_L07_Quiz_Q02&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.08&lt;/p&gt;&lt;p&gt;What should a listener do before disagreeing?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U01_L07_Quiz_Q02</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Interrupt quickly&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Interrupting prevents full understanding.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Change the speaker&amp;#39;s meaning&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Changing meaning is not active listening.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. Paraphrase the speaker&amp;#39;s idea accurately&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Paraphrasing checks understanding before response.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Ignore the speaker&amp;#39;s purpose&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Purpose helps shape a fair response.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U01_L07_Quiz_Q03</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U01_L07_Quiz_Q03&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.10&lt;/p&gt;&lt;p&gt;Which sentence uses academic language clearly?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U01_L07_Quiz_Q03</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. Your evidence supports the claim, but the transition needs to be clearer.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This uses precise vocabulary and gives useful feedback.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Your part has stuff that is good.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is vague and does not name the communication skill.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. The thing should sound better.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is too vague to guide revision.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. It is fine or whatever.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not use academic language or explain the idea.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U01_L07_Quiz_Q04</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U01_L07_Quiz_Q04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.06&lt;/p&gt;&lt;p&gt;Speech excerpt: &amp;quot;As your class representative, I have listened to your concerns.&amp;quot; Which appeal is strongest?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U01_L07_Quiz_Q04</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Emotion because the speaker uses a sad story&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;No sad story appears.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Logic because the speaker gives data&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This answer does not fully meet the lesson standard. Recheck the audience, purpose, evidence, or communication skill before choosing.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. No appeal because the sentence is simple&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Simple language can still build trust.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;D. Trust because the speaker identifies a responsible role&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. The speaker builds credibility by naming a role.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U01_L07_Quiz_Q05</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U01_L07_Quiz_Q05&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.11&lt;/p&gt;&lt;p&gt;Which response gives the clearest instructional help?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U01_L07_Quiz_Q05</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Do the thing from the page.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is vague and does not explain the task.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Write anything about speaking.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is too broad and unhelpful.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. Start by naming the audience, then explain why that audience affects tone.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This gives clear steps tied to the lesson.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Make it sound complete.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not explain what completion requires.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U01_L07_Quiz_Q06</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U01_L07_Quiz_Q06&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.08&lt;/p&gt;&lt;p&gt;Which response best builds on a classmate&amp;#39;s idea?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U01_L07_Quiz_Q06</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. I was not listening.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not build on the idea.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. Your point about audience connects to our tone; we could make the opening more respectful.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This connects to the idea and adds a useful next step.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. That has nothing to do with me.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This dismisses the group task.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Stop sharing ideas.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This blocks collaboration.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U01_L07_Quiz_Q07</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U01_L07_Quiz_Q07&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.09&lt;/p&gt;&lt;p&gt;Which sentence best matches audience and purpose?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U01_L07_Quiz_Q07</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Little kids, do not mess this up.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is disrespectful and harsh.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Whatever, hallway safety is a thing.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is careless and unclear.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. I guess you can listen if you want.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is uncertain and weak.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;D. Please walk on the right side so everyone can move safely.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. The sentence is clear, respectful, and safety-focused.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U01_L07_Quiz_Q08</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U01_L07_Quiz_Q08&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.06&lt;/p&gt;&lt;p&gt;Speech excerpt: &amp;quot;Imagine a hallway where every student moves safely and calmly.&amp;quot; Which appeal is strongest?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U01_L07_Quiz_Q08</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. Emotion because the speaker creates a positive image&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. The speaker helps the audience picture a safe and calm result.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Logic because the speaker gives a statistic&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;No statistic appears.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Trust because the speaker lists credentials&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;No credentials appear.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. No appeal because hallways are ordinary&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Ordinary topics can still use rhetorical appeals.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U01_L07_Quiz_Q09</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U01_L07_Quiz_Q09&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.10&lt;/p&gt;&lt;p&gt;Which feedback is most precise?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U01_L07_Quiz_Q09</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. The end is nice.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This answer does not fully meet the lesson standard. Recheck the audience, purpose, evidence, or communication skill before choosing.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. The conclusion restates the claim and reminds the audience of the purpose.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This names the speech part and communication function.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. The last thing is okay.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not name the conclusion or explain why.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. It has words at the end.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is not useful academic feedback.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U01_L07_Quiz_Q10</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U01_L07_Quiz_Q10&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.08&lt;/p&gt;&lt;p&gt;Which response shows respectful disagreement?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U01_L07_Quiz_Q10</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Your idea is wrong.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is blunt and unsupported.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. My idea wins.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is competitive, not collaborative.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. I understand your idea, but a serious opening may fit the safety topic better.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This paraphrases, disagrees respectfully, and gives a reason.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Nobody should listen to that.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is disrespectful.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U01_L07_Quiz_Q11</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U01_L07_Quiz_Q11&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.09&lt;/p&gt;&lt;p&gt;Why should a speaker identify audience before choosing tone?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U01_L07_Quiz_Q11</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. Tone should fit who is listening and why the message matters.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Audience and purpose guide tone.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Every audience needs the same tone.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Different audiences may need different tone choices.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Audience has no effect on tone.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Audience strongly affects tone.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Tone should be chosen randomly.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Tone should be intentional.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U01_L07_Quiz_Q12</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U01_L07_Quiz_Q12&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.11&lt;/p&gt;&lt;p&gt;Which response best clarifies a school task?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U01_L07_Quiz_Q12</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. This is confusing.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This states confusion but does not clarify the task.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. Do we need to submit one paragraph or a list of bullet points?&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This asks a specific question about expectations.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. I refuse to do it.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not seek understanding.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Someone should explain everything.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is too broad to guide help.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U01_L07_Quiz_Q13</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U01_L07_Quiz_Q13&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.06&lt;/p&gt;&lt;p&gt;Speech excerpt: &amp;quot;If each person practices once, we can find timing problems before the presentation.&amp;quot; Which appeal is strongest?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
