<?xml version="1.0" encoding="utf-8"?>
<quiz>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L07_Quiz_Q01</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L07_Quiz_Q01&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.SPK.01&lt;/p&gt;&lt;p&gt;Which focus is strongest for an informative speech plan?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L07_Quiz_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. Organized preparation helps students deliver clearer presentations.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This is specific and can guide related main points.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Presentations and other things.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is vague and not focused.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. I might talk about school.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not give a clear informative purpose.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Many topics are interesting.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is broad and does not guide the speech.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L07_Quiz_Q02</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L07_Quiz_Q02&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which set best develops one informative point?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L07_Quiz_Q02</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Point only, with no support.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is incomplete because the audience needs explanation.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. Point, support, reasoning.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This gives the idea, a detail, and an explanation of why it matters.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Joke, topic change, ending.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not develop information.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Unrelated fact, unrelated fact, unrelated fact.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Unrelated facts do not support a point.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L07_Quiz_Q03</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L07_Quiz_Q03&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.05&lt;/p&gt;&lt;p&gt;Which action shows accurate paraphrasing for speech notes?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L07_Quiz_Q03</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Copy the source exactly into the notes.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Copying does not show paraphrasing.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Change the meaning to make it sound stronger.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Changing meaning makes the paraphrase inaccurate.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Remove the main idea from the source.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Removing the main idea makes the note inaccurate because the speaker loses the source&amp;#39;s central idea.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;D. Restate the source idea in new wording while keeping the meaning.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Accurate paraphrase keeps meaning and changes wording.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L07_Quiz_Q04</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L07_Quiz_Q04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.PRES.02&lt;/p&gt;&lt;p&gt;Which item belongs in a speech-ready format checklist?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L07_Quiz_Q04</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Main points are unrelated.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Unrelated points weaken format and focus.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Notes are impossible to follow.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;A quality format should be easy to use.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. The speaker copies every source sentence.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Copying does not create speech-ready notes.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;D. The plan includes focus, points, support, transitions, and conclusion.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. These parts support quality speech format.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L07_Quiz_Q05</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L07_Quiz_Q05&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.SPK.01&lt;/p&gt;&lt;p&gt;Which main point supports the focus &amp;quot;Preparation improves presentation clarity&amp;quot;?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L07_Quiz_Q05</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. Outlining ideas helps the audience follow the order.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This supports how preparation improves clarity.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Lunch schedules can be confusing.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is unrelated to presentation clarity.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Some rooms have chairs.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not support the focus.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Music can be relaxing.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not connect to the speech focus.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L07_Quiz_Q06</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L07_Quiz_Q06&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which support is most specific?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L07_Quiz_Q06</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Practice is good.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is too general because it does not give a concrete detail that supports the speech point.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Notes help.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is vague and underdeveloped.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. A timer can show whether the introduction takes longer than planned.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This gives a specific support detail.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Speeches exist.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not support a point.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L07_Quiz_Q07</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L07_Quiz_Q07&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which transition is most purposeful?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L07_Quiz_Q07</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Next thing.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is vague and does not show connection.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Anyway.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is too casual and unclear.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. I forgot the next part.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This weakens delivery because it does not guide the audience from one speech idea to the next.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;D. After organizing the points, the speaker should add support for each idea.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This shows a relationship between organization and support.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L07_Quiz_Q08</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L07_Quiz_Q08&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.PRES.02&lt;/p&gt;&lt;p&gt;Which note card would best support speaking?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L07_Quiz_Q08</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Full paragraph copied from source.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This may make the speaker read instead of present.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Stuff about presentations.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is too vague because the note does not tell the speaker what point or support to deliver.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Random words with no order.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not guide delivery because the speaker needs ordered cues that match the speech plan.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;D. Point 2: paraphrase support; reasoning: audience hears source idea clearly.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This gives a clear speaking cue.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L07_Quiz_Q09</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L07_Quiz_Q09&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.SPK.01&lt;/p&gt;&lt;p&gt;Which plan has coherent focus?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L07_Quiz_Q09</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. Focus: speech preparation; points: outline, paraphrase support, rehearse.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Each point supports preparation.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Focus: speech preparation; points: lunch, phones, weather.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;These points do not support the focus.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Focus: note cards; points: cafeteria, sports, music.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;These points are unrelated.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Focus: presentation clarity; points: shoes, snacks, weekend plans.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;These points do not support clarity.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L07_Quiz_Q10</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L07_Quiz_Q10&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which sentence is reasoning?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L07_Quiz_Q10</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. A note card can list each main point.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is support, not reasoning, because it gives a detail without explaining why it matters.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. This helps because the speaker can find the next idea without reading a full script.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This explains why the support matters.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. The next point is rehearsal.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is a transition because it moves to another idea instead of explaining why support matters.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Notes are paper.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not explain support because it only names the material instead of explaining its value.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L07_Quiz_Q11</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L07_Quiz_Q11&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.05&lt;/p&gt;&lt;p&gt;Source: Clear transitions help listeners follow the relationship between ideas. Which paraphrase is accurate?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L07_Quiz_Q11</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Transitions confuse listeners.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This reverses the source meaning.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. Transitions guide the audience by showing how speech ideas connect.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This keeps the source meaning in new wording.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Listeners do not need transitions.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This contradicts the source.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Relationships between ideas should be hidden.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is the opposite of the source.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L07_Quiz_Q12</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L07_Quiz_Q12&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.PRES.02&lt;/p&gt;&lt;p&gt;What makes a speech plan presentation-ready?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L07_Quiz_Q12</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. It contains only a topic.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;A topic alone is incomplete.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. It uses random facts.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Random facts weaken the plan.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. It has required parts arranged clearly for speaking.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Speech-ready format supports clear delivery.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. It hides the conclusion.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;The conclusion should be clear.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L07_Quiz_Q13</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L07_Quiz_Q13&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.SPK.01&lt;/p&gt;&lt;p&gt;Which conclusion best closes an informative speech about preparation?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L07_Quiz_Q13</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. I also like weekends.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This adds an unrelated idea.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. Organized preparation helps speakers plan, support, and deliver clearer presentations.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This restates the focus and summarizes key ideas.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. There are many topics.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is too vague because it does not restate the speech focus or help the audience remember the message.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. I am done now.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not reinforce the message.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L07_Quiz_Q14</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L07_Quiz_Q14&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which support should be removed from a speech about presentation preparation?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L07_Quiz_Q14</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Rehearsing aloud helps speakers notice unclear sections.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This supports preparation.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. A note card can list main points in order.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This supports preparation.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. A transition can connect support to the next point.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This supports speech planning.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;D. Cafeteria lines are sometimes long.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This is unrelated to presentation preparation.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L07_Quiz_Q15</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L07_Quiz_Q15&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.05&lt;/p&gt;&lt;p&gt;Which paraphrase is too close to the source &amp;quot;Speakers should practice aloud before presenting&amp;quot;?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L07_Quiz_Q15</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. Speakers should practice aloud before presenting.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This copies the source exactly, so it is too close to count as an effective paraphrase.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Presenters should rehearse out loud before giving the speech.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This changes wording while keeping meaning, so it is an acceptable paraphrase.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Practicing out loud helps a speaker prepare to present.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This restates the idea with new wording instead of copying the source exactly.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Rehearsal before presenting can support delivery.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This changes wording and structure.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L07_Quiz_Q16</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L07_Quiz_Q16&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.PRES.02&lt;/p&gt;&lt;p&gt;Which format problem should be fixed first?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L07_Quiz_Q16</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. The plan has a clear focus.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is a strength, not a problem.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. The plan has support under each point.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is a strength because support helps each main point become clear and complete.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. The plan has no main points.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Main points are required for a speech plan.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. The plan has transitions.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Transitions support quality.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L07_Quiz_Q17</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L07_Quiz_Q17&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.SPK.01&lt;/p&gt;&lt;p&gt;Which structure best fits explaining how to prepare a speech?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L07_Quiz_Q17</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Random order.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Random order would confuse the audience.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Compare unrelated topics.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not explain a process.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. Chronological order.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Speech preparation is a step-by-step process.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Hidden order.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;A hidden order does not guide listeners.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L07_Quiz_Q18</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L07_Quiz_Q18&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which answer best combines support and reasoning?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L07_Quiz_Q18</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Rehearsal is helpful.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is too general because it does not include a specific support detail or reasoning.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. A timer can measure a speech section, which helps the speaker revise parts that run too long.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This gives a detail and explains why it matters.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Speeches can be timed.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is a detail but does not explain the value.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Timing is important because timing is important.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This repeats instead of reasoning.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L07_Quiz_Q19</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L07_Quiz_Q19&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.PRES.02&lt;/p&gt;&lt;p&gt;Which choice is best for speech notes?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L07_Quiz_Q19</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Full script copied word for word.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This may lead to reading.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. No notes at all.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;No notes may weaken organization.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. Short cues for focus, points, support, and transitions.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Short cues support delivery.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Unrelated phrases.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Unrelated phrases do not guide speaking.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L07_Quiz_Q20</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L07_Quiz_Q20&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.05&lt;/p&gt;&lt;p&gt;Why is paraphrasing useful in an informative speech plan?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L07_Quiz_Q20</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. It lets the speaker change the source meaning.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Changing meaning is inaccurate.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. It helps the speaker explain source ideas in their own words.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Paraphrase supports clear, accurate speech notes.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. It removes all support from the speech.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Paraphrase can be a form of support.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. It requires copying the source exactly.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Copying is not paraphrasing.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L07_Quiz_Q21</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L07_Quiz_Q21&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.SPK.01&lt;/p&gt;&lt;p&gt;Which question checks coherent focus?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L07_Quiz_Q21</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. Does each main point support the same central idea?&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This directly checks coherence.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Is every sentence copied from a source?&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Copying does not check focus.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Is the speech as long as possible?&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Length does not prove focus.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Are the ideas random enough?&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Random ideas weaken focus.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L07_Quiz_Q22</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L07_Quiz_Q22&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which transition signals sequence?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L07_Quiz_Q22</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. However, another support detail is needed.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;However signals contrast, so it does not show the order of steps in a sequence.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Because support explains the point.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Because signals cause, so it does not signal sequence.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. First, organize the main points before adding support.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. First signals sequence.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. In contrast, source notes are different.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;In contrast signals comparison.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L07_Quiz_Q23</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L07_Quiz_Q23&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.PRES.02&lt;/p&gt;&lt;p&gt;Which checklist item supports quality work?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L07_Quiz_Q23</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. The plan hides its focus.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;A hidden focus weakens quality.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. The notes are too vague to use.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Vague notes weaken delivery.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. The conclusion restates the informative focus.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. A conclusion should close the speech clearly.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. The support is unrelated.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Unrelated support weakens quality.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L07_Quiz_Q24</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L07_Quiz_Q24&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which option best explains why support matters?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L07_Quiz_Q24</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Support makes the speech longer only.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Length is not the main purpose.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Support replaces the focus.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;The focus is still needed.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Support lets the speaker avoid reasoning.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Reasoning is still needed.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;D. Support gives the audience details that explain the point.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Support helps listeners understand the idea.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L07_Quiz_Q25</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L07_Quiz_Q25&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.SPK.01&lt;/p&gt;&lt;p&gt;Which statement best summarizes Lesson 7?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L07_Quiz_Q25</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. An informative speech plan should combine focus, organization, support, paraphrase, transitions, and format.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This captures the integrated planning goal.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. A speech plan only needs a topic.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;A topic alone is incomplete.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Support and transitions are optional for clear explanation.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;They are important for audience understanding.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Paraphrase means changing the source meaning.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Paraphrase must keep meaning accurate.&lt;/p&gt;</text></feedback>
