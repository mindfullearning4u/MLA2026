<?xml version="1.0" encoding="utf-8"?>
<quiz>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L06_GuidedPractice_Q01</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L06_GuidedPractice_Q01&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Point: Rehearsal improves timing. Which support best fits?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L06_GuidedPractice_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Speeches can happen in classrooms.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is related to speaking but does not explain timing.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Timing is a word.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not support the speech point.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Some students like posters.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is unrelated to rehearsal and timing.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;D. A speaker can time each section during practice and revise sections that run too long.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This support directly explains how rehearsal improves timing.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L06_GuidedPractice_Q02</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L06_GuidedPractice_Q02&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.SPK.01&lt;/p&gt;&lt;p&gt;Which transition is most purposeful?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L06_GuidedPractice_Q02</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Next thing.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is vague and does not show the relationship between ideas.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. I am done with that.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This announces stopping but does not connect ideas.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. After rehearsal helps control timing, organized notes help guide delivery.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This transition connects two preparation ideas.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Whatever comes after.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is informal and unclear.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L06_GuidedPractice_Q03</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L06_GuidedPractice_Q03&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which sentence gives reasoning?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L06_GuidedPractice_Q03</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. This support matters because organized notes keep the speaker from skipping a main point.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This explains why the support helps.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Organized notes exist.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is a detail but does not explain why it matters.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. My next point is coming.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is a transition, not reasoning.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Notes are notes.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This repeats wording without explanation.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L06_GuidedPractice_Q04</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L06_GuidedPractice_Q04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.PRES.02&lt;/p&gt;&lt;p&gt;Which speech note is most useful for format and delivery?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L06_GuidedPractice_Q04</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Say stuff.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is too vague for quality speech notes.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. Point 1: note cards list main points; explain order.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This note gives a clear format cue and speaking reminder.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Everything maybe.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not guide the speaker.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Read all paragraphs.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This may prevent natural delivery.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L06_GuidedPractice_Q05</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L06_GuidedPractice_Q05&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which support is too general?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L06_GuidedPractice_Q05</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. A timer can show whether the introduction takes one minute.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is specific support.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. A note card can list the three main points in order.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is specific support.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. Practice is good.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This is too general because it does not explain how practice helps.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. A chart can show changes over time.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is a specific support detail.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
</quiz>
