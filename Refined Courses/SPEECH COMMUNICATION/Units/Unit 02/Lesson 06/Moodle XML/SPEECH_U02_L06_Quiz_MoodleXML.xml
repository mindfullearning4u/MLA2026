    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L06_Quiz_Q15</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. First, write the focus.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;First signals sequence, so it does not show contrast between ideas.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Because practice helps timing.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Because signals cause, so it does not show contrast.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. However, timing practice does not replace organized notes.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. However signals contrast.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Therefore, the speaker is prepared.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Therefore signals result.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L06_Quiz_Q16</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L06_Quiz_Q16&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which answer best improves weak support &amp;quot;visual aids are helpful&amp;quot;?&lt;/p&gt;</text>
