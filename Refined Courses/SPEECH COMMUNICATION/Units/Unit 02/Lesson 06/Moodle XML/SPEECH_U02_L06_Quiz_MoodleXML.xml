<?xml version="1.0" encoding="utf-8"?>
<quiz>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L06_Quiz_Q01</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L06_Quiz_Q01&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Point: Note cards help speakers stay organized. Which support best fits?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L06_Quiz_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Note cards are small.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is a detail but does not explain organization.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. A note card can list each main point in the order the speaker will present it.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This support explains how note cards help organization.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Some note cards are different colors.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not support the point clearly.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Speeches can happen in many rooms.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is unrelated to note cards.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L06_Quiz_Q02</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L06_Quiz_Q02&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.SPK.01&lt;/p&gt;&lt;p&gt;Which transition best connects rehearsal to delivery?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L06_Quiz_Q02</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Next thing.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is vague and does not show a relationship.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Whatever comes after that.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is informal and unclear because it does not show a relationship.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. I am moving on now.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This announces movement but does not explain the connection.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;D. After rehearsal helps control timing, delivery practice helps the speaker sound natural.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This shows how the ideas connect.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L06_Quiz_Q03</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L06_Quiz_Q03&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which sentence is reasoning?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L06_Quiz_Q03</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. This example matters because timing helps the audience follow the speech without feeling rushed.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. It explains why the support matters.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Timing exists in speeches.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is a statement but not reasoning.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. The next point is notes.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is a transition, not reasoning.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Practice is a word.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not explain support.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L06_Quiz_Q04</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L06_Quiz_Q04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.PRES.02&lt;/p&gt;&lt;p&gt;Which note is most speech-ready?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L06_Quiz_Q04</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Say stuff about preparation.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is too vague because it does not identify a specific point or support cue.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Read a full paragraph aloud.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This may prevent natural delivery because it encourages reading instead of presenting.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Maybe talk more.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not guide the speaker.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;D. Point 1: rehearsal improves timing; support: time each section.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This gives a clear point and support cue.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L06_Quiz_Q05</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L06_Quiz_Q05&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which support is too general?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L06_Quiz_Q05</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. Practice helps.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This does not explain how practice helps.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Timing each section shows whether a point is too long.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is specific support.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. A note card can list the order of ideas.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This specifically supports organization.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. A chart can show a pattern visually.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is specific support.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L06_Quiz_Q06</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L06_Quiz_Q06&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.SPK.01&lt;/p&gt;&lt;p&gt;What should a transition do?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L06_Quiz_Q06</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Hide the next idea.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Transitions should guide, not hide.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. Show how one idea connects to the next.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. A purposeful transition explains the relationship between ideas.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Replace all support.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Support is still needed.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Add unrelated information.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Transitions should connect related ideas.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L06_Quiz_Q07</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L06_Quiz_Q07&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which set follows the strongest development pattern?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L06_Quiz_Q07</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Transition, random fact, unrelated opinion.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not develop an informative point.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Opinion, joke, no explanation.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not fit informative development because it lacks clear support and reasoning.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Conclusion, topic change, missing support.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is not clear development.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;D. Point, support, reasoning, transition.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This pattern develops and connects the idea.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L06_Quiz_Q08</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L06_Quiz_Q08&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.SPK.01&lt;/p&gt;&lt;p&gt;Which transition signals sequence?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L06_Quiz_Q08</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. However, note cards also have limits.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;However signals contrast, so it does not show step-by-step order.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Because practice builds comfort, speakers may feel ready.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Because signals cause, so it does not show sequence.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. First, identify the point you need to support.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. First signals sequence.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. In contrast, silent practice differs from peer practice.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;In contrast signals comparison.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L06_Quiz_Q09</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L06_Quiz_Q09&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which support best fits the point &amp;quot;Visual aids can clarify information&amp;quot;?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L06_Quiz_Q09</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. A chart can show changes over time so the audience can see the pattern.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This gives a specific visual aid and explains how it clarifies.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Visual aids are things.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is vague because it does not explain how the visual aid helps the audience.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Some people like colors.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not clearly support the point.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Speeches can be short.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is unrelated to visual aids and does not explain how they clarify information.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L06_Quiz_Q10</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L06_Quiz_Q10&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.PRES.02&lt;/p&gt;&lt;p&gt;Which note best follows quality expectations?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L06_Quiz_Q10</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Support: good thing.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is too vague for quality work.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Transition: next.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is weak because it does not show a relationship.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. Point 2: visual aid shows pattern; reasoning: audience can see change quickly.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This note is clear and useful.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Say all the words.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not support speech-ready format.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L06_Quiz_Q11</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L06_Quiz_Q11&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which sentence repeats instead of reasons?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L06_Quiz_Q11</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. This matters because the audience can follow the order more easily.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This gives reasoning because it explains why the support helps listeners.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. The support is useful because it is useful.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This repeats the idea and does not explain why the support matters.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. This example shows how a timer helps the speaker adjust length.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This explains the support instead of merely repeating it.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. This detail helps listeners see the pattern.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This gives reasoning because it explains how the detail helps listeners.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L06_Quiz_Q12</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L06_Quiz_Q12&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.SPK.01&lt;/p&gt;&lt;p&gt;Which transition signals cause and effect?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L06_Quiz_Q12</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. However, another option is peer practice.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;However signals contrast.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. First, choose a topic.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;First signals sequence, so it does not show a cause-and-effect relationship.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. As a result, the speaker may feel more prepared.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. As a result signals an effect.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Similarly, both strategies require practice.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Similarly signals comparison.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L06_Quiz_Q13</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L06_Quiz_Q13&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which support best fits &amp;quot;organized notes improve delivery&amp;quot;?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L06_Quiz_Q13</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. Notes grouped by main point help a speaker find the next idea quickly.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This specific support explains how notes improve delivery.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Notes can be written with pencils.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This detail does not explain delivery.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Some speakers like blue paper.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is unrelated to delivery quality.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Delivery is part of speaking.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This repeats the topic without support.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L06_Quiz_Q14</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L06_Quiz_Q14&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.PRES.02&lt;/p&gt;&lt;p&gt;Why should support be included in a speech outline?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L06_Quiz_Q14</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. To make the outline confusing.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Support should clarify ideas.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. To show how each point will be explained to the audience.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Support makes the speech product more complete and useful.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. To replace the focus.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;The focus is still needed.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. To add unrelated material.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Support should connect to the point.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L06_Quiz_Q15</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L06_Quiz_Q15&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.SPK.01&lt;/p&gt;&lt;p&gt;Which transition best signals contrast?&lt;/p&gt;</text>
