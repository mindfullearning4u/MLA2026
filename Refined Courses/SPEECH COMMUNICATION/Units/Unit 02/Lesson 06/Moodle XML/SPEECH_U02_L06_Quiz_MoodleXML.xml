    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. Some cafeteria lines are long.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This is unrelated to rehearsal and timing.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. A timer can show whether the speech is too long.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This directly supports timing.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Practicing aloud can reveal sections that need shortening.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This supports rehearsal and timing.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Rehearsal can help the speaker adjust pacing.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This supports the point.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L06_Quiz_Q22</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L06_Quiz_Q22&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.PRES.02&lt;/p&gt;&lt;p&gt;Which speech note is too vague?&lt;/p&gt;</text>
