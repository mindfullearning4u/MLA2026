    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L06_Quiz_Q22</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Point 1: planner shows deadlines.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is clear and specific, so it is not the vague note.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. Talk about all the things.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This gives no clear point or support.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Evidence: note card lists main points.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This gives a specific cue.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Transition: after notes, practice delivery.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This gives a relationship cue.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L06_Quiz_Q23</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L06_Quiz_Q23&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.SPK.01&lt;/p&gt;&lt;p&gt;Why are transitions important for listeners?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L06_Quiz_Q23</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. They make the speech harder to follow.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Transitions should make the speech easier to follow.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. They replace all support.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Support is still needed.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. They show how ideas are connected.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Transitions guide listeners between points.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. They remove the need for organization.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Transitions are part of organization.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L06_Quiz_Q24</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L06_Quiz_Q24&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which phrase best introduces reasoning?&lt;/p&gt;</text>
