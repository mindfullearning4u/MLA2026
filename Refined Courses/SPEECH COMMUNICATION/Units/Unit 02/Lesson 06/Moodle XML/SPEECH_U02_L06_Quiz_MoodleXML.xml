    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L06_Quiz_Q20</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Notes exist.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not transition.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. I am done with notes.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not show a relationship.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Randomly, rehearsal.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is unclear because it does not show how notes connect to rehearsal.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;D. Once notes are organized, rehearsal helps the speaker practice using them.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This transition connects notes and rehearsal.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L06_Quiz_Q21</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L06_Quiz_Q21&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which support should be removed from a point about rehearsal improving timing?&lt;/p&gt;</text>
