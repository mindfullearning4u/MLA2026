<?xml version="1.0" encoding="utf-8"?>
<quiz>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_Pretest_Q01</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_Pretest_Q01&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.SPK.01&lt;/p&gt;&lt;p&gt;Which speech focus is clearest?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_Pretest_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Presentations are things.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is too vague to guide a speech.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. Organized preparation helps speakers deliver clearer presentations.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This is specific and can guide an informative speech.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. School has many topics.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not give a clear speaking focus.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. I might talk about something.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is unclear and unfocused.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_Pretest_Q02</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_Pretest_Q02&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which set best explains an informative point?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_Pretest_Q02</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Topic only.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;A topic alone does not explain information.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. A joke and a conclusion.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not develop an informative point.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Random facts only.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Random facts do not create clear explanation.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;D. Point, support, and reasoning.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This gives the idea, evidence or detail, and explanation.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_Pretest_Q03</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_Pretest_Q03&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.05&lt;/p&gt;&lt;p&gt;Source: Note cards help speakers remember the order of ideas. Which paraphrase is accurate?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_Pretest_Q03</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. Note cards can help speakers keep ideas in order.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This restates the source accurately.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Speakers should avoid notes.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This contradicts the source.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Note cards make ideas unnecessary.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This changes the meaning.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Order does not matter.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This contradicts the source.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_Pretest_Q04</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_Pretest_Q04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.PRES.02&lt;/p&gt;&lt;p&gt;Which speech product is most complete?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_Pretest_Q04</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. A title only.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;A title alone is incomplete.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. A copied paragraph only.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is not a speech-ready plan.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. Focus, main points, support, transitions, and conclusion.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. These are key parts of a quality speech product.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. A random list of words.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Random words do not show format.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_Pretest_Q05</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_Pretest_Q05&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.01&lt;/p&gt;&lt;p&gt;Which structure is best for explaining steps?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_Pretest_Q05</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. Chronological order&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Steps are clearest in time order.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Random order&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Random order makes steps hard to follow.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Hidden structure&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Hidden structure does not guide the audience.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Unrelated details&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Unrelated details do not explain steps.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_Pretest_Q06</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_Pretest_Q06&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.04&lt;/p&gt;&lt;p&gt;Which sentence follows standard English?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_Pretest_Q06</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. my outline show three planning points.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This has capitalization and agreement errors.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. my outline shows the speech points.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This needs capitalization before it follows standard English.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. My outline show three points.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This has a subject-verb agreement error.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;D. My outline shows three points.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This sentence follows standard English conventions.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_Pretest_Q07</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_Pretest_Q07&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.05&lt;/p&gt;&lt;p&gt;Which phrase uses precise academic speech vocabulary?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_Pretest_Q07</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. talking stuff&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is vague and informal.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. coherent focus&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This is precise vocabulary for speech planning.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. things to say&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is too general because it does not use precise speech-planning vocabulary.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. whatever words&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is informal and unclear.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_Pretest_Q08</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_Pretest_Q08&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which transition best connects organization to support?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_Pretest_Q08</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Next thing.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is vague because it does not explain how one organized idea leads to the support that follows.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. I am done now.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not connect ideas.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. After organizing the points, the speaker should add support that explains each idea.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This transition shows the relationship between ideas.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Anyway, support.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is too casual and unclear.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_Pretest_Q09</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_Pretest_Q09&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.SPK.01&lt;/p&gt;&lt;p&gt;Which plan has coherent focus?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_Pretest_Q09</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Focus: preparation; points: lunch, weather, sports.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;These points do not support the focus.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. Focus: preparation; points: outline, support, rehearsal.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. All points support preparation.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Focus: speeches; points: cafeteria, shoes, music.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;These points are unrelated.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Focus: notes; points: weekends, games, food.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;These points do not support the focus.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_Pretest_Q10</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_Pretest_Q10&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.PRES.02&lt;/p&gt;&lt;p&gt;Which statement best describes Unit 2 readiness?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_Pretest_Q10</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. A strong informative speech plan has focus, organization, support, transitions, and quality format.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This combines the major Unit 2 skills.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. A speech plan only needs a topic.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;A topic alone is incomplete.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Paraphrase means changing the source meaning.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Paraphrase must keep the meaning accurate.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Support should be unrelated to the point.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Support must connect to the point.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
</quiz>
