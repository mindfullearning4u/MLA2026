<?xml version="1.0" encoding="utf-8"?>
<quiz>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_Quiz_Q01</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_Quiz_Q01&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.01&lt;/p&gt;&lt;p&gt;Which structure arranges ideas by steps or time?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_Quiz_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. Chronological order&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Chronological order presents ideas in time or step sequence.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Compare and contrast&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This structure shows similarities and differences.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Cause and effect&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This structure explains why something happens and what results.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Random order&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Random order does not guide audience meaning.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_Quiz_Q02</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_Quiz_Q02&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.01&lt;/p&gt;&lt;p&gt;Sentence: However, note cards cannot replace rehearsal. What does however signal?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_Quiz_Q02</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Time order&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;However does not show sequence.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. Contrast&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. However signals a different or opposing idea.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Cause&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;However does not explain why something happens.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Definition&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;However does not define a term.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_Quiz_Q03</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_Quiz_Q03&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which structure best fits a speech explaining why practice reduces nervousness?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_Quiz_Q03</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Alphabetical order&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Alphabetical order would not explain the relationship.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Random examples&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Random examples weaken meaning.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. Cause and effect&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. The speech explains how one action leads to a result.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Unrelated list&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;An unrelated list does not support explanation.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_Quiz_Q04</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_Quiz_Q04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.SPK.01&lt;/p&gt;&lt;p&gt;Which feature most helps listeners move between speech points?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_Quiz_Q04</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. A hidden topic&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;A hidden topic makes listening harder.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. A transition&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Transitions guide listeners from one idea to the next.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. A random fact&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Random facts distract from meaning.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. A missing conclusion&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;A missing conclusion weakens closure.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_Quiz_Q05</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_Quiz_Q05&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.01&lt;/p&gt;&lt;p&gt;Which plan uses compare and contrast?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_Quiz_Q05</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Choose topic, write outline, rehearse.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is chronological order.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Practice causes confidence to increase.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is cause and effect.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Problem: speakers forget points; solution: use note cards.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is problem and solution.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;D. Silent practice helps privacy, while peer practice gives feedback.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This shows similarities or differences between two kinds of practice.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_Quiz_Q06</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_Quiz_Q06&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.01&lt;/p&gt;&lt;p&gt;What does the feature because usually show?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_Quiz_Q06</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. Cause and effect&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Because explains why something happens.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Contrast&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Contrast is usually signaled by words such as however.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. A title&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Because is not a title feature.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. A conclusion only&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Because can appear in many parts of a speech.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_Quiz_Q07</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_Quiz_Q07&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which sentence uses a feature that signals sequence?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_Quiz_Q07</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. However, practice alone is not enough.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;However signals contrast.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. First, choose the main points for your note cards.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. First signals sequence.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Because practice helps, speakers feel ready.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Because signals cause and effect.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. In contrast, peer practice gives feedback.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;In contrast signals comparison or difference.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_Quiz_Q08</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_Quiz_Q08&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.SPK.01&lt;/p&gt;&lt;p&gt;Why should a speaker choose structure before presenting?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_Quiz_Q08</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. Structure helps the audience follow the meaning.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Structure guides how listeners understand ideas.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Structure removes the need for a focus.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;A focus is still necessary.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Structure makes support unnecessary.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Support still explains points.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Structure hides the purpose.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Structure should clarify purpose.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_Quiz_Q09</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_Quiz_Q09&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.01&lt;/p&gt;&lt;p&gt;Which structure best fits &amp;quot;problem: students skip practice; solution: schedule short rehearsals&amp;quot;?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_Quiz_Q09</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Chronological only&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is not mainly a time sequence.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Compare and contrast&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not compare two options.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. Problem and solution&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. The plan names a problem and gives a solution.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Definition&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not define a term.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_Quiz_Q10</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_Quiz_Q10&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.01&lt;/p&gt;&lt;p&gt;Which word signals contrast?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_Quiz_Q10</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. First&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;First signals sequence, so it shows order instead of contrast.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Because&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Because signals cause, so it explains why something happens.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Next&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Next signals sequence, so it moves to another step rather than showing contrast.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;D. However&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. However signals contrast between ideas.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_Quiz_Q11</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_Quiz_Q11&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which structure would best explain how to complete a task?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_Quiz_Q11</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. Chronological order&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Steps are easiest to understand in order.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Random order&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Random order would confuse the process.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Unrelated details&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Unrelated details weaken explanation.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Hidden structure&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Hidden structure does not help the audience.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_Quiz_Q12</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_Quiz_Q12&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.SPK.01&lt;/p&gt;&lt;p&gt;Which feature gives emphasis by repeating an important phrase?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_Quiz_Q12</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Using the key phrase once and never returning to it.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This gives less emphasis.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. Repeating the central phrase at important moments.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Repetition can emphasize the main idea.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Removing the focus from the conclusion.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This weakens emphasis because the audience loses the final reminder of the main idea.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Adding an unrelated phrase.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Unrelated phrases distract from meaning.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_Quiz_Q13</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_Quiz_Q13&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.01&lt;/p&gt;&lt;p&gt;What does structure shape?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_Quiz_Q13</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Only the color of the page.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Structure affects meaning, not page color.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Only the speaker&amp;#39;s handwriting.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Structure affects audience understanding.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. The order, relationship, and importance of ideas.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. These features shape meaning.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Nothing about communication.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Structure is central to communication.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_Quiz_Q14</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_Quiz_Q14&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which speech plan is most logical for explaining a process?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_Quiz_Q14</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Practice delivery, choose topic, write focus.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This order is backward because rehearsal should come after the topic and focus are planned.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Write focus, rehearse, choose topic.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Choosing the topic should come before the focus so the speech has a clear starting point.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Rehearse, outline, choose topic.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This reverses the process because the topic should be chosen before outlining and rehearsing.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;D. Choose topic, write focus, outline points, rehearse.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This follows a logical sequence.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_Quiz_Q15</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_Quiz_Q15&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.01&lt;/p&gt;&lt;p&gt;Which feature signals an example?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_Quiz_Q15</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. For example&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This phrase tells the audience an example is coming.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. However&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;However signals contrast, so it does not introduce an example.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Because&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Because signals cause, so it does not tell the audience an example is coming.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Finally&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Finally signals sequence or conclusion.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_Quiz_Q16</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_Quiz_Q16&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.SPK.01&lt;/p&gt;&lt;p&gt;Where should a speaker place the central focus for strong emphasis?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_Quiz_Q16</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Only in an unrelated detail.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This hides the focus because the audience may not understand the main idea.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. In the introduction and conclusion.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. These positions help the audience recognize and remember the focus.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Nowhere in the speech.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;The audience needs a clear focus.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Only after the speech ends.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;The focus must guide the speech itself.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_Quiz_Q17</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_Quiz_Q17&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.01&lt;/p&gt;&lt;p&gt;Which plan uses cause and effect?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_Quiz_Q17</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. First, write notes; next, practice.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is chronological order.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Silent practice differs from peer practice.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is compare and contrast.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. Rehearsal builds familiarity, so nervousness may decrease.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This explains cause and result.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. A speech has an introduction and conclusion.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This identifies parts, not cause and effect.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_Quiz_Q18</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_Quiz_Q18&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which sentence best explains meaning shaped by structure?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_Quiz_Q18</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. The step-by-step order helps listeners understand how to prepare a speech.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. It connects structure to audience understanding.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. The speech is longer than another speech.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Length alone does not explain meaning.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. The words are on a page.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not explain how structure shapes meaning.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. The speaker uses a topic.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;A topic alone does not describe structure.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_Quiz_Q19</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_Quiz_Q19&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.01&lt;/p&gt;&lt;p&gt;Which structure compares two ways to practice?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_Quiz_Q19</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Chronological order&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This shows time order, not similarities and differences.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Cause and effect&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This explains why a result happens.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. Compare and contrast&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This structure explains similarities and differences.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Definition&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This explains what a term means.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_Quiz_Q20</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_Quiz_Q20&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.SPK.01&lt;/p&gt;&lt;p&gt;Which choice weakens audience understanding?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_Quiz_Q20</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Clear transitions between ideas.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This strengthens understanding.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Signal words that show relationships.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This helps listeners follow meaning.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. A conclusion that restates the focus.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This supports audience memory.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;D. Main points placed in random order.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Random order makes meaning harder to follow.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_Quiz_Q21</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_Quiz_Q21&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.01&lt;/p&gt;&lt;p&gt;Which word signals a result?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_Quiz_Q21</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. Therefore&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Therefore signals a result or conclusion.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. However&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;However signals contrast.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. First&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;First signals sequence, so it does not signal a result.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Similarly&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Similarly signals comparison.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_Quiz_Q22</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_Quiz_Q22&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which speech purpose best fits compare and contrast?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_Quiz_Q22</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Explaining the steps for making note cards.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This fits chronological order.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. Explaining differences between silent practice and peer practice.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This purpose compares two options.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Explaining why practice causes confidence.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This fits cause and effect.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Listing random facts about speaking.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Random facts do not fit a clear structure.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_Quiz_Q23</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_Quiz_Q23&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.01&lt;/p&gt;&lt;p&gt;Why are headings useful in speech notes?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_Quiz_Q23</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. They hide the structure.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Headings reveal structure.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. They replace all support.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Support is still needed.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. They label sections so the speaker can see the organization.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Headings are features that clarify structure.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. They remove the need for a focus.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;A focus is still needed.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_Quiz_Q24</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_Quiz_Q24&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.SPK.01&lt;/p&gt;&lt;p&gt;Which conclusion best uses structure to reinforce meaning?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_Quiz_Q24</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. That is all, and here is a new unrelated topic.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This shifts away from the focus.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. I forgot my main point.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This does not reinforce meaning because it fails to restate the speech focus.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. There were some ideas.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This is too vague because it does not restate the structure or central meaning.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;D. Preparing in steps helps speakers move from planning to confident delivery.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This returns to the process and reinforces the focus.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_Quiz_Q25</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_Quiz_Q25&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.01&lt;/p&gt;&lt;p&gt;Which statement best summarizes this lesson?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_Quiz_Q25</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. Structures and features guide how an audience understands relationships between ideas.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. This captures how structure shapes meaning.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Structure only changes how notes look.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Structure affects meaning, not only appearance.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Features should be ignored in speeches.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Features guide the audience.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Random organization helps listeners most.&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Random organization weakens understanding.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
</quiz>
