<?xml version="1.0" encoding="utf-8"?>
<quiz>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_GuidedPractice_Q01</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_GuidedPractice_Q01&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.01&lt;/p&gt;&lt;p&gt;Speech plan: choose a topic, write a focus, outline points, rehearse delivery. Which structure is used?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_GuidedPractice_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Compare and contrast&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This structure would show similarities and differences, not steps in time order.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Problem and solution&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This structure would name a problem and then solve it.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Cause and effect&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;This structure would explain why something happens and the result.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;D. Chronological order&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. The plan follows steps in the order they should happen.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_GuidedPractice_Q02</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_GuidedPractice_Q02&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.01&lt;/p&gt;&lt;p&gt;Sentence: Because rehearsal reduces uncertainty, speakers may feel more prepared. Which relationship does because signal?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_GuidedPractice_Q02</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Contrast&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Because does not signal a difference between two ideas.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Sequence&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Because does not mainly show time order.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. Cause and effect&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. Because signals why something happens and what results.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Definition&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Because does not define a term.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_GuidedPractice_Q03</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_GuidedPractice_Q03&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.COM.02&lt;/p&gt;&lt;p&gt;Which structure best fits a speech explaining how practice leads to stronger delivery?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_GuidedPractice_Q03</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;A. Cause and effect&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. The speech explains how one action creates a result.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Random order&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Random order would make the explanation harder to follow.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Alphabetical order&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Alphabetical order does not explain how practice affects delivery.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Unrelated examples&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Unrelated examples would weaken the speech focus.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_GuidedPractice_Q04</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_GuidedPractice_Q04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.SPK.01&lt;/p&gt;&lt;p&gt;Which feature helps an audience follow a speech from one point to the next?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_GuidedPractice_Q04</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Unrelated detail&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Unrelated details distract from the speech focus.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;B. Transition&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. A transition shows how ideas connect.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;C. Misspelled word&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Errors do not guide meaning.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Hidden focus&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;A hidden focus makes the speech harder to follow.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>SPEECH_U02_L05_GuidedPractice_Q05</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; SPEECH_U02_L05_GuidedPractice_Q05&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.SPEECH.LST.01&lt;/p&gt;&lt;p&gt;Sentence: However, silent practice does not provide audience feedback. What does however signal?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>SPEECH_U02_L05_GuidedPractice_Q05</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;A. Time order&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;However does not show what happens first or next.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;B. Cause&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;However does not show why something happens.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>&lt;p&gt;C. Contrast&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;Correct. However signals a difference or opposing idea.&lt;/p&gt;</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>&lt;p&gt;D. Repetition&lt;/p&gt;</text>
      <feedback format="html"><text>&lt;p&gt;However does not repeat a key word.&lt;/p&gt;</text></feedback>
    </answer>
  </question>
</quiz>
