  <question type="multichoice">
    <name>
      <text>GEO_U01_L03_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> GEO_U01_L03_GP_Q01</p><p><strong>MLA Standard:</strong> Readiness Support Only - No primary MLA standard assigned in approved mapping</p><p>Which statement is a conjecture?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[A point is an exact location.]]></text>
      <feedback format="html">
        <text><![CDATA[This is a definition, not a conjecture based on observations.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[I think these segments are congruent because they have matching tick marks.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. This is a claim based on observed diagram evidence.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The answer is correct because I chose it.]]></text>
      <feedback format="html">
        <text><![CDATA[This is not a mathematical conjecture or valid support.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A diagram is a drawing of geometric objects.]]></text>
      <feedback format="html">
        <text><![CDATA[This is a description, not a conjecture to test or support.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>GEO_U01_L03_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> GEO_U01_L03_GP_Q02</p><p><strong>MLA Standard:</strong> Readiness Support Only - No primary MLA standard assigned in approved mapping</p><p>A student claims two angles are congruent. Which evidence supports the claim?</p><p><img src="@@PLUGINFILE@@/GEO_U01_L03_GP_Q02_diagram.png" alt="Geometry diagram supports visual interpretation without adding new assessment facts." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="GEO_U01_L03_GP_Q02_diagram.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The angles are close together.]]></text>
      <feedback format="html">
        <text><![CDATA[Location does not prove congruence. The evidence must relate to angle measure.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The angles look about the same size.]]></text>
      <feedback format="html">
        <text><![CDATA[Appearance alone is not enough support for a Geometry claim.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The angles have matching arc marks.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Matching arc marks are relevant evidence that angles are congruent.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The angles are drawn in dark pencil.]]></text>
      <feedback format="html">
        <text><![CDATA[Drawing style does not support a mathematical conclusion.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>GEO_U01_L03_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> GEO_U01_L03_GP_Q03</p><p><strong>MLA Standard:</strong> Readiness Support Only - No primary MLA standard assigned in approved mapping</p><p>Which argument is flawed?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The segments are congruent because they have matching tick marks.]]></text>
      <feedback format="html">
        <text><![CDATA[This is supported by relevant diagram evidence.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The angle is a right angle because it has a square corner mark.]]></text>
      <feedback format="html">
        <text><![CDATA[This is supported by the right angle marking.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The points are collinear because they lie on the same straight line.]]></text>
      <feedback format="html">
        <text><![CDATA[This is supported by the definition of collinear points.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The lines are parallel because they look parallel.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Appearance alone is not enough evidence for a parallel-line conclusion.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>GEO_U01_L03_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> GEO_U01_L03_GP_Q04</p><p><strong>MLA Standard:</strong> Readiness Support Only - No primary MLA standard assigned in approved mapping</p><p>What does a valid mathematical argument need?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[A claim with no explanation]]></text>
      <feedback format="html">
        <text><![CDATA[A claim alone is incomplete because it does not show why the conclusion is supported.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[A claim, relevant evidence, and reasoning that connects them]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A valid argument explains why the evidence supports the claim.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A drawing that looks accurate]]></text>
      <feedback format="html">
        <text><![CDATA[A drawing can help, but appearance alone does not create a valid argument.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A conclusion based on one guess]]></text>
      <feedback format="html">
        <text><![CDATA[A guess is not enough support for a mathematical argument.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>GEO_U01_L03_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> GEO_U01_L03_GP_Q05</p><p><strong>MLA Standard:</strong> Readiness Support Only - No primary MLA standard assigned in approved mapping</p><p>A student says a conjecture is true because one example worked. What is the best correction?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[One example proves every conjecture.]]></text>
      <feedback format="html">
        <text><![CDATA[One example can suggest a conjecture, but it does not prove a general claim.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A conjecture never needs evidence.]]></text>
      <feedback format="html">
        <text><![CDATA[A conjecture should be tested and supported before it is accepted.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The conjecture must be false.]]></text>
      <feedback format="html">
        <text><![CDATA[One example is not enough to prove the conjecture false either.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[One example can suggest a conjecture, but more support is needed.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Stronger evidence or reasoning is needed before accepting a conjecture.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>