<quiz>
  <question type="category">
    <category>
      <text>$course$/GEOMETRY/Units/Unit 01/Lesson 02/GEO_U01_L02_GuidedPractice</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>GEO_U01_L02_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> GEO_U01_L02_GP_Q01</p><p><strong>MLA Standard:</strong> Readiness Support Only - No primary MLA standard assigned in approved mapping</p><p>A figure is a straight path with arrows on both ends. Which description is most precise?</p><p><img src="@@PLUGINFILE@@/GEO_U01_L02_GP_Q01_diagram.png" alt="Geometry diagram supports visual interpretation without adding new assessment facts." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="GEO_U01_L02_GP_Q01_diagram.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[A line]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A line is a straight path that extends forever in both directions, and arrows on both ends show that extension.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A segment]]></text>
      <feedback format="html">
        <text><![CDATA[A segment has two endpoints. Arrows on both ends show the figure does not stop at endpoints.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A ray]]></text>
      <feedback format="html">
        <text><![CDATA[A ray has one endpoint and extends in one direction. This figure extends in both directions.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[An angle]]></text>
      <feedback format="html">
        <text><![CDATA[An angle is formed by two rays with a common endpoint. The description gives one straight path.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>GEO_U01_L02_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> GEO_U01_L02_GP_Q02</p><p><strong>MLA Standard:</strong> Readiness Support Only - No primary MLA standard assigned in approved mapping</p><p>A figure has endpoints A and B. Which description matches the definition?</p><p><img src="@@PLUGINFILE@@/GEO_U01_L02_GP_Q02_diagram.png" alt="Geometry diagram supports visual interpretation without adding new assessment facts." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="GEO_U01_L02_GP_Q02_diagram.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Line AB]]></text>
      <feedback format="html">
        <text><![CDATA[A line extends forever in both directions and does not have endpoints.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Ray AB]]></text>
      <feedback format="html">
        <text><![CDATA[A ray has one endpoint and extends in one direction, so two endpoints do not match the definition.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Segment AB]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. A segment is a part of a line with two endpoints, so endpoints A and B identify segment AB.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Angle AB]]></text>
      <feedback format="html">
        <text><![CDATA[An angle is formed by two rays with a common endpoint. Two letters alone do not name a standard angle here.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>GEO_U01_L02_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> GEO_U01_L02_GP_Q03</p><p><strong>MLA Standard:</strong> Readiness Support Only - No primary MLA standard assigned in approved mapping</p><p>Which statement is most precise?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[There is a corner at B.]]></text>
      <feedback format="html">
        <text><![CDATA[This is informal and does not name the rays or the angle.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Rays BA and BC form angle ABC.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. This names the two rays and the angle they form.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The shape bends at B.]]></text>
      <feedback format="html">
        <text><![CDATA[This is vague and does not use precise Geometry language.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[B is somewhere in the figure.]]></text>
      <feedback format="html">
        <text><![CDATA[This does not describe the geometric relationship clearly.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>GEO_U01_L02_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> GEO_U01_L02_GP_Q04</p><p><strong>MLA Standard:</strong> Readiness Support Only - No primary MLA standard assigned in approved mapping</p><p>A student says a figure is a ray because it looks short. What is the best correction?</p><p><img src="@@PLUGINFILE@@/GEO_U01_L02_GP_Q04_diagram.png" alt="Geometry diagram supports visual interpretation without adding new assessment facts." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="GEO_U01_L02_GP_Q04_diagram.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[A ray is always the shortest object in a diagram.]]></text>
      <feedback format="html">
        <text><![CDATA[Length in a drawing does not define a ray. A ray is defined by one endpoint and extension in one direction.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A ray must have two endpoints.]]></text>
      <feedback format="html">
        <text><![CDATA[This confuses a ray with a segment. A ray has one endpoint.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Any short figure is a segment.]]></text>
      <feedback format="html">
        <text><![CDATA[Appearance is not enough evidence. The defining features are endpoints and arrows.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Use endpoints and arrows, not appearance, to identify the object.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Definitions and markings provide evidence; appearance alone is not proof.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>GEO_U01_L02_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> GEO_U01_L02_GP_Q05</p><p><strong>MLA Standard:</strong> Readiness Support Only - No primary MLA standard assigned in approved mapping</p><p>Which phrase best describes evidence in a Geometry explanation?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[A guess based on what the diagram looks like]]></text>
      <feedback format="html">
        <text><![CDATA[A guess is not evidence. Geometry explanations need support from definitions, labels, markings, or given information.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Information that supports a conclusion]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Evidence supports a conclusion using definitions, labels, markings, or given statements.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A word that sounds mathematical]]></text>
      <feedback format="html">
        <text><![CDATA[Mathematical vocabulary helps only when it is used accurately and supported by meaning.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A conclusion without a reason]]></text>
      <feedback format="html">
        <text><![CDATA[A conclusion needs evidence. A statement without a reason does not explain the Geometry.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>