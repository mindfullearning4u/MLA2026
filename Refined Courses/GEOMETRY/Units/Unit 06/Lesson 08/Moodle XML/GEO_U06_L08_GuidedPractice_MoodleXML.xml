  <question type="multichoice">
    <name>
      <text>GEO_U06_L08_GP01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> GEO_U06_L08_GP01</p><p><strong>MLA Standard:</strong> MLA.GEO.CGM.8</p><p>Which tool supports a coordinate proof that two sides are perpendicular?</p><p><img src="@@PLUGINFILE@@/GEO_U06_L08_GP01_diagram.png" alt="Geometry diagram supports visual interpretation without adding new assessment facts." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="GEO_U06_L08_GP01_diagram.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Slope]]></text>
      <feedback format="html">
        <text><![CDATA[Negative reciprocal slopes support perpendicular lines.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Volume formula]]></text>
      <feedback format="html">
        <text><![CDATA[Volume does not prove perpendicular sides.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Scale factor cubed]]></text>
      <feedback format="html">
        <text><![CDATA[This applies to volume scaling, not perpendicularity.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Cross-section sketch only]]></text>
      <feedback format="html">
        <text><![CDATA[A sketch alone is not enough coordinate proof.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>GEO_U06_L08_GP02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> GEO_U06_L08_GP02</p><p><strong>MLA Standard:</strong> MLA.GEO.CIR.9</p><p>What is the radius of (x - 1)? + (y + 2)? = 36?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[36]]></text>
      <feedback format="html">
        <text><![CDATA[The right side is r?, not r.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[6]]></text>
      <feedback format="html">
        <text><![CDATA[The radius is sqrt(36)=6.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[1]]></text>
      <feedback format="html">
        <text><![CDATA[This is part of the center, not the radius.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[2]]></text>
      <feedback format="html">
        <text><![CDATA[This is part of the center, not the radius.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>GEO_U06_L08_GP03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> GEO_U06_L08_GP03</p><p><strong>MLA Standard:</strong> MLA.GEO.CGM.14</p><p>Which unit should a volume answer use?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[meters]]></text>
      <feedback format="html">
        <text><![CDATA[Meters are linear units.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[square meters]]></text>
      <feedback format="html">
        <text><![CDATA[Square meters measure area.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[cubic meters]]></text>
      <feedback format="html">
        <text><![CDATA[Volume uses cubic units.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[degrees]]></text>
      <feedback format="html">
        <text><![CDATA[Degrees measure angles.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>GEO_U06_L08_GP04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> GEO_U06_L08_GP04</p><p><strong>MLA Standard:</strong> MLA.GEO.SIM.4</p><p>A solid is enlarged by scale factor 3. How does volume change?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[3 times]]></text>
      <feedback format="html">
        <text><![CDATA[That is the linear effect.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[6 times]]></text>
      <feedback format="html">
        <text><![CDATA[This doubles the scale factor, not the volume rule.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[9 times]]></text>
      <feedback format="html">
        <text><![CDATA[That is the area effect.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[27 times]]></text>
      <feedback format="html">
        <text><![CDATA[Volume changes by k?, so 3?=27.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>GEO_U06_L08_GP05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> GEO_U06_L08_GP05</p><p><strong>MLA Standard:</strong> MLA.GEO.CGM.11</p><p>A slice of a rectangular prism parallel to one face forms what type of cross-section?</p><p><img src="@@PLUGINFILE@@/GEO_U06_L08_GP05_diagram.png" alt="Geometry diagram supports visual interpretation without adding new assessment facts." style="max-width:100%;height:auto;" /></p>]]></text>
      <file name="GEO_U06_L08_GP05_diagram.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[A rectangle congruent or similar to that face]]></text>
      <feedback format="html">
        <text><![CDATA[A parallel slice of a rectangular prism matches the face shape.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Always a circle]]></text>
      <feedback format="html">
        <text><![CDATA[Rectangular prisms do not have circular faces.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Always a triangle]]></text>
      <feedback format="html">
        <text><![CDATA[A parallel slice to a rectangular face is rectangular.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A sphere]]></text>
      <feedback format="html">
        <text><![CDATA[A cross-section is two-dimensional, not a three-dimensional sphere.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>