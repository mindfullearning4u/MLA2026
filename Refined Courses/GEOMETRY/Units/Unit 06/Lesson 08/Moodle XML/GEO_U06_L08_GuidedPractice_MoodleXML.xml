<?xml version='1.0' encoding='utf-8'?>
<quiz>
  <question type="category">
    <category>
      <text>$course$/GEOMETRY/Units/Unit 06/Lesson 08/GEO_U06_L08_GuidedPractice</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>GEO_U06_L08_GP01</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; GEO_U06_L08_GP01&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.GEO.CGM.7&lt;/p&gt;&lt;p&gt;What is the point 1/2 of the way from A(2, 0) to B(10, 8)?&lt;/p&gt;</text>
      </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>(6, 4)</text>
      <feedback format="html">
        <text>Halfway means average each coordinate: ((2+10)/2, (0+8)/2) = (6, 4).</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>(8, 8)</text>
      <feedback format="html">
        <text>That does not average both coordinates.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>(12, 8)</text>
      <feedback format="html">
        <text>That adds the endpoint coordinates.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>(4, 6)</text>
      <feedback format="html">
        <text>The coordinates are not averaged correctly.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>GEO_U06_L08_GP02</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; GEO_U06_L08_GP02&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.GEO.CIR.9&lt;/p&gt;&lt;p&gt;What is the radius of (x - 1)? + (y + 2)? = 36?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>36</text>
      <feedback format="html">
        <text>The right side is r?, not r.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>6</text>
      <feedback format="html">
        <text>The radius is sqrt(36)=6.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>1</text>
      <feedback format="html">
        <text>This is part of the center, not the radius.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>2</text>
      <feedback format="html">
        <text>This is part of the center, not the radius.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>GEO_U06_L08_GP03</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; GEO_U06_L08_GP03&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.GEO.CGM.14&lt;/p&gt;&lt;p&gt;Which unit should a volume answer use?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>meters</text>
      <feedback format="html">
        <text>Meters are linear units.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>square meters</text>
      <feedback format="html">
        <text>Square meters measure area.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>cubic meters</text>
      <feedback format="html">
        <text>Volume uses cubic units.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>degrees</text>
      <feedback format="html">
        <text>Degrees measure angles.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>GEO_U06_L08_GP04</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; GEO_U06_L08_GP04&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.GEO.SIM.4&lt;/p&gt;&lt;p&gt;A solid is enlarged by scale factor 3. How does volume change?&lt;/p&gt;</text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text>3 times</text>
      <feedback format="html">
        <text>That is the linear effect.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>6 times</text>
      <feedback format="html">
        <text>This doubles the scale factor, not the volume rule.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>9 times</text>
      <feedback format="html">
        <text>That is the area effect.</text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text>27 times</text>
      <feedback format="html">
        <text>Volume changes by k?, so 3?=27.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>GEO_U06_L08_GP05</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;&lt;strong&gt;Question ID:&lt;/strong&gt; GEO_U06_L08_GP05&lt;/p&gt;&lt;p&gt;&lt;strong&gt;MLA Standard:&lt;/strong&gt; MLA.GEO.CGM.11&lt;/p&gt;&lt;p&gt;A slice of a rectangular prism parallel to one face forms what type of cross-section?&lt;/p&gt;&lt;p&gt;&lt;img src="@@PLUGINFILE@@/GEO_U06_L08_GP05_diagram.png" alt="Geometry diagram supports visual interpretation without adding new assessment facts." style="max-width:100%;height:auto;" /&gt;&lt;/p&gt;</text>
      <file name="GEO_U06_L08_GP05_diagram.png" path="/" encoding="base64"></file>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>A rectangle congruent or similar to that face</text>
      <feedback format="html">
        <text>A parallel slice of a rectangular prism matches the face shape.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Always a circle</text>
      <feedback format="html">
        <text>Rectangular prisms do not have circular faces.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Always a triangle</text>
      <feedback format="html">
        <text>A parallel slice to a rectangular face is rectangular.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>A sphere</text>
      <feedback format="html">
        <text>A cross-section is two-dimensional, not a three-dimensional sphere.</text>
      </feedback>
    </answer>
  </question>
</quiz>