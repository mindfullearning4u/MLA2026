    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[They become 16 times as large]]></text>
      <feedback format="html">
        <text><![CDATA[That is the area or surface area effect.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[They become 4 times as large]]></text>
      <feedback format="html">
        <text><![CDATA[Linear measurements change by k.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[They become 64 times as large]]></text>
      <feedback format="html">
        <text><![CDATA[That is the volume effect.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[They become 8 times as large]]></text>
      <feedback format="html">
        <text><![CDATA[This doubles k instead of using k.]]></text>
      </feedback>
    </answer>
  </question>
