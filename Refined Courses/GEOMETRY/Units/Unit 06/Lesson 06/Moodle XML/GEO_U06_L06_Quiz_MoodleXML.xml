    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> GEO_U06_L06_Q01</p><p><strong>MLA Standard:</strong> MLA.GEO.SIM.4</p><p>If k = 4, how do lengths change?</p>]]></text>
    </questiontext>
