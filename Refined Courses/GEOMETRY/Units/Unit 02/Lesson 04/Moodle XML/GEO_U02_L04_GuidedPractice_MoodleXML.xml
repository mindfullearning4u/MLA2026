<quiz>
  <question type="category">
    <category>
      <text>$course$/GEOMETRY/Units/Unit 02/Lesson 04/GEO_U02_L04_GuidedPractice</text>
    </category>
  </question>
  <question type="multichoice">
    <name>
      <text>GEO_U02_L04_GP_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> GEO_U02_L04_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.GEO.RP.5</p><p>What belongs in the reason column of a proof?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[A definition, property, theorem, or given fact.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Reasons justify statements.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Only the final answer.]]></text>
      <feedback format="html">
        <text><![CDATA[The final answer is not a reason for each step.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A drawing that looks correct.]]></text>
      <feedback format="html">
        <text><![CDATA[Appearance does not justify proof.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The same statement repeated.]]></text>
      <feedback format="html">
        <text><![CDATA[Repeating a statement does not explain why it is true.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>GEO_U02_L04_GP_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> GEO_U02_L04_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.GEO.RP.5</p><p>What is often the first reason in a proof?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Guess]]></text>
      <feedback format="html">
        <text><![CDATA[A guess is not valid proof.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Given]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Proofs often begin with given information.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Converse]]></text>
      <feedback format="html">
        <text><![CDATA[A converse is not usually the first reason.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Counterexample]]></text>
      <feedback format="html">
        <text><![CDATA[A counterexample disproves a claim.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>GEO_U02_L04_GP_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> GEO_U02_L04_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.GEO.RP.5</p><p>Proof by contradiction begins by assuming what?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The conclusion is already proven.]]></text>
      <feedback format="html">
        <text><![CDATA[That skips the proof.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The diagram is to scale.]]></text>
      <feedback format="html">
        <text><![CDATA[Diagrams are not assumed to scale.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The opposite of what you want to prove.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. The opposite assumption should lead to a conflict.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Every converse is true.]]></text>
      <feedback format="html">
        <text><![CDATA[Converses are not always true.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>GEO_U02_L04_GP_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> GEO_U02_L04_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.GEO.RP.5</p><p>Which proof reason is invalid?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Given]]></text>
      <feedback format="html">
        <text><![CDATA[Given is a valid reason.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Definition of midpoint]]></text>
      <feedback format="html">
        <text><![CDATA[Definitions can justify proof steps.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Linear Pair Postulate]]></text>
      <feedback format="html">
        <text><![CDATA[Postulates can justify proof steps.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Because it looks that way.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Appearance is not a proof reason.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>GEO_U02_L04_GP_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Question ID:</strong> GEO_U02_L04_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.GEO.RP.5</p><p>Why must proof steps be ordered logically?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Each step should follow from previous facts or accepted reasons.]]></text>
      <feedback format="html">
        <text><![CDATA[Correct. Logical order shows how the conclusion follows.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The shortest proof is always correct.]]></text>
      <feedback format="html">
        <text><![CDATA[A short proof can still be invalid.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Alphabetical order is required.]]></text>
      <feedback format="html">
        <text><![CDATA[Alphabetical order is unrelated.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Order never matters.]]></text>
      <feedback format="html">
        <text><![CDATA[Order matters when steps depend on earlier facts.]]></text>
      </feedback>
    </answer>
  </question>
</quiz>