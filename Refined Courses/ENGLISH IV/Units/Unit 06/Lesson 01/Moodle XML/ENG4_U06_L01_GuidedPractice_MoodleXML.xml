<?xml version="1.0" encoding="UTF-8"?>
<quiz>
  <question type="multichoice">
    <name><text>ENG4_U06_L01_GP_Q01</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U06_L01_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.ENG4.C.01</p><p>Which oral response order is strongest for listeners?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U06_L01_GP_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Evidence, unrelated detail, focus, conclusion.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The listener needs the focus before evidence.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. Focus, evidence, explanation, conclusion.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. This order helps listeners follow the point and support.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Conclusion, evidence, unrelated detail, focus.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This order is confusing.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Unrelated detail, evidence, conclusion, focus.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This does not support clear oral communication.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U06_L01_GP_Q02</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U06_L01_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.10</p><p>Source note: Workers with unreliable transportation are more likely to miss scheduled shifts. Which paraphrase is accurate?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U06_L01_GP_Q02</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Workers with reliable transportation miss more shifts.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This reverses the meaning.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. Transportation has no effect on work schedules.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This contradicts the source note.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Workers should avoid all transportation.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This adds an unsupported idea.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>D. Unreliable transportation can make workers miss scheduled shifts.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. This preserves the meaning.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U06_L01_GP_Q03</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U06_L01_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.ENG4.V.01</p><p>Which sentence uses academic vocabulary effectively in an oral response?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U06_L01_GP_Q03</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>A. The evidence is credible because it comes from a local workforce report.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Credible is used accurately.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. The thing is good because stuff happens.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This is vague and informal.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Evidence is a word in the presentation.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This does not use academic vocabulary meaningfully.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. The claim is claimy and has evidence things.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This is not academic language.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U06_L01_GP_Q04</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U06_L01_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.ENG4.L.01</p><p>Which spoken sentence is clearest and most conventional?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U06_L01_GP_Q04</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Evidence supports claim because report.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This is not standard English.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. The evidence supports the claim it comes from report.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This is a run-on sentence.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>C. The evidence supports the claim because it comes from a credible report.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. This is clear and conventional.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Because credible report evidence.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This is incomplete.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U06_L01_GP_Q05</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U06_L01_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.ENG4.C.01</p><p>Which statement best explains why focus matters in oral communication?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U06_L01_GP_Q05</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Focus matters only in writing, not speaking.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Focus is essential in oral communication.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. A clear focus helps listeners understand how each piece of evidence supports the main point.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Focus guides listener understanding.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Focus means adding as many topics as possible.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Focus narrows the message.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Focus replaces evidence.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Focus and evidence work together.</p>]]></text></feedback>
    </answer>
  </question>
</quiz>

