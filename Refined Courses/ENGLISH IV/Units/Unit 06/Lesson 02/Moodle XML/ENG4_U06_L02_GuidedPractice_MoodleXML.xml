      <feedback format="html"><text><![CDATA[<p>Incorrect. This is vague.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. The speech is speechy and good.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This is not academic language.</p>]]></text></feedback>
