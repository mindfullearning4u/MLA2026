<quiz>
  <question type="multichoice">
    <name><text>ENG4_U06_L02_GP_Q01</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U06_L02_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.ENG4.C.01</p><p>Presentation <strong>Excerpt:</strong> We need clear evidence, clear reasoning, and clear action. Which device is used?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U06_L02_GP_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Unrelated evidence.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The sentence uses a rhetorical structure, not evidence.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. Repetition and parallel structure.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Clear is repeated and the phrase pattern is balanced.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Sentence fragment only.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The sentence is complete.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Source citation.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. No source is cited.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U06_L02_GP_Q02</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U06_L02_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.12</p><p>Presentation <strong>Excerpt:</strong> We need clear evidence, clear reasoning, and clear action. Why is the repeated word clear effective in the excerpt?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U06_L02_GP_Q02</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. It distracts from the point.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The repetition supports the point.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. It replaces all evidence.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Rhetoric should not replace evidence.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. It makes the claim unrelated.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The repetition reinforces the claim.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>D. It emphasizes the qualities the speaker wants the audience to remember.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Repetition makes the key idea memorable.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U06_L02_GP_Q03</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U06_L02_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.08</p><p>Which use of rhetoric is weakest?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U06_L02_GP_Q03</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>A. A dramatic claim with no evidence or reasoning.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Rhetoric without evidence weakens argument quality.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. A rhetorical question after evidence has been explained.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. That can be effective.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Parallel structure that organizes three reasons.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. That can strengthen organization.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Repetition that emphasizes a proven pattern.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. That can support evidence.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U06_L02_GP_Q04</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U06_L02_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.ENG4.V.01</p><p>Which explanation uses academic vocabulary precisely?</p>]]></text></questiontext>
