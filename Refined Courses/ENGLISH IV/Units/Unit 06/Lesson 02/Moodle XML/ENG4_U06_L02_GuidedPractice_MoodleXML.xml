      <feedback format="html"><text><![CDATA[<p>Correct. This uses parallel structure and emphasizes accurately.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. The device is a thing.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This is vague.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U06_L02_GP_Q05</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U06_L02_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.ENG4.C.01</p><p>Which revision best uses rhetoric responsibly?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U06_L02_GP_Q05</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Add a rhetorical question that ignores the evidence.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Rhetoric should connect to evidence.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. Use parallel structure to summarize three evidence-based reasons.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. This supports clear oral presentation.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Use dramatic wording to hide weak support.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This replaces reasoning with style.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Repeat unrelated words for effect.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Repetition should serve the message.</p>]]></text></feedback>
    </answer>
  </question>
