  <question type="multichoice">
    <name><text>ENG4_U06_L02_Q01</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U06_L02_Q01</p><p><strong>MLA Standard:</strong> MLA.ENG4.C.01</p><p>Which oral presentation line uses parallel structure effectively?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U06_L02_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. The plan costs and purpose fair impact.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This is unclear.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. The plan is practical in cost, clear in purpose, and fair in impact.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The repeated structure makes related points balanced.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. The plan is about several unrelated things.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This lacks rhetorical structure.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. The plan, the plan, the plan, with no point.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Repetition without meaning is weak.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
