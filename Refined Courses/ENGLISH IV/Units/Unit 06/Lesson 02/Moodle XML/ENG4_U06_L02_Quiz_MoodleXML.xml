      <feedback format="html"><text><![CDATA[<p>Correct. The speaker compares a budget to a cage and compass.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U06_L02_Q03</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U06_L02_Q03</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.08</p><p>Why should rhetorical devices remain connected to evidence?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U06_L02_Q03</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>A. Rhetoric without evidence can become unsupported persuasion.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Strong argument needs reasoning and support.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. Evidence is never important in speeches.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Evidence is important.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Devices always prove claims.</p>]]></text>
