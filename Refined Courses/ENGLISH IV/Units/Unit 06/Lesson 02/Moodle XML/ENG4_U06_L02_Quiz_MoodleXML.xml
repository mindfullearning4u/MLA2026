    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Evidence makes every speech confusing.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Evidence can clarify.</p>]]></text></feedback>
    </answer>
  </question>
