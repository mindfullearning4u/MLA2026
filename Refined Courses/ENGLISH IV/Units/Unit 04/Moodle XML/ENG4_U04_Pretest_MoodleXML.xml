<quiz>
  <question type="multichoice">
    <name><text>ENG4_U04_PRE_Q01</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U04_PRE_Q01</p><p><strong>MLA Standard:</strong> MLA.ENG4.RS.01</p><p>Sources show a policy has benefits but needs staffing. Which synthesis is strongest?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U04_PRE_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Staffing concerns erase all benefits.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This ignores part of the evidence.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. The policy may work when staffing needs are planned before implementation.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. This connects benefit and condition.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Benefits mean staffing never matters.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This ignores the condition.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. The sources cannot be connected.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. They address the same issue.</p>]]></text></feedback>
    </answer>
  </question>
