    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. The orchard should never be discussed.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>He is discussing the offer.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. The offer should be considered because it could provide financial safety.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. He focuses on debts and the future.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. The grandmother&#39;s history is meaningless.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>He refers to grandmother too.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Nadia should ignore all practical concerns.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This is not his view.</p>]]></text></feedback>
    </answer>
  </question>
