  </question>
  <question type="multichoice">
    <name><text>ENG4_U02_L07_Q14</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U02_L07_Q14</p><p><strong>MLA Standard:</strong> MLA.ENG4.W.04</p><p><strong>Passage:</strong> A peer says, &quot;Your scene has a clear conflict, but I cannot tell what the narrator values.&quot; Which revision target best addresses the feedback?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U02_L07_Q14</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Add more random background information.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Random background may not reveal values.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
