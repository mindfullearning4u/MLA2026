<quiz>
  <question type="multichoice">
    <name><text>ENG4_U02_L07_Q01</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U02_L07_Q01</p><p><strong>MLA Standard:</strong> MLA.ENG4.W.01</p><p><strong>Passage:</strong> A writer plans a story in which an older sister wants to leave her town, while her younger brother sees leaving as abandonment. Which plan best supports a complex narrative?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U02_L07_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. List every place in the town without showing conflict.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>A setting list does not create narrative complexity.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. Use a scene where both siblings interpret the same departure differently.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Shared events with different interpretations support complexity.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Explain in the first sentence that leaving is bad.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This states a lesson too directly.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Avoid character motivation so the plot moves quickly.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Motivation is necessary for perspective and theme.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U02_L07_Q02</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U02_L07_Q02</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.03</p><p><strong>Passage:</strong> Lina saves the train ticket because it represents freedom. Tomas hides the same ticket because it represents losing his sister. What does the ticket reveal?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U02_L07_Q02</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Both characters have identical motivations.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Their motivations contrast.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. The story has no conflict.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>The object reveals conflict.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Objects cannot develop perspective.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>The ticket develops perspective.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>D. The same object can carry different meanings for different perspectives.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Lina and Tomas attach different emotional meanings to it.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U02_L07_Q03</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U02_L07_Q03</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.02</p><p><strong>Passage:</strong> A character realizes that protecting another person from pain can sometimes prevent that person from growing. Which universal theme does this suggest?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U02_L07_Q03</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>A. Care can become harmful when it prevents necessary growth.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. This expresses a universal theme with complexity.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. Growth never requires discomfort.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This contradicts the passage.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Protection is always wrong.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This is too absolute.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. People should never help each other.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This is unsupported.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U02_L07_Q04</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U02_L07_Q04</p><p><strong>MLA Standard:</strong> MLA.ENG4.W.04</p><p><strong>Passage:</strong> Weak draft: The argument was intense and important. Which revision best shows rather than tells?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U02_L07_Q04</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. The argument was very intense and very important.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This only adds repetition.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. The argument had significance and relevance.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This is abstract.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>C. Mina folded the letter until its corners split, but she still would not look at her father.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The action reveals tension.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. The argument happened, and people talked.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This is vague.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U02_L07_Q05</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U02_L07_Q05</p><p><strong>MLA Standard:</strong> MLA.ENG4.L.01</p><p><strong>Passage:</strong> The writer wants a correct sentence. Which sentence is correct?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U02_L07_Q05</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. When the door closed Selene understood, why her brother had stayed silent.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>The comma placement is incorrect.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. When the door closed, Selene understand why her brother had stayed silent.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>The verb does not agree.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>C. When the door closed, Selene understood why her brother had stayed silent.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The dependent clause is followed by a comma.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. when the door closed, Selene understood why her brother had stayed silent.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>The sentence should begin with a capital letter.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U02_L07_Q06</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U02_L07_Q06</p><p><strong>MLA Standard:</strong> MLA.ENG4.W.01</p><p><strong>Passage:</strong> A narrative about loyalty begins with a character defending a friend, then discovering the friend harmed someone else. Which choice best deepens the narrative?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U02_L07_Q06</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>A. Show the character struggling between loyalty to the friend and responsibility to the harmed person.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. This creates meaningful internal conflict.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. End immediately after the discovery with no response.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This prevents development.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Add an unrelated description of the weather only.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Unrelated description does not deepen conflict.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Remove the character&#39;s motivation.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Motivation is needed for complex narrative.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U02_L07_Q07</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U02_L07_Q07</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.03</p><p><strong>Passage:</strong> &quot;I kept the medal in a drawer,&quot; Nia says, &quot;because everyone called it courage, but I remembered only fear.&quot; What perspective is revealed?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U02_L07_Q07</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Nia sees the medal as simple proof of happiness.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This contradicts her memory of fear.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. Nia does not remember the event at all.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>She remembers fear.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Nia wants everyone to praise her more.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>There is no evidence for that.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>D. Nia has a conflicted perspective on public praise and private memory.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The medal means more than public courage to her.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U02_L07_Q08</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U02_L07_Q08</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.02</p><p><strong>Passage:</strong> A character leaves home to gain independence but later understands that independence also requires responsibility to others. Which theme is most precise?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U02_L07_Q08</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
