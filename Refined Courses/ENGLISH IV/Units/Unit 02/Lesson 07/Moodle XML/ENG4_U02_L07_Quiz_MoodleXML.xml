  <question type="multichoice">
    <name><text>ENG4_U02_L07_Q13</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U02_L07_Q13</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.02</p><p><strong>Passage:</strong> A story shows that a family argument ends only after each person admits a partial truth. Which theme is best supported?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U02_L07_Q13</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
