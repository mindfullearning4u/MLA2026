      <text><![CDATA[<p>C. Independence means never needing anyone.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This contradicts the responsibility element.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Home is only a physical place.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This misses the responsibility idea.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U02_L07_Q09</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U02_L07_Q09</p><p><strong>MLA Standard:</strong> MLA.ENG4.W.04</p><p><strong>Passage:</strong> Original <strong>Sentence:</strong> The room was sad. Which revision best improves precision and narrative effect?</p>]]></text></questiontext>
