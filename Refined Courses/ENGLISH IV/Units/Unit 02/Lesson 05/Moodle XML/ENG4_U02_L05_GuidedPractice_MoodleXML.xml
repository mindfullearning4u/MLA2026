  <question type="multichoice">
    <name><text>ENG4_U02_L05_GP_Q01</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U02_L05_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.09</p><p><strong>Passage:</strong> By morning, the city wore a coat of broken branches. Rainwater whispered along the curb, carrying leaves like small, exhausted boats. In the park, the oldest oak lifted one split limb toward the pale sky, not in defeat but in accusation. People stepped around the puddles quietly, as if the storm had taken the street&#39;s voice and left everyone listening for what it would say next. Which phrase is a metaphor?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U02_L05_GP_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. By morning</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This is a time phrase.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. the city wore a coat of broken branches</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The city is described as wearing storm damage.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. In the park</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This is a setting phrase.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. People stepped</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This is literal action.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U02_L05_GP_Q02</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U02_L05_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.09</p><p><strong>Passage:</strong> Rainwater whispered along the curb, carrying leaves like small, exhausted boats. What is the effect of whispered?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U02_L05_GP_Q02</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. It proves the water is speaking words.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This is too literal.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. It makes the passage comic.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>The mood is serious.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. It removes the storm&#39;s effect.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>It emphasizes aftermath.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>D. It personifies rainwater to create a quiet, tense mood.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct</p>]]></text></feedback>
    </answer>
  </question>
