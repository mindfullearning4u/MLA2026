      <feedback format="html"><text><![CDATA[<p>This is unrelated.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U02_PRE_Q10</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U02_PRE_Q10</p><p><strong>MLA Standard:</strong> MLA.ENG4.L.01</p><p><strong>Passage:</strong> Choose the sentence with correct conventions.</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U02_PRE_Q10</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>A. The narrator returns home, and she remembers the harbor.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Subject-verb agreement and punctuation are clear.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. The narrator return home, and she remembers the harbor.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>The verb should be returns.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. The narrator returns home and, she remembers the harbor.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>The comma is misplaced.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. the narrator returns home, and she remembers the harbor.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>The sentence should begin with a capital letter.</p>]]></text></feedback>
    </answer>
  </question>
</quiz>

