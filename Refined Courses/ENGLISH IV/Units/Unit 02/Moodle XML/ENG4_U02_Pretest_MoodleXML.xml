<quiz>
  <question type="multichoice">
    <name><text>ENG4_U02_PRE_Q01</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U02_PRE_Q01</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.01</p><p><strong>Passage:</strong> The old key appears each time the narrator remembers leaving home. What is the likely functional significance of the key?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U02_PRE_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. It only proves a door exists.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This is too literal.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. It connects the narrator&#39;s physical departure to unresolved memory and belonging.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The key functions symbolically.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. It removes meaning from the passage.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>The recurring key adds meaning.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. It proves the narrator dislikes all homes.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This is unsupported.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U02_PRE_Q02</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U02_PRE_Q02</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.02</p><p><strong>Passage:</strong> A character gains independence but realizes freedom can feel lonely without connection. Which theme is most supported?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U02_PRE_Q02</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Freedom is always easy.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This ignores loneliness.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. Connection prevents all freedom.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This is too absolute.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Loneliness has no relationship to independence.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>The passage connects them.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>D. Independence can bring both possibility and loneliness.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The theme includes both sides.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U02_PRE_Q03</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U02_PRE_Q03</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.03</p><p><strong>Passage:</strong> A narrator says she wants to forget the past, but she keeps rereading old letters. What does this reveal?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U02_PRE_Q03</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>A. The narrator&#39;s stated desire conflicts with private attachment.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Her action complicates her perspective.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. The narrator has no conflict.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>The actions reveal conflict.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. The letters have no meaning.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>The rereading gives them meaning.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. The narrator cannot read.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>She rereads the letters.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U02_PRE_Q04</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U02_PRE_Q04</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.04</p><p><strong>Passage:</strong> A poem written during social unrest uses images of locked doors and rising dawn. How can historical context help interpretation?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U02_PRE_Q04</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. It proves the poem is only about architecture.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This is too literal.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. It makes imagery irrelevant.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Context helps interpret imagery.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>C. It suggests the images may connect confinement with hope for change.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Context shapes interpretation.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. It prevents modern readers from understanding the poem.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Context supports understanding.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U02_PRE_Q05</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U02_PRE_Q05</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.09</p><p><strong>Passage:</strong> &quot;Regret followed him like a second shadow.&quot; What is the effect of the figurative language?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U02_PRE_Q05</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. It literally creates another physical shadow.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>The language is figurative.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. It shows the character feels no emotion.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Regret is emotional.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>C. It makes regret feel constant and attached to the character.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The simile gives regret persistent presence.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. It removes mood from the sentence.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>It creates mood.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U02_PRE_Q06</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U02_PRE_Q06</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.11</p><p>Classic context: A classic homecoming story often shows a changed traveler returning to a changed home. Contemporary <strong>Passage:</strong> After years away, the narrator returns and feels like both guest and child. What influence is most likely?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U02_PRE_Q06</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>A. The contemporary text adapts a homecoming pattern to explore changed identity.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. It transforms the classic pattern.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. The contemporary text has no relationship to homecoming.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>The return pattern is clear.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. The contemporary text copies the classic exactly.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>It adapts the pattern.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. The passage is only about transportation.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>It is about identity and home.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U02_PRE_Q07</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U02_PRE_Q07</p><p><strong>MLA Standard:</strong> MLA.ENG4.W.01</p><p><strong>Passage:</strong> A student plans a narrative about a character choosing between ambition and loyalty. Which plan best supports a universal theme?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U02_PRE_Q07</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Avoid the choice and summarize the character&#39;s schedule.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This avoids conflict.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. State the theme directly with no scene.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This tells instead of develops.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Remove character perspective.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Perspective is necessary.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>D. Create a scene where both ambition and loyalty have real consequences.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Consequential conflict develops theme.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U02_PRE_Q08</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U02_PRE_Q08</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.10</p><p><strong>Passage:</strong> The narrator did not forget home; distance taught her to hear it differently. Which paraphrase is accurate?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U02_PRE_Q08</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. The narrator forgot home completely.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This contradicts the passage.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. Distance changed the narrator&#39;s understanding of home without erasing it.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. This preserves the meaning.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. The narrator never left home.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Distance implies leaving.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. The narrator hates all memory.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This is unsupported.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U02_PRE_Q09</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U02_PRE_Q09</p><p><strong>MLA Standard:</strong> MLA.ENG4.V.01</p><p><strong>Passage:</strong> The ending is ambiguous because the character smiles while leaving the letter unopened. What does ambiguous mean here?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U02_PRE_Q09</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Completely obvious</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This is the opposite.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. Historically accurate</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This is unrelated.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>C. Open to more than one interpretation</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The ending is not fully settled.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
