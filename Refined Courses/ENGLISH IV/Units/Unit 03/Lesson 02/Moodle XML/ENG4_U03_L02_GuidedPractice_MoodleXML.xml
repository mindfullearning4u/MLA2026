<quiz>
  <question type="multichoice">
    <name><text>ENG4_U03_L02_GP_Q01</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U03_L02_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.06</p><p><strong>Passage:</strong> Community repair cafes can reduce waste while helping residents learn practical skills. Volunteers help people fix items, and one cafe reported that residents repaired 68 percent of items brought in over six months. What is the central idea?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U03_L02_GP_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Repair cafes are only social gatherings.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This misses waste reduction and skill learning.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. Repair cafes can reduce waste and teach useful repair skills.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. This captures the full central idea.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Residents should throw away broken items immediately.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This contradicts the passage.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Volunteers cannot help with practical skills.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This contradicts the passage.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U03_L02_GP_Q02</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U03_L02_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.06</p><p><strong>Passage:</strong> One repair cafe reported that residents repaired 68 percent of items brought in over six months. Why is this effective support?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U03_L02_GP_Q02</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. It is unrelated to repair cafes.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>It directly relates to repair cafes.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. It is vague and unsupported.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>The percentage is specific.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. It proves every item can be repaired.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>It says 68 percent, not every item.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>D. It gives specific measurable evidence connected to the central idea.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The statistic directly supports the claim.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U03_L02_GP_Q03</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U03_L02_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.05</p><p><strong>Passage:</strong> A passage first states a central idea, then gives examples, then evaluates the strongest evidence. Why is this structure effective?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U03_L02_GP_Q03</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>A. It helps readers understand the claim before judging support.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The order supports comprehension.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. It hides the main idea until the end.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>The main idea appears first.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. It avoids evidence.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>It gives examples and evaluates evidence.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. It turns the passage into fiction.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>The structure is informational.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U03_L02_GP_Q04</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U03_L02_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.10</p><p><strong>Passage:</strong> Participants said they were more likely to try simple repairs at home after watching volunteers explain each step. Which paraphrase is accurate?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U03_L02_GP_Q04</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Participants became less willing to repair anything.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This reverses the meaning.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. Volunteers refused to explain repairs.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This contradicts the passage.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>C. Watching volunteers made participants more willing to attempt simple repairs themselves.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. This preserves the meaning.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Participants only watched and learned nothing.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>The passage says they were more likely to try repairs.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U03_L02_GP_Q05</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U03_L02_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.ENG4.V.01</p><p><strong>Passage:</strong> The evidence is sufficient because it gives enough information to support the central idea. What does sufficient mean?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U03_L02_GP_Q05</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Unrelated</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This is the opposite.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. Enough for the purpose</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Sufficient means adequate or enough.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Decorative</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This is unrelated.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Impossible to understand</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This is not the meaning.</p>]]></text></feedback>
    </answer>
  </question>
</quiz>

