  <question type="multichoice">
    <name><text>ENG4_U05_L08_GP_Q05</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U05_L08_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.10</p><p><strong>Passage:</strong> The committee gave qualified support, approving the plan only if safeguards were added. Which paraphrase is accurate?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U05_L08_GP_Q05</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. The committee fully approved the plan with no conditions.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Qualified support has conditions.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. The committee supported the plan only if protections were included.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. This preserves the meaning.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. The committee rejected the plan entirely.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. It gave support, but with conditions.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. The committee ignored the plan.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The committee responded to the plan.</p>]]></text></feedback>
    </answer>
  </question>
