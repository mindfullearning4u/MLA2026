  <question type="multichoice">
    <name><text>ENG4_U05_L08_GP_Q01</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U05_L08_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.ENG4.L.01</p><p>Draft: The source is credible it uses recent data. Which revision is best?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U05_L08_GP_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. The source is credible it uses recent data.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This remains a run-on sentence.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. The source is credible because it uses recent data.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. This fixes the sentence boundary and clarifies the cause.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. The source, credible recent data uses.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This is not standard English.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Because recent data credible source.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This is incomplete and unclear.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U05_L08_GP_Q02</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U05_L08_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.ENG4.V.02</p><p>What does provisional mean in the sentence, &quot;The board approved a provisional schedule until the final vote&quot;?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U05_L08_GP_Q02</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. permanent.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Until the final vote shows it is not permanent.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. careless.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The word does not mean careless.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. hidden.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The sentence does not suggest hidden.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>D. temporary or conditional.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Provisional means temporary or likely to change.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U05_L08_GP_Q03</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U05_L08_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.ENG4.V.03</p><p><strong>Passage:</strong> The plan was ambitious, but critics called it unrealistic. What is the best comparison?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U05_L08_GP_Q03</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>A. Ambitious suggests a challenging goal, while unrealistic questions whether it can work.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. This explains connotation and meaning.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. Both words praise the plan equally.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Unrealistic is critical.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Ambitious means ordinary.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Ambitious suggests a large goal.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Unrealistic means guaranteed.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. It means unlikely to be practical.</p>]]></text></feedback>
    </answer>
  </question>
