<quiz>
  <question type="multichoice">
    <name><text>ENG4_U05_L03_Q01</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U05_L03_Q01</p><p><strong>MLA Standard:</strong> MLA.ENG4.V.03</p><p><strong>Passage:</strong> The article called the mayor&#39;s response measured rather than timid. What does measured suggest?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U05_L03_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Fearful and weak.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. That is closer to timid, not measured.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. Careful and controlled.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Measured has a positive connotation of restraint and judgment.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Loud and dramatic.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Measured suggests control, not drama.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Accidental and unplanned.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The word suggests deliberate control.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U05_L03_Q02</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U05_L03_Q02</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.09</p><p><strong>Passage:</strong> The poet writes, &quot;Memory is a locked room with one window open.&quot; What does the image suggest?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U05_L03_Q02</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Memory is easy to enter completely.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Locked room suggests limited access.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. Memory has no connection to the past.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The image is about access to memory.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Memory is a literal room in a house.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The image is figurative.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>D. Memory is partly inaccessible but not entirely closed.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The locked room and open window create partial access.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U05_L03_Q03</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U05_L03_Q03</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.12</p><p><strong>Passage:</strong> A speaker calls a policy a shield for consumers. What rhetorical effect does shield create?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U05_L03_Q03</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>A. It frames the policy as protective and necessary.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Shield creates a protective association.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. It suggests consumers are attacking businesses.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Shield emphasizes protection, not attack.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. It makes the policy seem decorative.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Shield does not suggest decoration here.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. It makes the policy seem unrelated to consumers.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Consumers are the group being protected.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U05_L03_Q04</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U05_L03_Q04</p><p><strong>MLA Standard:</strong> MLA.ENG4.V.01</p><p>Which analysis is most precise?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U05_L03_Q04</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. The author uses a word that sounds negative.</p>]]></text>
