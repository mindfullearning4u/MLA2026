<quiz>
  <question type="multichoice">
    <name><text>ENG4_U05_L04_GP_Q01</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U05_L04_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.ENG4.V.03</p><p><strong>Passage:</strong> The schedule is provisional and may change after the committee votes. What does provisional mean?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U05_L04_GP_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. final and permanent.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The schedule may change, so it is not final.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. temporary or conditional.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The context says it may change after a later event.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. careless and unplanned.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The sentence does not imply carelessness.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. secret and unavailable.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Availability is not addressed.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U05_L04_GP_Q02</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U05_L04_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.ENG4.V.02</p><p>The word predictable comes from predict and the suffix -able. What does predictable mean?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U05_L04_GP_Q02</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. unable to be understood.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. That would conflict with the word parts.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. already completed.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The word parts do not show completion.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. spoken in public.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The word parts do not refer to speech.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>D. able to be expected or forecast.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Predict means forecast, and -able means able to be.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U05_L04_GP_Q03</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U05_L04_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.10</p><p><strong>Passage:</strong> The evidence was inconclusive, so the researcher delayed announcing a final claim. Which paraphrase is accurate?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U05_L04_GP_Q03</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>A. The evidence did not settle the issue, so the researcher waited to make a final claim.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. This preserves the meaning of inconclusive and delayed.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. The evidence proved the claim completely.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Inconclusive means not settled.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. The researcher ignored all evidence.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The researcher responded to the evidence.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. The researcher announced the final claim immediately.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The passage says delayed.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U05_L04_GP_Q04</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U05_L04_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.ENG4.V.03</p><p><strong>Passage:</strong> The report was concise rather than exhaustive. What word relationship helps determine concise?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U05_L04_GP_Q04</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Cause and effect.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The sentence contrasts two descriptions.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. Example and category.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. No category list is provided.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>C. Contrast or antonym.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Rather than signals a contrast between concise and exhaustive.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Definition and restatement.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The meaning is not directly restated.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U05_L04_GP_Q05</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U05_L04_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.ENG4.V.03</p><p>Reference entry: qualified means limited by conditions; officially trained; modified. <strong>Passage:</strong> The senator gave qualified support only if oversight was added. Which meaning fits?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U05_L04_GP_Q05</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. officially trained.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The sentence is about support, not training.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. limited by conditions.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Only if oversight was added shows conditional support.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. physically repaired.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. That meaning is not in the entry or context.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. unrelated to limits.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The phrase only if shows a limit.</p>]]></text></feedback>
    </answer>
  </question>
</quiz>

