<quiz>
  <question type="multichoice">
    <name><text>ENG4_U05_L06_GP_Q01</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U05_L06_GP_Q01</p><p><strong>MLA Standard:</strong> MLA.ENG4.W.04</p><p>Sentences: A. This evidence shows why the proposal is practical. B. The report lists three cities that reduced costs. C. The proposal is practical because similar plans have succeeded elsewhere. What is the strongest order?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U05_L06_GP_Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. A, B, C.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The explanation appears before the main claim.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. C, B, A.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. This order moves from claim to evidence to explanation.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. B, A, C.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The claim should come before evidence.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. A, C, B.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. The paragraph begins with explanation before the claim.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U05_L06_GP_Q02</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U05_L06_GP_Q02</p><p><strong>MLA Standard:</strong> MLA.ENG4.L.01</p><p>Draft: The data is current. However, it supports the claim. Which transition best replaces However?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U05_L06_GP_Q02</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. However.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. However signals contrast, but the second sentence supports the first.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. Instead.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Instead signals replacement, not support.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Meanwhile.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Meanwhile signals time or simultaneous action.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>D. Therefore.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Therefore signals a result or conclusion.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U05_L06_GP_Q03</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U05_L06_GP_Q03</p><p><strong>MLA Standard:</strong> MLA.ENG4.V.03</p><p>In revision, what does coherent mean?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U05_L06_GP_Q03</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>A. logically connected and easy to follow.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Coherent writing fits together clearly.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. full of unrelated details.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. That is incoherent, not coherent.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. grammatically incorrect.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Coherence concerns logical connection.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. intentionally confusing.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Coherent writing is clear.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U05_L06_GP_Q04</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U05_L06_GP_Q04</p><p><strong>MLA Standard:</strong> MLA.ENG4.W.04</p><p>Which revision best improves organization?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U05_L06_GP_Q04</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Add a random transition before every sentence.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Transitions must match the logic.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. Put evidence, explanation, and claim in any order.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. Order affects clarity.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>C. Begin with the main idea, then present evidence, then explain its significance.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. This creates logical progression.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Remove all transitions and evidence.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. That weakens organization.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U05_L06_GP_Q05</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U05_L06_GP_Q05</p><p><strong>MLA Standard:</strong> MLA.ENG4.L.01</p><p>Draft: The study was large therefore the results were more reliable. Which revision best clarifies the relationship?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U05_L06_GP_Q05</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. The study was large therefore the results were more reliable.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This lacks punctuation between clauses.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. The study was large; therefore, the results were more reliable.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The semicolon and transition correctly connect the ideas.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. The study was large, therefore the results were more reliable.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. A comma alone is not enough before therefore between independent clauses.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. The study large therefore reliable results.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Incorrect. This is not standard English.</p>]]></text></feedback>
    </answer>
  </question>
</quiz>

