    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Only personal responsibility</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This omits support.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. Both personal responsibility and thoughtful use of support</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The passage emphasizes both.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Only available support</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This omits responsibility.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Neither responsibility nor support</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This contradicts the passage.</p>]]></text></feedback>
    </answer>
  </question>
