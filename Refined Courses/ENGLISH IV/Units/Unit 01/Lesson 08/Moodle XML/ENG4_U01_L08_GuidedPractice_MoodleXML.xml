<quiz>
  <question type="multichoice">
    <name><text>ENG4_U01_L08_GP_Q1</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U01_L08_GP_Q1</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.10</p><p><strong>Passage:</strong> Independent learning does not mean working without support. Effective independent learners use resources deliberately, ask focused questions, evaluate feedback, and revise their work. Which paraphrase preserves the claim?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U01_L08_GP_Q1</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Independent learners never use support.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This contradicts the passage.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. Independent learners take responsibility while using support thoughtfully.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. This preserves the qualified idea.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Independent learning means avoiding feedback.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This contradicts the passage.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Independent learners do not revise work.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This contradicts the passage.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U01_L08_GP_Q2</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U01_L08_GP_Q2</p><p><strong>MLA Standard:</strong> MLA.ENG4.V.01</p><p><strong>Passage:</strong> Effective independent learners use resources deliberately, ask focused questions, evaluate feedback, and revise their work. What does deliberately mean?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U01_L08_GP_Q2</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Accidentally</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This is the opposite.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. Without thinking</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This is the opposite.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Silently</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This is unrelated.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>D. Intentionally and purposefully</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Deliberately means on purpose.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U01_L08_GP_Q3</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U01_L08_GP_Q3</p><p><strong>MLA Standard:</strong> MLA.ENG4.L.01</p><p><strong>Passage:</strong> Effective independent learners use resources deliberately, ask focused questions, evaluate feedback, and revise their work. Which sentence follows standard conventions?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U01_L08_GP_Q3</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>A. Effective learners ask focused questions, evaluate feedback, and revise their work.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. The series is clear and conventional.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. Effective learners asks focused questions.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>The subject and verb do not agree.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. Effective learners ask focused questions evaluate feedback and revise work.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Commas are needed for clarity.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. effective learners ask focused questions.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>The sentence begins with a lowercase letter.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U01_L08_GP_Q4</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U01_L08_GP_Q4</p><p><strong>MLA Standard:</strong> MLA.ENG4.C.01</p><p><strong>Passage:</strong> A student who studies the feedback can identify the pattern behind the mistake. Which oral explanation is most coherent?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U01_L08_GP_Q4</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. Feedback is there and mistakes happen.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This is vague.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. Mistakes are bad, so feedback is feedback.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This is circular.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>C. Studying feedback supports independent learning because it helps students recognize patterns in mistakes.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. This gives claim, evidence, and rationale.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. Students should not examine feedback.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This contradicts the passage.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U01_L08_GP_Q5</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U01_L08_GP_Q5</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.10</p><p><strong>Passage:</strong> Strong independent learning therefore depends on both personal responsibility and thoughtful use of available support. Which phrase must be preserved in a paraphrase?</p>]]></text></questiontext>
