  <question type="multichoice">
    <name><text>ENG4_U01_L06_GP_Q1</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U01_L06_GP_Q1</p><p><strong>MLA Standard:</strong> MLA.ENG4.V.01</p><p><strong>Passage:</strong> Before changing the schedule for a public study center, the planning team gathered feedback from students, tutors, and local employers. The comments did not produce complete consensus, but they revealed a shared concern: evening access mattered for students who worked during the day. What does consensus mean?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U01_L06_GP_Q1</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. A single recommendation</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This is not consensus.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>B. General agreement</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. Consensus means general agreement.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. A stakeholder group</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This names affected people, not agreement.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>D. A trial period</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This is a testing period.</p>]]></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>ENG4_U01_L06_GP_Q2</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>Question ID:</strong> ENG4_U01_L06_GP_Q2</p><p><strong>MLA Standard:</strong> MLA.ENG4.R.10</p><p><strong>Passage:</strong> The team recommended extending hours twice a week and reviewing attendance data after three months. Which paraphrase is accurate?</p>]]></text></questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>ENG4_U01_L06_GP_Q2</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A. The team permanently changed the schedule every night.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This overstates the recommendation.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>B. The team rejected all schedule changes.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>This contradicts the passage.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>C. The team studied attendance before making any recommendation.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>The passage says attendance would be reviewed after three months.</p>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>D. The team suggested trying later hours two times each week and checking attendance after three months.</p>]]></text>
      <feedback format="html"><text><![CDATA[<p>Correct. This preserves the recommendation.</p>]]></text></feedback>
    </answer>
  </question>
